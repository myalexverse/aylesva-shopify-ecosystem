

<style>

       @media (min-width: 1200px) {
  .header-logo img{
  max-width: {{ section.settings.logo_width }}px;
  }
  }
  </style>


{% capture navSize %}250px{% endcapture %}
{% capture navHeaderSize %}{{ section.settings.menu_mobile }}px{% endcapture %}
{% capture logoMaxHeight %}{{ section.settings.menu_mobile | minus: 30 }}px{% endcapture %}
{% capture borderWidth %}{{ settings.border_width }}px{% endcapture %}
{% capture colorBorder %}{{ settings.color_borders }}{% endcapture %}
{% assign navMenu = linklists[section.settings.nav_menu] %}
{%- assign sticky_class = '' -%}
{% if section.settings.sticky_header %}
{%- assign sticky_class = 'sticky_header' -%}
{% endif %}
<header class="site-header page-element header_1 {{ settings.header_icon_color }}{% if section.settings.display_menu %} menu_enable{% endif %}" data-section-id="{{ section.id }}" data-section-type="header">
  {% if section.settings.header_topbar_show %}
  <nav id="top">
    <div class="container">

                       {% if section.settings.topbar_service != blank %}

      <div class="header-top-left">
        {% if section.settings.topbar_service != nil %}
        <div id="ttcmsheader">
          <a href="{{ section.settings.service_url }}"><div class="ttheader-service">{{ section.settings.topbar_service }}</div></a>
        </div>
        {% endif %}
      </div>
                           {% endif %}

      
      <div class="header-top-right">
        <div id="top-links" class="nav pull-right">
          <ul class="list-inline">
                     {% if section.settings.email != blank %}

            <li>
              <div class="email"><a href="mailto:{{ section.settings.email_link }}">{{ section.settings.email }}</a></div>
            </li>
                                     {% endif %}
            <li>
              {% if section.settings.display_currency %} 
              <div class="header_currency">
                <ul class="tbl-list">
                  <li class="currency dropdown-parent uppercase currency-block">
                    {% if section.settings.display_currency %}    
                    {% render 'currencies-switcher' %}
                    {% endif %}
                  </li>
                </ul>
              </div>
              {% endif %}
            </li>
            <li>
              {% if section.settings.display_language %} 
              <div class="header_language">
                <ul class="tbl-list">
                  <li class="language dropdown-parent uppercase language-block"> 
                    {% render 'language-switcher' %}
                  </li>
                </ul>
              </div>
              {% endif %}
            </li>
            <li>
              {% if section.settings.display_wishlist %}   
              <div class="wishlist-icon-div">
                {% render 'wishlist', product: product %} 
              </div>
              {% endif %}
            </li>
            {% if section.settings.display_compare %}
            <li>                       
              <div class="compare-icon-div">
                <a class="compare" href="/pages/compare" title="{{ 'products.compare.compare_name' | t }}"><div class="compare-icon">{{ 'products.compare.compare_name' | t }}</div> <span class="compare-count"></span></a>
              </div>                    
            </li>
            {% endif %}
          </ul>
        </div>
      </div>
    </div>
  </nav>
  {% endif %} 
  <div class="full-header">
    <div class="container">
      <div class="row">
        <div class="header-left col-sm-3">
        <h1 class="header-logo position_relative" itemscope itemtype="http://schema.org/Organization">
            {% if section.settings.logo != blank %}
            <a href="{{ routes.root_url }}" itemprop="url">
              <img loading="lazy"  src="{{ section.settings.logo | img_url: 'master' }}" alt="{{ shop.name }}" itemprop="logo">
            </a>
            {% else %}
            <a href="{{ routes.root_url }}" itemprop="url">{{ shop.name }}</a>
            {% endif %}
          </h1>
      </div>
      <div class="col-sm-6 header-middle">
        <div id="header-search" class="input-group">
          {% render 'search-bar' %}
        </div>
      </div>
      <div class="header-right col-sm-3">
        <div id="cart" class="btn-group">
          {% if section.settings.display_cart %}  
          <div class="site-header__cart icon-btn">
            <div class="wrapper-top-cart">
              <a href="{{ routes.cart_url }}" id="cart-products-count" class="site-header_cart_link" onclick="if(window.innerWidth >= 992 && window.aylCartDrawer) { event.preventDefault(); window.aylCartDrawer.toggle(); }">          
                {% if cart.item_count > 0 %}
                <span class="cart-heading">{{ 'cart.general.cart_item' | t }}</span>
                <div class="btn btn-inverse btn-block btn-lg dropdown-toggle">
                  <i class="mdi mdi-cart-outline"></i>
                  <div id="CartCount_sticky" class="site-header__cart-count">
                    <span  class="cart-products-count" aria-hidden="true">{{ cart.item_count }}</span>
                  </div>
                </div>
                {% else %}
                <span class="cart-heading">{{ 'cart.general.cart_item' | t }}</span>
                <div class="btn btn-inverse btn-block btn-lg dropdown-toggle">
                  <i class="mdi mdi-cart-outline"></i>
                  <div id="CartCount_sticky" class="site-header__cart-count">
                    <span  class="cart-products-count" aria-hidden="true">0</span>
                  </div>
                </div>
                {% endif %}
              </a>
              <div id="Sticky-slidedown-cart" class="hide-desktop">
                <div class="mini-cart-wrap">
                  <!--  <h3>{{ 'cart.general.mini_cart_title' | t }}</h3>-->
                  <div class="no-items">
                    <p>{{ 'cart.general.empty' | t }}</p>
                  </div>
                  <div class="has-items">
                    <ul class="mini-products-list">  
                      {% for item in cart.items %}
                      <li class="item" id="cart-item-{{item.id}}">
                        <a href="{{item.url}}" title="{{item.title}}" class="product-image">
                          <img loading="lazy" src="{{ item.image | product_img_url: 'small' }}" alt="{{item.title}}"></a>
                        <div class="product-details">
                          <p class="product-name"><a href="{{item.url}}">{{ item.product.title }}
                            {% if item.product.variants.size != 0 %}
                            {% unless item.variant.title contains 'Default' %}
                            {{ item.variant.title }}
                            {% endunless %}
                            {% endif %}</a></p>
                          <div class="cart-collateral"><span class="price">{{item.price | money}}</span> x{{ item.quantity }}</div>
                          
                        </div>
                        <a href="javascript:void(0)" title="Remove This Item" class="btn-remove"><span class="mdi mdi-close"></span></a>
                      </li>
                      {% endfor %}
                    </ul>
                    <div class="summary">                
                      <p class="total">
                        <span class="label">{{ 'cart.general.cart_total' | t }}</span>
                        <span class="price">{{cart.total_price | money}}</span> 
                      </p>
                    </div>
                    <div class="actions">

                              <p style="float: none; clear: both; margin: 0 0 ;" class="cart_condition">
          <input style="float:none; vertical-align: middle;" type="checkbox" id="agree" />
          <label style="display:inline; float:none" for="agree">
            {{ 'cart.label.agree' | t }} <a href="/pages/terms-condition" target="_" >{{ 'cart.label.agree_page' | t }}</a>.
          </label>
        </p>
                      
                      <button class="btn check-out checkout-btn" ><i class="mdi mdi-share"></i>{{ 'cart.general.checkout' | t }}</button>
                      <button class="btn text-cart" onclick="window.location='{{ routes.cart_url }}'">{{ 'cart.general.view_cart' | t }}</button>

                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          {% endif %}
        </div>
      </div>
      {% if section.settings.display_myaccount %}
      <div class="myaccount icon-btn">
        <span class="dropdown-toggle" title="{{ 'general.header.my_account' | t }}" data-toggle="dropdown">
          <i class="mdi mdi-account-outline"></i><span class="title">{{ 'general.header.my_account' | t }}</span>
        </span>
        <div class="customer_account">  
          <ul>
            {% if shop.customer_accounts_enabled %}
            {% if customer %}
            <li>
              <a href="{{ routes.account_url }}" title="{{ 'customer.account.hello' | t }}">{{ 'customer.account.hello' | t }}<span class="username"> {{ customer.first_name }}</span></a>
            </li>
            <li class="logout-link">
              {{ 'layout.customer.log_out' | t | customer_logout_link }}
            </li>
            {% else %}
            <li>
              <a href="{{ routes.account_login_url }}" title="{{ 'layout.customer.log_in' | t }}">{{ 'layout.customer.log_in' | t }}</a>
            </li>
            <li>
              <a href="{{ routes.account_register_url }}" title="{{ 'layout.customer.create_account' | t }}">{{ 'layout.customer.create_account' | t }}</a>
            </li>          
            {% endif %}  
            {% endif %} 
          </ul>
        </div>
      </div>
      {% endif %}
      <div class="topmenu">
        {% include 'site-nav' with navMenu %}
      </div>
      </div>
    </div>
    <div id="header-sticky" class="menu-bar {{ sticky_class }}">
      <div class="container">

         {% if section.settings.contact-no != blank %}
        <div class="header-right-cms">
        <a target="_blank" href="https://wa.me/{{ section.settings.contact-no | escape }}" class="ttcmsheaderservice d-block">
            <div class="ttsupport">
              <div class="service">
                <div class="ttservice-content">                               
                  {% if section.settings.contact-no != "" %}
                  <div class="service-title">{{ section.settings.contact-title | escape }}</div>
                  <div class="service-desc">{{ section.settings.contact-no | escape }}</div>
                  {% endif %}
                </div>
              </div>
            </div>
          </a>
        </div>
     {% endif %}


        {% render 'header-mega-menu' %}
        <div class="ttresponsive_menu-wrap {{ settings.menutoggle_color }}">
          <div class="ttresponsive_menu"></div>	
        </div>
      </div>
    </div>
    {% comment %}
    {% if section.settings.display_menu %}
    {% assign navMenu = linklists[section.settings.nav_menu] %}
    <nav id="menu" class="navbar"> <!-- add class name as 'mega-menu' LIKE class="mega-menu" -->
      <div class="nav-menu-wrapper container">
        <h4 id="category" class="widget-title">Categories</h4>
        <div class="collapse navbar-collapse navbar-ex1-collapse" id="topnavmenu">
          {% include 'site-nav' with navMenu %}
        </div>
      </div>
    </nav>
    {% endif %}
    {% endcomment %}
  </div>
</header>

<style> @media (min-width: 992px) { .hide-desktop { display: none !important; } } </style>
<style>#tt-megamenu .tt_menu_item span.icon {color: {{section.settings.menu_txt_clr }};background: {{section.settings.menu_txt_clr }};}{% if section.settings.header_bg != blank %}header .full-header {background:url({{ section.settings.header_bg | img_url: "master"}});background-attachment:scroll;background-repeat:repeat;}{% endif %}#ttcmsheader .ttheader-service:before{color:{{ section.settings.topbar_service_icon_color }};}.menu-bar .topmenu #accessibleNav > li > a{color:{{ section.settings.menu_txt_color }};}.site-header .menu-bar {background: {{ section.settings.menu_bg_color}};}.ttcmsheaderservice .service .ttservice-content .service-desc, .ttcmsheaderservice .ttsupport .ttservice-content::before{color:{{ section.settings.header_service_icon_color }};}.full-header .topmenu .site-nav li:hover > a{color:{{ section.settings.toplink_txthover_clr }};background: {{ section.settings.toplink_bghover_clr}};}@media(max-width:991px){.full-header #cart .dropdown-toggle > i.mdi-cart-outline::before{color:{{ section.settings.menu_txt_color }};}.full-header .myaccount span.dropdown-toggle{background:none;}.ttcmsheaderservice .service .ttservice-content .service-desc, .ttcmsheaderservice .ttsupport .ttservice-content::before{color:#000;}}</style>
<style>#tt-megamenu span.toggle_menu {background:{{ section.settings.tt-title_bgclr }};color:{{ section.settings.tt-title_clr }};}.tt-mega-menu #tt-megamenu .tt-mega_menu{background:{{ section.settings.menu_bgclr }};}#tt-megamenu .tt-mega_menu .tt_menus_ul > li > a, #tt-megamenu .tt-mega_menu .tt_menus_ul > li span.categories {color:{{ section.settings.menu_txt_clr }};}#tt-megamenu .tt-mega_menu .tt_menus_ul > li:hover > a, #tt-megamenu .tt-mega_menu .tt_menus_ul > li:hover span.categories {color:#000;}.header_2 #tt-megamenu span.toggle_menu::before{background-color: {{ section.settings.tt-title_bgclr }};}.header_2 #tt-megamenu span.toggle_menu::after{border-color:transparent {{ section.settings.tt-title_bgclr }} transparent transparent;}@media(max-width:991px){.full-header .myaccount span.dropdown-toggle, .full-header #cart .dropdown-toggle > i.mdi-cart-outline::before{color:{{ section.settings.tt-title_clr }} !important;}#tt-megamenu #accessibleNav > li > a, #tt-megamenu .tt-mega_menu .tt_menus_ul > li i.mdi, .currency_wrapper.dropdown-toggle,.language_wrapper.dropdown-toggle, .header-top-right #top-links .wishlist-icon-div a.wishlist,.header-top-right #top-links .compare-icon-div a.compare, .ttcmsheaderservice .service .ttservice-content .service-desc, .ttcmsheaderservice .ttsupport .ttservice-content::before{color:{{ section.settings.menu_txt_clr }}!important;}}</style>

          <style>

          @media (min-width: 992px) {
          .full-header .topmenu .site-nav li > a {
          color: {{section.settings.menu_top_txt_clr }}
          }
          .full-header .topmenu .site-nav li .sub-nav__dropdown li > a {
    color: var(--color-body-text);
}
}
.site-header { position: relative; z-index: 1000 !important; }
.full-header { position: relative; z-index: 1001 !important; overflow: visible !important; }
.myaccount .customer_account, #Sticky-slidedown-cart { z-index: 9999 !important; display: none; }
.myaccount.open .customer_account { display: block !important; }
