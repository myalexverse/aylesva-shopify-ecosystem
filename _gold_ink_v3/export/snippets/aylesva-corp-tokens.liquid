{% comment %}
  Aylesva · Sistema visual corporativo "Gold & Ink"
  Incluir UNA sola vez en theme.liquid, dentro de <head>:
    {% render 'aylesva-corp-tokens' %}
  Todas las secciones aylesva-corp-* dependen de estas variables.
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700&family=Manrope:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">

<style>
  :root{
    --ay-ink-900:#020617;
    --ay-ink-800:#0F172A;
    --ay-gold:#C5A47E;
    --ay-gold-light:#E3CCAE;
    --ay-gold-text:#9A7B52;   /* dorado oscurecido para texto sobre fondo claro (contraste AA) */
    --ay-stone:#FAFAF8;
    --ay-white:#FFFFFF;

    --ay-font-display:'Sora',system-ui,sans-serif;
    --ay-font-body:'Manrope',system-ui,sans-serif;
    --ay-font-mono:'IBM Plex Mono',ui-monospace,monospace;

    --ay-max:1440px;
    --ay-pad-x:48px;
    --ay-pad-y:100px;
    --ay-radius:2px;
    --ay-hairline:1px solid rgba(15,23,42,.12);
    --ay-hairline-dark:1px solid rgba(255,255,255,.16);
  }

  .ay{font-family:var(--ay-font-body);color:var(--ay-ink-800);-webkit-font-smoothing:antialiased}
  .ay *,.ay *::before,.ay *::after{box-sizing:border-box}
  .ay-wrap{max-width:var(--ay-max);margin:0 auto;padding:var(--ay-pad-y) var(--ay-pad-x)}

  /* Eyebrow: mono, mayúsculas, tracking positivo. Firma del sistema. */
  .ay-eyebrow{display:flex;align-items:center;gap:12px;font-family:var(--ay-font-mono);font-size:11px;font-weight:500;letter-spacing:.2em;text-transform:uppercase;color:var(--ay-gold-text);margin:0 0 22px}
  .ay-eyebrow::before{content:"";width:24px;height:1px;background:var(--ay-gold);flex:0 0 24px}
  .ay-eyebrow--dark{color:var(--ay-gold-light)}

  /* Titulares: tracking NEGATIVO siempre */
  .ay-h1{font-family:var(--ay-font-display);font-weight:300;font-size:clamp(34px,4.4vw,62px);line-height:1.06;letter-spacing:-.03em;margin:0 0 26px;text-wrap:balance}
  .ay-h2{font-family:var(--ay-font-display);font-weight:400;font-size:clamp(28px,3.2vw,42px);line-height:1.12;letter-spacing:-.028em;margin:0;text-wrap:balance}
  .ay-h3{font-family:var(--ay-font-display);font-weight:500;font-size:21px;line-height:1.3;letter-spacing:-.015em;margin:0}
  .ay-lead{font-size:17px;line-height:1.7;color:rgba(15,23,42,.66);margin:0;text-wrap:pretty}
  .ay-body{font-size:15px;line-height:1.7;color:rgba(15,23,42,.64);margin:0}
  .ay-legal{font-size:12px;line-height:1.75;color:rgba(15,23,42,.52);margin:0}

  /* Botones */
  .ay-btn{display:inline-block;font-family:var(--ay-font-body);font-size:14px;font-weight:600;letter-spacing:.04em;padding:17px 34px;border-radius:var(--ay-radius);text-decoration:none;transition:all .25s ease;cursor:pointer}
  .ay-btn--primary{background:var(--ay-ink-800);color:#fff;border:1px solid var(--ay-ink-800)}
  .ay-btn--primary:hover{background:var(--ay-ink-900);transform:translateY(-2px);box-shadow:0 12px 28px -12px rgba(2,6,23,.55)}
  .ay-btn--gold{background:var(--ay-gold);color:var(--ay-ink-800);font-weight:700;border:1px solid var(--ay-gold)}
  .ay-btn--gold:hover{background:var(--ay-gold-light);transform:translateY(-2px);box-shadow:0 14px 30px -14px rgba(197,164,126,.55)}
  .ay-btn--ghost{border:1px solid var(--ay-gold);color:var(--ay-gold-text);background:transparent}
  .ay-btn--ghost:hover{background:var(--ay-gold);color:#fff}
  .ay-btn--ghost-dark{border:1px solid rgba(255,255,255,.42);color:#fff;background:transparent}
  .ay-btn--ghost-dark:hover{border-color:#fff;background:rgba(255,255,255,.08)}
  .ay-link{font-family:var(--ay-font-mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--ay-gold-text);text-decoration:none;border-bottom:1px solid rgba(197,164,126,.5);padding-bottom:4px}
  .ay-link:hover{border-color:var(--ay-gold)}

  /* Rejilla de tarjetas con separadores hairline (sin sombras en reposo) */
  .ay-grid{display:grid;gap:1px;background:rgba(15,23,42,.12);border:var(--ay-hairline)}
  .ay-grid--3{grid-template-columns:repeat(3,1fr)}
  .ay-grid--4{grid-template-columns:repeat(4,1fr)}
  .ay-card{background:#fff;padding:40px 34px 44px;transition:all .3s ease}
  .ay-card:hover{transform:translateY(-3px);box-shadow:0 26px 52px -30px rgba(2,6,23,.3);position:relative;z-index:2}

  /* Íconos: trazo 1.25, sin relleno, sin fondo */
  .ay-icon{display:block;width:30px;height:30px;stroke:var(--ay-gold);stroke-width:1.25;fill:none}

  /* Marco dorado interior para fotografía de producto / inmueble */
  .ay-media{position:relative;background:#d8d4cc;background-size:cover;background-position:center}
  .ay-media--framed::after{content:"";position:absolute;inset:12px;border:1px solid rgba(197,164,126,.85);pointer-events:none}

  @media (max-width:1024px){
    :root{--ay-pad-x:28px;--ay-pad-y:72px}
    .ay-grid--3,.ay-grid--4{grid-template-columns:1fr 1fr}
  }
  @media (max-width:640px){
    :root{--ay-pad-x:20px;--ay-pad-y:56px}
    .ay-grid--3,.ay-grid--4{grid-template-columns:1fr}
  }
</style>