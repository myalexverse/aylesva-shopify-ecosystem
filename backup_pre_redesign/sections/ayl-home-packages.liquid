        <div class="ayl-pkg-price">{{ section.settings.pkg3_price }}</div>
        <div class="ayl-pkg-profit">
          <span class="ayl-pkg-profit-lbl">Ganancia estimada:</span>
          <span class="ayl-pkg-profit-val">{{ section.settings.pkg3_profit }}</span>
        </div>
