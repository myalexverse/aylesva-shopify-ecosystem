</div>

{% style %}
  .ayl-packages-section {
    width: 100%;
    background-color: #ffffff;
    padding: 80px 0;
    box-sizing: border-box;
  }

  .ayl-packages-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    box-sizing: border-box;
  }

  .ayl-packages-header {
    text-align: center;
    margin-bottom: 60px;
  }

  .ayl-packages-pretitle {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 700;
    color: #C5A47E;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    display: block;
    margin-bottom: 12px;
  }

  .ayl-packages-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 700;
    color: #1a1a1a;
    letter-spacing: 0.05em;
    margin: 0 0 16px 0;
    text-transform: uppercase;
  }

  .ayl-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    color: #C5A47E;
  }

  .ayl-divider::before,
  .ayl-divider::after {
    content: '';
    display: block;
    width: 60px;
    height: 1px;
    background-color: #E6E2DA;
  }

  .ayl-divider-diamond {
    font-size: 11px;
    line-height: 1;
  }

  .ayl-packages-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    align-items: stretch;
  }

  @media (max-width: 1199px) {
    .ayl-packages-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 30px;
    }
  }

  @media (max-width: 767px) {
    .ayl-packages-grid {
      grid-template-columns: 1fr;
      gap: 45px;
      max-width: 400px;
      margin: 0 auto;
    }
  }

  .ayl-package-card {
    position: relative;
    background-color: #ffffff;
    border: 1px solid #EFECE6;
    border-radius: 16px;
    padding: 40px 30px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    box-sizing: border-box;
    transition: all 0.3s ease;
    box-shadow: 0 4px 20px rgba(0,0,0,0.02);
  }

  .ayl-package-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.06);
  }

  /* Highlighted Card Style (Emprendedor) */
  .ayl-package-card--highlighted {
    border: 2px solid #C5A47E;
    box-shadow: 0 10px 30px rgba(197, 164, 126, 0.12);
  }

  .ayl-package-card--highlighted:hover {
    box-shadow: 0 15px 40px rgba(197, 164, 126, 0.2);
  }

  .ayl-pkg-badge {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translate(-50%, -50%);
    background-color: #C5A47E;
    color: #ffffff;
    font-family: 'Inter', sans-serif;
    font-weight: 800;
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 6px 18px;
    border-radius: 30px;
    box-shadow: 0 4px 10px rgba(197, 164, 126, 0.3);
  }

  .ayl-pkg-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 24px;
    gap: 8px;
  }

  .ayl-pkg-icon {
    font-size: 24px;
    line-height: 1;
    color: #C5A47E;
  }

  .ayl-pkg-name {
    font-family: 'Playfair Display', serif;
    font-size: 18px;
    font-weight: 700;
    color: #1a1a1a;
    letter-spacing: 0.05em;
    margin: 0;
    text-transform: uppercase;
  }

  .ayl-pkg-qty-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1;
    margin-bottom: 12px;
  }

  .ayl-pkg-qty {
    font-family: 'Playfair Display', serif;
    font-size: 72px;
    font-weight: 700;
    color: #1a1a1a;
  }

  .ayl-pkg-qty-lbl {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 800;
    color: #706861;
    letter-spacing: 0.15em;
    margin-top: 4px;
  }

  .ayl-pkg-tagline {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    color: #706861;
    margin: 0 0 28px 0;
    min-height: 20px;
  }

  .ayl-pkg-price {
    font-family: 'Playfair Display', serif;
    font-size: 32px;
    font-weight: 700;
    color: #1a1a1a;
    margin-bottom: 16px;
  }

  .ayl-pkg-profit {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    background-color: #F8F7F3;
    padding: 12px 24px;
    border-radius: 8px;
    width: 100%;
    box-sizing: border-box;
    margin-bottom: 28px;
  }

  .ayl-pkg-profit-lbl {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    color: #706861;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .ayl-pkg-profit-val {
    font-family: 'Inter', sans-serif;
    font-size: 18px;
    font-weight: 700;
    color: #2d6b2d;
  }

  .ayl-pkg-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    background-color: #1a1a1a;
    color: #ffffff;
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 16px;
    border-radius: 4px;
    text-decoration: none !important;
    transition: all 0.3s ease;
    box-sizing: border-box;
    margin-bottom: 12px;
    border: 2px solid #1a1a1a;
  }

  .ayl-pkg-btn:hover {
    background-color: #C5A47E;
    border-color: #C5A47E;
    color: #ffffff;
  }

  /* Custom Highlight button background */
  .ayl-package-card--highlighted .ayl-pkg-btn {
    background-color: #C5A47E;
    border-color: #C5A47E;
  }

  .ayl-package-card--highlighted .ayl-pkg-btn:hover {
    background-color: #1a1a1a;
    border-color: #1a1a1a;
  }

  .ayl-pkg-unit-cost {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    color: #999;
  }

  .ayl-packages-footer {
    text-align: center;
    margin-top: 40px;
  }

  .ayl-packages-disclaimer {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    color: #999;
    margin: 0;
  }
{% endstyle %}

