{% comment %}
  Aylesva Distribuidores Wholesale Packages
  Responsive grid featuring three tiered wholesale packages (12, 24, 48 pcs) with pricing and estimated profits.
{% endcomment %}

<div class="ayl-packages-section" id="packages">
  <div class="ayl-packages-container">
    
    <div class="ayl-packages-header">
      <span class="ayl-packages-pretitle">{{ section.settings.pre_title }}</span>
      <h2 class="ayl-packages-title">{{ section.settings.title }}</h2>
      <div class="ayl-divider"><span class="ayl-divider-diamond">♦</span></div>
    </div>
    
    <div class="ayl-packages-grid">
      
      <!-- Package 1: Starter -->
      <div class="ayl-package-card">
        <div class="ayl-pkg-header">
          <span class="ayl-pkg-icon">★</span>
          <h3 class="ayl-pkg-name">{{ section.settings.pkg1_name }}</h3>
        </div>
        <div class="ayl-pkg-qty-wrap">
          <span class="ayl-pkg-qty">{{ section.settings.pkg1_qty }}</span>
          <span class="ayl-pkg-qty-lbl">PIEZAS</span>
        </div>
        <p class="ayl-pkg-tagline">{{ section.settings.pkg1_tagline }}</p>
        <div class="ayl-pkg-price">{{ section.settings.pkg1_price }}</div>
        <div class="ayl-pkg-profit">
          <span class="ayl-pkg-profit-lbl">Ganancia estimada:</span>
          <span class="ayl-pkg-profit-val">{{ section.settings.pkg1_profit }}</span>
        </div>
        <a href="{{ section.settings.pkg1_link | default: '/collections/all' }}" class="ayl-pkg-btn">
          Armar mi Paquete
        </a>
        <div class="ayl-pkg-unit-cost">
          {{ section.settings.pkg1_unit_cost }}<br>
          <span style="font-size: 11px; color: #c5a47e; font-weight: 600; display: block; margin-top: 4px;">(Aplica markup de +20% en carrito)</span>
        </div>
      </div>
      
      <!-- Package 2: Emprendedor (Highlighted) -->
      <div class="ayl-package-card ayl-package-card--highlighted">
        <div class="ayl-pkg-badge">MÁS POPULAR</div>
        <div class="ayl-pkg-header">
          <span class="ayl-pkg-icon">👑</span>
          <h3 class="ayl-pkg-name">{{ section.settings.pkg2_name }}</h3>
        </div>
        <div class="ayl-pkg-qty-wrap">
          <span class="ayl-pkg-qty">{{ section.settings.pkg2_qty }}</span>
          <span class="ayl-pkg-qty-lbl">PIEZAS</span>
        </div>
        <p class="ayl-pkg-tagline">{{ section.settings.pkg2_tagline }}</p>
        <div class="ayl-pkg-price">{{ section.settings.pkg2_price }}</div>
        <div class="ayl-pkg-profit">
          <span class="ayl-pkg-profit-lbl">Ganancia estimada:</span>
          <span class="ayl-pkg-profit-val">{{ section.settings.pkg2_profit }}</span>
        </div>
        <a href="{{ section.settings.pkg2_link | default: '/collections/all' }}" class="ayl-pkg-btn">
          Armar mi Paquete
        </a>
        <div class="ayl-pkg-unit-cost">
          {{ section.settings.pkg2_unit_cost }}<br>
          <span style="font-size: 11px; color: #c5a47e; font-weight: 600; display: block; margin-top: 4px;">(Aplica markup de +15% en carrito)</span>
        </div>
      </div>

      <!-- Package 4: Negocio Elite (36 pieces) -->
      <div class="ayl-package-card">
        <div class="ayl-pkg-header">
          <span class="ayl-pkg-icon">⚡</span>
          <h3 class="ayl-pkg-name">{{ section.settings.pkg4_name }}</h3>
        </div>
        <div class="ayl-pkg-qty-wrap">
          <span class="ayl-pkg-qty">{{ section.settings.pkg4_qty }}</span>
          <span class="ayl-pkg-qty-lbl">PIEZAS</span>
        </div>
        <p class="ayl-pkg-tagline">{{ section.settings.pkg4_tagline }}</p>
        <div class="ayl-pkg-price">{{ section.settings.pkg4_price }}</div>
        <div class="ayl-pkg-profit">
          <span class="ayl-pkg-profit-lbl">Ganancia estimada:</span>
          <span class="ayl-pkg-profit-val">{{ section.settings.pkg4_profit }}</span>
        </div>
        <a href="{{ section.settings.pkg4_link | default: '/collections/all' }}" class="ayl-pkg-btn">
          Armar mi Paquete
        </a>
        <div class="ayl-pkg-unit-cost">
          {{ section.settings.pkg4_unit_cost }}<br>
          <span style="font-size: 11px; color: #c5a47e; font-weight: 600; display: block; margin-top: 4px;">(Aplica markup de +10% en carrito)</span>
        </div>
      </div>
      
      <!-- Package 3: Tienda Pro -->
      <div class="ayl-package-card">
        <div class="ayl-pkg-header">
          <span class="ayl-pkg-icon">💎</span>
          <h3 class="ayl-pkg-name">{{ section.settings.pkg3_name }}</h3>
        </div>
        <div class="ayl-pkg-qty-wrap">
          <span class="ayl-pkg-qty">{{ section.settings.pkg3_qty }}</span>
          <span class="ayl-pkg-qty-lbl">PIEZAS</span>
        </div>
