{% comment %}
  Aylesva Distribuidores Benefits Bar
  Horizontal row of 5 corporate value propositions with custom SVG icons.
{% endcomment %}

<div class="ayl-benefits-bar" id="ayl-benefits-{{ section.id }}">
  <div class="ayl-benefits-container">
    <div class="ayl-benefits-grid">
      
      <!-- Benefit 1: Precios de Mayoreo -->
      <div class="ayl-benefit-item">
        <div class="ayl-benefit-icon-wrapper">
          <svg class="ayl-benefit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
            <line x1="7" y1="7" x2="7.01" y2="7"></line>
          </svg>
        </div>
        <div class="ayl-benefit-text">
          <h3 class="ayl-benefit-title">{{ section.settings.title_1 }}</h3>
          <p class="ayl-benefit-desc">{{ section.settings.desc_1 }}</p>
        </div>
      </div>

      <!-- Benefit 2: Desde 12 piezas -->
      <div class="ayl-benefit-item">
        <div class="ayl-benefit-icon-wrapper">
          <svg class="ayl-benefit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
            <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
            <line x1="12" y1="22.08" x2="12" y2="12"></line>
          </svg>
        </div>
        <div class="ayl-benefit-text">
          <h3 class="ayl-benefit-title">{{ section.settings.title_2 }}</h3>
          <p class="ayl-benefit-desc">{{ section.settings.desc_2 }}</p>
        </div>
      </div>

      <!-- Benefit 3: Envíos a todo México -->
      <div class="ayl-benefit-item">
        <div class="ayl-benefit-icon-wrapper">
          <svg class="ayl-benefit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="1" y="3" width="15" height="13"></rect>
            <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
            <circle cx="5.5" cy="18.5" r="2.5"></circle>
            <circle cx="18.5" cy="18.5" r="2.5"></circle>
          </svg>
        </div>
        <div class="ayl-benefit-text">
          <h3 class="ayl-benefit-title">{{ section.settings.title_3 }}</h3>
          <p class="ayl-benefit-desc">{{ section.settings.desc_3 }}</p>
        </div>
      </div>

      <!-- Benefit 4: Calidad Garantizada -->
      <div class="ayl-benefit-item">
        <div class="ayl-benefit-icon-wrapper">
          <svg class="ayl-benefit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="8" r="7"></circle>
            <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>
          </svg>
        </div>
        <div class="ayl-benefit-text">
          <h3 class="ayl-benefit-title">{{ section.settings.title_4 }}</h3>
          <p class="ayl-benefit-desc">{{ section.settings.desc_4 }}</p>
        </div>
      </div>

      <!-- Benefit 5: Atención Personalizada -->
      <div class="ayl-benefit-item">
        <div class="ayl-benefit-icon-wrapper">
          <svg class="ayl-benefit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
          </svg>
        </div>
        <div class="ayl-benefit-text">
          <h3 class="ayl-benefit-title">{{ section.settings.title_5 }}</h3>
          <p class="ayl-benefit-desc">{{ section.settings.desc_5 }}</p>
        </div>
      </div>

    </div>
  </div>
</div>

{% style %}
  .ayl-benefits-bar {
    width: 100%;
    background-color: #FDFBF7; /* Cozy warm ivory background */
    border-top: 1px solid #EFECE6;
    border-bottom: 1px solid #EFECE6;
    padding: 30px 0;
    box-sizing: border-box;
  }

  .ayl-benefits-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    box-sizing: border-box;
  }

  .ayl-benefits-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 20px;
    align-items: center;
  }

  @media (max-width: 991px) {
    .ayl-benefits-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 30px 20px;
    }
    
    /* Center fifth item when wrapping 2x2 */
    .ayl-benefit-item:last-child {
      grid-column: span 2;
      justify-content: center;
      max-width: 320px;
      margin: 0 auto;
    }
  }

  @media (max-width: 575px) {
    .ayl-benefits-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    
    .ayl-benefit-item:last-child {
      grid-column: span 1;
      max-width: 100%;
      margin: 0;
    }
  }

  .ayl-benefit-item {
    display: flex;
    align-items: center;
    gap: 16px;
    transition: all 0.3s ease;
  }

  .ayl-benefit-icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: #F6F2E9;
    color: #4a3e35;
    flex-shrink: 0;
    transition: all 0.3s ease;
  }

  .ayl-benefit-icon {
    width: 20px;
    height: 20px;
    transition: transform 0.3s ease;
  }

  .ayl-benefit-item:hover .ayl-benefit-icon-wrapper {
    background-color: #C5A47E;
    color: #ffffff;
    box-shadow: 0 4px 10px rgba(197, 164, 126, 0.2);
  }

  .ayl-benefit-item:hover .ayl-benefit-icon {
    transform: scale(1.1);
  }

  .ayl-benefit-text {
    display: flex;
    flex-direction: column;
  }

  .ayl-benefit-title {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 11px;
    font-weight: 800;
    color: #1a1a1a;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 3px 0;
  }

  .ayl-benefit-desc {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    color: #706861;
    margin: 0;
    line-height: 1.3;
  }
{% endstyle %}

