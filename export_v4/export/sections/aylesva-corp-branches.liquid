{% comment %}
  Aylesva · Banda del ecosistema. Va al pie de TODAS las landings de servicio,
  siempre con las otras ramas (nunca la rama en la que está el usuario).
{% endcomment %}
<section class="ay" style="background:{{ section.settings.bg }};border-top:var(--ay-hairline)">
  <div class="ay-wrap" style="padding-bottom:96px">
    <div style="margin-bottom:44px">
      {% if section.settings.eyebrow != blank %}<p class="ay-eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      <h2 class="ay-h2" style="font-size:34px;max-width:30ch">{{ section.settings.title }}</h2>
    </div>
    <div class="ay-grid ay-grid--4">
      {% for block in section.blocks %}
        <a class="ay-card" href="{{ block.settings.link }}" style="text-decoration:none;color:inherit;display:block" {{ block.shopify_attributes }}>
          {% if block.settings.icon != blank %}
            <svg class="ay-icon" viewBox="0 0 24 24" stroke-linecap="square" aria-hidden="true">{{ block.settings.icon }}</svg>
          {% endif %}
          <h3 class="ay-h3" style="font-size:18px;margin:26px 0 10px">{{ block.settings.title }}</h3>
          <p class="ay-body" style="font-size:14px">{{ block.settings.text }}</p>
          <span style="display:block;font-family:var(--ay-font-mono);font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--ay-gold-text);margin-top:26px">Conocer &rarr;</span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Aylesva · Ecosistema",
  "settings": [
    { "type": "color", "id": "bg", "label": "Fondo", "default": "#FFFFFF" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Ecosistema Aylesva" },
    { "type": "textarea", "id": "title", "label": "Titular", "default": "El mismo respaldo, en cada una de nuestras ramas" }
  ],
  "blocks": [
    { "type": "branch", "name": "Rama", "limit": 4, "settings": [
      { "type": "textarea", "id": "icon", "label": "Trazado SVG del ícono" },
      { "type": "text", "id": "title", "label": "Nombre de la rama" },
      { "type": "textarea", "id": "text", "label": "Descripción de una línea" },
      { "type": "url", "id": "link", "label": "Enlace" }
    ]}
  ],
  "presets": [{ "name": "Aylesva · Ecosistema" }]
}
{% endschema %}