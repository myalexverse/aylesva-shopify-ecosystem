{% comment %} Aylesva · Home v3 · Ecosistema: 6 tarjetas con foto, necesidad y puntos {% endcomment %}
<section class="ay" id="{{ section.settings.anchor }}" style="background:#fff;border-bottom:var(--ay-hairline)">
  <div class="ay-wrap" style="padding-top:88px;padding-bottom:96px">
    <div style="text-align:center;margin-bottom:56px">
      <p class="ay-eyebrow" style="justify-content:center;margin-bottom:12px">GRUPO AYLESVA · SOLUCIONES ESTRATÉGICAS</p>
      <h2 class="ay-h2" style="font-size:clamp(30px,3.8vw,46px);font-weight:700;letter-spacing:-0.025em">{{ section.settings.title }}</h2>
      {% if section.settings.intro != blank %}<p style="font-size:17px;line-height:1.65;color:#475569;margin:16px auto 0;max-width:64ch">{{ section.settings.intro }}</p>{% endif %}
    </div>
    <div class="ay-svc3-grid">
      {% for block in section.blocks %}
        {%- assign raw_img = block.settings.image_url | default: block.settings.image -%}
        {%- capture svc_img_src -%}
          {%- if raw_img.src -%}{{ raw_img | image_url: width: 900 }}
          {%- elsif raw_img contains 'http' -%}{{ raw_img }}
          {%- elsif raw_img contains 'shopify://shop_images/' -%}{%- assign ch = raw_img | remove: 'shopify://shop_images/' -%}{{ ch | file_img_url: '900x' }}
          {%- elsif raw_img contains '.jpg' or raw_img contains '.png' or raw_img contains '.webp' -%}{{ raw_img | asset_url }}
          {%- endif -%}
        {%- endcapture -%}
        {%- assign svc_img_src = svc_img_src | strip -%}
        <a class="ay-svc3 ay-reveal" href="{{ block.settings.link }}" style="animation-delay:{{ forloop.index0 | times: 80 }}ms" {{ block.shopify_attributes }}>
          <span class="ay-svc3-media">
            <span class="ay-svc3-img" {% if svc_img_src != blank %}style="background-image:url({{ svc_img_src }})"{% endif %}></span>
            <span class="ay-svc3-veil"></span>
            <span class="ay-svc3-badge">
              <span class="ay-svc3-chip">{% if block.settings.icon != blank %}<svg class="ay-icon ay-icon--xs" viewBox="0 0 24 24" stroke-linecap="square" aria-hidden="true">{{ block.settings.icon }}</svg>{% endif %}</span>
              <span class="ay-svc3-need">{{ block.settings.need }}</span>
            </span>
            {% if svc_img_src == blank %}<span class="ay-svc3-note">{{ block.settings.image_note }}</span>{% endif %}
          </span>
          <span class="ay-svc3-body">
            <span class="ay-svc3-name">{{ block.settings.name }}</span>
            <span class="ay-svc3-plain">{{ block.settings.plain }}</span>
            <span class="ay-svc3-desc">{{ block.settings.text }}</span>
            {% if block.settings.points != blank %}
              <span class="ay-svc3-points">
                {% assign items = block.settings.points | newline_to_br | split: '<br />' %}
                {% for item in items %}{% if item != blank %}
                  <span class="ay-svc3-point"><span class="ay-svc3-dot">&#9672;</span>{{ item | strip }}</span>
                {% endif %}{% endfor %}
              </span>
            {% endif %}
            <span class="ay-svc3-more">Ver detalles y beneficios <span class="ay-arrow">&rarr;</span></span>
          </span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .ay-svc3-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
  .ay-svc3{display:flex;flex-direction:column;border:1px solid rgba(15,23,42,.14);background:#FFFFFF;text-decoration:none;color:inherit;transition:all .35s cubic-bezier(.2,.8,.2,1);border-radius:10px;overflow:hidden;box-shadow:0 4px 16px -4px rgba(2,6,23,.06)}
  .ay-svc3:hover{transform:translateY(-6px);box-shadow:0 24px 48px -12px rgba(2,6,23,.18);border-color:var(--ay-gold)}
  .ay-svc3-media{position:relative;display:block;height:175px;overflow:hidden}
  .ay-svc3-img{position:absolute;inset:0;background-color:#111;background-size:cover;background-position:center;transition:transform .7s cubic-bezier(.22,.61,.36,1)}
  .ay-svc3:hover .ay-svc3-img{transform:scale(1.08)}
  .ay-svc3-veil{position:absolute;inset:0;background:linear-gradient(180deg,rgba(2,6,23,.6) 0%,rgba(2,6,23,.08) 65%)}
  .ay-svc3-badge{position:absolute;top:12px;left:12px;display:flex;align-items:center;gap:8px;z-index:2}
  .ay-svc3-chip{width:30px;height:30px;flex:0 0 30px;background:var(--ay-ink-900);display:flex;align-items:center;justify-content:center;border-radius:4px;border:1px solid rgba(197,164,126,0.5);box-shadow:0 2px 8px rgba(0,0,0,.3)}
  .ay-icon--xs{width:16px;height:16px;stroke:var(--ay-gold-light)}
  .ay-svc3-need{font-family:var(--ay-font-mono);font-size:10px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#fff;background:rgba(2,6,23,0.85);padding:4px 9px;border-radius:4px;border:1px solid rgba(255,255,255,.15);backdrop-filter:blur(4px)}
  .ay-svc3-note{position:absolute;left:12px;bottom:10px;font-family:var(--ay-font-mono);font-size:8px;letter-spacing:.1em;color:rgba(255,255,255,.65)}
  .ay-svc3-body{display:flex;flex-direction:column;gap:10px;padding:24px 22px 26px;flex:1}
  .ay-svc3-name{font-family:var(--ay-font-display);font-size:20px;font-weight:700;color:var(--ay-ink-900);letter-spacing:-.02em;line-height:1.2}
  .ay-svc3-plain{font-family:var(--ay-font-display);font-size:15.5px;font-weight:600;letter-spacing:-.01em;line-height:1.35;color:#8C6D40;text-wrap:pretty}
  .ay-svc3-desc{font-size:14px;line-height:1.62;color:#334155}
  .ay-svc3-points{display:flex;flex-direction:column;gap:8px;padding-top:14px;border-top:1px solid rgba(15,23,42,.1)}
  .ay-svc3-point{display:flex;gap:10px;align-items:center;font-size:13px;font-weight:600;line-height:1.4;color:var(--ay-ink-800)}
  .ay-svc3-dot{color:var(--ay-gold);font-size:11px;flex:0 0 auto}
  .ay-svc3-more{font-family:var(--ay-font-mono);font-size:11px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--ay-ink-900);margin-top:auto;padding-top:16px;display:inline-flex;align-items:center;gap:6px;transition:color .25s ease}
  .ay-svc3:hover .ay-svc3-more{color:var(--ay-gold-text)}

  @media (max-width:1024px){
    .ay-svc3-grid{grid-template-columns:1fr 1fr;gap:20px}
  }
  @media (max-width:640px){
    .ay-svc3-grid{grid-template-columns:1fr !important;gap:18px !important}
    .ay-svc3-media{height:180px !important}
  }
</style>

{% schema %}
{
  "name": "Aylesva · Servicios v3",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Ancla (id)", "default": "ecosistema" },
    { "type": "textarea", "id": "title", "label": "Titular", "default": "Nuestro ecosistema de soluciones" },
    { "type": "textarea", "id": "intro", "label": "Texto de entrada" }
  ],
  "blocks": [
    { "type": "service", "name": "Servicio", "limit": 6, "settings": [
      { "type": "image_picker", "id": "image", "label": "Fotografía (900×600)" },
      { "type": "text", "id": "image_url", "label": "URL o nombre de asset de imagen" },
      { "type": "text", "id": "image_note", "label": "Nota si no hay foto aún", "default": "foto pendiente" },
      { "type": "textarea", "id": "icon", "label": "Trazado SVG del ícono" },
      { "type": "text", "id": "need", "label": "Necesidad (Financiamiento, Inversión…)" },
      { "type": "text", "id": "name", "label": "Nombre de la rama" },
      { "type": "text", "id": "plain", "label": "Beneficio en lenguaje llano" },
      { "type": "textarea", "id": "text", "label": "Qué hace" },
      { "type": "textarea", "id": "points", "label": "Dos puntos (uno por línea)" },
      { "type": "url", "id": "link", "label": "Enlace a la landing" }
    ]}
  ],
  "presets": [{ "name": "Aylesva · Servicios v3" }]
}
{% endschema %}