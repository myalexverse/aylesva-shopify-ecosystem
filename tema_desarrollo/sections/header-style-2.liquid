    <script type="text/javascript">
      document.addEventListener('DOMContentLoaded', function() {
        var navBar = document.getElementById('custom-nav-bar');
        var navItems = document.querySelectorAll('#custom-nav-bar .nav-item');
        
        // Create portals container
        var portalContainer = document.createElement('div');
        portalContainer.id = 'nav-submenu-portals';
        document.body.appendChild(portalContainer);

        navItems.forEach(function(item, index) {
          var originalSubmenu = item.querySelector('.nav-submenu');
          if (!originalSubmenu) return;

          // Clone submenu for portal
          var portalSubmenu = originalSubmenu.cloneNode(true);
          portalSubmenu.className = 'nav-portal-submenu';
          if (index >= navItems.length - 2) {
            portalSubmenu.classList.add('align-right');
          }
          portalContainer.appendChild(portalSubmenu);

          var hideTimeout;

          function showPortal() {
            clearTimeout(hideTimeout);
            var rect = item.getBoundingClientRect();
            portalSubmenu.style.top = (rect.bottom - 5) + 'px'; // Tiny overlap
            
            if (portalSubmenu.classList.contains('align-right')) {
               portalSubmenu.style.left = 'auto';
               portalSubmenu.style.right = (window.innerWidth - rect.right) + 'px';
            } else {
               portalSubmenu.style.left = rect.left + 'px';
               portalSubmenu.style.right = 'auto';
            }
            
            portalSubmenu.classList.add('active');
          }

          function hidePortal() {
            hideTimeout = setTimeout(function() {
              portalSubmenu.classList.remove('active');
            }, 50);
          }

          item.addEventListener('mouseenter', showPortal);
          item.addEventListener('mouseleave', hidePortal);
          portalSubmenu.addEventListener('mouseenter', showPortal);
          portalSubmenu.addEventListener('mouseleave', hidePortal);
        });

        function closeAllPortals() {
          var activePortals = document.querySelectorAll('.nav-portal-submenu.active');
          activePortals.forEach(function(portal) {
            portal.classList.remove('active');
          });
        }

        window.addEventListener('scroll', closeAllPortals);
        var containerElement = navBar.querySelector('.container');
        if (containerElement) {
          containerElement.addEventListener('scroll', closeAllPortals);
        }

        // DYNAMIC SCROLL ARROWS & GRADIENTS MANAGER (LUXURY BRANDING)
        var leftArrow = document.getElementById('nav-arrow-left');
        var rightArrow = document.getElementById('nav-arrow-right');
        var container = navBar ? navBar.querySelector('.container') : null;

        function updateScrollIndicators() {
          if (!container || !leftArrow || !rightArrow) return;
          
          var scrollLeft = container.scrollLeft;
          var scrollWidth = container.scrollWidth;
          var clientWidth = container.clientWidth;
          
          // Allow a 4px tolerance for fractional subpixel layout calculations
          var hasLeftScroll = scrollLeft > 4;
          var hasRightScroll = (scrollWidth - clientWidth - scrollLeft) > 4;
          
          if (hasLeftScroll) {
            leftArrow.classList.add('visible');
            navBar.classList.add('scroll-left-active');
          } else {
            leftArrow.classList.remove('visible');
            navBar.classList.remove('scroll-left-active');
          }
          
          if (hasRightScroll) {
            rightArrow.classList.add('visible');
            navBar.classList.add('scroll-right-active');
          } else {
            rightArrow.classList.remove('visible');
            navBar.classList.remove('scroll-right-active');
          }
        }
        
        if (container && leftArrow && rightArrow) {
          container.addEventListener('scroll', updateScrollIndicators);
          window.addEventListener('resize', updateScrollIndicators);
          window.addEventListener('scroll', updateScrollIndicators); // Recalculate on sticky scroll toggle
          
          // Double timeout queue to cover page load rendering and font layout calculations
          setTimeout(updateScrollIndicators, 100);
          setTimeout(updateScrollIndicators, 600);
          
          leftArrow.addEventListener('click', function() {
            container.scrollBy({ left: -250, behavior: 'smooth' });
          });
          
          rightArrow.addEventListener('click', function() {
            container.scrollBy({ left: 250, behavior: 'smooth' });
          });
        }

        function handleSticky() {
          if (window.innerWidth > 991) {
            if (window.scrollY > 150) { 
              navBar.classList.add('fixed');
            } else {
              navBar.classList.remove('fixed');
            }
          } else {
            navBar.classList.remove('fixed');
          }
        }
        window.addEventListener('scroll', handleSticky);
        window.addEventListener('resize', handleSticky);
        handleSticky();
      });
    </script>
