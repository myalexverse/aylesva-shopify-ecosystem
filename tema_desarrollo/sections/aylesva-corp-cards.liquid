  }
  .ay-proj-modal__body {
    padding: 36px;
  }

  /* SLIDER INTERACTIVO */
  .ay-slider {
    margin-bottom: 24px;
  }
  .ay-slider__stage {
    position: relative;
    width: 100%;
    height: 460px;
    background: #0f172a;
    border-radius: var(--ay-radius);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ay-slider__track {
    width: 100%;
    height: 100%;
    position: relative;
  }
  .ay-slider__item {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.35s ease, visibility 0.35s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ay-slider__item.is-active {
    opacity: 1;
    visibility: visible;
    z-index: 2;
  }
  .ay-slider__item img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }
  .ay-slider__caption {
    position: absolute;
    bottom: 16px;
    left: 16px;
    background: rgba(2,6,23,0.85);
    backdrop-filter: blur(6px);
    color: #E3CCAE;
    font-family: var(--ay-font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 8px 14px;
    border-radius: 2px;
    z-index: 4;
  }

  /* Botones de navegación (Flechas) */
  .ay-slider__btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255,255,255,0.9);
    border: none;
    color: var(--ay-ink-900);
    font-size: 26px;
    line-height: 1;
    display: grid;
    place-items: center;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(0,0,0,0.3);
    transition: all 0.2s ease;
  }
  .ay-slider__btn:hover {
    background: #fff;
    transform: translateY(-50%) scale(1.1);
    color: var(--ay-gold-text);
  }
  .ay-slider__btn--prev { left: 16px; }
  .ay-slider__btn--next { right: 16px; }

  .ay-slider__counter {
    position: absolute;
    top: 16px;
    right: 16px;
    background: rgba(2,6,23,0.8);
    backdrop-filter: blur(6px);
    color: #fff;
    font-family: var(--ay-font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    padding: 6px 12px;
    border-radius: 2px;
    z-index: 4;
  }

  /* Miniaturas / Pestañas de slider */
  .ay-slider__thumbs {
    display: flex;
    gap: 12px;
    margin-top: 16px;
    overflow-x: auto;
    padding-bottom: 8px;
  }
  .ay-slider__thumb {
    flex: 0 0 110px;
    height: 70px;
    border: 2px solid transparent;
    border-radius: var(--ay-radius);
    overflow: hidden;
    position: relative;
    cursor: pointer;
    background: #111827;
    padding: 0;
    transition: all 0.2s ease;
  }
  .ay-slider__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.6;
    transition: opacity 0.2s ease;
  }
  .ay-slider__thumb span {
    position: absolute;
    bottom: 2px;
    left: 2px;
    right: 2px;
    background: rgba(2,6,23,0.85);
    color: #fff;
    font-family: var(--ay-font-mono);
    font-size: 9px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 2px 4px;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ay-slider__thumb:hover img {
    opacity: 0.85;
  }
  .ay-slider__thumb.is-active {
    border-color: var(--ay-gold);
    box-shadow: 0 0 0 2px rgba(197,164,126,0.4);
  }
  .ay-slider__thumb.is-active img {
    opacity: 1;
  }

  @media (max-width: 1024px) {
    .ay-cards{grid-template-columns:1fr 1fr !important}
    .ay-head{grid-template-columns:1fr !important;gap:24px !important}
    .ay-slider__stage { height: 320px; }
    .ay-proj-modal__header { padding: 20px 24px; }
    .ay-proj-modal__body { padding: 24px; }
    .ay-slider__thumb { flex: 0 0 85px; height: 55px; }
  }
  @media (max-width: 640px) {
    .ay-cards{grid-template-columns:1fr !important}
    .ay-proj-modal { padding: 12px; }
    .ay-slider__stage { height: 260px; }
    .ay-slider__btn { width: 36px; height: 36px; font-size: 20px; }
  }
</style>

<script>
  (function() {
    // Abrir modales de galería
    document.querySelectorAll('[data-open-modal]').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        var modalId = btn.getAttribute('data-open-modal');
        var modal = document.getElementById(modalId);
        if (modal) {
          modal.classList.add('is-open');
          document.body.style.overflow = 'hidden';
          // Inicializar contador del slider
          var slider = modal.querySelector('[data-ay-slider]');
          if (slider) updateSliderState(slider, 0);
        }
      });
    });

    // Cerrar modales
    document.querySelectorAll('[data-close-modal]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var modal = btn.closest('.ay-proj-modal');
        if (modal) {
          modal.classList.remove('is-open');
          document.body.style.overflow = '';
        }
      });
    });

    // Cerrar con Escape
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        document.querySelectorAll('.ay-proj-modal.is-open').forEach(function(m) {
          m.classList.remove('is-open');
        });
        document.body.style.overflow = '';
      }
    });

    // Función controladora del Slider
    function updateSliderState(slider, targetIndex) {
      var items = slider.querySelectorAll('.ay-slider__item');
      var thumbs = slider.querySelectorAll('.ay-slider__thumb');
      var counter = slider.querySelector('[data-slide-counter]');
      var total = items.length;
      if (total === 0) return;

      if (targetIndex < 0) targetIndex = total - 1;
      if (targetIndex >= total) targetIndex = 0;

      items.forEach(function(item, idx) {
        item.classList.toggle('is-active', idx === targetIndex);
      });

      thumbs.forEach(function(thumb, idx) {
        thumb.classList.toggle('is-active', idx === targetIndex);
      });

      if (counter) {
        counter.textContent = (targetIndex + 1) + ' / ' + total;
      }
      slider.setAttribute('data-current-index', targetIndex);
    }

    // Inicializar controles de cada slider
    document.querySelectorAll('[data-ay-slider]').forEach(function(slider) {
      var prevBtn = slider.querySelector('[data-slide-prev]');
      var nextBtn = slider.querySelector('[data-slide-next]');
      var thumbs = slider.querySelectorAll('[data-thumb-index]');

      function getCur() {
        return parseInt(slider.getAttribute('data-current-index') || '0', 10);
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', function(e) {
          e.stopPropagation();
          updateSliderState(slider, getCur() - 1);
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', function(e) {
          e.stopPropagation();
          updateSliderState(slider, getCur() + 1);
        });
      }

      thumbs.forEach(function(thumb) {
        thumb.addEventListener('click', function() {
          var idx = parseInt(thumb.getAttribute('data-thumb-index'), 10);
          updateSliderState(slider, idx);
        });
      });

      // Swipe táctil para móviles
      var startX = 0;
      slider.querySelector('.ay-slider__stage').addEventListener('touchstart', function(e) {
        startX = e.changedTouches[0].screenX;
      }, { passive: true });

      slider.querySelector('.ay-slider__stage').addEventListener('touchend', function(e) {
        var endX = e.changedTouches[0].screenX;
        if (startX - endX > 40) {
          updateSliderState(slider, getCur() + 1); // Swipe izquierda -> siguiente
        } else if (endX - startX > 40) {
          updateSliderState(slider, getCur() - 1); // Swipe derecha -> anterior
        }
      }, { passive: true });
    });

  })();
</script>

