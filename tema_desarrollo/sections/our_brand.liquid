<div class="page-width brands_slider_wrap" data-section-id="{{ section.id }}" style="padding: 50px 0; background-color: {{ section.settings.bg | default: '#ffffff' }}; border-top: 1px solid #f0f0f0;">
  <div class="container" style="max-width: 1200px; margin: 0 auto; padding: 0 20px;">
    {% if section.settings.title != blank %}
      <div class="section-header text-center" style="margin-bottom: 30px;">
        <h2 class="tt-title" style="font-size: 20px; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; color: #1a1a1a; margin: 0;">{{ section.settings.title | escape }}</h2>
      </div>
    {% endif %}
    <style>
      .ayl-brands-grid {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 40px 60px;
      }
      .ayl-brand-item {
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.2s ease, opacity 0.2s ease;
      }
      .ayl-brand-item:hover {
        transform: translateY(-3px);
      }
      .ayl-brand-item img {
        max-height: 55px;
        max-width: 150px;
        width: auto;
        height: auto;
        object-fit: contain;
        filter: grayscale(100%);
        opacity: 0.65;
        transition: all 0.3s ease;
      }
      .ayl-brand-item:hover img {
        filter: grayscale(0%);
        opacity: 1;
      }
      @media (max-width: 767px) {
        .ayl-brands-grid {
          gap: 25px 30px;
        }
        .ayl-brand-item img {
          max-height: 38px;
          max-width: 110px;
        }
      }
    </style>
    <div class="ayl-brands-grid">
      {% for block in section.blocks %}
        {% if block.settings.image != blank or block.settings.link != blank %}
          <div class="ayl-brand-item" {{ block.shopify_attributes }}>
            {% if block.settings.link != blank %}
              <a href="{{ block.settings.link }}" class="brand-bar__link" aria-label="Marca asociada">
            {% endif %}
            {% if block.settings.image != blank %}
              <img loading="lazy" src="{{ block.settings.image | img_url: '400x' }}" alt="Marca" />
            {% else %}
              {{ 'logo' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
            {% if block.settings.link != blank %}
              </a>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>


{% schema %}
{
"name": "Brand list",
"class": "index-section",
"settings": [


          {
"type": "range",
"id": "product_col_desktop_pro",
"min": 2,
"max": 20,
"step": 1,
"label": "Number of columns on Desktop",
"default": 6
},


{
"type": "range",
"id": "product_col_mobile_pro",
"min": 1,
"max": 5,
"step": 1,
"label": "Number of columns on Mobile",
"default": 2
},

  
{
"type": "text",
"id": "addclass",
"label": "Add Class",
"default": "brands"
},
{
"type": "text",
"id": "title",
"label": "Heading",
"default": "Brand list"
},
{
"type": "color",
"id": "bg",
"label": "background color",
"default": "#fff"
}
],
"blocks": [
{
"type": "brand_image",
"name": "Brand",
"settings": [
{
