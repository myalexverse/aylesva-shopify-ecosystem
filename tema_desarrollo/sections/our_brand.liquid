"info": "Optional"
}
]
}
],
"presets": [
{
"name": "Brand list",
"category": "Image",
"blocks": [
{
"type": "brand_image"
},
{
"type": "brand_image"
},
{
"type": "brand_image"
},
{
"type": "brand_image"
},
{
"type": "brand_image"
},
{
"type": "brand_image"
}
]
}
]
}
{% endschema %}