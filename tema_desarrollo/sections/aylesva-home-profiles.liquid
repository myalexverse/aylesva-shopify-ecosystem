{% comment %}
  Aylesva · Home v3 · Selector "Soy…".
  Cada bloque "profile" trae su propia lista de coincidencias (3 recomendadas)
  en el campo "matches", una por línea:
      Rama | Beneficio | Por qué aplica | enlace | trazado SVG del ícono
{% endcomment %}
<section class="ay" id="{{ section.settings.anchor }}" style="background:var(--ay-stone);border-bottom:var(--ay-hairline)">
  <div class="ay-wrap" style="padding-top:80px;padding-bottom:80px">
    <div style="text-align:center;margin-bottom:44px">
      <h2 class="ay-h2">{{ section.settings.title }}</h2>
      {% if section.settings.intro != blank %}<p style="font-size:16px;line-height:1.65;color:rgba(15,23,42,.6);margin:14px auto 0;max-width:60ch">{{ section.settings.intro }}</p>{% endif %}
    </div>

    <div class="ay-prof-grid">
      {% for block in section.blocks %}
        {%- assign raw_img = block.settings.image_url | default: block.settings.image -%}
        {%- capture prof_img_src -%}
          {%- if raw_img.src -%}{{ raw_img | image_url: width: 900 }}
          {%- elsif raw_img contains 'http' -%}{{ raw_img }}
          {%- elsif raw_img contains 'shopify://shop_images/' -%}{%- assign ch = raw_img | remove: 'shopify://shop_images/' -%}{{ ch | file_img_url: '900x' }}
          {%- elsif raw_img contains '.jpg' or raw_img contains '.png' or raw_img contains '.webp' -%}{{ raw_img | asset_url }}
          {%- endif -%}
        {%- endcapture -%}
        {%- assign prof_img_src = prof_img_src | strip -%}
        <button class="ay-prof" type="button" data-prof="{{ forloop.index0 }}" {% if forloop.first %}data-on="1"{% endif %} {{ block.shopify_attributes }}>
          <span class="ay-prof-img" {% if prof_img_src != blank %}style="background-image:url({{ prof_img_src }})"{% endif %}></span>
          <span class="ay-prof-veil"></span>
          {% if prof_img_src == blank %}<span class="ay-prof-note">{{ block.settings.image_note }}</span>{% endif %}
          <span class="ay-prof-body">
            <span class="ay-prof-name">{{ block.settings.name }}</span>
            <span class="ay-prof-desc">{{ block.settings.text }}</span>
            <span class="ay-prof-mark"></span>
          </span>
        </button>
      {% endfor %}
    </div>

    <div class="ay-prof-results">
      {% for block in section.blocks %}
        <div class="ay-prof-panel" data-prof="{{ forloop.index0 }}" {% if forloop.first %}data-on="1"{% endif %}>
          <p class="ay-prof-lead">{{ block.settings.lead }}</p>
          <div class="ay-prof-matches">
            {% assign rows = block.settings.matches | newline_to_br | split: '<br />' %}
            {% for row in rows %}
              {% if row != blank %}
                {% assign c = row | split: '|' %}
                <a class="ay-match" href="{{ c[3] | strip }}">
                  <span class="ay-match-top">
                    <span class="ay-match-chip"><svg class="ay-icon ay-icon--xs" viewBox="0 0 24 24" stroke-linecap="square" aria-hidden="true">{{ c[4] | strip }}</svg></span>
                    <span class="ay-match-name">{{ c[0] | strip }}</span>
                  </span>
                  <span class="ay-match-plain">{{ c[1] | strip }}</span>
                  <span class="ay-match-why">{{ c[2] | strip }}</span>
                  <span class="ay-match-more">Conocer <span class="ay-arrow">&rarr;</span></span>
                </a>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .ay-prof-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-bottom:36px}
  .ay-prof{position:relative;display:flex;height:262px;overflow:hidden;border:1px solid rgba(15,23,42,.14);background:none;padding:0;cursor:pointer;text-align:left;transition:all .35s cubic-bezier(.22,.61,.36,1);border-radius:var(--ay-radius)}
  .ay-prof[data-on]{border-color:var(--ay-gold);box-shadow:0 12px 28px -10px rgba(0,0,0,0.3)}
  .ay-prof-img{position:absolute;inset:0;background-color:#111;background-size:cover;background-position:center;transition:transform .6s cubic-bezier(.22,.61,.36,1)}
  .ay-prof:hover .ay-prof-img{transform:scale(1.05)}
  .ay-prof-veil{position:absolute;inset:0;background:linear-gradient(180deg,rgba(2,6,23,.1) 0%,rgba(2,6,23,.55) 50%,rgba(2,6,23,.95) 100%)}
  .ay-prof-note{position:absolute;left:14px;top:14px;font-family:var(--ay-font-mono);font-size:8px;letter-spacing:.1em;color:rgba(255,255,255,.65)}
  .ay-prof-body{position:absolute;left:0;right:0;bottom:0;padding:18px;display:flex;flex-direction:column;gap:6px;z-index:2}
  .ay-prof-name{font-family:var(--ay-font-display);font-size:18px;font-weight:400;color:#fff;letter-spacing:-.015em}
  .ay-prof-desc{font-size:12.5px;line-height:1.45;color:rgba(255,255,255,.75)}
  .ay-prof-mark{width:0;height:2px;background:var(--ay-gold);transition:width .35s ease;margin-top:4px}
  .ay-prof[data-on] .ay-prof-mark{width:36px}

  .ay-prof-panel{display:none}
  .ay-prof-panel[data-on]{display:block;animation:ay-fade .4s ease forwards}
  .ay-prof-lead{font-family:var(--ay-font-display);font-size:17px;font-weight:400;color:var(--ay-ink-800);margin:0 0 20px;letter-spacing:-.01em}
  .ay-prof-matches{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
  .ay-match{display:flex;flex-direction:column;gap:10px;padding:22px 20px 24px;background:#fff;border:1px solid rgba(15,23,42,.12);text-decoration:none;color:inherit;transition:all .3s ease;border-radius:var(--ay-radius)}
  .ay-match:hover{transform:translateY(-3px);border-color:rgba(197,164,126,.8);box-shadow:0 16px 36px -20px rgba(2,6,23,.25)}
  .ay-match-top{display:flex;align-items:center;gap:10px}
  .ay-match-chip{width:28px;height:28px;background:var(--ay-ink-800);display:flex;align-items:center;justify-content:center;border-radius:2px;border:1px solid rgba(197,164,126,0.3)}
  .ay-match-name{font-family:var(--ay-font-mono);font-size:10px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:var(--ay-gold-text)}
  .ay-match-plain{font-family:var(--ay-font-display);font-size:16px;font-weight:400;color:var(--ay-ink-800);letter-spacing:-.015em;line-height:1.3}
  .ay-match-why{font-size:13px;line-height:1.55;color:rgba(15,23,42,.62)}
  .ay-match-more{font-family:var(--ay-font-mono);font-size:9.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--ay-gold-text);margin-top:auto;padding-top:10px}

  @keyframes ay-fade{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}

  @media (max-width:1024px){
    .ay-prof-grid{grid-template-columns:repeat(2,1fr);gap:14px}
    .ay-prof-matches{grid-template-columns:1fr 1fr;gap:14px}
  }
  @media (max-width:640px){
    .ay-prof-grid{grid-template-columns:1fr 1fr !important;gap:10px !important}
    .ay-prof{height:200px !important}
    .ay-prof-name{font-size:16px !important}
    .ay-prof-desc{font-size:11.5px !important}
    .ay-prof-matches{grid-template-columns:1fr !important;gap:14px !important}
  }
</style>

<script>
  (function(){
    var root = document.getElementById('shopify-section-{{ section.id }}') || document.getElementById('{{ section.id }}');
    if(!root) return;
    var btns = root.querySelectorAll('.ay-prof');
    var panels = root.querySelectorAll('.ay-prof-panel');
    btns.forEach(function(b,n){
      b.addEventListener('click', function(){
        btns.forEach(function(x,i){ if(i===n) x.setAttribute('data-on','1'); else x.removeAttribute('data-on'); });
        panels.forEach(function(p,i){ if(i===n) p.setAttribute('data-on','1'); else p.removeAttribute('data-on'); });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Aylesva · Perfiles",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Ancla (id)", "default": "perfiles" },
    { "type": "textarea", "id": "title", "label": "Titular", "default": "Encuentra tu solución ideal" },
    { "type": "textarea", "id": "intro", "label": "Texto de entrada", "default": "Selecciona el perfil que mejor te describe para ver las ramas pensadas para ti." }
  ],
  "blocks": [
    { "type": "profile", "name": "Perfil", "limit": 4, "settings": [
      { "type": "image_picker", "id": "image", "label": "Fotografía vertical (900×1100)" },
      { "type": "text", "id": "image_url", "label": "URL o nombre de asset de imagen" },
      { "type": "text", "id": "image_note", "label": "Nota si no hay foto aún", "default": "foto pendiente" },
      { "type": "text", "id": "name", "label": "Nombre del perfil (p. ej. Soy emprendedor)" },
      { "type": "textarea", "id": "text", "label": "Descripción corta" },
      { "type": "textarea", "id": "lead", "label": "Encabezado de resultados" },
      { "type": "textarea", "id": "matches", "label": "Coincidencias (Rama | Beneficio | Por qué | Enlace | SVG)" }
    ]}
  ],
  "presets": [{ "name": "Aylesva · Perfiles" }]
}
{% endschema %}