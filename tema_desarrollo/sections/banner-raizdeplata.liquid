{% comment %}
  ============================================================
  Raíz de Plata — De Haro | Banner de Lujo con Marco 3D y Relieve
  Inspirado en la orfebrería de plata y oro de Zacatecas y cavas de autor.
  Diseño tridimensional, creativo, interactivo y 100% responsive.
  ============================================================
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700;800;900&family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<div id="rdp-3d-{{ section.id }}" class="rdp-3d-wrapper">
  
  <!-- CONTENEDOR PRINCIPAL CON RELIEVE Y BISEL 3D -->
  <div class="rdp-3d-box">
    
    <!-- ESQUINAS ORNAMENTALES METÁLICAS 3D -->
    <div class="rdp-corner rdp-corner-tl"></div>
    <div class="rdp-corner rdp-corner-tr"></div>
    <div class="rdp-corner rdp-corner-bl"></div>
    <div class="rdp-corner rdp-corner-br"></div>

    <!-- FONDO ATMOSFÉRICO DE VIÑEDO & CAVA -->
    <div class="rdp-3d-bg">
      <div class="rdp-3d-photo" style="background-image: url('{{ 'rdp-vinedos-bg.jpg' | asset_url }}');"></div>
      <div class="rdp-3d-gradient"></div>
      <div class="rdp-spotlight-top"></div>
      <div class="rdp-spotlight-bottle"></div>
    </div>

    <!-- ESTRUCTURA INTERNA -->
    <div class="rdp-3d-content">
      
      <!-- CABECERA DE MARCA HERÁLDICA -->
      <div class="rdp-header-brand">
        <div class="rdp-logo-shield-wrap">
          <img src="{{ 'rdp-logo-gold.png' | asset_url }}" alt="Raíz de Plata — De Haro" class="rdp-gold-heraldry" width="180" height="90" loading="lazy">
        </div>
        <div class="rdp-crest-divider">
          <span class="rdp-crest-line"></span>
          <span class="rdp-crest-gem">❖</span>
          <span class="rdp-crest-line"></span>
        </div>
        <div class="rdp-terroir-ribbon">
          <span class="rdp-ribbon-text">BODEGA BOUTIQUE · TERROIR DE ALTURA · JEREZ, ZACATECAS</span>
        </div>
      </div>

      <!-- ESCENARIO PRINCIPAL A DOS COLUMNAS -->
      <div class="rdp-main-stage">
        
        <!-- COLUMNA IZQUIERDA: INFORMACIÓN Y SELECTOR 3D -->
        <div class="rdp-left-narrative">
          
          <div class="rdp-headline-wrap">
            <span class="rdp-subtitle-top">COLECCIÓN PRIVADA DE AUTOR</span>
            <h2 class="rdp-headline-title">
              Vinos de Terruño <br>
              <span class="rdp-gold-shimmer">Nacidos en las Alturas</span>
            </h2>
          </div>

          <p class="rdp-synopsis">
            A más de 2,000 metros sobre el nivel del mar, en los valles minerales de Jerez, cada racimo es cosechado a mano y transformado pacientemente en barricas de roble francés. Un homenaje a la tierra, el arte y la tradición vitivinícola zacatecana.
          </p>

          <!-- SELECTOR DINÁMICO DE MEDALLAS 3D -->
          <div class="rdp-pills-container">
            <span class="rdp-pills-label">SELECCIONA LA ETIQUETA:</span>
            <div class="rdp-medallion-tabs" role="tablist">
              <button type="button" class="rdp-medallion-btn is-active" data-wine="lvo" role="tab" aria-selected="true">
                <span class="rdp-medallion-icon">🍷</span>
                <span class="rdp-medallion-title">L.V.O. 2022</span>
                <span class="rdp-medallion-sub">Blend de Tintos</span>
              </button>
              <button type="button" class="rdp-medallion-btn" data-wine="cabernet" role="tab" aria-selected="false">
                <span class="rdp-medallion-icon">🍷</span>
                <span class="rdp-medallion-title">Cabernet Sauvignon</span>
                <span class="rdp-medallion-sub">Cosecha 2020</span>
              </button>
              <button type="button" class="rdp-medallion-btn" data-wine="syrah" role="tab" aria-selected="false">
                <span class="rdp-medallion-icon">🍷</span>
                <span class="rdp-medallion-title">Syrah 2021</span>
                <span class="rdp-medallion-sub">100% Syrah</span>
              </button>
              <button type="button" class="rdp-medallion-btn" data-wine="rose" role="tab" aria-selected="false">
                <span class="rdp-medallion-icon">🥂</span>
                <span class="rdp-medallion-title">Rosé 2023</span>
                <span class="rdp-medallion-sub">Syrah · Cariñan</span>
              </button>
              <button type="button" class="rdp-medallion-btn" data-wine="semillon" role="tab" aria-selected="false">
                <span class="rdp-medallion-icon">🍸</span>
                <span class="rdp-medallion-title">Semillón 2023</span>
                <span class="rdp-medallion-sub">Blanco Mineral</span>
              </button>
            </div>
          </div>

          <!-- TARJETA CON RELIEVE 3D DE CATA -->
          <div class="rdp-wine-spec-card">
            <div class="rdp-spec-header">
              <div>
                <span id="rdp-spec-tag" class="rdp-spec-tag">GRAN RESERVA · COSECHA 2022</span>
                <h3 id="rdp-spec-name" class="rdp-spec-name">L.V.O. Cosecha 2022</h3>
              </div>
              <div class="rdp-spec-price-box">
                <span class="rdp-price-pre">PRECIO DE BODEGA</span>
                <span id="rdp-spec-price" class="rdp-price-amount">$450 <small>MXN</small></span>
              </div>
            </div>

            <div class="rdp-spec-grid-info">
              <div class="rdp-grid-cell">
                <span class="rdp-cell-key">Varietales</span>
                <span id="rdp-spec-blend" class="rdp-cell-val">40% Tempranillo · 40% Cariñan · 20% Nebbiolo</span>
              </div>
              <div class="rdp-grid-cell">
                <span class="rdp-cell-key">Crianza</span>
                <span id="rdp-spec-crianza" class="rdp-cell-val">12 meses en barrica de roble francés</span>
              </div>
              <div class="rdp-grid-cell full-width">
                <span class="rdp-cell-key">Notas de Cata</span>
                <span id="rdp-spec-tasting" class="rdp-cell-val">Ciruela negra madura, moras silvestres, café tostado y cacao con final aterciopelado.</span>
              </div>
              <div class="rdp-grid-cell full-width">
                <span class="rdp-cell-key">Maridaje Recomendado</span>
                <span id="rdp-spec-food" class="rdp-cell-val">Cortes marmoleados a las brasas, cordero al romero y quesos madurados.</span>
              </div>
            </div>

            <!-- BOTONERÍA 3D DE LUJO -->
            <div class="rdp-cta-toolbar">
              <a id="rdp-main-link" href="https://www.raizdeplata.com/collections/all" target="_blank" rel="noopener noreferrer" class="rdp-3d-btn-gold">
                <span class="rdp-btn-glow"></span>
                <span class="rdp-btn-txt">Explorar Colección Raíz de Plata</span>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
              <a id="rdp-wa-link" href="https://wa.me/524941044143?text=Hola%2C%20me%20interesa%20comprar%20vinos%20de%20Ra%C3%ADz%20de%20Plata%20en%20Aylesva%20Marketplace." target="_blank" rel="noopener noreferrer" class="rdp-3d-btn-glass">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824z"/></svg>
                <span>Pedidos WhatsApp</span>
              </a>
            </div>
          </div>

        </div>

        <!-- COLUMNA DERECHA: ESCAPARATE DE BOTELLA 3D -->
        <div class="rdp-right-showcase">
          <div class="rdp-pedestal-scene">
            <div class="rdp-pedestal-light"></div>
            
            <!-- MARCO FLOTANTE 3D CON BISEL -->
            <div class="rdp-3d-photo-frame">
              <img id="rdp-stage-bottle" src="{{ 'rdp-botella-lvo.jpg' | asset_url }}" alt="Vino Raíz de Plata" class="rdp-bottle-visual" width="819" height="1024" loading="lazy">
              <div class="rdp-frame-sheen"></div>
            </div>

            <!-- DISTINTIVO FLOTANTE 3D -->
            <div class="rdp-terroir-token">
              <span class="rdp-token-gem">✦</span>
              <div class="rdp-token-copy">
                <span id="rdp-token-vignoble" class="rdp-token-main">Valle de Barranquillas</span>
                <span id="rdp-token-sub" class="rdp-token-extra">Cosecha Seleccionada a Mano</span>
              </div>
            </div>

            <!-- PEDESTAL INFERIOR CON SOMBRA PROYECTADA -->
            <div class="rdp-ground-pedestal"></div>
          </div>
        </div>

      </div>

      <!-- BARRA DE RECONOCIMIENTOS 3D -->
      <div class="rdp-bottom-pillars">
        <div class="rdp-pillar-card">
          <div class="rdp-pillar-badge">🍇</div>
          <div class="rdp-pillar-meta">
            <h5>Uva de Autor</h5>
            <p>Cosecha manual en Viñedo Martínez y Barranquillas.</p>
          </div>
        </div>
        <div class="rdp-pillar-card">
          <div class="rdp-pillar-badge">⛰️</div>
          <div class="rdp-pillar-meta">
            <h5>2,000 MSNM</h5>
            <p>Amplitud térmica y suelos calcáreos de altura.</p>
          </div>
        </div>
        <div class="rdp-pillar-card">
          <div class="rdp-pillar-badge">🍷</div>
          <div class="rdp-pillar-meta">
            <h5>Roble Francés</h5>
            <p>Crianza paciente en barricas seleccionadas.</p>
          </div>
        </div>
        <div class="rdp-pillar-card">
          <div class="rdp-pillar-badge">🇲🇽</div>
          <div class="rdp-pillar-meta">
            <h5>Jerez, Zacatecas</h5>
            <p>Bodega y cava boutique en Los Haro.</p>
          </div>
        </div>
      </div>

    </div>

  </div>

</div>

<style>
  #rdp-3d-{{ section.id }} {
    --rdp-gold-1: #FFE2B8;
    --rdp-gold-2: #D4AF37;
    --rdp-gold-3: #B58A43;
    --rdp-gold-dark: #6C4F22;
    --rdp-wine-glow: #6E1220;
    --rdp-wine-dark: #2A060C;
    --rdp-obsidian: #09080A;
    --rdp-black-card: #121014;
    --rdp-silver: #E0E2E6;
    
    width: 100%;
    margin: 38px 0 52px;
    padding: 0 20px;
    box-sizing: border-box;
    font-family: 'Montserrat', -apple-system, sans-serif;
    color: #F8F5F0;
  }

  #rdp-3d-{{ section.id }} * {
    box-sizing: border-box;
  }

  /* MARCO 3D CON BISEL METÁLICO Y MULTIPLES SOMBRAS DE PROFUNDIDAD */
  #rdp-3d-{{ section.id }} .rdp-3d-box {
    position: relative;
    max-width: 1360px;
    margin: 0 auto;
    border-radius: 24px;
    overflow: hidden;
    background-color: var(--rdp-obsidian);
    
    /* Bisel 3D de oro fundido y profundidad */
    border: 2px solid transparent;
    background-image: linear-gradient(var(--rdp-obsidian), var(--rdp-obsidian)), 
                      linear-gradient(135deg, #FFE2B8 0%, #B58A43 35%, #422D11 60%, #D4AF37 85%, #FFF 100%);
    background-origin: border-box;
    background-clip: padding-box, border-box;
    
    box-shadow: 
      0 2px 0 1px rgba(255, 226, 184, 0.4),
      0 20px 50px -10px rgba(0, 0, 0, 0.8),
      0 0 35px rgba(212, 175, 55, 0.18),
      inset 0 1px 1px rgba(255, 255, 255, 0.18),
      inset 0 -2px 4px rgba(0, 0, 0, 0.7);
  }

  /* ESQUINAS ORNAMENTALES 3D */
  #rdp-3d-{{ section.id }} .rdp-corner {
    position: absolute;
    width: 24px;
    height: 24px;
    z-index: 10;
    pointer-events: none;
    border-color: #E2C79E;
    border-style: solid;
    box-shadow: 0 0 10px rgba(212, 175, 55, 0.5);
  }
  #rdp-3d-{{ section.id }} .rdp-corner-tl {
    top: 12px;
    left: 12px;
    border-width: 3px 0 0 3px;
    border-top-left-radius: 10px;
  }
  #rdp-3d-{{ section.id }} .rdp-corner-tr {
    top: 12px;
    right: 12px;
    border-width: 3px 3px 0 0;
    border-top-right-radius: 10px;
  }
  #rdp-3d-{{ section.id }} .rdp-corner-bl {
    bottom: 12px;
    left: 12px;
    border-width: 0 0 3px 3px;
    border-bottom-left-radius: 10px;
  }
  #rdp-3d-{{ section.id }} .rdp-corner-br {
    bottom: 12px;
    right: 12px;
    border-width: 0 3px 3px 0;
    border-bottom-right-radius: 10px;
  }

  /* BACKGROUND ATMOSPHERE */
  #rdp-3d-{{ section.id }} .rdp-3d-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  #rdp-3d-{{ section.id }} .rdp-3d-photo {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center 38%;
    filter: brightness(0.38) contrast(1.2);
    transform: scale(1.02);
    transition: transform 8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  #rdp-3d-{{ section.id }}:hover .rdp-3d-photo {
    transform: scale(1.05);
  }
  #rdp-3d-{{ section.id }} .rdp-3d-gradient {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 70% 35%, rgba(110, 18, 32, 0.45) 0%, transparent 60%),
                linear-gradient(135deg, rgba(9, 8, 10, 0.96) 0%, rgba(26, 16, 21, 0.88) 45%, rgba(9, 8, 10, 0.96) 100%);
  }
  #rdp-3d-{{ section.id }} .rdp-spotlight-top {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 60%;
    height: 3px;
    background: radial-gradient(ellipse at center, rgba(255, 226, 184, 0.8) 0%, rgba(212, 175, 55, 0.4) 40%, transparent 80%);
    box-shadow: 0 0 16px rgba(255, 226, 184, 0.6);
  }
  #rdp-3d-{{ section.id }} .rdp-spotlight-bottle {
    position: absolute;
    right: 15%;
    top: 25%;
    width: 440px;
    height: 440px;
    background: radial-gradient(circle, rgba(212, 175, 55, 0.22) 0%, rgba(110, 18, 32, 0.25) 45%, transparent 70%);
    filter: blur(55px);
  }

  /* INNER CONTENT */
  #rdp-3d-{{ section.id }} .rdp-3d-content {
    position: relative;
    z-index: 2;
    padding: 46px 44px 34px;
  }

  /* HEADER BRAND */
  #rdp-3d-{{ section.id }} .rdp-header-brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: 30px;
  }
  #rdp-3d-{{ section.id }} .rdp-gold-heraldry {
    height: 64px;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 4px 14px rgba(0, 0, 0, 0.7));
  }
  #rdp-3d-{{ section.id }} .rdp-crest-divider {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    max-width: 480px;
    margin: 12px 0 8px;
  }
  #rdp-3d-{{ section.id }} .rdp-crest-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(212, 175, 55, 0.5), transparent);
  }
  #rdp-3d-{{ section.id }} .rdp-crest-gem {
    color: var(--rdp-gold-2);
    font-size: 11px;
    filter: drop-shadow(0 0 6px rgba(212, 175, 55, 0.6));
  }
  #rdp-3d-{{ section.id }} .rdp-terroir-ribbon {
    font-family: 'Cinzel', serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.22em;
    color: var(--rdp-gold-1);
    text-transform: uppercase;
  }

  /* MAIN STAGE */
  #rdp-3d-{{ section.id }} .rdp-main-stage {
    display: grid;
    grid-template-columns: 1.18fr 0.82fr;
    gap: 36px;
    align-items: center;
    margin-bottom: 36px;
  }

  /* LEFT NARRATIVE */
  #rdp-3d-{{ section.id }} .rdp-subtitle-top {
    display: block;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--rdp-gold-2);
    margin-bottom: 6px;
  }
  #rdp-3d-{{ section.id }} .rdp-headline-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(32px, 3.4vw, 46px);
    font-weight: 700;
    line-height: 1.08;
    color: #FFFFFF;
    margin: 0 0 14px 0;
  }
  #rdp-3d-{{ section.id }} .rdp-gold-shimmer {
    font-style: italic;
    background: linear-gradient(135deg, #FFE2B8 0%, #D4AF37 50%, #E8CDA0 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 2px 8px rgba(212, 175, 55, 0.3));
  }
  #rdp-3d-{{ section.id }} .rdp-synopsis {
    font-size: 13.5px;
    line-height: 1.6;
    color: rgba(248, 245, 240, 0.75);
    max-width: 58ch;
    margin: 0 0 22px 0;
  }

  /* SELECTOR MEDALLIONS 3D */
  #rdp-3d-{{ section.id }} .rdp-pills-container {
    margin-bottom: 20px;
  }
  #rdp-3d-{{ section.id }} .rdp-pills-label {
    display: block;
    font-size: 9.5px;
    letter-spacing: 0.16em;
    font-weight: 700;
    color: var(--rdp-gold-2);
    margin-bottom: 10px;
  }
  #rdp-3d-{{ section.id }} .rdp-medallion-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  #rdp-3d-{{ section.id }} .rdp-medallion-btn {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 7px 14px;
    background: linear-gradient(180deg, rgba(35, 30, 38, 0.8) 0%, rgba(18, 15, 20, 0.95) 100%);
    border: 1px solid rgba(212, 175, 55, 0.25);
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 
      inset 0 1px 0 rgba(255, 255, 255, 0.1),
      0 3px 8px rgba(0, 0, 0, 0.4);
  }
  #rdp-3d-{{ section.id }} .rdp-medallion-btn:hover {
    border-color: var(--rdp-gold-2);
    transform: translateY(-2px);
    box-shadow: 
      inset 0 1px 0 rgba(255, 255, 255, 0.2),
      0 6px 14px rgba(0, 0, 0, 0.5),
      0 0 10px rgba(212, 175, 55, 0.25);
  }
  #rdp-3d-{{ section.id }} .rdp-medallion-btn.is-active {
    background: linear-gradient(180deg, rgba(85, 22, 33, 0.7) 0%, rgba(35, 10, 16, 0.9) 100%);
    border: 1px solid var(--rdp-gold-1);
    box-shadow: 
      inset 0 1px 2px rgba(255, 226, 184, 0.4),
      0 4px 12px rgba(0, 0, 0, 0.6),
      0 0 14px rgba(212, 175, 55, 0.35);
  }
  #rdp-3d-{{ section.id }} .rdp-medallion-title {
    font-family: 'Cinzel', serif;
    font-size: 11.5px;
    font-weight: 700;
    color: #FFFFFF;
  }
  #rdp-3d-{{ section.id }} .rdp-medallion-btn.is-active .rdp-medallion-title {
    color: var(--rdp-gold-1);
  }
  #rdp-3d-{{ section.id }} .rdp-medallion-sub {
    font-size: 9px;
    color: rgba(248, 245, 240, 0.55);
    margin-top: 2px;
  }

  /* TARJETA 3D DE CATA */
  #rdp-3d-{{ section.id }} .rdp-wine-spec-card {
    background: linear-gradient(145deg, rgba(28, 24, 32, 0.85) 0%, rgba(14, 12, 16, 0.95) 100%);
    border-radius: 16px;
    padding: 22px 24px;
    border: 1px solid rgba(212, 175, 55, 0.35);
    box-shadow: 
      inset 0 1px 1px rgba(255, 255, 255, 0.12),
      inset 0 -1px 2px rgba(0, 0, 0, 0.8),
      0 12px 30px rgba(0, 0, 0, 0.5);
  }
  #rdp-3d-{{ section.id }} .rdp-spec-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding-bottom: 12px;
    margin-bottom: 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    gap: 16px;
  }
  #rdp-3d-{{ section.id }} .rdp-spec-tag {
    display: inline-block;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--rdp-gold-1);
    background: rgba(110, 18, 32, 0.55);
    border: 1px solid rgba(212, 175, 55, 0.3);
    padding: 2px 8px;
    border-radius: 4px;
    margin-bottom: 4px;
  }
  #rdp-3d-{{ section.id }} .rdp-spec-name {
