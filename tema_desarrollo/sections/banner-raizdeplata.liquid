        </div>

      </div>

    </div>

  </div>
</div>

<script>
  function rdpSlideWines(direction) {
    var container = document.getElementById('rdp-cards-track-{{ section.id }}');
    if (!container) return;
    var shift = 260;
    container.scrollBy({ left: direction * shift, behavior: 'smooth' });
  }
</script>

<style>
  #rdp-cards-{{ section.id }} {
    /* BREAKOUT FULL WIDTH 100vw */
    position: relative;
    width: 100vw;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    margin-top: 50px;
    margin-bottom: 60px;
    box-sizing: border-box;
    font-family: 'Montserrat', -apple-system, sans-serif;
    color: #F8F5F0;
    overflow: visible;
  }

  #rdp-cards-{{ section.id }} * {
    box-sizing: border-box;
  }

  /* BARRA PRINCIPAL: FONDO PURO CSS SIN NINGUNA IMAGEN PIXELADA */
  #rdp-cards-{{ section.id }} .rdp-cards-bar {
    position: relative;
    width: 100%;
    min-height: 410px;
    background: linear-gradient(135deg, #09070A 0%, #150912 45%, #0B080D 100%);
    border-top: 1px solid rgba(212, 175, 55, 0.4);
    border-bottom: 1px solid rgba(212, 175, 55, 0.4);
    box-shadow: 
      0 20px 50px rgba(0, 0, 0, 0.9),
      0 0 40px rgba(212, 175, 55, 0.08);
    display: flex;
    align-items: center;
    overflow: visible;
  }

  /* RESPLANDOR AMBIENTAL AMBAR/BORGOÑA EN CSS */
  #rdp-cards-{{ section.id }} .rdp-ambient-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 75% 50%, rgba(212, 175, 55, 0.12) 0%, rgba(107, 17, 30, 0.18) 45%, transparent 75%);
    pointer-events: none;
    z-index: 0;
  }

  /* INNER LAYOUT */
  #rdp-cards-{{ section.id }} .rdp-cards-inner {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1560px;
    margin: 0 auto;
    padding: 0 44px;
    display: grid;
    grid-template-columns: 350px 1fr;
    gap: 48px;
    align-items: center;
    overflow: visible;
  }

  /* -------------------------------------------------------------
     COLUMNA IZQUIERDA: EDITORIAL
  ------------------------------------------------------------- */
  #rdp-cards-{{ section.id }} .rdp-editorial-col {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 30px 0;
    z-index: 4;
  }

  #rdp-cards-{{ section.id }} .rdp-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 9.5px;
    letter-spacing: 0.18em;
    font-weight: 600;
    color: #D4AF37;
    text-transform: uppercase;
    margin-bottom: 14px;
  }
  #rdp-cards-{{ section.id }} .rdp-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background-color: #D4AF37;
    box-shadow: 0 0 6px #D4AF37;
  }

  #rdp-cards-{{ section.id }} .rdp-logo-box {
    margin-bottom: 12px;
  }
  #rdp-cards-{{ section.id }} .rdp-gold-crest {
    height: 46px;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 2px 8px rgba(0,0,0,0.8));
    transition: opacity 0.2s ease;
  }
  #rdp-cards-{{ section.id }} .rdp-gold-crest:hover {
    opacity: 0.9;
  }

  #rdp-cards-{{ section.id }} .rdp-headline {
    margin: 0 0 12px 0;
    line-height: 1.04;
    display: flex;
    flex-direction: column;
  }
  #rdp-cards-{{ section.id }} .rdp-caps {
    font-family: 'Cinzel', serif;
    font-size: 26px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #FFFFFF;
  }
  #rdp-cards-{{ section.id }} .rdp-script {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 42px;
    font-style: italic;
    font-weight: 500;
    color: #F4E4C1;
    letter-spacing: 0.01em;
    margin-top: -3px;
    text-shadow: 0 0 20px rgba(212, 175, 55, 0.35);
  }

  #rdp-cards-{{ section.id }} .rdp-line {
    width: 48px;
    height: 1px;
    background: rgba(212, 175, 55, 0.6);
    margin-bottom: 14px;
  }

  #rdp-cards-{{ section.id }} .rdp-lead {
    font-family: 'Montserrat', sans-serif;
    font-size: 13.5px;
    font-weight: 400;
    line-height: 1.5;
    color: rgba(248, 245, 240, 0.85);
    margin: 0 0 16px 0;
    max-width: 32ch;
  }

  #rdp-cards-{{ section.id }} .rdp-trust-pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 11px;
    font-weight: 600;
    color: #F4E4C1;
    letter-spacing: 0.04em;
    margin-bottom: 22px;
  }
  #rdp-cards-{{ section.id }} .rdp-trust-pill svg {
    color: #D4AF37;
  }

  #rdp-cards-{{ section.id }} .rdp-buttons {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }
  #rdp-cards-{{ section.id }} .rdp-btn-gold {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 22px;
    background: linear-gradient(135deg, #F0DBB4 0%, #D4AF37 50%, #9B7028 100%);
    color: #0A080A;
    font-family: 'Cinzel', serif;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
    border-radius: 999px;
    text-decoration: none;
    box-shadow: 0 4px 16px rgba(212, 175, 55, 0.35);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  #rdp-cards-{{ section.id }} .rdp-btn-gold:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(212, 175, 55, 0.55);
    filter: brightness(1.06);
  }

  #rdp-cards-{{ section.id }} .rdp-btn-sommelier {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 9px 16px;
    background: rgba(14, 22, 18, 0.7);
    border: 1px solid rgba(37, 211, 102, 0.45);
    border-radius: 999px;
    color: #34D399;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  #rdp-cards-{{ section.id }} .rdp-btn-sommelier:hover {
    background: rgba(37, 211, 102, 0.2);
    border-color: #34D399;
    color: #FFFFFF;
    transform: translateY(-1px);
  }

  /* -------------------------------------------------------------
     COLUMNA DERECHA: TARJETAS EN ALTA CALIDAD
  ------------------------------------------------------------- */
  #rdp-cards-{{ section.id }} .rdp-showcase-container {
    position: relative;
    width: 100%;
    overflow: visible;
  }

  /* Header del Carrusel */
  #rdp-cards-{{ section.id }} .rdp-carousel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
    padding: 0 6px;
  }
  #rdp-cards-{{ section.id }} .rdp-curated-tag {
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: rgba(248, 245, 240, 0.6);
    text-transform: uppercase;
  }
  #rdp-cards-{{ section.id }} .rdp-nav-controls {
    display: flex;
    gap: 8px;
  }
  #rdp-cards-{{ section.id }} .rdp-arrow-nav {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1px solid rgba(212, 175, 55, 0.4);
    background: rgba(14, 11, 16, 0.7);
    color: #F4E4C1;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    padding: 0;
  }
  #rdp-cards-{{ section.id }} .rdp-arrow-nav:hover {
    border-color: #D4AF37;
    background: rgba(212, 175, 55, 0.25);
    color: #FFFFFF;
  }

  /* Track de tarjetas con overflow suave */
  #rdp-cards-{{ section.id }} .rdp-cards-track {
    display: flex;
    align-items: center;
    gap: 18px;
    overflow-x: auto;
    scroll-behavior: smooth;
    padding: 16px 4px 20px;
    -ms-overflow-style: none;
    scrollbar-width: none;
    overflow-y: visible;
  }
  #rdp-cards-{{ section.id }} .rdp-cards-track::-webkit-scrollbar {
    display: none;
  }

  /* CADA TARJETA DE VINO EN ALTA CALIDAD */
  #rdp-cards-{{ section.id }} .rdp-wine-card {
    position: relative;
    flex: 0 0 215px;
    background: linear-gradient(175deg, rgba(26, 20, 28, 0.95) 0%, rgba(12, 10, 14, 0.98) 100%);
    border: 1px solid rgba(212, 175, 55, 0.25);
    border-radius: 16px;
    padding: 14px 12px 14px;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    box-shadow: 
      0 18px 36px rgba(0, 0, 0, 0.75),
      0 0 16px rgba(212, 175, 55, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    cursor: pointer;
  }
  #rdp-cards-{{ section.id }} .rdp-wine-card:hover {
    transform: translateY(-10px) scale(1.025);
    border-color: #D4AF37;
    box-shadow: 
      0 28px 50px rgba(0, 0, 0, 0.9),
      0 0 25px rgba(212, 175, 55, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.2);
    z-index: 10;
  }

  /* Tarjeta Héroe (Cabernet) */
  #rdp-cards-{{ section.id }} .rdp-wine-card.rdp-card-hero {
    flex: 0 0 230px;
    border-color: rgba(212, 175, 55, 0.45);
    background: linear-gradient(175deg, rgba(34, 22, 32, 0.95) 0%, rgba(14, 11, 16, 0.98) 100%);
  }

  /* Badge Superior */
  #rdp-cards-{{ section.id }} .rdp-card-top-tag {
    align-self: flex-start;
    font-size: 7.5px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #F4E4C1;
    background: rgba(90, 15, 28, 0.7);
    border: 1px solid rgba(212, 175, 55, 0.3);
    padding: 2.5px 7px;
    border-radius: 4px;
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  #rdp-cards-{{ section.id }} .rdp-card-hero .rdp-card-top-tag {
    background: rgba(212, 175, 55, 0.18);
    border-color: #D4AF37;
    color: #FFFFFF;
  }

  /* Marco de Fotografía de Estudio */
  #rdp-cards-{{ section.id }} .rdp-photo-frame {
    width: 100%;
    height: 195px;
    border-radius: 10px;
    overflow: hidden;
    position: relative;
    background-color: #08060A;
    margin-bottom: 10px;
  }
  #rdp-cards-{{ section.id }} .rdp-card-hero .rdp-photo-frame {
    height: 215px;
  }
  #rdp-cards-{{ section.id }} .rdp-studio-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    transition: transform 0.4s ease;
  }
  #rdp-cards-{{ section.id }} .rdp-wine-card:hover .rdp-studio-img {
    transform: scale(1.05);
  }

  /* Metadatos */
  #rdp-cards-{{ section.id }} .rdp-card-body {
    display: flex;
    flex-direction: column;
  }
  #rdp-cards-{{ section.id }} .rdp-card-wine-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 18px;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 2px 0;
    line-height: 1.15;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  #rdp-cards-{{ section.id }} .rdp-wine-card:hover .rdp-card-wine-title {
