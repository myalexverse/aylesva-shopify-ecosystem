<script>
  function rdpSlideWines(direction) {
    var container = document.getElementById('rdp-cards-track-{{ section.id }}');
    if (!container) return;
    var card = container.querySelector('.rdp-wine-card');
    var shift = card ? (card.offsetWidth + 18) : 260;
    container.scrollBy({ left: direction * shift, behavior: 'smooth' });
  }

  function rdpGoToWine(index) {
    var container = document.getElementById('rdp-cards-track-{{ section.id }}');
    if (!container) return;
    var cards = container.querySelectorAll('.rdp-wine-card');
    if (cards[index]) {
      cards[index].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' });
    }
  }

  // Sincronizar dots con el scroll y activar drag-to-scroll con el mouse
  (function() {
    var container = document.getElementById('rdp-cards-track-{{ section.id }}');
    var dotsContainer = document.getElementById('rdp-dots-{{ section.id }}');
    if (!container) return;

    // Actualizar dots en tiempo real
    container.addEventListener('scroll', function() {
      var scrollLeft = container.scrollLeft;
      var card = container.querySelector('.rdp-wine-card');
      var cardWidth = card ? (card.offsetWidth + 18) : 260;
      var activeIndex = Math.min(5, Math.max(0, Math.round(scrollLeft / cardWidth)));
      if (dotsContainer) {
        var dots = dotsContainer.querySelectorAll('.rdp-dot-btn');
        dots.forEach(function(dot, idx) {
          if (idx === activeIndex) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }
    }, { passive: true });

    // Arrastre fluido con mouse (Drag-to-Scroll)
    var isDown = false;
    var startX, scrollStart;

    container.addEventListener('mousedown', function(e) {
      // Ignorar si se hizo clic en un enlace de compra directo
      if (e.target.closest('a')) return;
      isDown = true;
      container.classList.add('active-dragging');
      startX = e.pageX - container.offsetLeft;
      scrollStart = container.scrollLeft;
    });

    window.addEventListener('mouseup', function() {
      if (!isDown) return;
      isDown = false;
      container.classList.remove('active-dragging');
    });

    container.addEventListener('mousemove', function(e) {
      if (!isDown) return;
      e.preventDefault();
      var x = e.pageX - container.offsetLeft;
      var walk = (x - startX) * 1.3;
      container.scrollLeft = scrollStart - walk;
    });
  })();
</script>

<style>
