        </p>

        <div class="rdp-fw-actions">
          <a href="https://www.raizdeplata.com/collections/all" target="_blank" rel="noopener noreferrer" class="rdp-fw-cta-gold">
            <span>Ver Colección Completa</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="https://wa.me/524941044143?text=Hola%2C%20me%20interesa%20comprar%20vinos%20de%20Ra%C3%ADz%20de%20Plata%20en%20Aylesva%20Marketplace." target="_blank" rel="noopener noreferrer" class="rdp-fw-cta-wa" title="Atención personalizada por WhatsApp">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824z"/></svg>
            <span>WhatsApp</span>
          </a>
        </div>
      </div>

      <!-- RIGHT: OVERLAPPING PRODUCTS ROW (PRODUCTOS SUPERPUESTOS) -->
      <div class="rdp-fw-products-track">
        
        <!-- PRODUCT 1: LVO 2022 -->
        <a href="https://www.raizdeplata.com/products/lvo-2022" target="_blank" rel="noopener noreferrer" class="rdp-product-overlap rdp-card-1">
          <div class="rdp-card-tag">TINTO RESERVA</div>
          <div class="rdp-bottle-visual-box">
            <img src="{{ 'rdp-botella-lvo.jpg' | asset_url }}" alt="Vino LVO 2022 Raíz de Plata" class="rdp-img-pop" width="400" height="500" loading="lazy">
          </div>
          <div class="rdp-card-info">
            <h4 class="rdp-card-title">L.V.O. 2022</h4>
            <p class="rdp-card-grapes">Tempranillo · Cariñan · Nebbiolo</p>
            <div class="rdp-card-footer">
              <span class="rdp-card-price">$655 <small>MXN</small></span>
              <span class="rdp-card-buy-btn">Comprar ↗</span>
            </div>
          </div>
        </a>

        <!-- PRODUCT 2: CABERNET SAUVIGNON 2020 -->
        <a href="https://www.raizdeplata.com/products/cabernet-sauvignon-2020" target="_blank" rel="noopener noreferrer" class="rdp-product-overlap rdp-card-2">
          <div class="rdp-card-tag">GRAN GUARDA</div>
          <div class="rdp-bottle-visual-box">
            <img src="{{ 'rdp-botella-cabernet.jpg' | asset_url }}" alt="Vino Cabernet Sauvignon 2020 Raíz de Plata" class="rdp-img-pop" width="400" height="500" loading="lazy">
          </div>
          <div class="rdp-card-info">
            <h4 class="rdp-card-title">Cabernet Sauvignon</h4>
            <p class="rdp-card-grapes">100% Cabernet · 14 Meses Roble</p>
            <div class="rdp-card-footer">
              <span class="rdp-card-price">$900 <small>MXN</small></span>
              <span class="rdp-card-buy-btn">Comprar ↗</span>
            </div>
          </div>
        </a>

        <!-- PRODUCT 3: SYRAH 2021 -->
        <a href="https://www.raizdeplata.com/products/syrah-2021" target="_blank" rel="noopener noreferrer" class="rdp-product-overlap rdp-card-3">
          <div class="rdp-card-tag">MINERAL DE ALTURA</div>
          <div class="rdp-bottle-visual-box">
            <img src="{{ 'rdp-botella-syrah.jpg' | asset_url }}" alt="Vino Syrah 2021 Raíz de Plata" class="rdp-img-pop" width="400" height="500" loading="lazy">
          </div>
          <div class="rdp-card-info">
            <h4 class="rdp-card-title">Syrah 2021</h4>
            <p class="rdp-card-grapes">100% Syrah · Suelo Calcáreo</p>
            <div class="rdp-card-footer">
              <span class="rdp-card-price">$750 <small>MXN</small></span>
              <span class="rdp-card-buy-btn">Comprar ↗</span>
            </div>
          </div>
        </a>

        <!-- PRODUCT 4: ROSÉ 2023 -->
        <a href="https://www.raizdeplata.com/products/rose-2023" target="_blank" rel="noopener noreferrer" class="rdp-product-overlap rdp-card-4">
          <div class="rdp-card-tag">ROSÉ PROVENZAL</div>
          <div class="rdp-bottle-visual-box">
            <img src="{{ 'rdp-botella-rose.jpg' | asset_url }}" alt="Vino Rosé 2023 Raíz de Plata" class="rdp-img-pop" width="400" height="500" loading="lazy">
          </div>
          <div class="rdp-card-info">
            <h4 class="rdp-card-title">Rosé 2023</h4>
            <p class="rdp-card-grapes">Syrah · Cariñan · Fresco & Floral</p>
            <div class="rdp-card-footer">
              <span class="rdp-card-price">$450 <small>MXN</small></span>
              <span class="rdp-card-buy-btn">Comprar ↗</span>
            </div>
          </div>
        </a>

        <!-- PRODUCT 5: SEMILLÓN 2023 -->
        <a href="https://www.raizdeplata.com/products/semillon-2023" target="_blank" rel="noopener noreferrer" class="rdp-product-overlap rdp-card-5">
          <div class="rdp-card-tag">BLANCO MINERAL</div>
          <div class="rdp-bottle-visual-box">
            <img src="{{ 'rdp-botella-semillon.jpg' | asset_url }}" alt="Vino Semillón 2023 Raíz de Plata" class="rdp-img-pop" width="400" height="500" loading="lazy">
          </div>
          <div class="rdp-card-info">
            <h4 class="rdp-card-title">Semillón 2023</h4>
            <p class="rdp-card-grapes">100% Semillón · Cítrico & Untuoso</p>
            <div class="rdp-card-footer">
              <span class="rdp-card-price">$400 <small>MXN</small></span>
              <span class="rdp-card-buy-btn">Comprar ↗</span>
            </div>
          </div>
        </a>

      </div>

    </div>

  </div>

</div>

<style>
  #rdp-fw-{{ section.id }} {
    --rdp-gold: #D4AF37;
    --rdp-gold-light: #F3DEBA;
    --rdp-gold-dark: #8C6B28;
    --rdp-wine: #6B111E;
    --rdp-obsidian: #0D0A0E;
    --rdp-card-border: rgba(212, 175, 55, 0.35);
    
    /* BREAKOUT A PANTALLA COMPLETA 100vw */
    position: relative;
    width: 100vw;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    margin-top: 70px;
    margin-bottom: 75px;
    box-sizing: border-box;
    font-family: 'Montserrat', -apple-system, sans-serif;
    color: #F8F5F0;
    overflow: visible;
  }

  #rdp-fw-{{ section.id }} * {
    box-sizing: border-box;
  }

  /* BARRA PANORÁMICA ESBELTA (LA MITAD DEL ALTO DE ANTES) */
  #rdp-fw-{{ section.id }} .rdp-fw-bar {
    position: relative;
    width: 100%;
    min-height: 310px;
    background-color: var(--rdp-obsidian);
    border-top: 1px solid rgba(212, 175, 55, 0.45);
    border-bottom: 1px solid rgba(212, 175, 55, 0.45);
    box-shadow: 
      0 0 35px rgba(212, 175, 55, 0.15),
      0 20px 40px rgba(0, 0, 0, 0.7);
    overflow: visible;
    display: flex;
    align-items: center;
  }

  /* FONDO PANORÁMICO ATMOSFÉRICO */
  #rdp-fw-{{ section.id }} .rdp-fw-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }
  #rdp-fw-{{ section.id }} .rdp-fw-photo {
    position: absolute;
    inset: -20px;
    background-size: cover;
    background-position: center 42%;
    filter: brightness(0.35) contrast(1.2);
    transform: scale(1.02);
    transition: transform 10s ease;
  }
  #rdp-fw-{{ section.id }}:hover .rdp-fw-photo {
    transform: scale(1.06);
  }
  #rdp-fw-{{ section.id }} .rdp-fw-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, 
      rgba(10, 8, 11, 0.98) 0%, 
      rgba(16, 12, 18, 0.92) 28%, 
      rgba(40, 15, 22, 0.75) 60%, 
      rgba(10, 8, 11, 0.95) 100%);
  }
  #rdp-fw-{{ section.id }} .rdp-fw-glow {
    position: absolute;
    width: 650px;
    height: 100%;
    right: 15%;
    top: 0;
    background: radial-gradient(circle, rgba(212, 175, 55, 0.2) 0%, rgba(107, 17, 30, 0.25) 50%, transparent 75%);
    filter: blur(50px);
  }

  /* INNER LAYOUT */
  #rdp-fw-{{ section.id }} .rdp-fw-inner {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1520px;
    margin: 0 auto;
    padding: 0 40px;
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: 40px;
    align-items: center;
    overflow: visible;
  }

  /* BRAND COL (LEFT) */
  #rdp-fw-{{ section.id }} .rdp-fw-brand-col {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 24px 0;
    z-index: 3;
  }
  #rdp-fw-{{ section.id }} .rdp-fw-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 9px;
    letter-spacing: 0.18em;
    font-weight: 700;
    color: var(--rdp-gold-light);
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  #rdp-fw-{{ section.id }} .rdp-fw-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--rdp-gold);
    box-shadow: 0 0 8px var(--rdp-gold);
  }
  #rdp-fw-{{ section.id }} .rdp-fw-logo-wrap {
    margin-bottom: 12px;
  }
  #rdp-fw-{{ section.id }} .rdp-fw-logo {
    height: 52px;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.7));
    transition: transform 0.25s ease;
  }
  #rdp-fw-{{ section.id }} .rdp-fw-logo:hover {
    transform: scale(1.03);
  }
  #rdp-fw-{{ section.id }} .rdp-fw-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 34px;
    font-weight: 700;
    line-height: 1.05;
    color: #FFFFFF;
    margin: 0 0 10px 0;
  }
  #rdp-fw-{{ section.id }} .rdp-fw-title em {
    font-style: italic;
    color: var(--rdp-gold-light);
    text-shadow: 0 0 16px rgba(212, 175, 55, 0.4);
  }
  #rdp-fw-{{ section.id }} .rdp-fw-desc {
    font-size: 12.5px;
    line-height: 1.55;
    color: rgba(248, 245, 240, 0.75);
    margin: 0 0 18px 0;
    max-width: 44ch;
  }
  #rdp-fw-{{ section.id }} .rdp-fw-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  #rdp-fw-{{ section.id }} .rdp-fw-cta-gold {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    background: linear-gradient(135deg, #EAD0A5 0%, #D4AF37 50%, #A37932 100%);
    color: #0E0B09;
    font-family: 'Cinzel', serif;
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.08em;
    border-radius: 999px;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(212, 175, 55, 0.35);
    transition: all 0.25s ease;
  }
  #rdp-fw-{{ section.id }} .rdp-fw-cta-gold:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(212, 175, 55, 0.55);
    filter: brightness(1.08);
  }
  #rdp-fw-{{ section.id }} .rdp-fw-cta-wa {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 9px 16px;
    background: rgba(37, 211, 102, 0.12);
    border: 1px solid rgba(37, 211, 102, 0.45);
    border-radius: 999px;
    color: #25D366;
    font-size: 11px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  #rdp-fw-{{ section.id }} .rdp-fw-cta-wa:hover {
    background: rgba(37, 211, 102, 0.24);
    transform: translateY(-2px);
  }

  /* OVERLAPPING PRODUCTS TRACK (SOBRESALEN DEL BANNER) */
  #rdp-fw-{{ section.id }} .rdp-fw-products-track {
    display: flex;
    align-items: center;
    gap: 18px;
    overflow: visible;
    padding: 10px 0;
    /* Los productos superpuestos rebasan la barra */
    margin-top: -65px;
    margin-bottom: -55px;
    z-index: 5;
  }

  /* CADA TARJETA SUPERPUESTA DE VINO */
  #rdp-fw-{{ section.id }} .rdp-product-overlap {
    position: relative;
    flex: 1 1 0;
    min-width: 175px;
    max-width: 225px;
    background: linear-gradient(170deg, rgba(32, 27, 36, 0.94) 0%, rgba(14, 11, 16, 0.98) 100%);
    border: 1px solid var(--rdp-card-border);
    border-radius: 16px;
    padding: 14px 12px 14px;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    box-shadow: 
      0 18px 36px rgba(0, 0, 0, 0.65),
      0 0 16px rgba(212, 175, 55, 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 0.15);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    cursor: pointer;
  }

  /* EFECTO 3D HOVER: SE ELEVA Y RESPLANDECE */
  #rdp-fw-{{ section.id }} .rdp-product-overlap:hover {
    transform: translateY(-16px) scale(1.035);
    border-color: var(--rdp-gold-light);
    box-shadow: 
      0 28px 50px -5px rgba(0, 0, 0, 0.85),
      0 0 30px rgba(212, 175, 55, 0.35),
      inset 0 1px 0 rgba(255, 255, 255, 0.3);
    z-index: 10;
  }

  /* BADGE TAG */
  #rdp-fw-{{ section.id }} .rdp-card-tag {
    align-self: flex-start;
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--rdp-gold-light);
    background: rgba(107, 17, 30, 0.65);
    border: 1px solid rgba(212, 175, 55, 0.3);
    padding: 2px 7px;
    border-radius: 4px;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  /* CAJA VISUAL DE LA BOTELLA */
  #rdp-fw-{{ section.id }} .rdp-bottle-visual-box {
    width: 100%;
    height: 200px;
    border-radius: 10px;
    overflow: hidden;
    position: relative;
    background-color: #0A080C;
    margin-bottom: 12px;
  }
  #rdp-fw-{{ section.id }} .rdp-img-pop {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    transition: transform 0.4s ease;
  }
  #rdp-fw-{{ section.id }} .rdp-product-overlap:hover .rdp-img-pop {
    transform: scale(1.06);
  }

  /* INFO DEL VINO */
  #rdp-fw-{{ section.id }} .rdp-card-info {
    display: flex;
    flex-direction: column;
  }
  #rdp-fw-{{ section.id }} .rdp-card-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 18px;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 2px 0;
    line-height: 1.15;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  #rdp-fw-{{ section.id }} .rdp-product-overlap:hover .rdp-card-title {
    color: var(--rdp-gold-light);
  }
  #rdp-fw-{{ section.id }} .rdp-card-grapes {
    font-size: 10px;
    color: rgba(248, 245, 240, 0.6);
    margin: 0 0 10px 0;
    line-height: 1.25;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  #rdp-fw-{{ section.id }} .rdp-card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 8px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  #rdp-fw-{{ section.id }} .rdp-card-price {
    font-family: 'Cinzel', serif;
    font-size: 14px;
    font-weight: 700;
    color: var(--rdp-gold-light);
  }
  #rdp-fw-{{ section.id }} .rdp-card-price small {
    font-size: 9px;
    font-family: 'Montserrat', sans-serif;
    color: rgba(255, 255, 255, 0.5);
  }
  #rdp-fw-{{ section.id }} .rdp-card-buy-btn {
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--rdp-gold);
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 3px;
    transition: color 0.2s ease;
  }
  #rdp-fw-{{ section.id }} .rdp-product-overlap:hover .rdp-card-buy-btn {
    color: #FFFFFF;
  }

  /* RESPONSIVE BREAKPOINTS */
  @media (max-width: 1200px) {
    #rdp-fw-{{ section.id }} .rdp-fw-inner {
      grid-template-columns: 320px 1fr;
      padding: 0 24px;
      gap: 24px;
    }
    #rdp-fw-{{ section.id }} .rdp-product-overlap {
      min-width: 155px;
    }
    #rdp-fw-{{ section.id }} .rdp-bottle-visual-box {
      height: 175px;
    }
    #rdp-fw-{{ section.id }} .rdp-fw-title {
      font-size: 28px;
    }
  }

  @media (max-width: 991px) {
    #rdp-fw-{{ section.id }} {
      margin-top: 50px;
      margin-bottom: 60px;
    }
    #rdp-fw-{{ section.id }} .rdp-fw-bar {
      min-height: auto;
      padding: 36px 0 30px;
    }
    #rdp-fw-{{ section.id }} .rdp-fw-inner {
      grid-template-columns: 1fr;
      padding: 0 20px;
      gap: 28px;
    }
    #rdp-fw-{{ section.id }} .rdp-fw-brand-col {
      padding: 0;
      text-align: center;
      align-items: center;
    }
    #rdp-fw-{{ section.id }} .rdp-fw-desc {
      max-width: 60ch;
    }
    #rdp-fw-{{ section.id }} .rdp-fw-actions {
      justify-content: center;
    }
    
    /* EN MÓVIL Y TABLET: CARRUSEL HORIZONTAL TÁCTIL CON SNAP */
    #rdp-fw-{{ section.id }} .rdp-fw-products-track {
      margin-top: -10px;
      margin-bottom: -15px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      padding: 20px 10px 25px;
      gap: 14px;
      width: 100%;
    }
    #rdp-fw-{{ section.id }} .rdp-product-overlap {
      flex: 0 0 170px;
      scroll-snap-align: start;
    }
    #rdp-fw-{{ section.id }} .rdp-bottle-visual-box {
      height: 180px;
    }
  }

  @media (max-width: 540px) {
    #rdp-fw-{{ section.id }} .rdp-fw-inner {
      padding: 0 14px;
    }
    #rdp-fw-{{ section.id }} .rdp-fw-title {
      font-size: 26px;
    }
    #rdp-fw-{{ section.id }} .rdp-product-overlap {
      flex: 0 0 155px;
