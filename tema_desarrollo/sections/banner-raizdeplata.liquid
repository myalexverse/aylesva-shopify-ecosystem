{% comment %}
  ============================================================
  Raíz de Plata — De Haro | Banner Editorial Maestro (10/10)
  Diseño Idéntico a la Referencia Aprobada (media_1788389813686.png)
  Zonas Interactivas con Enlaces Directos a Productos y Colección Aylesva
  ============================================================
{% endcomment %}

<div id="rdp-master-{{ section.id }}" class="rdp-master-section">
  <div class="rdp-master-wrapper">
    
    <!-- MASTER VISUAL CANVAS (2048x1024 HIGH-RES) -->
    <div class="rdp-master-canvas">
      <img 
        src="{{ 'rdp-banner-art-director-2x.jpg' | asset_url }}" 
        alt="Vinos de Autor Raíz de Plata — Aylesva Marketplace" 
        class="rdp-master-img"
        width="2048"
        height="1024"
        loading="eager"
      >

      <!-- INTERACTIVE HOTSPOTS (ACCIONES REALES Y CLICKEABLES) -->
      <div class="rdp-hotspots-layer">
        
        <!-- 1. LOGO & TITULAR -> /collections/vinos -->
        <a href="/collections/vinos" class="rdp-hotspot rdp-hs-brand" title="Ver Colección Vinos en Aylesva" aria-label="Ir a Colección de Vinos Raíz de Plata">
          <span class="rdp-sr-only">Colección Vinos de Autor Raíz de Plata</span>
        </a>

        <!-- 2. BOTÓN PRINCIPAL [ EXPLORAR COLECCIÓN → ] -->
        <a href="/collections/vinos" class="rdp-hotspot rdp-hs-cta" title="Explorar Colección de Vinos" aria-label="Explorar Colección de Vinos">
          <span class="rdp-ripple"></span>
        </a>

        <!-- 3. BOTÓN [ ASESOR SOMMELIER ] -> WHATSAPP -->
        <a href="https://wa.me/524941044143?text=Hola%2C%20me%20gustar%C3%ADa%20asesor%C3%ADa%20de%20sommelier%20sobre%20los%20vinos%20de%20la%20colecci%C3%B3n%20Ra%C3%ADz%20de%20Plata%20en%20Aylesva." target="_blank" rel="noopener noreferrer" class="rdp-hotspot rdp-hs-wa" title="Asesoría personalizada por WhatsApp" aria-label="Contactar Asesor Sommelier">
          <span class="rdp-ripple"></span>
        </a>

        <!-- 4. BOTELLA HÉROE: CABERNET SAUVIGNON 2020 ($900 MXN) -->
        <a href="/products/cabernet-sauvignon-2020" class="rdp-hotspot rdp-hs-wine-1" title="Comprar Cabernet Sauvignon 2020 - $900 MXN" aria-label="Comprar Cabernet Sauvignon 2020">
          <div class="rdp-hs-hover-cue">
            <span class="rdp-cue-badge">COMPRAR CABERNET $900 MXN ↗</span>
          </div>
        </a>

        <!-- 5. BOTELLA 2: SYRAH 2021 ($750 MXN) -->
        <a href="/products/syrah-2021" class="rdp-hotspot rdp-hs-wine-2" title="Comprar Syrah 2021 - $750 MXN" aria-label="Comprar Syrah 2021">
          <div class="rdp-hs-hover-cue">
            <span class="rdp-cue-badge">COMPRAR SYRAH $750 MXN ↗</span>
          </div>
        </a>

        <!-- 6. BOTELLA 3: ROSÉ 2023 ($450 MXN) -->
        <a href="/products/rose-2023" class="rdp-hotspot rdp-hs-wine-3" title="Comprar Rosé 2023 - $450 MXN" aria-label="Comprar Rosé 2023">
          <div class="rdp-hs-hover-cue">
            <span class="rdp-cue-badge">COMPRAR ROSÉ $450 MXN ↗</span>
          </div>
        </a>

        <!-- 7. FLECHAS / NAVEGACIÓN -> /collections/vinos -->
        <a href="/collections/vinos" class="rdp-hotspot rdp-hs-nav" title="Ver más vinos de la colección" aria-label="Ver todos los vinos">
          <span class="rdp-sr-only">Ver todos los vinos</span>
        </a>

      </div>

    </div>

    <!-- MÓVIL: BARRA DE ACCIÓN RÁPIDA DEBAJO DEL BANNER -->
    <div class="rdp-mobile-quickbar">
      <a href="/collections/vinos" class="rdp-mob-btn-main">
        EXPLORAR COLECCIÓN DE VINOS →
      </a>
      <div class="rdp-mob-pills">
        <a href="/products/cabernet-sauvignon-2020" class="rdp-mob-pill">Cabernet $900</a>
        <a href="/products/syrah-2021" class="rdp-mob-pill">Syrah $750</a>
        <a href="/products/rose-2023" class="rdp-mob-pill">Rosé $450</a>
        <a href="/products/cosecha-tardia-2025" class="rdp-mob-pill">Cosecha Tardía $400</a>
        <a href="/products/l-v-o-2022" class="rdp-mob-pill">L.V.O. $655</a>
        <a href="/products/semillon-2023" class="rdp-mob-pill">Semillón $400</a>
      </div>
    </div>

  </div>
</div>

<style>
  #rdp-master-{{ section.id }} {
    /* FULL WIDTH BREAKOUT 100vw */
    position: relative;
    width: 100vw;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    margin-top: 45px;
    margin-bottom: 55px;
    box-sizing: border-box;
    background-color: #050406;
    overflow: hidden;
  }

  #rdp-master-{{ section.id }} * {
    box-sizing: border-box;
  }

  #rdp-master-{{ section.id }} .rdp-master-wrapper {
    position: relative;
    width: 100%;
    max-width: 1720px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* CANVAS CONTAINER CON RELACIÓN DE ASPECTO 2:1 */
  #rdp-master-{{ section.id }} .rdp-master-canvas {
    position: relative;
    width: 100%;
    aspect-ratio: 2 / 1;
    border-radius: 4px;
    overflow: hidden;
    box-shadow: 
      0 20px 50px rgba(0, 0, 0, 0.9),
      0 0 0 1px rgba(212, 175, 55, 0.35);
  }

  #rdp-master-{{ section.id }} .rdp-master-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    user-select: none;
    -webkit-user-drag: none;
  }

  /* CAPA DE HOTSPOTS INTERACTIVOS */
  #rdp-master-{{ section.id }} .rdp-hotspots-layer {
    position: absolute;
    inset: 0;
    z-index: 5;
  }

  #rdp-master-{{ section.id }} .rdp-hotspot {
    position: absolute;
    display: block;
    text-decoration: none;
    cursor: pointer;
    border-radius: 6px;
    transition: all 0.25s ease;
  }

  /* ACCESIBILIDAD */
  #rdp-master-{{ section.id }} .rdp-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* COORDENADAS PORCENTUALES EXACTAS */
  
  /* 1. Logo & Titular */
  #rdp-master-{{ section.id }} .rdp-hs-brand {
    top: 9%;
    left: 4.5%;
    width: 38%;
    height: 48%;
  }

  /* 2. Botón [ EXPLORAR COLECCIÓN → ] */
  #rdp-master-{{ section.id }} .rdp-hs-cta {
    top: 74.2%;
    left: 4.8%;
    width: 20.8%;
    height: 9%;
    border-radius: 999px;
  }
  #rdp-master-{{ section.id }} .rdp-hs-cta:hover {
    box-shadow: 
      0 0 25px rgba(212, 175, 55, 0.6),
      inset 0 0 15px rgba(255, 255, 255, 0.4);
    transform: translateY(-1px);
  }

  /* 3. Botón [ ASESOR SOMMELIER ] */
  #rdp-master-{{ section.id }} .rdp-hs-wa {
    top: 85.2%;
    left: 4.8%;
    width: 13.6%;
    height: 6.8%;
    border-radius: 999px;
  }
  #rdp-master-{{ section.id }} .rdp-hs-wa:hover {
    box-shadow: 
      0 0 20px rgba(37, 211, 102, 0.4),
      inset 0 0 10px rgba(37, 211, 102, 0.2);
  }

  /* 4. Cabernet Sauvignon (Hero) */
  #rdp-master-{{ section.id }} .rdp-hs-wine-1 {
    top: 4%;
    left: 46%;
    width: 19.5%;
    height: 93%;
  }
  #rdp-master-{{ section.id }} .rdp-hs-wine-1:hover {
    background: radial-gradient(circle at 50% 45%, rgba(212, 175, 55, 0.12) 0%, transparent 70%);
  }

  /* 5. Syrah */
  #rdp-master-{{ section.id }} .rdp-hs-wine-2 {
    top: 20%;
    left: 66.5%;
    width: 12.5%;
    height: 77%;
  }
  #rdp-master-{{ section.id }} .rdp-hs-wine-2:hover {
    background: radial-gradient(circle at 50% 45%, rgba(212, 175, 55, 0.12) 0%, transparent 70%);
  }

  /* 6. Rosé 2023 */
  #rdp-master-{{ section.id }} .rdp-hs-wine-3 {
    top: 22%;
    left: 79.5%;
    width: 12.5%;
    height: 75%;
  }
  #rdp-master-{{ section.id }} .rdp-hs-wine-3:hover {
    background: radial-gradient(circle at 50% 45%, rgba(212, 175, 55, 0.12) 0%, transparent 70%);
  }

  /* 7. Flechas de navegación */
  #rdp-master-{{ section.id }} .rdp-hs-nav {
    top: 90%;
    left: 91%;
    width: 6%;
    height: 7%;
    border-radius: 999px;
  }
  #rdp-master-{{ section.id }} .rdp-hs-nav:hover {
    box-shadow: 0 0 15px rgba(212, 175, 55, 0.4);
  }

  /* CUE BADGES FLOTANTES EN HOVER (DISCRETOS) */
  #rdp-master-{{ section.id }} .rdp-hs-hover-cue {
    position: absolute;
    bottom: 2%;
    left: 50%;
    transform: translateX(-50%) translateY(5px);
    opacity: 0;
    pointer-events: none;
    transition: all 0.25s ease;
    white-space: nowrap;
  }
  #rdp-master-{{ section.id }} .rdp-cue-badge {
    display: inline-block;
    font-family: 'Cinzel', serif;
    font-size: 10px;
    font-weight: 700;
    color: #0A080A;
    background: linear-gradient(135deg, #F5E5C9 0%, #D4AF37 100%);
    padding: 4px 10px;
    border-radius: 999px;
    box-shadow: 0 4px 14px rgba(0,0,0,0.8);
    letter-spacing: 0.05em;
  }
  #rdp-master-{{ section.id }} .rdp-hotspot:hover .rdp-hs-hover-cue {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  /* MÓVIL BARRA RÁPIDA (OCULTA EN DESKTOP) */
  #rdp-master-{{ section.id }} .rdp-mobile-quickbar {
    display: none;
    margin-top: 14px;
    padding: 0 4px;
  }
  #rdp-master-{{ section.id }} .rdp-mob-btn-main {
    display: block;
    width: 100%;
    text-align: center;
    background: linear-gradient(135deg, #F0DBB4 0%, #D4AF37 50%, #9B7028 100%);
    color: #0A080A;
    font-family: 'Cinzel', serif;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 12px;
    border-radius: 8px;
    text-decoration: none;
    box-shadow: 0 4px 16px rgba(0,0,0,0.4);
    margin-bottom: 10px;
  }
  #rdp-master-{{ section.id }} .rdp-mob-pills {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-bottom: 6px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  #rdp-master-{{ section.id }} .rdp-mob-pills::-webkit-scrollbar {
    display: none;
  }
  #rdp-master-{{ section.id }} .rdp-mob-pill {
    flex: 0 0 auto;
    font-size: 10.5px;
    font-weight: 600;
    color: #F4E4C1;
    background: rgba(212, 175, 55, 0.12);
    border: 1px solid rgba(212, 175, 55, 0.35);
    padding: 6px 12px;
    border-radius: 999px;
    text-decoration: none;
    white-space: nowrap;
  }

  /* RESPONSIVE */
  @media (max-width: 768px) {
    #rdp-master-{{ section.id }} {
      margin-top: 30px;
      margin-bottom: 40px;
    }
    #rdp-master-{{ section.id }} .rdp-master-wrapper {
      padding: 0 10px;
    }
    #rdp-master-{{ section.id }} .rdp-mobile-quickbar {
      display: block;
    }
  }
</style>

{% schema %}
{
  "name": "Banner Raíz de Plata",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título de referencia",
      "default": "Banner Raíz de Plata Master"
    }
  ],
  "presets": [
    {
      "name": "Banner Raíz de Plata"
    }
  ]
}
{% endschema %}
