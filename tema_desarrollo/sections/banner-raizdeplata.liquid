          <!-- TARJETA 6: SEMILLÓN 2023 -->
          <a href="/products/semillon-2023" class="rdp-wine-card">
            <div class="rdp-card-top-tag">BLANCO MINERAL · 2023</div>
            <div class="rdp-photo-frame">
              <img src="{{ 'rdp-botella-semillon.jpg' | asset_url }}" alt="Vino Semillón 2023 Raíz de Plata" class="rdp-studio-img" width="683" height="1024" loading="lazy">
            </div>
            <div class="rdp-card-body">
              <h3 class="rdp-card-wine-title">Semillón 2023</h3>
              <p class="rdp-card-wine-desc">100% Semillón · Cítrico & Untuoso</p>
              <div class="rdp-card-action-bar">
