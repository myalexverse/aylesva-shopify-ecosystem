<script>
  (function(){
    var root = document.getElementById('rdp-3d-{{ section.id }}');
    if (!root) return;

    var wineCatalog = {
      lvo: {
        tag: "GRAN RESERVA · BLEND DE TINTOS",
        name: "L.V.O. Cosecha 2022",
        price: "$450 <small>MXN</small>",
        blend: "40% Tempranillo · 40% Cariñan · 20% Nebbiolo",
        crianza: "12 meses en barrica de roble francés",
        tasting: "Ciruela negra madura, moras silvestres, café tostado y cacao. Final aterciopelado con taninos redondos.",
        food: "Cortes marmoleados a las brasas, cordero al romero y quesos madurados.",
        image: "{{ 'rdp-botella-lvo.jpg' | asset_url }}",
        alt: "Raíz de Plata L.V.O. 2022",
        vignoble: "Valle de Barranquillas",
        subtoken: "Cosecha Seleccionada a Mano"
      },
      cabernet: {
        tag: "VARIETAL TINTO · GRAN GUARDA",
        name: "Cabernet Sauvignon 2020",
        price: "$480 <small>MXN</small>",
        blend: "100% Cabernet Sauvignon",
        crianza: "14 meses en barrica de roble francés",
        tasting: "Estructura potente y taninos elegantes. Aromas a cassis, pimienta negra, cacao amargo, tabaco y vainilla.",
        food: "Ribeye a las brasas, cortes premium New York y estofados de larga cocción.",
        image: "{{ 'rdp-botella-cabernet.jpg' | asset_url }}",
        alt: "Raíz de Plata Cabernet Sauvignon 2020",
        vignoble: "Valle de Barranquillas",
        subtoken: "Gran Reserva de Guarda"
      },
      syrah: {
        tag: "VARIETAL TINTO · MINERAL DE ALTURA",
        name: "Syrah Cosecha 2021",
        price: "$450 <small>MXN</small>",
        blend: "100% Syrah",
        crianza: "10 meses en barrica de roble",
        tasting: "Mineralidad vibrante y frescura aromática. Notas de higo maduro, lavanda silvestre, pimienta rosa y trufa negra.",
        food: "Carnes de caza, lechón al horno, magret de pato y charcutería fina.",
        image: "{{ 'rdp-botella-syrah.jpg' | asset_url }}",
        alt: "Raíz de Plata Syrah 2021",
        vignoble: "Viñedo Martínez",
        subtoken: "Terroir Mineral de Altura"
      },
      rose: {
        tag: "ROSADO PROVENZAL · EDICIÓN FRESCA",
        name: "Rosé Cosecha 2023",
        price: "$400 <small>MXN</small>",
        blend: "56% Syrah · 44% Cariñan",
        crianza: "Fermentación en frío sin barrica",
        tasting: "Color salmón pálido provenzal. Aromas de fresas silvestres, pétalos de rosa, toronja rubí y acidez crujiente.",
        food: "Mariscos frescos, pastas ligeras, ceviches gourmet y tapas mediterráneas.",
        image: "{{ 'rdp-botella-rose.jpg' | asset_url }}",
        alt: "Raíz de Plata Rosé 2023",
        vignoble: "Viñedo Martínez",
        subtoken: "Fresco, Floral & Vibrante"
      },
      semillon: {
        tag: "BLANCO MINERAL DE ALTURA",
        name: "Semillón Cosecha 2023",
        price: "$400 <small>MXN</small>",
        blend: "100% Semillón",
        crianza: "Lías finas en tanque de acero inoxidable",
        tasting: "Blanco de gran complejidad y pureza mineral. Aromas de lima kaffir, manzana verde, cera de abeja y jazmín.",
        food: "Pescados grasos, mariscos al vapor, cocina oriental y aves en salsa cremosa.",
        image: "{{ 'rdp-botella-semillon.jpg' | asset_url }}",
        alt: "Raíz de Plata Semillón 2023",
        vignoble: "Viñedo Martínez",
        subtoken: "Blanco de Altura Mineral"
      }
    };

    var tabs = root.querySelectorAll('.rdp-medallion-btn');
    var elTag = root.querySelector('#rdp-spec-tag');
    var elName = root.querySelector('#rdp-spec-name');
    var elPrice = root.querySelector('#rdp-spec-price');
    var elBlend = root.querySelector('#rdp-spec-blend');
    var elCrianza = root.querySelector('#rdp-spec-crianza');
    var elTasting = root.querySelector('#rdp-spec-tasting');
    var elFood = root.querySelector('#rdp-spec-food');
    var elBottle = root.querySelector('#rdp-stage-bottle');
    var elVignoble = root.querySelector('#rdp-token-vignoble');
    var elSubtoken = root.querySelector('#rdp-token-sub');

    tabs.forEach(function(tab){
      tab.addEventListener('click', function(){
        var key = this.getAttribute('data-wine');
        var wine = wineCatalog[key];
        if (!wine) return;

        tabs.forEach(function(t){
          t.classList.remove('is-active');
          t.setAttribute('aria-selected', 'false');
        });
        this.classList.add('is-active');
        this.setAttribute('aria-selected', 'true');

        // Smooth image switch with 3D scale
        elBottle.style.opacity = '0';
        elBottle.style.transform = 'scale(0.95)';

        setTimeout(function(){
          elBottle.src = wine.image;
          elBottle.alt = wine.alt;
          if (elTag) elTag.textContent = wine.tag;
          if (elName) elName.textContent = wine.name;
          if (elPrice) elPrice.innerHTML = wine.price;
          if (elBlend) elBlend.textContent = wine.blend;
          if (elCrianza) elCrianza.textContent = wine.crianza;
          if (elTasting) elTasting.textContent = wine.tasting;
          if (elFood) elFood.textContent = wine.food;
          if (elVignoble) elVignoble.textContent = wine.vignoble;
          if (elSubtoken) elSubtoken.textContent = wine.subtoken;

          elBottle.style.opacity = '1';
          elBottle.style.transform = 'scale(1)';
        }, 150);
      });
    });

  })();
</script>

