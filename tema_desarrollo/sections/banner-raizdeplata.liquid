            <div class="rdp-photo-frame">
              <img src="{{ 'rdp-botella-rose.jpg' | asset_url }}" alt="Vino Rosé 2023 Raíz de Plata" class="rdp-studio-img" width="819" height="1024" loading="lazy">
            </div>
            <div class="rdp-card-body">
              <h3 class="rdp-card-wine-title">Rosé 2023</h3>
              <p class="rdp-card-wine-desc">Syrah · Cariñan · Fresco & Floral</p>
