{% comment %}
  ============================================================
  Raíz de Plata — De Haro | Banner Panorámico Full-Width
  Productos Superpuestos (Overlapping) con Enlaces Directos de Compra
  Diseño E-Commerce Prémium de Alta Gama (100% Responsive)
  ============================================================
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700;800&family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,400;1,600&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<div id="rdp-fw-{{ section.id }}" class="rdp-fw-section">
  
  <!-- PANORAMIC BAR (FULL WIDTH 100vw) -->
  <div class="rdp-fw-bar">
    
    <!-- BACKGROUND ART -->
    <div class="rdp-fw-bg">
      <div class="rdp-fw-photo" style="background-image: url('{{ 'rdp-vinedos-bg.jpg' | asset_url }}');"></div>
      <div class="rdp-fw-overlay"></div>
      <div class="rdp-fw-glow"></div>
    </div>

    <!-- INNER CONTAINER -->
    <div class="rdp-fw-inner">
      
      <!-- LEFT BRAND & NARRATIVE -->
      <div class="rdp-fw-brand-col">
        <div class="rdp-fw-badge-pill">
          <span class="rdp-fw-dot"></span>
          <span>BODEGA BOUTIQUE · JEREZ, ZACATECAS</span>
        </div>

        <div class="rdp-fw-logo-wrap">
          <a href="https://www.raizdeplata.com/" target="_blank" rel="noopener noreferrer" title="Raíz de Plata — De Haro">
            <img src="{{ 'rdp-logo-gold.png' | asset_url }}" alt="Raíz de Plata — De Haro" class="rdp-fw-logo" width="170" height="85" loading="lazy">
          </a>
        </div>

        <h2 class="rdp-fw-title">
          Vinos de Terruño <br>
          <em>a 2,000 MSNM</em>
        </h2>

