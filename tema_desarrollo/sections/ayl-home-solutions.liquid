<div id="{{ section.id }}" class="ayl-solutions">
  <div class="ayl-solutions__container">
    <div class="ayl-solutions__content">
      <div class="ayl-solutions__left">
        {% if section.settings.eyebrow != blank %}
          <div class="ayl-solutions__eyebrow">{{ section.settings.eyebrow }}</div>
        {% endif %}
        {% if section.settings.headline != blank %}
          <h2 class="ayl-solutions__headline">{{ section.settings.headline }}</h2>
        {% endif %}
      </div>
      <div class="ayl-solutions__right">
        <div class="ayl-solutions__grid">
          {% for block in section.blocks %}
            <div class="ayl-solutions__card" {{ block.shopify_attributes }}>
              <div class="ayl-solutions__card-icon">
                {{ block.settings.icon_svg }}
              </div>
              <h3 class="ayl-solutions__card-title">{{ block.settings.title }}</h3>
              <p class="ayl-solutions__card-desc">{{ block.settings.description }}</p>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  #{{ section.id }} {
    --ayl-bg: #FFFFFF;
    --ayl-ink: #1A1A1A;
    --ayl-stone: #6B6B6B;
    --ayl-gold: #C5A47E;
    --ayl-border: rgba(0,0,0,0.06);
    
    background-color: var(--ayl-bg);
    padding: 80px 0;
    font-family: 'Poppins', sans-serif;
  }

  #{{ section.id }} .ayl-solutions__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  #{{ section.id }} .ayl-solutions__content {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  @media (min-width: 768px) {
    #{{ section.id }} .ayl-solutions__content {
      flex-direction: row;
      justify-content: space-between;
      gap: 64px;
    }
  }

  #{{ section.id }} .ayl-solutions__left {
    flex: 0 0 100%;
  }

  @media (min-width: 768px) {
    #{{ section.id }} .ayl-solutions__left {
      flex: 0 0 calc(40% - 32px);
    }
  }

  #{{ section.id }} .ayl-solutions__eyebrow {
    font-size: 12px;
    font-weight: 500;
    text-transform: uppercase;
    color: var(--ayl-gold);
    letter-spacing: 0.1em;
    margin-bottom: 16px;
  }

  #{{ section.id }} .ayl-solutions__headline {
    font-family: 'Playfair Display', serif;
    font-size: 32px;
    line-height: 1.2;
    color: var(--ayl-ink);
    margin: 0;
  }

  @media (min-width: 768px) {
    #{{ section.id }} .ayl-solutions__headline {
      font-size: 38px;
    }
  }

  #{{ section.id }} .ayl-solutions__right {
    flex: 0 0 100%;
  }

  @media (min-width: 768px) {
    #{{ section.id }} .ayl-solutions__right {
      flex: 0 0 calc(60% - 32px);
    }
  }

  #{{ section.id }} .ayl-solutions__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }

  @media (min-width: 768px) {
    #{{ section.id }} .ayl-solutions__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 40px;
    }
  }

  #{{ section.id }} .ayl-solutions__card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  #{{ section.id }} .ayl-solutions__card-icon {
    width: 48px;
    height: 48px;
    background-color: #FAFAF8;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    border: 1px solid var(--ayl-border);
    color: var(--ayl-gold);
  }

  #{{ section.id }} .ayl-solutions__card-icon svg {
    width: 24px;
    height: 24px;
    fill: currentColor;
  }

  #{{ section.id }} .ayl-solutions__card-title {
    font-size: 16px;
    font-weight: 600;
    color: var(--ayl-ink);
    margin: 0 0 8px 0;
  }

  #{{ section.id }} .ayl-solutions__card-desc {
    font-size: 14px;
    line-height: 1.6;
    color: var(--ayl-stone);
    margin: 0;
  }
</style>

<script>
  (function() {
    // Optional intersection observer for fade-in animations
    document.addEventListener("DOMContentLoaded", function() {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if(entry.isIntersecting) {
            entry.target.style.opacity = 1;
            entry.target.style.transform = 'translateY(0)';
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1 });

      const cards = document.querySelectorAll('#{{ section.id }} .ayl-solutions__card');
      cards.forEach((card, index) => {
        card.style.opacity = 0;
        card.style.transform = 'translateY(20px)';
        card.style.transition = `opacity 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94) ${index * 0.1}s, transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94) ${index * 0.1}s`;
        observer.observe(card);
      });
    });
  })();
</script>

