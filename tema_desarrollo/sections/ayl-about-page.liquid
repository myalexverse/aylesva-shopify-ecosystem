{{ 'base.css' | asset_url | stylesheet_tag }}

<style>
  .ayl-page-hero {
    position: relative;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    height: 350px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    margin-bottom: 60px;
  }
  
  .ayl-page-hero::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(45, 12, 18, 0.6); /* Wine themed overlay */
    z-index: 1;
  }

  .ayl-page-hero .hero-content {
    position: relative;
    z-index: 2;
    max-width: 800px;
    padding: 0 20px;
  }

  .ayl-page-hero h1 {
    color: #ffffff !important;
    font-family: 'Outfit', 'Inter', sans-serif;
    font-size: 3rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 15px;
    text-shadow: 0 2px 4px rgba(0,0,0,0.3);
  }

  .ayl-page-hero p {
    color: #C5A47E !important;
    font-family: 'Inter', sans-serif;
    font-size: 1.2rem;
    font-weight: 500;
    max-width: 600px;
    margin: 0 auto;
    text-shadow: 0 1px 2px rgba(0,0,0,0.3);
  }

  /* Split Story Grid */
  .ayl-about-story {
    max-width: 1100px;
    margin: 0 auto 80px;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 60px;
    align-items: center;
  }

  @media screen and (max-width: 992px) {
    .ayl-about-story {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .ayl-page-hero h1 {
      font-size: 2.2rem;
    }
  }

  .story-text-col {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .story-tagline {
    color: #C5A47E;
    font-family: 'Outfit', sans-serif;
    font-size: 0.9rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 3px;
    margin: 0;
  }

  .story-title {
    color: #4A0E17;
    font-family: 'Outfit', sans-serif;
    font-size: 2.2rem;
    font-weight: 800;
    line-height: 1.2;
    margin: 0;
  }

  .story-desc {
    color: #555555;
    font-family: 'Inter', sans-serif;
    font-size: 1.05rem;
    line-height: 1.8;
    text-align: justify;
    margin: 0;
  }

  .story-desc strong {
    color: #4A0E17;
  }

  .story-image-col {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .story-image-wrap {
    position: relative;
    border: 2px solid #C5A47E;
    padding: 10px;
    background: #ffffff;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
    border-radius: 4px;
    max-width: 100%;
    transition: transform 0.4s ease;
  }

  .story-image-wrap:hover {
    transform: translateY(-5px);
  }

  .story-image-wrap img {
    display: block;
    max-width: 100%;
    height: auto;
    border-radius: 2px;
  }

  /* Pillars Section */
  .ayl-pillars-section {
    background: #fdfaf7;
    padding: 80px 24px;
    border-top: 1px solid #f2e9df;
    border-bottom: 1px solid #f2e9df;
  }

  .ayl-pillars-container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .pillars-header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 50px;
  }

  .pillars-tagline {
    color: #C5A47E;
    font-family: 'Outfit', sans-serif;
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 3px;
    display: block;
    margin-bottom: 10px;
  }

  .pillars-title {
    color: #4A0E17;
    font-family: 'Outfit', sans-serif;
    font-size: 2.2rem;
    font-weight: 800;
    margin: 0;
  }

  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }

  @media screen and (max-width: 768px) {
    .pillars-grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    .ayl-pillars-section {
      padding: 60px 24px;
    }
  }

  .pillar-card {
    background: #ffffff;
    border: 1px solid #efe5db;
    border-radius: 8px;
    padding: 40px 30px;
    text-align: center;
    box-shadow: 0 4px 6px rgba(74, 14, 23, 0.01);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .pillar-card:hover {
    transform: translateY(-8px);
    border-color: #C5A47E;
    box-shadow: 0 15px 30px rgba(74, 14, 23, 0.06);
  }

  .pillar-icon-wrap {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: #4A0E17;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 24px;
    color: #C5A47E;
    box-shadow: 0 4px 10px rgba(74, 14, 23, 0.2);
  }

  .pillar-icon-wrap svg {
    width: 28px;
    height: 28px;
    fill: currentColor;
  }

  .pillar-name {
    color: #4A0E17;
    font-family: 'Outfit', sans-serif;
    font-size: 1.25rem;
    font-weight: 800;
    margin-bottom: 12px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .pillar-desc {
    color: #666666;
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }
</style>

<div class="ayl-page-hero" style="background-image: linear-gradient(rgba(45, 12, 18, 0.6), rgba(45, 12, 18, 0.6)), url({{ section.settings.image_hero | default: 'mayoreo-about-banner.png' | asset_url }});">
  <div class="hero-content">
    <h1>{{ section.settings.heading | default: "Nuestra Historia" }}</h1>
    <p>{{ section.settings.subheading | default: "Calidad, tradición y el verdadero estilo vaquero en cada paso" }}</p>
  </div>
</div>

<div class="ayl-about-story">
  <div class="story-text-col">
    <p class="story-tagline">Tradición Aylesva</p>
    <h2 class="story-title">{{ section.settings.story_title | default: "Raíces con Carácter Vaquero" }}</h2>
    <p class="story-desc">
      <strong>Aylesva</strong> nació con la profunda pasión de llevar la esencia, elegancia y calidad de la moda country y vaquera a cada rincón del país. Para nosotros, vestir con estilo vaquero no es solo una moda, sino una declaración de libertad, orgullo y respeto por la tradición artesanal.
    </p>
    <p class="story-desc">
      Como distribuidores autorizados de las marcas más prestigiosas y fabricantes de calzado vaquero de alta gama, nos esforzamos en seleccionar pieles legítimas y acabados perfectos. Cada bota exótica, sombrero fino y chaleco de nuestro catálogo es un testimonio de durabilidad y diseño premium.
    </p>
    <p class="story-desc">
      Nuestra plataforma de <strong>Mayoreo</strong> se creó específicamente para respaldar el espíritu emprendedor mexicano. Proporcionamos inventario garantizado, logística eficiente y atención personalizada para que tiendas establecidas y nuevos distribuidores expandan sus negocios de forma rentable y segura.
    </p>
  </div>

  <div class="story-image-col">
    <div class="story-image-wrap">
      <img src="{{ section.settings.image_story | default: 'mayoreo-leather-craft.png' | asset_url }}" alt="Artesano fabricando botas de piel de Aylesva" loading="lazy" width="450" height="450">
    </div>
  </div>
</div>

<div class="ayl-pillars-section">
  <div class="ayl-pillars-container">
    <div class="pillars-header">
      <span class="pillars-tagline">Nuestra Esencia</span>
      <h2 class="pillars-title">Nuestros Compromisos</h2>
    </div>
    
    <div class="pillars-grid">
      <!-- Pillar 1: Calidad -->
      <div class="pillar-card">
        <div class="pillar-icon-wrap">
          <svg viewBox="0 0 24 24">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 17h-2v-2h2v2zm2.07-7.75l-.9.92C13.45 12.9 13 13.5 13 15h-2v-.5c0-1.1.45-2.1 1.17-2.83l1.24-1.26c.37-.36.59-.86.59-1.41 0-1.1-.9-2-2-2s-2 .9-2 2H7c0-2.76 2.24-5 5-5s5 2.24 5 5c0 1.04-.42 1.99-1.07 2.75z"/>
          </svg>
        </div>
        <h3 class="pillar-name">Calidad Suprema</h3>
        <p class="pillar-desc">Pieles 100% genuinas seleccionadas a mano y costuras reforzadas para ofrecer un producto de alta resistencia y durabilidad excepcional.</p>
      </div>

      <!-- Pillar 2: Emprendimiento -->
      <div class="pillar-card">
        <div class="pillar-icon-wrap">
          <svg viewBox="0 0 24 24">
            <path d="M16 6l2.29 2.29-4.88 4.88-4-4L2 16.59 3.41 18l6-6 4 4 6.3-6.29L22 12V6h-6z"/>
          </svg>
        </div>
        <h3 class="pillar-name">Apoyo Emprendedor</h3>
        <p class="pillar-desc">Tarifas de mayoreo sumamente competitivas y paquetes prediseñados de bajo riesgo para ayudarte a lanzar o escalar tu negocio con éxito.</p>
      </div>

      <!-- Pillar 3: Tradición -->
      <div class="pillar-card">
        <div class="pillar-icon-wrap">
          <svg viewBox="0 0 24 24">
            <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
          </svg>
        </div>
        <h3 class="pillar-name">Tradición Vaquera</h3>
        <p class="pillar-desc">Diseños icónicos y cortes country auténticos que respetan el legado vaquero, adaptados con toques contemporáneos de moda.</p>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Nuestra Historia",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Hero Heading",
      "default": "Nuestra Historia"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Hero Subheading",
      "default": "Calidad, tradición y el verdadero estilo vaquero en cada paso"
    },
    {
      "type": "image_picker",
      "id": "image_hero",
      "label": "Hero Image Banner"
    },
    {
      "type": "text",
      "id": "story_title",
      "label": "Story Title",
      "default": "Raíces con Carácter Vaquero"
    },
    {
      "type": "image_picker",
      "id": "image_story",
      "label": "Story Content Image"
    }
  ]
}
{% endschema %}
