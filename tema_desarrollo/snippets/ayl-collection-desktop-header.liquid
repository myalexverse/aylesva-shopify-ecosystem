          {%- assign cat_url = parts[1] -%}
          {%- assign sub_coll_handle = parts[2] -%}
          {%- assign sub_coll = collections[sub_coll_handle] -%}
          
          {%- assign sub_img_url = "" -%}
          {%- if current_handle == 'hombre' or current_handle == 'ropa-hombre' -%}
            {%- if cat_name == 'Camisas' -%}
              {%- assign sub_img_url = 'https://cdn.shopify.com/s/files/1/0784/2375/2727/files/044079.jpg?v=1773965871' -%}
            {%- elsif cat_name == 'Jeans' -%}
              {%- assign sub_img_url = 'https://cdn.shopify.com/s/files/1/0784/2375/2727/files/044975.jpg?v=1773968936' -%}
            {%- elsif cat_name == 'Vaquera' -%}
              {%- assign sub_img_url = 'https://cdn.shopify.com/s/files/1/0784/2375/2727/files/023075.jpg?v=1773962147' -%}
            {%- elsif cat_name == 'Chalecos' -%}
              {%- assign sub_img_url = 'https://cdn.shopify.com/s/files/1/0784/2375/2727/files/127086.jpg?v=1773971262' -%}
            {%- elsif cat_name == 'Botas' -%}
              {%- assign sub_img_url = 'cat-botas-hombre.png' | asset_url -%}
            {%- elsif cat_name == 'Playeras' -%}
              {%- assign sub_img_url = 'https://cdn.shopify.com/s/files/1/0784/2375/2727/files/043602.jpg?v=1773964556' -%}
            {%- elsif cat_name == 'Chamarras' -%}
              {%- assign sub_img_url = 'https://cdn.shopify.com/s/files/1/0784/2375/2727/files/127086.jpg?v=1773971262' -%}
            {%- endif -%}
          {%- elsif current_handle == 'mujer' or current_handle == 'ropa-mujer' -%}
            {%- if cat_name == 'Ropa' -%}
              {%- assign sub_img_url = 'cat-ropa.png' | asset_url -%}
            {%- elsif cat_name == 'Calzado' -%}
              {%- assign sub_img_url = 'cat-calzado.png' | asset_url -%}
            {%- elsif cat_name == 'Lencería' -%}
              {%- assign sub_img_url = 'cat-lenceria.png' | asset_url -%}
            {%- elsif cat_name == 'Joyería' -%}
              {%- assign sub_img_url = 'cat-joyeria.png' | asset_url -%}
            {%- elsif cat_name == 'Bolsas' -%}
              {%- assign sub_img_url = 'cat-bolsas.png' | asset_url -%}
            {%- elsif cat_name == 'Accesorios' -%}
              {%- assign sub_img_url = 'cat-accesorios.png' | asset_url -%}
            {%- elsif cat_name == 'Belleza' -%}
              {%- assign sub_img_url = 'cat-belleza.png' | asset_url -%}
            {%- elsif cat_name == 'Maternidad' -%}
              {%- assign sub_img_url = 'cat-maternidad.png' | asset_url -%}
            {%- endif -%}
          {%- elsif current_handle == 'calzado-hombre' -%}
            {%- if cat_name == 'Zapatos Formales' -%}
              {%- assign sub_img_url = 'cat-zapatos-formales.png' | asset_url -%}
            {%- elsif cat_name == 'Botas' -%}
              {%- assign sub_img_url = 'cat-botas-hombre.png' | asset_url -%}
            {%- elsif cat_name == 'Botas Exóticas' -%}
              {%- assign sub_img_url = 'cat-botas-exoticas.png' | asset_url -%}
            {%- elsif cat_name == 'Tenis' -%}
              {%- assign sub_img_url = 'cat-tenis-hombre.png' | asset_url -%}
            {%- elsif cat_name == 'Sandalias' -%}
              {%- assign sub_img_url = 'cat-sandalias-hombre.png' | asset_url -%}
            {%- elsif cat_name == 'Mocasines' -%}
              {%- assign sub_img_url = 'cat-mocasines-hombre.png' | asset_url -%}
            {%- elsif cat_name == 'Pantuflas' -%}
              {%- assign sub_img_url = 'cat-pantuflas-hombre.png' | asset_url -%}
            {%- endif -%}
          {%- elsif current_handle == 'calzado-mujer' -%}
            {%- if cat_name == 'Tacones y stilettos' -%}
              {%- assign sub_img_url = 'cat-tacones-mujer.png' | asset_url -%}
            {%- elsif cat_name == 'Sandalias Mujer' -%}
              {%- assign sub_img_url = 'cat-sandalias-mujer.png' | asset_url -%}
            {%- elsif cat_name == 'Flats y bailarinas' -%}
              {%- assign sub_img_url = 'cat-flats-mujer.png' | asset_url -%}
            {%- elsif cat_name == 'Botas y botines Mujer' -%}
              {%- assign sub_img_url = 'cat-botas-mujer.png' | asset_url -%}
            {%- elsif cat_name == 'Tenis y sneakers Mujer' -%}
              {%- assign sub_img_url = 'cat-tenis-mujer.png' | asset_url -%}
            {%- elsif cat_name == 'Zapatos de trabajo' -%}
              {%- assign sub_img_url = 'cat-trabajo-mujer.png' | asset_url -%}
            {%- elsif cat_name == 'Pantuflas y chanclas' -%}
              {%- assign sub_img_url = 'cat-pantuflas-mujer.png' | asset_url -%}
            {%- elsif cat_name == 'Plataformas' -%}
              {%- assign sub_img_url = 'cat-plataformas-mujer.png' | asset_url -%}
            {%- endif -%}
          {%- elsif current_handle == 'nino' or current_handle == 'ropa-nino' -%}
            {%- if cat_name == 'Ropa' -%}
              {%- assign sub_img_url = 'cat-ropa-nino.png' | asset_url -%}
            {%- elsif cat_name == 'Calzado' -%}
              {%- assign sub_img_url = 'cat-calzado-nino.png' | asset_url -%}
            {%- elsif cat_name == 'Ropa Interior' -%}
              {%- assign sub_img_url = 'cat-interior-nino.png' | asset_url -%}
            {%- elsif cat_name == 'Accesorios' -%}
              {%- assign sub_img_url = 'cat-accesorios-nino.png' | asset_url -%}
            {%- endif -%}
          {%- elsif current_handle == 'nina' or current_handle == 'ropa-nina' -%}
            {%- if cat_name == 'Ropa' -%}
              {%- assign sub_img_url = 'cat-ropa-nina.png' | asset_url -%}
            {%- elsif cat_name == 'Calzado' -%}
              {%- assign sub_img_url = 'cat-calzado-nina.png' | asset_url -%}
            {%- elsif cat_name == 'Ropa Interior' -%}
              {%- assign sub_img_url = 'cat-interior-nina.png' | asset_url -%}
            {%- elsif cat_name == 'Accesorios' -%}
              {%- assign sub_img_url = 'cat-accesorios-nina.png' | asset_url -%}
            {%- endif -%}
          {%- elsif current_handle == 'bebe' or current_handle == 'ropa-bebe' -%}
            {%- if cat_name == 'Ropa' -%}
              {%- assign sub_img_url = 'cat-ropa-bebe.png' | asset_url -%}
            {%- elsif cat_name == 'Calzado' -%}
              {%- assign sub_img_url = 'cat-calzado-bebe.png' | asset_url -%}
            {%- elsif cat_name == 'Pañales' -%}
              {%- assign sub_img_url = 'cat-panales-bebe.png' | asset_url -%}
            {%- elsif cat_name == 'Accesorios' -%}
              {%- assign sub_img_url = 'cat-accesorios-bebe.png' | asset_url -%}
            {%- endif -%}
          {%- endif -%}

          {%- if sub_img_url == "" -%}
            {%- if sub_coll.image != blank -%}
              {%- assign sub_img_url = sub_coll.image | img_url: '200x200', crop: 'center' -%}
            {%- elsif sub_coll.products.first.featured_image != blank -%}
              {%- assign sub_img_url = sub_coll.products.first.featured_image | img_url: '200x200', crop: 'center' -%}
            {%- endif -%}
          {%- endif -%}
          
          <a href="{{ cat_url }}" class="ayl-quick-category-card">
            <div class="ayl-quick-category-image">
              {%- if cat_name == 'Ofertas' -%}
                <div style="display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; background: #ffffff;">
                  <svg viewBox="0 0 24 24" fill="none" stroke="#C5A47E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 28px; height: 28px;">
                    <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
                    <line x1="7" y1="7" x2="7.01" y2="7"></line>
                  </svg>
                </div>
              {%- elsif sub_img_url != "" -%}
                <img src="{{ sub_img_url }}" alt="{{ cat_name }}" loading="lazy">
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <span class="ayl-quick-category-name">{{ cat_name }}</span>
          </a>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  <!-- TRUST BAR -->
  <div class="ayl-quick-trust-bar">
    <div class="ayl-quick-trust-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13" rx="2" ry="2"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
      <span>Envío a todo México</span>
    </div>
    <div class="ayl-quick-trust-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
      <span>Productos verificados</span>
    </div>
    <div class="ayl-quick-trust-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      <span>Pagos seguros</span>
    </div>
    <div class="ayl-quick-trust-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      <span>Atención personalizada</span>
    </div>
  </div>

  <!-- RESTYLED TOOLBAR -->
  <div class="ayl-new-toolbar">
    <div class="ayl-new-toolbar-left" style="display: flex; align-items: center; gap: 20px;">
      <button class="ayl-filter-toggle-btn" aria-label="Filtros" style="display: flex; align-items: center; gap: 8px; background: #1c1c1e; color: #fff; border: none; padding: 10px 18px; border-radius: 6px; font-size: 13px; font-weight: 700; cursor: pointer; transition: background 0.2s ease;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width: 14px; height: 14px;"><line x1="4" y1="21" x2="4" y2="14"></line><line x1="4" y1="10" x2="4" y2="3"></line><line x1="12" y1="21" x2="12" y2="12"></line><line x1="12" y1="8" x2="12" y2="3"></line><line x1="20" y1="21" x2="20" y2="16"></line><line x1="20" y1="12" x2="20" y2="3"></line><line x1="1" y1="14" x2="7" y2="14"></line><line x1="9" y1="8" x2="15" y2="8"></line><line x1="17" y1="16" x2="23" y2="16"></line></svg>
        Filtros
      </button>
      
      <a href="{{ results.url }}" class="ayl-clear-all-link" style="font-size: 13px; font-weight: 600; color: #C5A47E; text-decoration: none; transition: color 0.2s ease;">Limpiar todo</a>
      
      <span class="ayl-product-count-text" style="font-size: 14px; font-weight: 700; color: #1c1c1e; margin-left: 10px;">{{ results.products_count | default: results.results_count }} Productos</span>
    </div>
    
    <script>
      (function() {
        var btn = document.currentScript.previousElementSibling.querySelector('.ayl-filter-toggle-btn');
        btn.addEventListener('click', function() {
          var sidebar = document.getElementById('left-column') || document.getElementById('right-column');
          var wrapper = document.querySelector('.collection_wrapper');
          if (!sidebar || !wrapper) return;
          var isHidden = window.getComputedStyle(sidebar).display === 'none';
          if (isHidden) {
            sidebar.style.setProperty('display', 'block', 'important');
            wrapper.classList.remove('col-sm-12');
            wrapper.classList.remove('col-sm-offset-3');
            wrapper.classList.add('col-sm-9');
          } else {
            sidebar.style.setProperty('display', 'none', 'important');
            wrapper.classList.remove('col-sm-12');
            wrapper.classList.add('col-sm-9');
            if (sidebar.id === 'left-column') {
              wrapper.classList.add('col-sm-offset-3');
            }
          }
        });
      })();
    </script>

    <div class="ayl-new-toolbar-right">
      {% if settings.collection_sort_enable %}
        <div class="ayl-sort-wrap" style="display: flex; align-items: center; gap: 8px;">
          <span class="ayl-new-sort-label">Ordenar por:</span>
          {%- assign sort_by = results.sort_by | default: results.default_sort_by -%}
          <select name="sort_by" class="ayl-new-sort-select" onchange="location.href='?sort_by=' + this.value">
            {%- for option in results.sort_options -%}
              <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>
            {%- endfor -%}
          </select>
        </div>
      {% endif %}
      
      <div class="ayl-new-grid-modes">
        <button class="ayl-grid-mode-btn active" aria-label="Vista de cuadrícula">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
        </button>
        <button class="ayl-grid-mode-btn" aria-label="Vista de lista">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
        </button>
      </div>
    </div>
  </div>
</header>
