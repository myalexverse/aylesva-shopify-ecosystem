{% comment %}
  AYLESVA - Tabla de Precios Mayoreo
  Solo se muestra en productos de "Diana Zapateria Inc"
  Descuentos por volumen: 4pz=20%, 6pz=30%, 8pz=40%, 12pz=50%
{% endcomment %}

{% assign title_lower = product.title | downcase %}
{% if product.vendor == 'Diana Zapateria Inc' %}
  {% unless title_lower contains 'artesanal' or title_lower contains 'artesania' %}
    <div class="ayl-mayoreo-widget" id="AylMayoreoWidget">
  <style>
    .ayl-mayoreo-widget {
      margin: 20px 0;
      border: 2px solid #c9a96e;
      border-radius: 10px;
      overflow: hidden;
      font-family: 'Inter', sans-serif;
    }
    .ayl-mayoreo-header {
      background: linear-gradient(135deg, #1a1a1a, #2d2d2d);
      color: #fff;
      padding: 14px 20px;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .ayl-mayoreo-header svg {
      width: 22px; height: 22px; fill: #c9a96e;
    }
    .ayl-mayoreo-header span {
      font-size: 14px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }
    .ayl-mayoreo-badge {
      background: #c9a96e;
      color: #1a1a1a;
      font-size: 10px;
      font-weight: 800;
      padding: 3px 8px;
      border-radius: 4px;
      margin-left: auto;
      letter-spacing: 0.05em;
    }
    .ayl-mayoreo-tiers {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0;
    }
    .ayl-mayoreo-tier {
      padding: 16px 10px;
      text-align: center;
      border-right: 1px solid #f0ebe3;
      background: #fefcf8;
      transition: all 0.3s ease;
      cursor: default;
      position: relative;
    }
    .ayl-mayoreo-tier:last-child { border-right: none; }
    .ayl-mayoreo-tier:hover, .ayl-mayoreo-tier.active {
      background: #f8f0e0;
    }
    .ayl-mayoreo-tier.best {
      background: linear-gradient(180deg, #fdf6e8, #f8ecd0);
    }
    .ayl-mayoreo-tier.best::after {
      content: '★ MEJOR';
      position: absolute;
      top: -1px;
      left: 50%;
      transform: translateX(-50%);
      background: #c9a96e;
      color: #fff;
      font-size: 8px;
      font-weight: 800;
      padding: 2px 8px;
      border-radius: 0 0 4px 4px;
      letter-spacing: 0.1em;
    }
    .ayl-tier-qty {
      font-size: 22px;
      font-weight: 900;
      color: #1a1a1a;
      line-height: 1;
    }
    .ayl-tier-qty small {
      font-size: 11px;
      font-weight: 600;
      color: #888;
      display: block;
      margin-top: 2px;
    }
    .ayl-tier-discount {
      display: inline-block;
      background: #1a1a1a;
      color: #c9a96e;
      font-size: 13px;
      font-weight: 800;
      padding: 4px 10px;
      border-radius: 5px;
      margin: 8px 0 6px;
    }
    .ayl-tier-price {
      font-size: 14px;
      font-weight: 700;
      color: #2d6b2d;
    }
    .ayl-tier-price small {
      display: block;
      font-size: 11px;
      color: #999;
      font-weight: 400;
      text-decoration: line-through;
      margin-bottom: 2px;
    }
    .ayl-mayoreo-note {
      padding: 10px 16px;
      background: #f9f6f0;
      border-top: 1px solid #f0ebe3;
      font-size: 11px;
      color: #888;
      text-align: center;
    }
    .ayl-mayoreo-note strong { color: #1a1a1a; }

    @media (max-width: 480px) {
      .ayl-mayoreo-tiers {
        grid-template-columns: repeat(2, 1fr);
      }
      .ayl-mayoreo-tier {
        border-bottom: 1px solid #f0ebe3;
      }
      .ayl-mayoreo-tier:nth-child(2) { border-right: none; }
    }
  </style>

  <div class="ayl-mayoreo-header">
    <svg viewBox="0 0 24 24"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
    <span>Precios de Mayoreo</span>
    <span class="ayl-mayoreo-badge">EXCLUSIVO</span>
  </div>

  <div class="ayl-mayoreo-tiers">
    {% assign base_price = product.price %}

    {% comment %} Tier 1: 4 piezas = 20% off {% endcomment %}
    <div class="ayl-mayoreo-tier" data-tier-min="4">
      <div class="ayl-tier-qty">4 <small>piezas</small></div>
      <div class="ayl-tier-discount">-20%</div>
      <div class="ayl-tier-price">
        <small>{{ base_price | money }}</small>
        {{ base_price | times: 80 | divided_by: 100 | money }} c/u
      </div>
    </div>

    {% comment %} Tier 2: 6 piezas = 30% off {% endcomment %}
    <div class="ayl-mayoreo-tier" data-tier-min="6">
      <div class="ayl-tier-qty">6 <small>piezas</small></div>
      <div class="ayl-tier-discount">-30%</div>
      <div class="ayl-tier-price">
        <small>{{ base_price | money }}</small>
        {{ base_price | times: 70 | divided_by: 100 | money }} c/u
      </div>
    </div>

    {% comment %} Tier 3: 8 piezas = 40% off {% endcomment %}
    <div class="ayl-mayoreo-tier" data-tier-min="8">
      <div class="ayl-tier-qty">8 <small>piezas</small></div>
      <div class="ayl-tier-discount">-40%</div>
      <div class="ayl-tier-price">
        <small>{{ base_price | money }}</small>
        {{ base_price | times: 60 | divided_by: 100 | money }} c/u
      </div>
    </div>

    {% comment %} Tier 4: 12 piezas = 50% off {% endcomment %}
    <div class="ayl-mayoreo-tier best" data-tier-min="12">
      <div class="ayl-tier-qty">12 <small>piezas</small></div>
      <div class="ayl-tier-discount">-50%</div>
      <div class="ayl-tier-price">
        <small>{{ base_price | money }}</small>
        {{ base_price | times: 50 | divided_by: 100 | money }} c/u
      </div>
    </div>
  </div>

  <div class="ayl-mayoreo-note">
    <strong>Mismo producto (las variantes de talla suman).</strong> Compra al mayoreo y ahorra hasta 50%. Solo productos de moda vaquera Diana.
  </div>
</div>
  {% endunless %}
{% endif %}
