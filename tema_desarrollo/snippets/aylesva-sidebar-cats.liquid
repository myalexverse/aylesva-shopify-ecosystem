  {%- assign sidebar_cats = 'Bicicletas|/collections/bicicletas,Bicicletas electricas|/collections/bicicletas-electricas,Patinetas y scooters electricos|/collections/patinetas-y-scooters-electricos,Go-karts|/collections/go-karts,Botes y lanchas|/collections/botes-y-lanchas,Jet skis y motos acuaticas|/collections/jet-skis-y-motos-acuaticas,Casas rodantes y RVs|/collections/casas-rodantes-y-rvs' -%}
{%- elsif col == 'transporte-publico-y-comercial' -%}
  {%- assign sidebar_titulo = 'Transporte Publico y Comercial' -%}
  {%- assign sidebar_back = '<- Vehiculos' -%}
  {%- assign sidebar_back_url = '/collections/vehiculos' -%}
  {%- assign sidebar_cats = 'Autobuses y microbuses|/collections/autobuses-y-microbuses,Taxis y vehiculos de transporte|/collections/taxis-y-vehiculos-de-transporte,Vehiculos de reparto|/collections/vehiculos-de-reparto' -%}
{%- endif -%}

{%- if sidebar_titulo != '' -%}
<style>
  .ayl-sb-back {
    display: block;
    font-size: 0.82rem;
    color: #2e7d32;
    text-decoration: none;
    margin-bottom: 10px;
    font-weight: 700;
  }
  .ayl-sb-back:hover { color: #1b5e20; }
</style>
<div id="shopify-section-sidebar-aylesva" class="shopify-section widget widget_product_categories active">
  <summary class="facets__summary">
    <div>
      <h4 class="widget-title">CATEGORÍAS</h4>
    </div>
  </summary>
  <div class="facets-filter" style="margin-top: 15px;">
    {%- if sidebar_back != '' -%}
      <a class="ayl-sb-back" href="{{ sidebar_back_url }}">{{ sidebar_back }}</a>
    {%- endif -%}
    <ul class="product-categories dt-sc-toggle-frame-set">
      {%- assign cat_items = sidebar_cats | split: ',' -%}
      {%- for item in cat_items -%}
        {%- assign parts = item | split: '|' -%}
        {%- assign cat_name = parts[0] -%}
        {%- assign cat_url  = parts[1] -%}
        {%- assign cat_handle = cat_url | split: '/collections/' | last | split: '?' | first -%}
        {%- assign cat_count = collections[cat_handle].all_products_count -%}
        <li class="cat-item">
          <a href="{{ cat_url }}" class="{%- if collection.url == cat_url %} active{%- endif -%}">
            {{ cat_name }} {% if cat_count != blank %}({{ cat_count }}){% endif %}
          </a>
        </li>
      {%- endfor -%}
    </ul>
    {%- if sidebar_back_url != '' -%}
      <a href="{{ sidebar_back_url }}" class="ayl-see-more-link">Ver todas</a>
    {%- else -%}
      <a href="/collections/all" class="ayl-see-more-link">Ver todas</a>
    {%- endif -%}
  </div>
</div>
{%- endif -%}