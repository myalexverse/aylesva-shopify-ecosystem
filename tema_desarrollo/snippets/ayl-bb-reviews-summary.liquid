<div class="ayl-bb-reviews-summary">
  
  {% comment %} 1. CALIFICACIÓN GIGANTE {% endcomment %}
  <div class="ayl-bb-rating-big">
    4.8
    <span>Basado en 124 reseñas</span>
    <div class="ayl-bb-stars" style="margin-top: 10px; justify-content: center; display: flex;">
      <i class="mdi mdi-star"></i><i class="mdi mdi-star"></i><i class="mdi mdi-star"></i><i class="mdi mdi-star"></i><i class="mdi mdi-star"></i>
    </div>
  </div>

  {% comment %} 2. BARRAS DE DISTRIBUCIÓN {% endcomment %}
  <div class="ayl-bb-bars">
    <div class="ayl-bb-bar-row">
      <span>5 estrellas</span>
      <div class="ayl-bb-bar-bg"><div class="ayl-bb-bar-fill" style="width: 85%;"></div></div>
      <span class="ayl-bb-bar-count">105</span>
    </div>
    <div class="ayl-bb-bar-row">
      <span>4 estrellas</span>
      <div class="ayl-bb-bar-bg"><div class="ayl-bb-bar-fill" style="width: 10%;"></div></div>
      <span class="ayl-bb-bar-count">12</span>
    </div>
    <div class="ayl-bb-bar-row">
      <span>3 estrellas</span>
      <div class="ayl-bb-bar-bg"><div class="ayl-bb-bar-fill" style="width: 3%;"></div></div>
      <span class="ayl-bb-bar-count">4</span>
    </div>
    <div class="ayl-bb-bar-row">
      <span>2 estrellas</span>
      <div class="ayl-bb-bar-bg"><div class="ayl-bb-bar-fill" style="width: 1%;"></div></div>
      <span class="ayl-bb-bar-count">2</span>
    </div>
    <div class="ayl-bb-bar-row">
      <span>1 estrella</span>
      <div class="ayl-bb-bar-bg"><div class="ayl-bb-bar-fill" style="width: 1%;"></div></div>
      <span class="ayl-bb-bar-count">1</span>
    </div>
  </div>

  {% comment %} 3. PORCENTAJE DE RECOMENDACIÓN {% endcomment %}
  <div class="ayl-bb-recommend-percent hidden-xs">
    <div class="ayl-bb-percent-num">98%</div>
    <p>de los clientes recomendarían este producto.</p>
  </div>

</div>

<div class="ayl-bb-verified-info">
  <div class="ayl-bb-verified-badge">
    <i class="mdi mdi-check-decagram"></i> Compradores Verificados
  </div>
  <p style="font-size: 13px; color: var(--bb-text-muted); margin-bottom: 20px;">
    Nuestras reseñas provienen de personas reales que han comprado el producto.
  </p>
</div>
