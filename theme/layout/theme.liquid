<!-- AYLESVA MX — Colección navega directo al seleccionar -->
<script>
(function() {
  function initCollectionSelect() {
    // Buscar el select de colecciones en el buscador
    var selects = document.querySelectorAll(
      'select[name="type"], .search-bar select, .search__select, ' +
      'select.collection-select, select[data-type="collection"], ' +
      'header select, .site-header select'
    );

    selects.forEach(function(sel) {
      if (sel.dataset.aylFixed) return;
      sel.dataset.aylFixed = '1';

      sel.addEventListener('change', function() {
        var val = this.value;
        if (!val || val === '' || val === 'product') return;

        // Si el valor es un handle de colección, navegar directo
        if (val.indexOf('/collections/') === 0) {
          window.location.href = val;
        } else if (val !== 'article' && val !== 'page') {
          window.location.href = '/collections/' + val;
        }
      });
    });
  }

  // Ejecutar cuando carga la página
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCollectionSelect);
  } else {
    initCollectionSelect();
  }

  // También observar cambios dinámicos con Debounce para evitar bloqueos (Freeze)
  var aylMutationTimeout;
  var observer = new MutationObserver(function() {
    clearTimeout(aylMutationTimeout);
    aylMutationTimeout = setTimeout(function() {
      initCollectionSelect();
    }, 300); // Esperar 300ms de calma antes de ejecutar
  });
  observer.observe(document.body, { childList: true, subtree: true });
})();
</script>

