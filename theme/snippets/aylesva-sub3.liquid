{% if sub3 != '' %}
<style>
  #ayl-sub3-wrap {
    margin: 0 0 28px;
  }
  .ayl-sub3-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
    padding-bottom: 10px;
    border-bottom: 2px solid {{ sub3_color }};
  }
  .ayl-sub3-header h3 {
    font-size: 1rem;
    font-weight: 700;
    color: #222;
    margin: 0;
  }
  .ayl-sub3-badge {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    background: {{ sub3_color }};
    color: #fff;
    padding: 3px 10px;
    border-radius: 50px;
  }
  .ayl-sub3-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 10px;
    margin-bottom: 28px;
  }
  .ayl-sub3-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 11px 14px;
    background: #fff;
    border: 1.5px solid #e8e8e8;
    border-radius: 8px;
    text-decoration: none;
    color: #333;
    font-size: 0.85rem;
    font-weight: 600;
    transition: all .15s;
    line-height: 1.3;
  }
  .ayl-sub3-card:hover {
    border-color: {{ sub3_color }};
    color: {{ sub3_color }};
    background: #fafafa;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(0,0,0,.08);
  }
  .ayl-sub3-arrow {
    font-size: 0.75rem;
    opacity: 0;
    transition: opacity .15s;
    flex-shrink: 0;
    margin-left: 6px;
  }
  .ayl-sub3-card:hover .ayl-sub3-arrow { opacity: 1; }
  .ayl-sub3-divider {
    height: 1px;
    background: #eee;
    margin: 0 0 24px;
  }
  @media (max-width: 600px) {
    .ayl-sub3-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

<div id="ayl-sub3-wrap">
  <div class="ayl-sub3-header">
    <h3>Subcategorías de {{ sub3_titulo }}</h3>
    <span class="ayl-sub3-badge">Explorar</span>
  </div>
  <div class="ayl-sub3-grid">
    {% assign items = sub3 | split: ',' %}
    {% for item in items %}
      {% assign parts = item | split: '|' %}
      <a class="ayl-sub3-card" href="{{ parts[1] }}">
        <span>{{ parts[0] }}</span>
        <span class="ayl-sub3-arrow">→</span>
      </a>
    {% endfor %}
  </div>
  <div class="ayl-sub3-divider"></div>
</div>
{% endif %}
