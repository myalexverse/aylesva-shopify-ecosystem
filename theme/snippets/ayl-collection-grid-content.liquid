<header class="ayl-modern-header" style="display: none !important;">
  <style>
    .ayl-modern-header { margin-bottom: 30px; margin-top: -110px; } /* Maximum pull up */
    .ayl-col-title-wrap { border-left: 6px solid #000; padding-left: 25px; margin-bottom: 35px; }
    .ayl-col-title-wrap h1 { font-size: 42px; font-weight: 900; text-transform: uppercase; letter-spacing: -1px; margin: 0; color: #000; line-height: 1; }
    .ayl-col-title-wrap .description { font-size: 14px; color: #777; margin-top: 15px; max-width: 900px; line-height: 1.8; }
    
    .ayl-col-toolbar { 
      display: flex; 
      justify-content: space-between; 
      align-items: center; 
      padding: 25px 0px; 
      border-bottom: 1px solid #000;
      margin-top: 20px;
    }
    .ayl-toolbar-left { font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 2.5px; color: #bbb; }
    .ayl-toolbar-left b { color: #000; }
    .ayl-toolbar-right { display: flex; align-items: center; gap: 30px; }
    .ayl-sort-label { font-size: 11px; font-weight: 800; text-transform: uppercase; color: #bbb; letter-spacing: 1.5px; }
    .ayl-sort-select { border: none; background: transparent; font-size: 11px; font-weight: 900; cursor: pointer; outline: none; text-transform: uppercase; color: #000; letter-spacing: 1.5px; }
    
    /* CLEAN SIDEBAR (No bullets, more air) */
    .sidebar-block, .widget_product_categories, .facets__disclosure { list-style: none !important; }
    .sidebar-block li { list-style: none !important; }
    .sidebar-block ul { padding-left: 0 !important; list-style: none !important; }
    
    .widget-title { 
      background: transparent !important; 
      color: #000 !important; 
      text-transform: uppercase !important; 
      font-size: 15px !important; 
      font-weight: 900 !important; 
      letter-spacing: 3px !important;
      padding: 0 0 0 18px !important;
      border-left: 5px solid #000 !important;
      border-radius: 0 !important;
      margin-bottom: 30px !important;
      line-height: 1 !important;
      display: block !important;
    }
    
    .widget, .sidebar-block > div { margin-bottom: 55px !important; } /* More space between widgets */
    
    /* BUTTON CONGRUENCE */
    .active-facets__button-remove, .facets__button-no-js, .button-primary, #shopify-section-sidebar-tag-filters .btn, .sidebar-block .btn {
      background: #000 !important;
      color: #fff !important;
      border-radius: 0 !important;
      text-transform: uppercase !important;
      font-weight: 900 !important;
      letter-spacing: 3px !important;
      border: none !important;
      padding: 16px 35px !important;
      font-size: 11px !important;
      transition: all 0.3s ease;
    }
    
    .active-facets__button-remove:hover { opacity: 0.8; transform: translateY(-2px); }
    
    /* ALIGNMENT FIX */
    .left-sidebar { padding-top: 130px !important; } /* Push sidebar down below title level */
    .left-sidebar .collection_right { padding-left: 20px; }
    .products-grid-view { margin-top: 0px; }
  </style>

  <div class="ayl-col-title-wrap">
    {% if search.performed %}
      <h1>Resultados para: "{{ search.terms }}"</h1>
    {% else %}
      <h1>{{ results.title }}</h1>
    {% endif %}
    {% if results.description != blank %}
      <div class="description">{{ results.description }}</div>
    {% endif %}
  </div>

  <div class="ayl-col-toolbar">
    <div class="ayl-toolbar-left">
      <span>{{ results.results_count | default: results.products_count }} artículos encontrados</span>
    </div>
    
    <div class="ayl-toolbar-right">
      {% if settings.collection_sort_enable %}
        <div class="ayl-sort-wrap">
          <span class="ayl-sort-label">Ordenar por:</span>
          {%- assign sort_by = results.sort_by | default: results.default_sort_by -%}
          <select name="sort_by" class="ayl-sort-select" onchange="location.href='?sort_by=' + this.value">
            {%- for option in results.sort_options -%}
              <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>
            {%- endfor -%}
          </select>
        </div>
      {% endif %}
    </div>
  </div>
</header>

<div class="grid-uniform product-grid col-main">
  <div class="row">
    <div class="products-grid-view">
      {% case products_per_row %}
        {% when '2' %}
          {% assign grid_item_width = 'medium-up--one-third large-up--one-half' %}
        {% when '3' %}
          {% assign grid_item_width = 'medium-up--one-third large-up--one-third' %}
        {% when '4' %}
          {% assign grid_item_width = 'medium-up--one-third large-up--one-quarter' %}
        {% when '5' %}
          {% assign grid_item_width = 'medium-down--one-half large-up--one-fifth' %}
        {% when '6' %}
          {% assign grid_item_width = 'medium-down--one-half large-up--one-sixth' %}
      {% endcase %}
      
      {% assign items = results.products | default: results.results %}
      
      {% assign product_count = 0 %}
      {% for product in items -%}
        {%- if product.object_type == 'article' or product.object_type == 'page' %}{% continue %}{% endif %}
        {%- if product.type == 'PPLR_HIDDEN_PRODUCT' %}{% continue %}{% endif %}
        {% assign product_count = product_count | plus: 1 %}
        <div class="grid-item {{ settings.product_hover_btn }} {{ grid_item_width }} {{product.type}}">
          {% render 'ayl-product-card-grid', collection: results, product: product, grid_item_width: grid_item_width %}
        </div>
        
        {% if product_count == 8 %}
          {% if results.handle == 'ropa-hombre' or results.handle == 'hombre' or results.handle == 'ropa-mujer' or results.handle == 'mujer' or results.handle == 'calzado-hombre' or results.handle == 'calzado-mujer' or results.handle == 'ropa-nino' or results.handle == 'nino' or results.handle == 'ropa-nina' or results.handle == 'nina' or results.handle == 'ropa-bebe' or results.handle == 'bebe' %}
            {%- assign promo_banner_image = "aylesva-western-promo.png" -%}
            {%- assign promo_banner_url = "/collections/ropa-hombre" -%}
            {%- if results.handle == 'ropa-mujer' or results.handle == 'mujer' -%}
              {%- assign promo_banner_image = "aylesva-western-promo-mujer.png" -%}
              {%- assign promo_banner_url = "/collections/ropa-mujer" -%}
            {%- elsif results.handle == 'calzado-hombre' -%}
              {%- assign promo_banner_image = "aylesva-western-promo-calzado-hombre.png" -%}
              {%- assign promo_banner_url = "/collections/calzado-hombre" -%}
            {%- elsif results.handle == 'calzado-mujer' -%}
              {%- assign promo_banner_image = "aylesva-western-promo-calzado-mujer.png" -%}
              {%- assign promo_banner_url = "/collections/calzado-mujer" -%}
            {%- elsif results.handle == 'ropa-nino' or results.handle == 'nino' -%}
              {%- assign promo_banner_image = "aylesva-western-promo-ropa-nino.png" -%}
              {%- assign promo_banner_url = "/collections/ropa-nino" -%}
            {%- elsif results.handle == 'ropa-nina' or results.handle == 'nina' -%}
              {%- assign promo_banner_image = "aylesva-western-promo-ropa-nina.png" -%}
              {%- assign promo_banner_url = "/collections/ropa-nina" -%}
            {%- elsif results.handle == 'ropa-bebe' or results.handle == 'bebe' -%}
              {%- assign promo_banner_image = "aylesva-western-promo-ropa-bebe.png" -%}
              {%- assign promo_banner_url = "/collections/ropa-bebe" -%}
            {%- endif -%}
            <div class="col-xs-12 col-sm-12 ayl-grid-promo-banner-wrap" style="width: 100%; padding: 15px 8px; box-sizing: border-box; clear: both;">
              <style>
                .ayl-grid-promo-banner {
                  position: relative;
                  width: 100%;
                  height: 280px;
                  background-image: url('{{ promo_banner_image | asset_url }}');
                  background-size: cover;
                  background-position: center;
                  border-radius: 8px;
                  overflow: hidden;
                  display: flex;
                  align-items: center;
                  padding: 40px;
                  box-sizing: border-box;
                }
                .ayl-grid-promo-banner::after {
                  content: '';
                  position: absolute;
                  inset: 0;
                  background: linear-gradient(90deg, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.2) 60%, rgba(0,0,0,0) 100%);
                  z-index: 1;
                }
                .ayl-promo-banner-content {
                  position: relative;
                  z-index: 2;
                  max-width: 480px;
                  color: #ffffff;
                  text-align: left;
                }
                .ayl-promo-banner-tag {
                  font-size: 11px;
                  font-weight: 800;
                  color: #C5A47E;
                  text-transform: uppercase;
                  letter-spacing: 1.5px;
                  margin-bottom: 8px;
                  display: block;
                }
                .ayl-promo-banner-title {
                  font-size: 28px;
                  font-weight: 900;
                  text-transform: uppercase;
                  margin: 0 0 10px;
                  line-height: 1.2;
                  color: #ffffff;
                }
                .ayl-promo-banner-desc {
                  font-size: 13px;
                  color: rgba(255,255,255,0.9);
                  margin: 0 0 20px;
                  line-height: 1.5;
                }
                .ayl-promo-banner-btn {
                  display: inline-flex;
                  align-items: center;
                  gap: 8px;
                  background: #C5A47E;
                  color: #ffffff;
                  text-decoration: none;
                  padding: 10px 20px;
                  border-radius: 4px;
                  font-size: 12px;
                  font-weight: 700;
                  text-transform: uppercase;
                  transition: background 0.3s ease;
                }
                .ayl-promo-banner-btn:hover {
                  background: #b08d65;
                  color: #ffffff;
                }
              </style>
              {%- assign promo_bg_position = "center" -%}
              {%- if results.handle == 'calzado-mujer' or results.handle == 'calzado-hombre' -%}
                {%- assign promo_bg_position = "bottom" -%}
              {%- endif -%}
              <div class="ayl-grid-promo-banner" style="background-position: {{ promo_bg_position }} !important;">
                <div class="ayl-promo-banner-content">
                  <span class="ayl-promo-banner-tag">Colección Western Premium</span>
                  <h3 class="ayl-promo-banner-title">Estilo que impone<br>tradición que permanece.</h3>
                  <p class="ayl-promo-banner-desc">Descubre nuestras prendas más exclusivas con la mejor calidad.</p>
                  <a href="{{ promo_banner_url }}" class="ayl-promo-banner-btn">Ver selección <span style="font-size: 14px;">&rarr;</span></a>
                </div>
              </div>
            </div>
          {% endif %}
        {% endif %}
      {% else %}
        <div class="grid-item">
          <p>{{ 'collections.general.no_matches' | t }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<div class="ayl-bottom-trust-bar hidden-xs" style="width: 100%; border-top: 1px solid #eaeaea; border-bottom: 1px solid #eaeaea; padding: 25px 0; margin: 30px 0; display: flex; justify-content: space-around; box-sizing: border-box; background: #ffffff; border-radius: 6px; clear: both;">
  <style>
    .ayl-bottom-trust-item {
      display: flex;
      align-items: center;
      gap: 12px;
      flex: 1;
      padding: 0 15px;
      border-right: 1px solid #eaeaea;
    }
    .ayl-bottom-trust-item:last-child {
      border-right: none;
    }
    .ayl-bottom-trust-icon {
      color: #C5A47E;
      flex-shrink: 0;
    }
    .ayl-bottom-trust-icon svg {
      width: 28px;
      height: 28px;
      stroke-width: 1.5;
    }
    .ayl-bottom-trust-text {
      text-align: left;
    }
    .ayl-bottom-trust-title {
      font-size: 13px;
      font-weight: 800;
      color: #1c1c1e;
      text-transform: uppercase;
      margin: 0 0 3px;
      letter-spacing: 0.5px;
    }
    .ayl-bottom-trust-desc {
      font-size: 11px;
      color: #71717a;
      margin: 0;
      line-height: 1.3;
    }
  </style>
  <div class="ayl-bottom-trust-item">
    <div class="ayl-bottom-trust-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
        <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
        <line x1="12" y1="22.08" x2="12" y2="12"></line>
      </svg>
    </div>
    <div class="ayl-bottom-trust-text">
      <h4 class="ayl-bottom-trust-title">Precios mayoristas</h4>
      <p class="ayl-bottom-trust-desc">Obtén ganancias reales con nuestros precios especiales.</p>
    </div>
  </div>
  <div class="ayl-bottom-trust-item">
    <div class="ayl-bottom-trust-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
        <polyline points="22 4 12 14.01 9 11.01"></polyline>
      </svg>
    </div>
    <div class="ayl-bottom-trust-text">
      <h4 class="ayl-bottom-trust-title">Productos verificados</h4>
      <p class="ayl-bottom-trust-desc">Todas nuestras prendas pasan por control de calidad.</p>
    </div>
  </div>
  <div class="ayl-bottom-trust-item">
    <div class="ayl-bottom-trust-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <rect x="1" y="3" width="15" height="13" rx="2" ry="2"></rect>
        <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
        <circle cx="5.5" cy="18.5" r="2.5"></circle>
        <circle cx="18.5" cy="18.5" r="2.5"></circle>
      </svg>
    </div>
    <div class="ayl-bottom-trust-text">
      <h4 class="ayl-bottom-trust-title">Envíos rápidos</h4>
      <p class="ayl-bottom-trust-desc">Entregas seguras en todo México.</p>
    </div>
  </div>
  <div class="ayl-bottom-trust-item">
    <div class="ayl-bottom-trust-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
      </svg>
    </div>
    <div class="ayl-bottom-trust-text">
      <h4 class="ayl-bottom-trust-title">Asesoría personalizada</h4>
      <p class="ayl-bottom-trust-desc">Te ayudamos a elegir los mejores productos.</p>
    </div>
  </div>
</div>

{% if paginate.pages > 1 %}
  {% render 'aylesva-premium-pagination', paginate: paginate %}
{% endif %}
