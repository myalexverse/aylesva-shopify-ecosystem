}
.search-products .text--left.section-header__title {
  font-size: 26px;
  line-height: 34px;
  font-weight: 400;
  float: left;
  width: 100%;
  color: $colorTitle;
  @include at-query ($max, $tablet){
    font-size: 20px;
    line-height: 30px;
  }
}
/*-------------- product-layout css -------------*/
.product-layouts {
  float:left;
  width:100%;
  display: inline-block;
  padding:0 15px;
}
.product-tab .product-tab-type-1 .grid__item {
  float: left;
  width: 100%;
  position: relative;
  padding: 30px 30px 0;
  @include border-radius(8px);
  @include at-query ($max, $postlaptop){
    padding: 15px 15px 0px;
  }
}
.product-wrapper {
  position: relative;
  text-align: center;
  margin-bottom: 0;
  float:left;
  width:100%;
  margin:10px 0 20px;
}
.product-wrapper .product-description-wrap {
  float: left;
  width: 100%;
}
.product-wrapper .product-description .grid-view-item__vendor {
  font-size: 12px;
  text-transform: uppercase;
}
.product-wrapper .product-description .grid-view-item__vendor {
  font-size: 12px;
  text-transform: uppercase;
}
.product-wrapper:hover {
  z-index: 20;
}
.product-wrapper .product-image a.grid-view-item__link {
  float: left;
  width: 100%;
  position: relative;
  @include border-radius(8px);
  overflow:hidden;
  font-weight:600;
  color:$colorBtnSecondary;
}
.grid-view-item .thumbs.product-thumb,
.products-grid-view .product-grid .product-thumb,
#recently-viewed-products .product-thumb{
  float: left;
  position: relative;
  width:100%;
  padding:0;
  overflow:hidden;
  @include border-radius(8px);
}
.product-layouts .fade_img {
  overflow: hidden;
  padding:0;
}
.product-thumb .fade_img img.image_thumb_swap {
  left: 0;
  @include opacity(0);
  position: absolute;
  right: 0;
  top: 0;
  @include transition('all 500ms ease-in-out 0s');
  margin: auto;
  bottom:0;
}
.product-thumb .fade_img img.image_thumb {
  @include opacity(1);
  @include transition('all 500ms ease-in-out 0s');
}
.product-price__sale-label {
  color: lighten($colorTitle,40%);
  font-size:13px;
  float:right;
  position:absolute;
  left:0;
  top:10px;
  right:auto;
  bottom:auto;
  line-height:16px;
  @include opacity(0);
  @include transition('400ms ease-in-out');
  @include at-query ($max, $tablet){
    @include opacity(1);
    top:35px;
  }
}
.product-wrapper .custom_lable {
  color: lighten($colorTitle,40%);
  font-size: 13px;
  line-height: 16px;
  float:left;
  position:absolute;
  left:15px;
  top:-10px;
  right:auto;
  bottom:auto;
  @include opacity(0);
  @include transition('400ms ease-in-out');
  @include at-query ($max, $tablet){
    @include opacity(1);
    top:15px;
  }
}
.product-wrapper:hover .custom_lable {
  @include opacity(1);
  top:15px;
}
.product-wrapper:hover .product-price__sale-label{
  @include opacity(1);
  top:35px;
}
.owl-carousel .product-description, .grid-item.product-grid .product-description,
#recently-viewed-products .product-wrapper .product-description,
.search-products .grid-view-item.product-layouts .product-wrapper .product-description, 
.collections_masonry .grid-item.ms-item .product-wrapper .product-description {
  padding: 10px;
  text-align: center;
  width: 100%;
  position:relative;
  float:left;
}
.ttimg-bg {
  background: #fff;
  @include border-radius(8px);
  @include box-shadow(0 0 10px rgba(0, 0, 0, 0.15));
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  top: 0;
  margin-bottom: 0;
  @include opacity(0);
  @include transform(scale(0.98));
  @include transition('all 0.3s ease 0s');
  z-index: -1;
  margin-bottom: -60px;
  visibility: hidden;
  @include at-query ($max, $tablet){
    display:none;
  }
}
.product-wrapper:hover .ttimg-bg {
  @include opacity(1);
  @include transform(scale(1));
  @include transition('opacity 0.3s ease 0s, visibility 0s ease 0s, transform 0.3s ease 0s, -webkit-transform 0.3s ease 0s');
  visibility: visible;
}
.product-description .h4 {
  font-weight: 400;
  font-size:13px;
  line-height:18px;
  overflow: hidden;
  margin: 0px;
  padding: 7px 0;
  float: left;
  width:100%;
  text-overflow: ellipsis;
}
a.grid-link__title {
  font-size: 14px;
  line-height:18px;
  font-weight: 400;
  white-space: nowrap;
  font-family:$ternaryFontStack,sans-serif;
}
.product-wrapper:hover a.grid-link__title,.product-wrapper:hover .thumb-description h4 a{
  color: $colorLinkHover;
}
.product-description .grid-view-item__meta {
  display: inline-block;
  width: 100%;
  margin: 0;
}
.grid-view-item .visually-hidden {
  display: none;
}
.product-price__price,.product-price__price .money,.price,price .money{
  font:600 16px/18px $primaryFontStack, Helvetica,sans-serif;
  color: $colorPrice;
}
.product-price__price.compare_price .money,.product-price__price.compare_price{
  font:400 12px/16px $primaryFontStack, Helvetica,sans-serif;
  color:$colorTextBody;
}
.discount-percentage {
  color: #fff;
  font-size: 12px;
  font-weight: 600;
  line-height: 40px;
  padding: 0 3px;
  vertical-align:middle;
  position: absolute;
  right:-15px;
  left:auto;
  top:45px;
  height:40px;	
  width:40px;
  @include border-radius(50%);
  background:#FF4141;
  @include opacity(0);
  text-align:center;
  @include transition('400ms ease-in-out');
  @include at-query ($max, $tablet){
    @include opacity(1);
    right:12px;
  }
}
.product-wrapper:hover .discount-percentage {
  right:12px;
  @include opacity(1);
}
.product-wrapper .ttqtyprogress {
  display: none;
}
.product-wrapper .product-description .ttqtyprogress {
  float: left;
  width: 100%;
  padding: 10px 0 0;
  text-align:left;
}
.product-wrapper .product-description .ttqtyprogress span.QuantityAvailable {
  color: #000;
}
.product-wrapper .product-description .ttqtyprogress span.quantity {
  font-weight: 400;
  color: #000;
}
.product-wrapper .product-description .ttqtyprogress .progress {
  margin: 5px 0 0 0;
  height: 10px;
  @include border-radius(25px);
  width: 100%;
  float: left;
  background: #f5f5f5;
  @include box-shadow(none);
}
.product-wrapper .product-description .ttqtyprogress .progress-bar {
  @include box-shadow(none);
  background:#fed700;
}
/*============================================================================
#Rich Text Editor
==============================================================================*/
.rte {
  margin-bottom: $gutter / 2;
  line-height: 1.7;
  color: $colorTextBody;
  // Add some top margin to headers from the rich text editor
  h1, h2, h3, h4, h5, h6 {
    margin-top: 1em;
    color: $colorTitle;

    &:first-child {
      margin-top: 0;
    }
  }
  h3 {
    font-size: em(18px);
  }
  & > div {
    margin-bottom: $gutter / 2;
  }
  ul, ol {
    margin-left: 35px;
  }
  &.text-center, .text-center & {
    ul, ol {
      margin-left: 0;
      list-style-position: inside;
    }
  }
  ul {
    @extend ul.disc;
    ul {
      list-style-type: circle;
      ul {
        @extend ul.square;
      }
    }
  }
  li {
    margin-bottom: 0.4em;
  }
  img {
    max-width: 100%;
    height: auto;
  }
  @include at-query ($min, $large) {
    .banner-img {
      width: 120%;
      max-width: 120%;
      margin-left: -10%;
      margin-right: -10%;
    }
    img:not([style]){
      display: block;
      margin: 0 auto;
    }
  }
  table {
    table-layout: fixed;
  }
}
.rte-header {
  margin-bottom: 0;
}
/*============================================================================
#Links and Buttons
==============================================================================*/
a {
  color: $colorLink;
  background: transparent;
  text-decoration: none;
}
a:hover,
a:focus {
  color: $colorLinkHover;
  outline:none !important;
}
button {
  overflow: visible;
}
button[disabled],
html input[disabled] {
  cursor: default;
}
.btn {
  background-color: $colorBtnPrimary;
  color: $colorBtnText;
  border: none;
  cursor: pointer;
  display: inline-block;
  font-weight: 400;
  font-family: $primaryFontStack,sans-serif;
  line-height: 1.42;
  margin: 0;
  padding: 10px 20px;
  position:relative;
  overflow:hidden;
  text-align: center;
  vertical-align: middle;
  white-space: nowrap;
  -webkit-appearance: none;
  -moz-appearance: none;
  @include prefix('user-select', 'none');
  @include border-radius(25px);
  &:hover {
    background-color: $colorBtnSecondaryHover;
    color: $colorBtnHoverText;
  }
  &:active,
  &:focus {
    background-color: $colorBtnSecondaryHover;
    color: $colorBtnHoverText;
  }
  &[disabled],
  &.disabled {
    cursor: default;
    color: $disabledBorder;
    background-color: $disabledGrey;
  }
}
.btn-primary.disabled,
.btn-primary.disabled.active,
.btn-primary.disabled.focus,
.btn-primary.disabled:active,
.btn-primary.disabled:focus,
.btn-primary.disabled:hover,
.btn-primary[disabled],
.btn-primary[disabled].active,
.btn-primary[disabled].focus,
.btn-primary[disabled]:active,
.btn-primary[disabled]:focus,
.btn-primary[disabled]:hover,
fieldset[disabled] .btn-primary,
fieldset[disabled] .btn-primary.active,
fieldset[disabled] .btn-primary.focus,
fieldset[disabled] .btn-primary:active,
fieldset[disabled] .btn-primary:focus,
fieldset[disabled] .btn-primary:hover {
  background-color: $colorBtnSecondaryHover;
  border-color: $colorBtnSecondaryHover;
  color: $colorBtnHoverText;
}
.btn--secondary,
input.btn--secondary {
  @extend .btn;

  &:hover {
    background-color: $colorBtnSecondaryHover;
    color: $colorBtnHoverText;
  }
  &:active,
  &:focus {
    background-color: $colorBtnSecondaryHover;
    color: $colorBtnHoverText;
  }
}
.btn--small {
  padding: 4px 5px;
  font-size: em(12px);
}
.btn--large {
  padding: 12px 15px;
  font-size: em(16px);
}
.btn--full {
  width: 100%;
  white-space: normal;
}
@-moz-keyframes fillToRight {
  /* line 578, ../sass/global.scss */
  to {
    width: 100%;
  }
}

@keyframes fillToRight {
  /* line 584, ../sass/global.scss */
  to {
    width: 100%;
  }
}
.btn::after,.template-index .nav-tabs > li > a::after,.clearfix.paginatoin_custom.blog_nav .left a::after,.clearfix.paginatoin_custom.blog_nav .right a::after,#comment_form .grid-item input.text-center[type="submit"]::after,.full-header .topmenu .site-nav li > a::before{
  background: #fff none repeat scroll 0 0;
  content: "";
  height: 100%;
  left: 0;
  opacity: 0.2;
  position: absolute;
  top: 0;
  width: 0;
  @include border-radius(22px);
}
#tt-megamenu span.toggle_menu::after {
  @include border-radius(8px);
}
.btn:hover::after, .template-index .nav-tabs > li > a:hover::after,.clearfix.paginatoin_custom.blog_nav .left a:hover::after, .clearfix.paginatoin_custom.blog_nav .right a:hover::after,#comment_form .grid-item input.text-center[type="submit"]:hover::after,.full-header .topmenu .site-nav li > a:hover::before,#tt-megamenu span.toggle_menu:hover::after{
  animation: 0.6s ease 0s normal forwards 1 running fillToRight;
}
/*================ Force an input/button to look like a text link ================*/
.text-link {
  display: inline;
  border: 0 none;
  background: none;
  padding: 0;
  margin: 0;
}
/*============================================================================
#Lists
==============================================================================*/
ul, ol {
  margin: 0 0 $gutter;
  padding: 0;
}
ul { list-style: none outside; }
ol { list-style: decimal; }
ul ul, ul ol,
ol ol, ol ul { margin: 4px 0 5px 20px; }
li { margin-bottom: 0.25em; }
ol, ul.square, ul.disc { margin-left: 20px; }
ul.square { list-style: square outside; }
ul.disc { list-style: disc outside; }
ol.alpha { list-style: lower-alpha outside; }
.inline-list li {
  display: inline-block;
  margin-bottom: 0;
}
/*============================================================================
#Tables
==============================================================================*/
table {
  border: $borderWidth solid $colorBorder;
  border-collapse: collapse;
  border-spacing: 0;
  width: 100%;
  p {
    margin-bottom: 0;
  }
}
table.full {
  width: 100%;
  margin-bottom: 1em;
}
th {
  font-weight: bold;
}
th, td {
  text-align: left;
  padding: $gutter / 2;
  border: 1px solid $colorBorder;
}
/*============================================================================
#Images and Iframes
==============================================================================*/
svg:not(:root) {
  overflow: hidden;
}
img.auto,
.grid-item img,
.grid-item iframe {
  max-width: 100%;
}
.video-wrapper {
  position: relative;
  overflow: hidden;
  max-width: 100%;
  padding-bottom: 56.25%;
  height: 0;
  height: auto;

  iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }
}
.site-nav li .grid-item {
  float:none;
  padding:0;
}
/*============================================================================
#Forms
==============================================================================*/
::-webkit-input-placeholder {
  color: $colorTextBody;

}
:-moz-placeholder { /* Firefox 18- */
  color: $colorTextBody;

}
::-moz-placeholder {  /* Firefox 19+ */
  color: $colorTextBody;

}
:-ms-input-placeholder {
  color: $colorTextBody;

}
::-ms-input-placeholder { /* Edge 12+ */
  color: $colorTextBody;
  opacity: 1;
}
form {
  margin: 0 0 ($gutter / 2);
}
select {
  font-size: em(12px);
}
button,
input[type="text"],
input[type="search"],
input[type="password"],
input[type="email"],
input[type="file"],
input[type="number"],
input[type="tel"],
input[type="submit"],
textarea {
  -webkit-appearance: none;
  -moz-appearance: none;
}
input[type="text"]:active, input[type="text"]:focus {
  background: #fcfcfc;
}
input,
textarea,
select,
fieldset {
  max-width: 100%;

  &.input-full {
    width: 100%;
  }
}
input,
select,
textarea {
  padding: ($gutter / 2) ($gutter * 0.45);
  line-height: 1.42;
}
input {
  padding: 12px 10px;
}
fieldset {
  border: $borderWidth solid $colorBorder;
  padding: $gutter / 2;
}
legend {
  border: 0;
  padding: 0;
}
optgroup {
  font-weight: bold;
}
input {
  display: inline-block;
  width: auto;
}
button,
input[type="submit"] {
  cursor: pointer;
}
input[type="submit"] {
  @extend .btn;
}
/*================ Input width and border ================*/
input[type="text"],
input[type="search"],
input[type="password"],
input[type="email"],
input[type="file"],
input[type="number"],
input[type="tel"],
textarea {
  background-color: $colorBody;
  color: #000;
  border: $borderWidth solid $colorBorder;
  width: 100%;
  max-width: 100%;
  display: block;
  margin: 0 0 1em;
  @include border-radius(8px);

  .input-group & {
    border: 0;
    border-right: 1px solid $colorBorder;
  }
  &:focus, &:active{
    border: inherit solid darken($colorBorder, 10%);
    background: #fcfcfc;
  }
  &[disabled],
  &.disabled {
    cursor: default;
    background-color: $disabledGrey;
    border-color: $disabledBorder;
  }
}
textarea {
  min-height: 100px;
}
input[type="checkbox"],
input[type="radio"] {
  display: inline;
  margin: 0;
  padding: 0;
}
select {
  -webkit-appearance: none;
  -moz-appearance: none;
  appearance: none;
  background-position: right center;
  background: {
    image: url($selectIcon);
    repeat: no-repeat;
    position: right 10px center;
    size: 6px;
    color: $colorBody;
  }
  padding-right: 28px;
  text-indent: 0.01px;
  text-overflow: '';
  cursor: pointer;
  /*================ Hide the svg arrow in IE9 and below ================*/
  .ie9 &,
  .lt-ie9 & {
    background-image: none;
    padding-right: 10px;
  }
}
select::-ms-expand {
  display: none;
}
select{
  background-color: #fff;
  color: $colorTextBody;
  border: $borderWidth solid $colorBorder;
  width: 100%;
  max-width: 100%;
  display: block;
}
/*================ Form labels ================*/
label,
legend {
  color: $colorTextBody;
  display: inline-block;
  margin-bottom: 2px;
  font-family: $primaryFontStack,sans-serif;
  font-size: em(12px);
  font-weight: bold;

  &.inline {
    display: inline;
  }
}
/*================ Accessible labels ====================*/
.visuallyhidden {
  @include visuallyHidden;
}
/*================ Off-screen labels with placeholder ================*/
.form-label--hidden {
  display: inline;  // reset margins and helps FF deal with the input on a SR
  .ie9 &,
  .lt-ie9 & {
    .visuallyhidden {
      clip: auto;
      height: auto;
      margin: 0;
      overflow: visible;
      position: static;
      width: auto;
    }
  }
}
/*================ We don't want the same label treatment for checkboxes/radios ================*/
input[type="checkbox"] + label,
input[type="radio"] + label {
  font-weight: normal;
}
label[for] {
  cursor: pointer;
}
.label-hint {
  color: #999;
}
/*================ Horizontal Form ================*/
form.form-horizontal,
.form-horizontal {
  margin-bottom: 0;
  input[type="text"],
  input[type="search"],
  input[type="password"],
  input[type="email"],
  input[type="file"],
  input[type="number"],
  input[type="tel"],
  textarea,
  select,
  label {
    display: inline-block;
    margin-bottom: 0;
    width: auto;
  }
}
/*================ Error styles ================*/
input[type="text"],
input[type="search"],
input[type="password"],
input[type="email"],
input[type="file"],
input[type="number"],
input[type="tel"],
textarea {
  &.error {
    border-color: $errorRed;
    background-color: $errorRedBg;
    color: $errorRed;
  }
}
label.error {
  color: $errorRed;
}
/*================ Input Group ================*/
.input-group {
  border: $borderWidth solid $colorBorder;
  input {
    // Nasty Firefox hack for inputs http://davidwalsh.name/firefox-buttons
    &::-moz-focus-inner {
      border: 0;
      padding: 0;
      margin-top: -1px;
      margin-bottom: -1px;
    }
  }
}
.input-group-field,
.input-group-btn {
  display: table-cell;
  vertical-align: middle;
  margin: 0;
}
.input-group .btn,
.input-group .input-group-field {
  height: 37px;
}
.input-group .input-group-field {
  width: 100%;
  margin-bottom: 0;
}
.input-group-btn {
  position: relative;
  white-space: nowrap;
  width: 1%;
  padding: 0;

  .btn {
    background-color: transparent;

    .icon {
      color: $colorTextBody;
      position: relative;
      font-size:18px;
      line-height:18px;
    }
  }
}
/*============================================================================
#Icons
==============================================================================*/
.icon-fallback-text .icon {
  display: none;

  .supports-fontface & {
    display: inline-block;
  }
}
/*============================================================================
A generic way to visually hide content while
remaining accessible to screen readers (h5bp.com)
==============================================================================*/
.supports-fontface .icon-fallback-text .fallback-text {
  clip: rect(0 0 0 0);
  overflow: hidden;
  position: absolute;
  height: 1px;
  width: 1px;
}
.icon:before {
  display: none;
}
.supports-fontface .icon:before {
  display: inline;
  font-family: $socialIconFontStack;
  speak: none; // future fallback, limited in effect currently
  font-style: normal;
  font-weight: normal;
  font-variant: normal;
  text-transform: none;
  line-height: 1;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}
