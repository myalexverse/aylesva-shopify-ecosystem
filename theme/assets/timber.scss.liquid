  width: 100%;
  float: left;
}
.instagram-wrapper .slick-arrow.slick-next { background:url({{ 'arrow.png' | assrt_url }}) no-repeat 5px 7px;margin:0 auto;float:right;width:40px;height:70px;@include transform(rotate(180deg));text-indent:-9999px;}
.instagram-wrapper .slick-arrow.slick-prev { background:url({{ 'arrow.png' | assrt_url }}) no-repeat 5px 7px;float:left;left:10px;width:40px;height:70px;text-indent:-9999px;}
