/*------------------ title -------------*/
.tt-innerpagetitle {
  float: left;
  font-family: $secondaryFontStack,sans-serif;
  font-size: 22px;
  line-height: 24px;
  padding: 0;
  text-align: left;
  font-weight:600;
  width: 100%;
  color:$colorTitle;
  @include at-query ($max, $tablet){
    font-size:18px;
    line-height:20px;
  }
}
.rte .page-subheading{
  color:$colorTitle;
  float:left;
  width:100%;
}
.tthometab-title h3{
  margin:30px 0 0 ;
}
.tt-title {
  color: #111;
  display: inline-block;
  float: none;
  font: 700 22px/34px $ternaryFontStack,sans-serif;
  margin:0;
  position: relative;
  text-align: center;
  width: auto;
  z-index: 1;
  padding: 6px 0px;
