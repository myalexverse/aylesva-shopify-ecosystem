/*============================================================================
#Typography
==============================================================================*/
body,
input,

textarea,
button,
select {
  @include border-radius(0);
  font-family: $primaryFontStack,sans-serif;
  font-size: $baseFontSize;
  font-weight: 400;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  -webkit-text-size-adjust: 100%;
}
input,
textarea,
button,
select {
  font-family: $primaryFontStack,sans-serif;
  letter-spacing:1px;
}
h1, h2, h3, h4, h5, h6 {
  font-family: $primaryFontStack,sans-serif;
  line-height: 1.6;
  margin: 0 0 0.5em;

  a {

    font-weight: inherit;
  }
}
/*================ Use em() Sass function to declare font-size ================*/
h1 {
  font-size: em(32px);
}
h2 {
  font-size: em(28px);
}
h3 {
  font-size: em(22px);
}
h4 {
  font-size: em(20px);
}
h5 {
  font-size: em(18px);
}
h6 {
  font-size: em(14px);
}
.h1 { @extend h1; }
.h2 { @extend h2; }
.h3 { @extend h3; }
.h4 { @extend h4; }
.h5 { @extend h5; }
.h6 { @extend h6; }

p {
  margin: 0 0 ($gutter / 2) 0;

  img {
    margin: 0;
  }
}
em {
  font-style: italic;
}
b, strong {
  font-weight: bold;
}
small {
  font-size: 80%;
}
sup, sub {
  position: relative;
  font-size: 60%;
  vertical-align: baseline;
}
sup {
  top: -0.5em;
}
sub {
  bottom: -0.5em;
}
/*================ Blockquotes ================*/
blockquote {
  font-size: em(18px);
  line-height: em(24px);
  font-style: italic;
  margin: 0 0 $gutter;
  padding: ($gutter / 2) 0;

  p {
    margin-bottom: 0;

    & + cite {
      margin-top: $gutter / 2;
    }
  }
  cite {
    display: block;
    font-size: 0.75em;

    &:before {
      content: "\2014 \0020";
    }
  }
  @include at-query ($min, $large) {
    font-size: em(24px);
    line-height: em(30px);
    margin-left: -20%;
    width: 140%;
    text-align: center;
  }
}
/*================ Code ================*/
code, pre {
  background-color: #faf7f5;
  font-family: Consolas,monospace;
  font-size: 1em;
  border: 0 none;
  padding: 0 2px;
  color: #51ab62;
}
pre {
  overflow: auto;
  padding: $gutter / 2;
  margin: 0 0 $gutter;
}
/*================ Horizontal Rules ================*/
hr {
  clear: both;
  border-top: solid $colorBorder;
  border-width: 1px 0 0;
  margin: 20px 0;
  height: 0;

  &.hr--small {
    border-width: $borderWidth 0 0;
    margin: ($gutter / 2) auto;
    width: 50px;
  }
  &.hr--clear {
    margin-top: 0;
    border: 0;
  }
  @include at-query ($min, $large) {
    margin: ($gutter/2) 0;
  }
}
