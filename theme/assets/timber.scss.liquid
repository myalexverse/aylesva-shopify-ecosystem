  position: relative;
  display: block;
  padding-top: 15px;
  padding-bottom: 15px;
  text-transform: uppercase;
  font-size: 14px;
  font-weight: 600;
  text-decoration: none;
}
.tt-scroll {
  position: absolute;
  top: 0;
  right: 15px;
  bottom: 0;
  left: 0;
  min-height:385px;
  overflow: hidden; 
  height: 100%; 
  @include at-query ($max, $laptop){
    min-height:355px;
  }
  @include at-query ($max, $postlaptop){
    position:static;
  }
}
.tt-scroll.has-scrollbar{
  height: 100%; 
  left: 15px;
  @include at-query ($max, $tablet){
    left:0;
  }
}
.tt-scroll-pane.active, .tt-scroll-pane.flashed, .tt-scroll:hover>.tt-scroll-pane {
  visibility: visible;
  @include opacity(0.99);
}
.tt-scroll .tt-scroll-content {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  overflow: scroll;
  overflow-x: hidden;
}
.tt-scroll > .tt-scroll-pane {
  width: 2px;
  background: rgba(0,0,0,.05);
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  @include transition('200ms ease-in-out');
  @include border-radius(5px);
  visibility: hidden\9;
  @include opacity(0);
}
.tt-scroll > .tt-scroll-pane > .tt-scroll-slider {
