/*============================================================================
#FlexSlider
- jQuery FlexSlider v2.2.2 | http://www.woothemes.com/flexslider/
- Contributing author: Tyler Smith (@mbmufffin)
==============================================================================*/
.flexslider {
  margin: 0 0 30px;
  padding: 0;
  width:100%;
  overflow:hidden;
  @include at-query ($max, $mobile){
    margin:0;
  }
}
.flexslider .slider-title{
  font-family: $ternaryFontStack,sans-serif;
}
.flexslider .slider-subtitle,.flexslider .slider-button{
  font-family: $primaryFontStack,sans-serif;
}
.flexslider li { margin: 0; }
.flexslider .slides > li {
  display: none; /* Hide the slides before the JS is loaded. Avoids image jumping */
  margin: 0;
  position: relative;
  @include backface();
  background:#111;
}
.flexslider .slides img {
  max-width: 100%;
  margin: 0 auto;
  display: block;
  width:100%;
}
.flexslider #popup_toggle {
  position: relative;
  float: left;
  width: 100%;
}
.flexslider .play-icone {
  bottom: 70px;
  height: 85px;
  left: 0;
  margin: auto;
  position: absolute;
  right: 0;
  text-align: center;
  top: 0;
  width: 85px;
  background: #fff;
  @include border-radius(50%);
  @include transform(scale(1));
  @include transition('all 0.4s ease-in-out 0s');
  @include opacity(1);
  cursor:pointer;
  @include at-query ($max, $mobile){
    height:34px;
    width:34px;
  }
}
.flexslider .play-icone:hover{
  background-color:$productIconHoverColor;
}
.flexslider .play-icone:hover i{
  color: $IconHoverColor;
}
.flexslider .play-icone i {
  color: #222;
  font-size: 62px;
  line-height: 85px;
  padding: 0 1px;
  @include at-query ($max, $mobile){
    line-height:34px;
    font-size: 32px;
  }
}
.flexslider .popup_overlay {
  float: left;
  width: 100%;
  position: absolute;
  left: 0;
  text-align: center;
  z-index: 999;
  right: 0;
  display: none;
  top: 0;
  background: rgba(0,0,0,0.9);
  height: 100%;
}
.flexslider .popup_overlay .video-wrapper {
  position: static;
}
.slides { @include clearfix; }
html[xmlns] .slides { display: block; }
* html .slides { height: 1%; }
/*================ No JS Fallback ================*/
.no-js .slides > li:first-child { display: block; }
.flexslider { position: relative; zoom: 1; }
.flex-viewport {
  max-height: 2000px;
  @include transition('all 1s ease');
}
.loading .flex-viewport { max-height: 300px; }
.flexslider .slides { zoom: 1; }
.carousel li { margin-right: 5px; }
/*================ Direction Nav ================*/
.flex-direction-nav {
  margin: 0;
  padding: 0;
  list-style: none;
}
.flex-direction-nav .flex-next::before {
  content: "\f142";
  font-family: "Material Design Icons";
  font-size: 28px;
  color: #fff;
  line-height: 52px;
  padding:0;
}
.flex-direction-nav .flex-prev::before {
  content: "\f141";
  font-family: "Material Design Icons";
  font-size: 28px;
  color: #fff;
  line-height: 52px;
  padding:0;
}
.flex-direction-nav a {
  display: inline-block;
  font-size: inherit;
  text-rendering: auto;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}
.flex-direction-nav { *height: 0; }
.flex-direction-nav a  {
  background-color: #000;
  border: 2px solid #000;
  height: 55px;
  width: 55px;
  display: block;
  position: absolute;
  top: 0;
  bottom:0;
  margin:auto;
  z-index: 2;
  overflow: hidden;
  @include opacity(0);
  cursor: pointer;
  @include border-radius(50%);
  font-size:0;
  text-align:center;
  @include transition('all 0.3s ease');
}
.flex-direction-nav a:hover  {
  background-color: #ffc446;
  border: 2px solid #ffc446;
}
.flex-direction-nav .flex-disabled {
  opacity: 0!important;
  filter: alpha(opacity=0);
  cursor: default;
}
.flex-direction-nav a {

  /*================ Hide SVG arrows in oldIE ================*/
  .lte-ie9 & {
    display: none;
  }
  &.flex-prev {
    // background-image: url("data:image/svg+xml;base64,");
    background-position: center left;
  }
  &.flex-next {
    // background-image: url("data:image/svg+xml;base64,");
    background-position: center right;
  }
}
/*================ Control Nav ================*/
.flex-control-nav {
  position: absolute;
  bottom: -$gutter;
  width: 100%;
  text-align: center;
  margin: 0;
  padding: 0;
  list-style: none;
  display: none;

  li {
    margin: 0 4px;
    display: inline-block;
    zoom: 1;
    *display: inline;
    vertical-align: middle;
  }
}
.flex-control-paging li a {
  width: 12px;
  height: 12px;
  display: block;
  background-color: $colorBorder;
  cursor: pointer;
  text-indent: -9999px;
  @include border-radius(20px);
  border: 2px solid $colorBody;
  @include transition('all 0.1s ease-in-out');

  &:hover {
    background-color: darken($colorBorder, 10%);
  }
  &.flex-active {
    background-color: $colorBody;
    border-color: $colorBorder;
    cursor: default;
