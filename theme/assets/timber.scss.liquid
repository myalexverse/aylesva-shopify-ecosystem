@include at-query(null, $prelaptop, $postlaptop) {
  #header-search > .form-control.input-lg {
    width: 58.2%;
  }
  .header-middle {
    float: left;
    width: 100%;
    padding: 0;
    margin: 0 auto 20px;
  }
  #header-search.input-group {
    float: left;
    width: 100%;
  }
}
@include at-query($max ,$tablet) {
  .header-middle .input-group.search-bar .input-group-field {
    width: 240px;
  }
  .header-middle .input-group .form-control.innner-search {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  #header-search > .form-control.input-lg {
    width: 200px;
  }
  #header-search .select-wrapper {
    width: 80px;
  }
  header .header-middle {
    float:left;
    width:100%;
    margin: 0 auto 15px;
    padding: 0 10px;
  }
  #header-search.input-group {
    float: none;
    margin: 0 auto;
    width: 100%;
  }
  #header-search .select-wrapper::after {
    display: none;
  }
  h1.header-logo.position_relative {
    float: none;
    margin: 0 auto;
    display: inline-block;
  }    
}
@include at-query ($max, $mobile){
  .header-middle .input-group.search-bar .input-group-field {
    width: 130px;
  }
  #header-search > .form-control.input-lg {
    width: 147px;
  }
  #header-search .select-wrapper {
    width: 60px;
  }
  .header-middle #header-search .btn-default {
    background: #111111 url({{ 'sprite.png' | asset_url }}) no-repeat scroll 1px -235px;
    width: 53px;
    height: 38px;
    font-size: 0;
    padding: 0;
    margin:0;
  }
  .header-middle #header-search .btn-default:hover,
  .header-middle #header-search .btn-default:focus {
    background: #111111 url({{ 'sprite.png' | asset_url }}) no-repeat scroll 1px -235px;
    border-color: #000;
  }
  header .header-middle {
    padding:0;
  }
}
.site-nav .sub-nav__dropdown .sub-sub-nav__dropdown > li {
  padding: 0;
}
.Site-navigation .sub-sub-nav__dropdown.sub-menu{
  display: none;
}
.Site-navigation .sub-nav__dropdown.sub-menu.mega-menu .sub-sub-nav__dropdown.sub-menu{
  display: inline-block;
}
.nav-bar {
  .page-move--nav & {
    height: 100%;
  }
  .grid-item {
    height: 100%;
  }
  .icon {
    color: $colorMenuText;
  }
  .wrapper {
    padding: 0;
  }
  @include at-query ($min, $large) {
    .lt-ie9 & {
      margin-top: -$gutter;
    }
  }
}
.site-nav {
  cursor: default;
  font-size: em($menuFontSize);
  margin: 0;
  width: 100%;

  li {
    margin: 0;
    display: inline-block;
    padding:10px 25px;
    float:none;
    vertical-align:top;
  }
  li:first-child {
    border-top: 0;
  }
  li:last-child {
  }
  @include at-query ($min, $large) {
    text-align: center;
    li,
    li:last-child {
      border: 0;
    }
  }
  .grid-item {
    position: relative;
  }
}
@include at-query ($min, $large) {
  .lt-ie9 .site-nav {
    display: inline-table;
    ul {
      margin: 0;
    }
    li {
      border: 0;
      display: inline;
    }
  }
}
.site-nav__link {
  display: inline-block;
  font-weight: 400;
  padding: $gutter / 2;
  white-space: normal;
  max-width: 100%;
  width: 100%;

  &:active,
  &:hover,
  &:focus {
    color: darken($colorMenuText, 10%);
  }
  @include transition('all 0.3s ease');
  @include at-query ($max, $medium) {
    &.site-nav__linknodrop {
      padding-left: $gutter / 2;
    }
  }
  @include at-query ($min, $large) {
    padding: 0 0 ($gutter / 2);

    &:active,
    &:hover,
    &:focus {
      @include transform('none');
    }
  }
}
.site-nav__linkdrop {
  @extend .site-nav__link;

  @include at-query ($max, $large) {
    width: auto;
    min-width: 0;
    padding-right: 0;
  }
}
.site-nav__linkdroparrow {
  @extend .site-nav__link;

  padding-left: $gutter / 2;
}
.sub-nav__dropdown {
  display: none;

  a {
    max-width: 100%;
    white-space: normal;
  }
  li:last-child {
    border-bottom: 0;
  }
  @include at-query ($max, $large) {
    margin: 0;
  }
  @include at-query ($min, $large) {
    margin: -10px 0 30px;
    background-color: transparent;

    a {
      padding: 0;
    }
    li,
    li:first-child {
      border: 0;
    }
  }
}
.site-nav__link, .site-nav__linkdrop, .site-nav__linkdroparrow {
  padding: 0;
}
.site-nav--active,
.site-nav--active a {
  @include opacity(1);
  color: color-control-text($colorMenuText, 25%);
}
.sub-nav__dropdown-toggle {
  font-size: em(17px);
  float: right;
  background-color: transparent;
  color: $colorMenuText;

  &:hover {
    background-color: transparent;
    color: $colorMenuText;
  }
  @include at-query($min, $large) {
    display: inline-block;
    float: none;
    padding: 0;
    position: absolute;
    bottom: calc(50% - 6px);
    width: auto;
  }

  @include at-query ($max, $large) {
    padding-top: 20px;
    padding-bottom: 12px;
    position: absolute;
  }
}
.site-nav__label {
  @include at-query ($min, $large) {
    display: inline-block;
    padding: 0;
    width: auto;
    white-space: normal;
  }
}
@media(max-width:1199px){
  .site-nav__link.site-nav__linknodrop, .site-nav__linknodrop.site-nav__linkdrop, .site-nav__linknodrop.site-nav__linkdroparrow{
    padding:0;
  }
  .site-nav__link, .site-nav__linkdrop, .site-nav__linkdroparrow{
    width:auto;
  }
  .site-nav {
    text-align: center;
  }
}
/*================ Mobile Nav ================*/
.cart-toggle,
.nav-toggle {
  color: $colorMenuText;
  display: inline-block;
  text-align: center;
  width: 100%;
  &:active,
  &:hover,
  &:focus {
    color: lighten($colorMenuText, 10%);
  }
}
.cart-toggle {
  font-size: em(18px);
}
.nav-toggle {
  font-size: em(22px);
}
@include at-query ($min, $large) {
  .cart-toggle {
    font-size: $menuFontSize;
    height: auto;
    margin: 0;
    width: auto;
  }
}
.hidden-count {
  display: none;
}
.nav-mobile {

  position: absolute;
  background-color: $colorMenu;
  font-family: $primaryFontStack,sans-serif;
  height: 100%;
  top: 0;
  left: 0;
  height: 100%;
  font-family: $primaryFontStack,sans-serif;
  z-index: 0;
  overflow: hidden;

  @include at-query ($min, $large) {
    display: none;
  }
  .page-move--nav {
    position:absolute
  }
  .mobile-drawer--open & {
    overflow: auto;
    -webkit-overflow-scrolling: touch;
  }
}
.page-wrapper {
  float: left;
  width: 100%;
  overflow:hidden;
}
.page-element.activated {
  @include transition('left 0.5s cubic-bezier(0.75, 0.03, 0.52, 1)');
}
.cart_table input[type="number"]{
  padding:0;
}
.cart_table .cart-box img{
  @include border-radius(8px);
  border:1px solid $colorBorder;
}
.nav-search {
  @include at-query ($max, $medium) {
    margin: 0 0 ($gutter / 2);
  }	
}
/*================ mobile menu bar =================*/
.nav-menu-wrap .nav-toggle,.site-nav--has-dropdown .site-nav__dropdown-toggle,.nav_dropdown-toggle.btn,.mobile-nav__sublist-trigger {
  display: none;
}
@include at-query ($min, $laptopsmall){
  .site-nav--has-dropdown:hover > .sub-nav__dropdown{
    display: block;
  }
}
/*================ Secondary nav ================*/
.nav-secondary {
  font-family: $primaryFontStack,sans-serif;
  font-size: em(14px);
  margin: 0 0 ($gutter / 2);
  a {
    color: $colorFooterLink;

    &:hover {
      color: lighten($colorFooterLink, 20%);
    }
  }
  li {
    margin: 0 0 0 ($gutter / 2);
  }
  li:first-child {
    margin: 0;
  }
}
/*================ Page nav ====================*/
.article-pagination,
.product-pagination {
  border: $borderWidth solid $colorBorder;
  border-width: $borderWidth 0;
  font-family: $primaryFontStack,sans-serif;
  font-size: em(14px);
  margin: $gutter 0;
  padding: $gutter 0;
  &.last {
    border-bottom: 0;
    padding-bottom: 0;
  }
  p {
    margin: 0;
  }
  .article-pagination__sep,
  .product-pagination__sep {
    padding: 0 ($gutter / 4);
  }
  @include at-query ($min, $large) {
    margin: ($gutter * 2) 0;
  }
}
