/* 
  Aylesva MX - Desktop Grid (Amazon / Mercado Libre Modern Style)
  Min Width 768px
*/

@media (min-width: 768px) {

  /* 1. Global Grey Workspace */
  body.template-collection,
  #ProductGridContainer {
    background-color: #f5f5f5 !important;
  }
  
  .collection_template {
    background-color: transparent !important;
  }

  /* 2. Collection Header Redesign */
  .template-collection header.section-header {
    text-align: left !important;
    margin: 40px 0 30px 0 !important;
    padding: 0 !important;
    border: none !important;
    display: flex !important;
    flex-wrap: wrap !important;
    align-items: baseline !important;
    background: transparent !important;
  }

  .template-collection .section-header__title {
    font-size: 32px !important;
    font-weight: 700 !important;
    color: #333 !important;
    margin: 0 30px 0 0 !important;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif !important;
  }

  /* 3. Simplificando el feo Sorting Sidebar/Header */
  .template-collection .filter-show {
    order: 2; /* Puts right after title */
    margin-right: auto; 
    display: inline-flex;
    align-items: center;
  }

  .template-collection .pag-product {
    font-size: 14px !important;
    color: #888 !important;
    font-weight: 400 !important;
  }

  .template-collection .sorting_wrapper {
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  .template-collection .filter-sortby label {
    font-size: 13px !important;
    color: #666 !important;
    font-weight: 500 !important;
  }

  .template-collection .filter-sortby select {
    border: 1px solid #ddd !important;
    border-radius: 4px !important;
    background: #fff !important;
    font-size: 13px !important;
    padding: 6px 12px !important;
    color: #333 !important;
    font-weight: 500 !important;
    height: 38px !important;
    outline: none !important;
  }

  /* 4. Left Sidebar Cleanup (Categorias, Precio, etc) */
  .template-collection .filter-wrapper {
    background-color: transparent !important;
    border: none !important;
    box-shadow: none !important;
    padding: 0 !important;
  }
  
  /* Retain inside blocks but make them ML-style clean */
  .template-collection .sidebar-block .widget {
    background-color: #fff !important;
    border-radius: 8px !important;
    margin-bottom: 20px !important;
    padding: 20px !important;
    box-shadow: 0 1px 2px rgba(0,0,0,0.06) !important;
    border: 1px solid rgba(0,0,0,0.05) !important;
  }

  .template-collection .sidebar-block .widget h4 {
    background: transparent !important;
    color: #333 !important;
    padding: 0 0 15px 0 !important;
    font-size: 16px !important;
    font-weight: 600 !important;
    border-bottom: 1px solid #efefef !important;
    margin-bottom: 15px !important;
  }

  /* 5. The Grid (Products) */
  .products-grid-view {
    display: flex !important;
    flex-wrap: wrap !important;
    margin: 0 -8px !important;
  }

  /* 6. White Box Cards (Mercado Libre Style) */
  .products-grid-view .grid-item {
    margin: 8px !important;
    padding: 0 !important;
    background-color: #ffffff !important;
    border-radius: 6px !important;
    box-shadow: 0 1px 2px 0 rgba(0,0,0,0.12) !important;
    display: flex !important;
    flex-direction: column !important;
    overflow: hidden !important;
    transition: all 0.25s ease-out !important;
    cursor: pointer !important;
    border: none !important;
  }

  /* Amazon/ML hover lift */
  .products-grid-view .grid-item:hover {
    box-shadow: 0 8px 16px 0 rgba(0,0,0,0.1) !important;
    transform: translateY(-4px) !important;
    z-index: 10;
  }

  /* 7. Image Container */
  .products-grid-view .grid-item .product-wrapper {
    position: relative !important;
    width: 100% !important;
    background: #fff !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow: hidden !important;
  }

  .products-grid-view .grid-item .product-wrapper img {
    width: 100% !important;
    height: auto !important;
    aspect-ratio: 1/1 !important; /* Square base to enforce uniform alignment */
    object-fit: cover !important; 
    display: block !important;
    background: #fff !important;
  }

  /* 8. Text Formatting inside the white box */
  .products-grid-view .grid-item .product-description {
    padding: 16px !important;
    flex-grow: 1 !important;
    display: flex !important;
    flex-direction: column !important;
    text-align: left !important;
    background: transparent !important;
  }

  .products-grid-view .grid-item .grid-view-item__title {
    font-size: 14px !important;
    color: #666666 !important;
    font-weight: 400 !important;
    line-height: 1.3 !important;
    margin: 0 0 12px 0 !important;
    display: -webkit-box !important;
    -webkit-line-clamp: 2 !important;
    -webkit-box-orient: vertical !important;
    overflow: hidden !important;
    height: 36px !important;
  }
  
  .products-grid-view .grid-item .grid-view-item__title a {
    color: inherit !important;
    text-decoration: none !important;
  }

  /* Pricing (Standard ML Style) */
  .products-grid-view .grid-item .grid-view-item__meta {
    margin-top: auto !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 4px !important;
    align-items: flex-start !important;
  }

  .products-grid-view .grid-item .product-price__price {
    font-size: 24px !important;
    font-weight: 400 !important;
    color: #333333 !important;
    margin: 0 !important;
  }

  .products-grid-view .grid-item .regular-price,
  .products-grid-view .grid-item .compare_price {
    font-size: 12px !important;
    color: #999999 !important;
    text-decoration: line-through !important;
    margin: 0 !important;
  }
  
  /* 9. Action Buttons Alignment Fix (Definitive Overflow/Margin Reset) */
  /* Target the product containers and DISABLE overflow to prevent decapitating icons */
  .grid-view-item, .product-wrapper, .product-description, .btn_wrapper {
    overflow: visible !important;
  }

  .grid-view-item .product-description .btn_wrapper,
  .product-layouts .product-description .btn_wrapper {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    width: 100% !important;
    height: auto !important;
    padding: 10px 0 !important;
    margin-top: 5px !important;
    border-top: 1px solid var(--color-border) !important;
    gap: 8px !important;
    flex-wrap: nowrap !important;
  }

  /* Target the LEGACY divs that are pushing the wishlist icon down */
  .btn_wrapper .pro_btn,
  .btn_wrapper .add_tocart,
  .btn_wrapper .add-to-wishlist,
  .btn_wrapper .quick-view-wrap,
  .btn_wrapper .show,
  .btn_wrapper .loading,
  .btn_wrapper [class*="wishbutton"] {
    margin: 0 !important;
    padding: 0 !important;
    top: 0 !important;
    position: relative !important;
    float: none !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    height: 38px !important;
  }

  /* Circular Buttons Normalization */
  .btn_wrapper .add-to-wishlist,
  .btn_wrapper .quick-view-wrap {
    flex: 0 0 38px !important;
    width: 38px !important;
    background-color: #F05E5E !important;
    border-radius: 50% !important;
  }

  /* Keep the long button flexible but constrained */
  .btn_wrapper .add_tocart {
    flex: 1 1 auto !important;
    max-width: 140px !important;
    height: 38px !important;
    background-color: #F05E5E !important;
    border-radius: 20px !important;
  }

  .btn_wrapper a, .btn_wrapper i {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    color: #fff !important;
    font-size: 18px !important;
    margin: 0 !important;
    line-height: normal !important;
    background: transparent !important;
  }

  /* Hide labels and sub-spans that break the flow */
  .btn_wrapper span:not(.add_cart), 
  .btn_wrapper .tooltip-label,
  .btn_wrapper .show span {
    display: none !important;
  }
}



