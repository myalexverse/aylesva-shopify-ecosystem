<style>
/* ── HIDE BREADCRUMB on this page ─────────────────────────────────── */
body:has(#ay-lp-{{ section.id }}) nav.breadcrumb-wrapper {
  display: none !important;
}

/* ── BOOTSTRAP ROW ESCAPE ──────────────────────────────────────────── */
#shopify-section-{{ section.id }} {
  display: block !important;
  flex: 0 0 100% !important;
  width: 100% !important;
  max-width: 100% !important;
  padding: 0 !important;
  margin: 0 !important;
}

/* ── RESET INHERITED THEME STYLES ──────────────────────────────────── */
.ay-lp, .ay-lp *, .ay-lp *::before, .ay-lp *::after {
  box-sizing: border-box;
}
.ay-lp {
  display: block;
  width: 100%;
  overflow-x: hidden;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Segoe UI", Helvetica, Arial, sans-serif;
  -webkit-font-smoothing: antialiased;
  color: #1d1d1f;
  background: #fff;
  scroll-behavior: smooth;
}
.ay-lp a { text-decoration: none; }
.ay-lp img { display: block; max-width: 100%; }
.ay-lp p { margin: 0; }
.ay-lp h1, .ay-lp h2, .ay-lp h3 { margin: 0; }
.ay-lp strong, .ay-lp small { display: block; }

/* ── ANIMATIONS ────────────────────────────────────────────────────── */
@keyframes ay-shimmer { 0%{background-position:-600px 0} 100%{background-position:600px 0} }
@keyframes ay-fadeup  { from{opacity:0;transform:translateY(24px)} to{opacity:1;transform:none} }
@keyframes ay-pulse   { 0%,100%{opacity:1} 50%{opacity:.35} }
@keyframes ay-float-in-1 { from{opacity:0;transform:translateX(30px) scale(.9)} to{opacity:1;transform:none} }
@keyframes ay-float-in-2 { from{opacity:0;transform:translateX(-30px) scale(.9)} to{opacity:1;transform:none} }
@keyframes ay-float-in-3 { from{opacity:0;transform:translateY(20px) scale(.9)} to{opacity:1;transform:none} }
@keyframes ay-float-bob { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-6px)} }
@keyframes ay-glow-pulse { 0%,100%{opacity:.4;transform:scale(1)} 50%{opacity:.7;transform:scale(1.05)} }

/* ── SHARED ────────────────────────────────────────────────────────── */
.ay-inner    { max-width:1180px; margin:0 auto; padding:0 24px; }
.ay-inner-md { max-width:1080px; margin:0 auto; padding:0 24px; }
.ay-inner-sm { max-width:760px;  margin:0 auto; padding:0 24px; }
.ay-inner-xs { max-width:680px;  margin:0 auto; padding:0 24px; }
.ay-eyebrow  { font-size:13px; font-weight:600; letter-spacing:.14em; text-transform:uppercase; color:#a4243b; }
.ay-h2       { font-size:clamp(32px,4.6vw,52px); line-height:1.07; letter-spacing:-0.022em; font-weight:700; margin-bottom:18px; }
.ay-sub      { font-size:clamp(17px,2vw,20px); line-height:1.5; color:#6e6e73; }
.ay-shimmer  { position:absolute; inset:0; display:grid; place-items:center; background:linear-gradient(90deg,#f0f0f3 25%,#fafafc 50%,#f0f0f3 75%); background-size:1200px 100%; animation:ay-shimmer 1.6s linear infinite; }
.ay-check    { color:#a4243b; font-weight:700; }
.ay-btn-dark { display:inline-flex; align-items:center; gap:10px; background:#1d1d1f; color:#fff !important; font-size:17px; font-weight:600; padding:16px 32px; border-radius:999px; box-shadow:0 12px 28px -12px rgba(0,0,0,.35); transition:transform .35s cubic-bezier(.2,.8,.2,1),background .3s; }
.ay-btn-dark:hover { background:#000; transform:scale(1.045); }
.ay-btn-ghost { display:inline-flex; align-items:center; background:#f5f5f7; color:#1d1d1f !important; font-size:17px; font-weight:600; padding:16px 30px; border-radius:999px; transition:background .3s; }
.ay-btn-ghost:hover { background:#e8e8ed; }

/* ── NAV ───────────────────────────────────────────────────────────── */
.ay-nav { display:block; position:relative; background:rgba(255,255,255,.95); border-bottom:1px solid #e8e8ed; }
.ay-nav__inner { max-width:1180px; margin:0 auto; padding:14px 24px; display:flex; align-items:center; justify-content:flex-end; gap:24px; }
.ay-nav__logo  { font-size:22px; font-weight:700; letter-spacing:-0.02em; font-style:italic; color:#a4243b; }
.ay-nav__links { display:flex; align-items:center; gap:28px; font-size:14px; }
.ay-nav__link  { color:#424245; transition:color .25s; }
.ay-nav__link:hover { color:#000; }
.ay-nav__cta   { display:inline-flex; align-items:center; background:#1d1d1f; color:#fff !important; font-weight:600; font-size:14px; padding:10px 22px; border-radius:999px; transition:transform .3s cubic-bezier(.2,.8,.2,1),background .3s; }
.ay-nav__cta:hover { background:#000; transform:scale(1.04); }
@media(max-width:680px) { .ay-nav__link:not(.ay-nav__cta) { display:none; } .ay-nav__links { gap:14px; } }

/* ── HERO ──────────────────────────────────────────────────────────── */
.ay-hero { display:block; padding:110px 24px 90px; background:linear-gradient(160deg, #fff 0%, #faf8f9 30%, #f5f0f1 60%, #fafafc 100%); position:relative; overflow:hidden; }
.ay-hero__glow { position:absolute; top:-120px; right:-80px; width:500px; height:500px; border-radius:50%; background:radial-gradient(circle, rgba(164,36,59,.12) 0%, transparent 70%); animation:ay-glow-pulse 6s ease-in-out infinite; pointer-events:none; }
.ay-hero__inner { max-width:1180px; margin:0 auto; display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1.1fr); gap:56px; align-items:center; position:relative; z-index:1; }
.ay-hero__copy  { display:flex; flex-direction:column; gap:22px; animation:ay-fadeup .8s cubic-bezier(.2,.8,.2,1) both; }
.ay-hero__eyebrow { margin-bottom:0; }
.ay-hero__h1    { font-size:clamp(38px,5vw,64px); line-height:1.06; letter-spacing:-0.028em; font-weight:700; }
.ay-hero__h1-accent { background:linear-gradient(135deg, #6e6e73 0%, #a4243b 100%); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }
.ay-hero__sub   { font-size:clamp(17px,2vw,21px); line-height:1.5; color:#6e6e73; max-width:520px; }
.ay-hero__btns  { display:flex; align-items:center; gap:14px; margin-top:10px; flex-wrap:wrap; }
.ay-hero__mini  { display:flex; gap:22px; flex-wrap:wrap; margin-top:8px; font-size:14px; color:#6e6e73; }
.ay-hero__mini span { display:inline-flex; align-items:center; gap:7px; }

/* Hero visual with floating badges */
.ay-hero__visual { position:relative; animation: ay-fadeup .9s .15s cubic-bezier(.2,.8,.2,1) both; }
.ay-hero__img { width:100%; height:auto; display:block; border-radius:24px; box-shadow:0 40px 80px -20px rgba(0,0,0,.3), 0 0 0 1px rgba(0,0,0,.06); }

/* Floating notification badges */
.ay-hero__float { position:absolute; display:flex; align-items:center; gap:12px; background:rgba(255,255,255,.95); backdrop-filter:blur(12px); -webkit-backdrop-filter:blur(12px); border:1px solid rgba(0,0,0,.06); border-radius:16px; padding:12px 18px; box-shadow:0 16px 40px -12px rgba(0,0,0,.18); z-index:3; white-space:nowrap; }
.ay-hero__float--1 { top:12%; right:-16px; animation:ay-float-in-1 .7s .6s cubic-bezier(.2,.8,.2,1) both, ay-float-bob 4s 1.3s ease-in-out infinite; }
.ay-hero__float--2 { bottom:32%; left:-20px; animation:ay-float-in-2 .7s .9s cubic-bezier(.2,.8,.2,1) both, ay-float-bob 4.5s 1.6s ease-in-out infinite; }
.ay-hero__float--3 { bottom:8%; right:10%; animation:ay-float-in-3 .7s 1.2s cubic-bezier(.2,.8,.2,1) both, ay-float-bob 5s 1.9s ease-in-out infinite; }
.ay-float-icon { width:38px; height:38px; border-radius:10px; display:grid; place-items:center; flex:none; }
.ay-float-icon--green { background:#e8f8ee; color:#22c55e; }
.ay-float-icon--blue  { background:#e8f0ff; color:#3b82f6; }
.ay-float-icon--gold  { background:#fef3e2; color:#f59e0b; }
.ay-float-text strong { font-size:14px; font-weight:600; color:#1d1d1f; display:block; }
.ay-float-text small  { font-size:12px; color:#6e6e73; display:block; margin-top:1px; }
@media(max-width:820px) {
  .ay-hero__inner { grid-template-columns:1fr; }
  .ay-hero__visual { margin-top:20px; }
  .ay-hero__float--1 { top:8%; right:4px; }
  .ay-hero__float--2 { left:4px; bottom:28%; }
  .ay-hero__float--3 { bottom:4%; right:4%; }
  .ay-hero__glow { width:300px; height:300px; top:-60px; right:-40px; }
}
@media(max-width:480px) {
  .ay-hero__float { padding:8px 12px; border-radius:12px; gap:8px; }
  .ay-float-icon { width:30px; height:30px; border-radius:8px; }
  .ay-float-icon svg { width:14px !important; height:14px !important; }
  .ay-float-text strong { font-size:12px; }
  .ay-float-text small { font-size:10px; }
}

/* Stats Bar */
.ay-stats { display: block; background: #1d1d1f; padding: 56px 24px; }
.ay-stats__grid { max-width: 1080px; margin: 0 auto; display: grid; grid-template-columns: repeat(4, 1fr); gap: 36px; text-align: center; }
.ay-stat { display: flex; flex-direction: column; gap: 6px; }
.ay-stat__number { font-size: clamp(36px, 5vw, 56px); font-weight: 700; color: #fff; letter-spacing: -0.03em; line-height: 1; }
.ay-stat__plus { font-size: clamp(24px, 3vw, 36px); font-weight: 700; color: #a4243b; }
.ay-stat__label { font-size: 14px; color: #a1a1a6; letter-spacing: 0.04em; text-transform: uppercase; font-weight: 500; }
@media(max-width: 600px) { .ay-stats__grid { grid-template-columns: repeat(2, 1fr); gap: 32px; } }

/* ── PERKS STRIP ───────────────────────────────────────────────────── */
.ay-perks { display:block; background:#fff; border-top:1px solid #f0f0f3; border-bottom:1px solid #f0f0f3; padding:56px 24px; }
.ay-perks__grid { max-width:1080px; margin:0 auto; display:grid; grid-template-columns:repeat(4,1fr); gap:36px 28px; }
@media(max-width:780px) { .ay-perks__grid { grid-template-columns:repeat(2,1fr); } }
@media(max-width:460px) { .ay-perks__grid { grid-template-columns:1fr; } }
.ay-perk { display:flex; flex-direction:column; align-items:center; gap:6px; text-align:center; }
.ay-perk__icon { width:56px; height:56px; border-radius:50%; display:grid; place-items:center; margin-bottom:8px; color:#1d1d1f; background:#f5f5f7; transition:background .35s,color .35s,transform .45s cubic-bezier(.2,.8,.2,1); flex:none; }
.ay-perk__icon:hover { background:#1d1d1f; color:#fff; transform:translateY(-4px); }
.ay-perk__title { font-size:16px; font-weight:600; letter-spacing:-0.01em; }
.ay-perk__text  { font-size:13.5px; line-height:1.5; color:#6e6e73; max-width:230px; }

/* ── BENEFITS ──────────────────────────────────────────────────────── */
.ay-benefits { display:block; padding:110px 24px; }
.ay-benefits__header { max-width:760px; margin:0 auto 64px; text-align:center; }
.ay-alt-row { max-width: 1080px; margin: 0 auto 64px; display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
.ay-alt-row--reverse { direction: rtl; }
.ay-alt-row--reverse > * { direction: ltr; }
.ay-alt-row__img { display: flex; align-items: center; justify-content: center; }
.ay-alt-row__icon-big { width: 160px; height: 160px; border-radius: 40px; background: #f8ecee; display: grid; place-items: center; transition: transform .5s cubic-bezier(.2,.8,.2,1); }
.ay-alt-row__icon-big:hover { transform: scale(1.06) rotate(-3deg); }
.ay-alt-row__title { font-size: clamp(24px, 3vw, 32px); font-weight: 700; letter-spacing: -0.02em; margin-bottom: 14px; display: block; }
.ay-alt-row__desc { font-size: clamp(16px, 1.8vw, 19px); line-height: 1.6; color: #6e6e73; }
@media(max-width: 820px) { 
  .ay-alt-row { grid-template-columns: 1fr; gap: 32px; text-align: center; }
  .ay-alt-row--reverse { direction: ltr; }
}

/* ── STEPS ─────────────────────────────────────────────────────────── */
.ay-steps { display:block; background:#f5f5f7; padding:110px 24px; }
.ay-steps__header { max-width:760px; margin:0 auto 60px; text-align:center; }
.ay-steps__visual { max-width: 1180px; margin: 0 auto; display: flex; align-items: flex-start; justify-content: center; gap: 0; }
.ay-vstep { display: flex; flex-direction: column; align-items: center; gap: 18px; text-align: center; flex: 1; max-width: 340px; }
.ay-vstep__img-wrap { position: relative; width: 100%; aspect-ratio: 1; border-radius: 24px; overflow: hidden; box-shadow: 0 20px 48px -16px rgba(0,0,0,.15); }
.ay-vstep__img-wrap img { width: 100%; height: 100%; object-fit: cover; }
.ay-vstep__badge { position: absolute; top: 16px; left: 16px; width: 44px; height: 44px; border-radius: 50%; background: #a4243b; color: #fff; font-size: 20px; font-weight: 700; display: grid; place-items: center; box-shadow: 0 8px 20px -6px rgba(164,36,59,.5); }
.ay-vstep__title { font-size: 19px; font-weight: 600; letter-spacing: -0.015em; }
.ay-vstep__text { font-size: 15px; line-height: 1.55; color: #6e6e73; max-width: 280px; }
.ay-vstep__connector { display: flex; align-items: center; padding-top: 80px; flex: 0 0 60px; }
@media(max-width: 820px) { 
  .ay-steps__visual { flex-direction: column; align-items: center; gap: 36px; }
  .ay-vstep { max-width: 400px; }
  .ay-vstep__connector { display: none; }
}

/* ── PORTFOLIO ─────────────────────────────────────────────────────── */
.ay-portfolio { display:block; padding:120px 24px 100px; }
.ay-portfolio__header { max-width:760px; margin:0 auto 68px; text-align:center; }
.ay-sites-grid { max-width:1180px; margin:0 auto; display:grid; grid-template-columns:repeat(auto-fill,minmax(320px,1fr)); gap:26px; }
.ay-site-card { display:flex; flex-direction:column; background:#fff; border:1px solid #e8e8ed; border-radius:20px; overflow:hidden; cursor:pointer; box-shadow:0 1px 2px rgba(0,0,0,.04); transition:transform .45s cubic-bezier(.2,.8,.2,1),box-shadow .45s cubic-bezier(.2,.8,.2,1); }
.ay-site-card:hover { transform:translateY(-6px); box-shadow:0 24px 48px -16px rgba(0,0,0,.16); }
.ay-site-card--hidden { display:none !important; }
.ay-card-bar { display:flex; align-items:center; gap:12px; padding:11px 14px; background:#f5f5f7; border-bottom:1px solid #e8e8ed; }
.ay-card-dots { display:flex; gap:6px; flex:none; }
.ay-card-dots i { width:9px; height:9px; border-radius:50%; background:#d4d4d9; font-style:normal; }
.ay-card-url  { flex:1; min-width:0; text-align:center; font-size:12.5px; color:#6e6e73; background:#fff; border:1px solid #e8e8ed; border-radius:999px; padding:4px 14px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.ay-card-screen { display:block; aspect-ratio:16/10.5; overflow:hidden; background:#f5f5f7; position:relative; }
.ay-card-screen img { width:100%; height:100%; object-fit:cover; object-position:top center; transition:transform .9s cubic-bezier(.2,.8,.2,1); }
.ay-site-card:hover .ay-card-screen img { transform:scale(1.03); }
.ay-card-shimmer { position:absolute; inset:0; display:grid; place-items:center; background:linear-gradient(90deg,#f0f0f3 25%,#fafafc 50%,#f0f0f3 75%); background-size:1200px 100%; animation:ay-shimmer 1.6s linear infinite; }
.ay-card-shimmer__inner { display:flex; flex-direction:column; align-items:center; gap:8px; }
.ay-card-initials { width:54px; height:54px; border-radius:50%; background:#fff; display:grid; place-items:center; font-size:20px; font-weight:700; color:#a4243b; box-shadow:0 6px 16px -8px rgba(0,0,0,.15); }
.ay-card-loading  { font-size:12px; color:#a1a1a6; letter-spacing:.06em; text-transform:uppercase; animation:ay-pulse 1.8s ease infinite; }
.ay-card-footer   { display:flex; align-items:center; justify-content:space-between; gap:16px; padding:18px 20px; }
.ay-card-info     { display:flex; flex-direction:column; gap:3px; min-width:0; }
.ay-card-name     { font-size:17px; font-weight:600; letter-spacing:-0.01em; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.ay-card-domain   { font-size:13.5px; color:#6e6e73; }
.ay-card-arrow    { flex:none; width:34px; height:34px; border-radius:50%; display:grid; place-items:center; color:#6e6e73; background:#f5f5f7; transition:background .35s,color .35s; }
.ay-site-card:hover .ay-card-arrow { background:#1d1d1f; color:#fff; }
.ay-toggle-wrap { display:flex; justify-content:center; margin-top:48px; }
.ay-toggle-btn  { display:inline-flex; align-items:center; gap:10px; background:#f5f5f7; color:#1d1d1f; border:none; font-family:inherit; font-size:16px; font-weight:600; padding:15px 32px; border-radius:999px; cursor:pointer; transition:background .3s,transform .3s cubic-bezier(.2,.8,.2,1); }
.ay-toggle-btn:hover { background:#e8e8ed; transform:scale(1.03); }

/* ── SERVICES BANNER ───────────────────────────────────────────────── */
.ay-services { display:block; position:relative; padding:120px 24px; background:#0c0c0f; overflow:hidden; }
.ay-services__bg { position:absolute; inset:0; background:
  radial-gradient(ellipse 80% 60% at 20% 80%, rgba(164,36,59,.15) 0%, transparent 60%),
  radial-gradient(ellipse 60% 50% at 80% 20%, rgba(164,36,59,.1) 0%, transparent 50%);
  pointer-events:none; }
.ay-services__inner { max-width:1180px; margin:0 auto; position:relative; z-index:1; }
.ay-services__header { text-align:center; margin-bottom:64px; }
.ay-services__h2 { font-size:clamp(32px,4.6vw,52px); line-height:1.07; letter-spacing:-0.022em; font-weight:700; color:#fff; margin-bottom:18px; }
.ay-services__accent { background:linear-gradient(135deg, #e08a99, #a4243b); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }
.ay-services__sub { font-size:clamp(17px,2vw,20px); line-height:1.5; color:#a1a1a6; max-width:600px; margin:0 auto; }
.ay-services__grid { display:grid; grid-template-columns:repeat(2,1fr); gap:32px; }
@media(max-width:820px) { .ay-services__grid { grid-template-columns:1fr; max-width:520px; margin:0 auto; } }

/* Service Cards */
.ay-svc-card { display:flex; flex-direction:column; background:rgba(255,255,255,.04); border:1px solid rgba(255,255,255,.08); border-radius:24px; overflow:hidden; transition:transform .5s cubic-bezier(.2,.8,.2,1), box-shadow .5s cubic-bezier(.2,.8,.2,1), border-color .4s; }
.ay-svc-card:hover { transform:translateY(-8px); box-shadow:0 32px 64px -16px rgba(164,36,59,.25); border-color:rgba(164,36,59,.3); }
.ay-svc-card__img { position:relative; aspect-ratio:16/9; overflow:hidden; }
.ay-svc-card__img img { width:100%; height:100%; object-fit:cover; transition:transform .8s cubic-bezier(.2,.8,.2,1); }
.ay-svc-card:hover .ay-svc-card__img img { transform:scale(1.06); }
.ay-svc-card__overlay { position:absolute; inset:0; background:linear-gradient(180deg, transparent 40%, rgba(12,12,15,.6) 100%); pointer-events:none; }
.ay-svc-card__tag { position:absolute; top:16px; right:16px; background:rgba(164,36,59,.9); color:#fff; font-size:12px; font-weight:600; letter-spacing:.06em; text-transform:uppercase; padding:6px 14px; border-radius:999px; backdrop-filter:blur(8px); }
.ay-svc-card__tag--blue { background:rgba(59,130,246,.85); }
.ay-svc-card__body { padding:32px 28px 36px; display:flex; flex-direction:column; gap:14px; flex:1; }
.ay-svc-card__icon { width:52px; height:52px; border-radius:14px; background:rgba(164,36,59,.12); color:#e08a99; display:grid; place-items:center; flex:none; }
.ay-svc-card__title { font-size:22px; font-weight:700; letter-spacing:-0.015em; color:#fff; display:block; }
.ay-svc-card__text { font-size:15.5px; line-height:1.6; color:#a1a1a6; }
.ay-svc-card__list { list-style:none; padding:0; margin:8px 0 4px; display:flex; flex-direction:column; gap:8px; }
.ay-svc-card__list li { display:flex; align-items:center; gap:10px; font-size:14.5px; color:#d1d1d6; }
.ay-svc-card__list .ay-check { color:#e08a99; font-weight:700; font-size:15px; }
.ay-svc-card__btn { display:inline-flex; align-items:center; gap:8px; margin-top:auto; padding-top:12px; color:#e08a99 !important; font-size:16px; font-weight:600; text-decoration:none !important; transition:gap .3s ease, color .3s; }
.ay-svc-card__btn:hover { gap:14px; color:#fff !important; }

/* ── FORM SECTION ──────────────────────────────────────────────────── */
.ay-form-section { display:block; background:#101014; color:#f5f5f7; padding:120px 24px; }
.ay-form-section__inner { max-width:760px; margin:0 auto; text-align:center; display:flex; flex-direction:column; align-items:center; gap:18px; }
.ay-form-eyebrow { font-size:13px; font-weight:600; letter-spacing:.14em; text-transform:uppercase; color:#e08a99; }
.ay-form-h2 { font-size:clamp(30px,4.4vw,48px); line-height:1.08; letter-spacing:-0.022em; font-weight:700; color:#fff; margin-bottom:0; }
.ay-form-sub { font-size:clamp(16px,2vw,19px); line-height:1.5; color:#a1a1a6; margin-bottom:22px; }
.ay-form-embed { width:100%; }
.ay-form-placeholder { min-height:320px; border:1.5px dashed #3a3a40; border-radius:24px; display:grid; place-items:center; background:#17171c; width:100%; }
.ay-form-placeholder__inner { display:flex; flex-direction:column; align-items:center; gap:10px; padding:40px; text-align:center; }
.ay-form-placeholder__title { font-size:15px; font-weight:600; color:#d1d1d6; }
.ay-form-placeholder__text  { font-size:13.5px; color:#6e6e73; max-width:380px; line-height:1.55; }
.ay-form-perks { display:flex; gap:24px; flex-wrap:wrap; justify-content:center; margin-top:14px; font-size:13.5px; color:#a1a1a6; }
.ay-form-perks span { display:inline-flex; align-items:center; gap:7px; }
.ay-form-check { color:#e08a99; }

/* ── CTA ───────────────────────────────────────────────────────────── */
.ay-cta { display:block; background:#f5f5f7; padding:110px 24px 120px; text-align:center; }
.ay-cta__inner { max-width:680px; margin:0 auto; display:flex; flex-direction:column; align-items:center; gap:18px; }
.ay-cta__h2    { font-size:clamp(32px,4.6vw,52px); line-height:1.08; letter-spacing:-0.022em; font-weight:700; }
.ay-cta__sub   { font-size:clamp(17px,2vw,20px); line-height:1.5; color:#6e6e73; margin-bottom:14px; }
.ay-cta__small { font-size:13.5px; color:#6e6e73; margin-top:4px; }

/* ── FOOTER ────────────────────────────────────────────────────────── */
.ay-footer { display:block; background:#fff; border-top:1px solid #e8e8ed; padding:34px 24px; }
.ay-footer__inner { max-width:1180px; margin:0 auto; display:flex; align-items:center; justify-content:space-between; gap:24px; flex-wrap:wrap; }
.ay-footer__logo  { font-size:19px; font-weight:700; font-style:italic; color:#a4243b; }
.ay-footer__links { display:flex; gap:26px; font-size:14px; flex-wrap:wrap; }
.ay-footer__links a { color:#6e6e73; transition:color .25s; }
.ay-footer__links a:hover { color:#000; }
.ay-footer__copy  { font-size:13.5px; color:#a1a1a6; }

/* ── MODAL ─────────────────────────────────────────────────────────── */
.ay-modal-backdrop { position:fixed; inset:0; z-index:9999; display:grid; place-items:center; padding:24px; opacity:0; pointer-events:none; transition:opacity .3s; }
.ay-modal-backdrop.is-open { opacity:1; pointer-events:all; }
.ay-modal-overlay  { position:absolute; inset:0; background:rgba(20,20,22,.5); backdrop-filter:blur(14px); -webkit-backdrop-filter:blur(14px); }
.ay-modal-box      { position:relative; width:min(460px,100%); background:#fff; border-radius:24px; overflow:hidden; box-shadow:0 40px 90px -20px rgba(0,0,0,.4); transform:translateY(24px); opacity:0; transition:transform .35s cubic-bezier(.2,.8,.2,1),opacity .35s; }
.ay-modal-backdrop.is-open .ay-modal-box { transform:none; opacity:1; }
.ay-modal-close    { position:absolute; top:14px; right:14px; z-index:2; width:34px; height:34px; border-radius:50%; border:none; display:grid; place-items:center; background:rgba(255,255,255,.9); color:#1d1d1f; font-size:20px; line-height:1; cursor:pointer; box-shadow:0 1px 4px rgba(0,0,0,.14); font-family:inherit; transition:transform .25s; }
.ay-modal-close:hover { transform:scale(1.08); }
.ay-modal-screen   { aspect-ratio:16/9; overflow:hidden; background:#f5f5f7; position:relative; }
.ay-modal-screen img { width:100%; height:100%; object-fit:cover; object-position:top center; }
.ay-modal-body     { padding:28px 30px 32px; text-align:center; display:flex; flex-direction:column; align-items:center; gap:10px; }
.ay-modal-tag      { font-size:12px; font-weight:600; letter-spacing:.14em; text-transform:uppercase; color:#a4243b; }
.ay-modal-name     { font-size:26px; font-weight:700; letter-spacing:-0.02em; }
.ay-modal-badge    { font-size:13px; color:#6e6e73; background:#f5f5f7; border:1px solid #e8e8ed; border-radius:999px; padding:5px 14px; }
.ay-modal-desc     { font-size:15.5px; line-height:1.55; color:#6e6e73; margin:6px 0 10px; }
.ay-modal-visit    { display:inline-flex; align-items:center; gap:8px; background:#1d1d1f; color:#fff !important; font-size:16px; font-weight:600; padding:13px 28px; border-radius:999px; transition:transform .3s cubic-bezier(.2,.8,.2,1),background .3s; }
.ay-modal-visit:hover { background:#000; transform:scale(1.04); }

@media(prefers-reduced-motion:reduce) {
  .ay-lp *, .ay-lp *::before, .ay-lp *::after { animation-duration:.01ms !important; transition-duration:.01ms !important; }
}
</style>

