<script id="ay-urls-{{ section.id }}" type="application/json">{}</script>

<script>
(function () {
  'use strict';
  var SID = '{{ section.id }}';

  // Hide breadcrumb (JS fallback for browsers without :has())
  var bc = document.querySelector('nav.breadcrumb-wrapper');
  if (bc) bc.style.display = 'none';

  var FEATURED = 6;
  var HERO_INTERVAL = 7000;
  var sites = [
    { name: 'Vaquero de Napa',         url: 'https://vaquerodenapa.com' },
    { name: 'WearMex',                  url: 'https://wearmex.com' },
    { name: 'Hector Boots',             url: 'https://hectorboots.com' },
    { name: 'Cowboy Empire Boots',      url: 'https://cowboyempireboots.com' },
    { name: 'La Joya Western Wear',     url: 'https://lajoyawesternwear.com' },
    { name: 'Mi Rancho Boots',          url: 'https://miranchoboots.com' },
    { name: 'Botas El Villa',           url: 'https://botaselvilla.com' },
    { name: 'Tu Tienda Vaquera',        url: 'https://tutiendavaquera.com' },
    { name: "Valadez Men's Wear",       url: 'https://valadezmens.com' },
    { name: 'OH Cattle',                url: 'https://ohcattle.com' },
    { name: 'Torres Fashion Boutique',  url: 'https://www.torresfashionboutique.com' },
    { name: "Ayala's Todo en Piel y Más", url: 'https://www.ayalastodoenpielymas.com' },
    { name: 'El Norteño Family Store',  url: 'https://elnortenofamilystore.com' },
    { name: 'MG Western',              url: 'https://mgwestern.com' },
    { name: "Jessica's Western Wear",   url: 'https://jessicaswesternwear.com' },
    { name: 'Torres Western Wear',      url: 'https://torreswesternwear.com' },
    { name: 'Family Western Wear',      url: 'https://familywesternwear.com' },
    { name: 'El Vaquero Co.',           url: 'https://elvaqueroco.com' },
    { name: 'Covarruvias Western Wear', url: 'https://covarruviaswesternwear.com' },
    { name: 'Twins Harbor Supply',      url: 'https://twinsharborsupply.com' },
    { name: 'Dos Amigos Western Wear',  url: 'https://dosamigoswesternwear.com' },
    { name: 'Astillero Boots',          url: 'https://astilleroboots.com' },
    { name: '2 Marías',                 url: 'https://www.2marias.com' }
  ];

  // Apply URL overrides from Theme Editor settings
  var urlOverridesEl = document.getElementById('ay-urls-' + SID);
  var urlOverrides = urlOverridesEl ? JSON.parse(urlOverridesEl.textContent) : {};
  sites = sites.map(function(s, i) {
    return urlOverrides[String(i)] ? { name: s.name, url: urlOverrides[String(i)] } : s;
  });

  function domainOf(url) { return url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, ''); }
  function initialsOf(n) { return n.split(/\s+/).map(function(w){return w[0]||'';}).join('').slice(0,2).toUpperCase(); }
  function mshotsUrl(url, attempt) {
    var base = 'https://image.thum.io/get/width/1200/crop/800/' + url + '/';
    return attempt ? base + '?r=' + attempt : base;
  }

  // Load static image overrides from Liquid-injected JSON
  var staticEl = document.getElementById('ay-static-' + SID);
  var staticImgs = staticEl ? JSON.parse(staticEl.textContent) : {};

  var imgs = {}, showAll = false, heroIdx = 0, cardEls = [];
  var grid = document.getElementById('ay-sites-grid-' + SID);

  // Build cards
  sites.forEach(function (site, idx) {
    var domain = domainOf(site.url);
    var initials = initialsOf(site.name);
    var card = document.createElement('div');
    card.className = 'ay-site-card' + (idx >= FEATURED ? ' ay-site-card--hidden' : '');
    card.setAttribute('data-domain', domain);
    card.innerHTML =
      '<div class="ay-card-bar">' +
        '<div class="ay-card-dots"><i></i><i></i><i></i></div>' +
        '<div class="ay-card-url" data-bar>' + domain + '</div>' +
      '</div>' +
      '<div class="ay-card-screen">' +
        '<img data-img src="" alt="' + site.name.replace(/"/g,'&quot;') + '" style="display:none;">' +
        '<div data-shimmer class="ay-card-shimmer">' +
          '<div class="ay-card-shimmer__inner">' +
            '<div class="ay-card-initials">' + initials + '</div>' +
            '<span class="ay-card-loading">Cargando vista previa…</span>' +
          '</div>' +
        '</div>' +
      '</div>' +
      '<div class="ay-card-footer">' +
        '<div class="ay-card-info">' +
          '<div class="ay-card-name">' + site.name + '</div>' +
          '<div class="ay-card-domain">' + domain + '</div>' +
        '</div>' +
        '<div class="ay-card-arrow"><svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><ellipse cx="12" cy="12" rx="4" ry="9"/><path d="M3.6 9h16.8M3.6 15h16.8"/></svg></div>' +
      '</div>';
    card.addEventListener('click', (function(s,d){ return function(){ openModal(s,d); }; })(site, domain));
    grid.appendChild(card);
    cardEls.push(card);
  });

  // Toggle expand/collapse
  document.getElementById('ay-toggle-' + SID).addEventListener('click', function () {
    showAll = !showAll;
    cardEls.forEach(function(c,i){ if(i>=FEATURED) c.classList.toggle('ay-site-card--hidden', !showAll); });
    this.textContent = showAll ? 'Mostrar menos' : 'Ver las ' + sites.length + ' marcas →';
  });

  // Pre-fill cards that have a static image (skip thum.io for those)
  sites.forEach(function(site){
    var d = domainOf(site.url);
    if (staticImgs[d]) { imgs[d] = staticImgs[d]; revealCard(d, staticImgs[d]); }
  });

  // ── Smart screenshot queue: only sites without a static image ──
  var pending = sites.filter(function(s){ return !staticImgs[domainOf(s.url)]; });
  var active = 0, MAX = 2;
  function pump() {
    while (active < MAX && pending.length) {
      var s = pending.shift(); active++;
      load(s, 0, function(){ active--; pump(); });
    }
  }
  function load(site, attempt, done) {
    var url = mshotsUrl(site.url, attempt);
    var im = new Image();
    im.onload = function () {
      var d = domainOf(site.url);
      imgs[d] = url;
      revealCard(d, url);
      if (done){ done(); done=null; }
    };
    im.onerror = function () {
      if (attempt < 8) {
        setTimeout(function(){ load(site, attempt+1, done||noop); }, 4000 + attempt*1500);
        if (done){ done(); done=null; }
      } else if (done){ done(); done=null; }
    };
    im.src = url;
  }
  function noop(){}
  function revealCard(domain, url) {
    var card = grid.querySelector('[data-domain="' + domain + '"]');
    if (!card) return;
    var img = card.querySelector('[data-img]');
    var shimmer = card.querySelector('[data-shimmer]');
    if (img){ img.src = url; img.style.display = 'block'; }
    if (shimmer) shimmer.style.display = 'none';
    rotateHero();
  }

  // ── Hero rotation ──
  var heroImg = document.getElementById('ay-hero-img-' + SID);
  var heroShimmer = document.getElementById('ay-hero-shimmer-' + SID);
  var heroUrl = document.getElementById('ay-hero-url-' + SID);
  function loadedKeys() { return Object.keys(imgs); }
  function rotateHero() {
    var keys = loadedKeys();
    if (!keys.length) return;
    var d = keys[heroIdx % keys.length];
    if (heroImg) { heroImg.src = imgs[d]; heroImg.style.display = 'block'; }
    if (heroShimmer) heroShimmer.style.display = 'none';
    if (heroUrl) heroUrl.textContent = d;
  }
  setInterval(function(){
    var keys = loadedKeys(); if (!keys.length) return;
    heroIdx = (heroIdx + 1) % keys.length; rotateHero();
  }, HERO_INTERVAL);
  pump();

  // ── Typewriter on scroll ──
  var typed = {};
  function typeBar(domain) {
    if (typed[domain] !== undefined) return;
    typed[domain] = 0;
    var card = grid.querySelector('[data-domain="' + domain + '"]');
    if (!card) return;
    var bar = card.querySelector('[data-bar]');
    if (!bar) return;
    var full = domain, i = 0;
    var step = Math.min(900, Math.max(500, full.length * 32)) / full.length;
    var t = setInterval(function(){
      i++;
      bar.textContent = i >= full.length ? full : full.slice(0,i) + '|';
      if (i >= full.length) { clearInterval(t); setTimeout(function(){ typed[domain]=-1; }, 800); }
    }, step);
  }
  if ('IntersectionObserver' in window) {
    var obs = {}, io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if (!e.isIntersecting) return;
        io.unobserve(e.target);
        typeBar(e.target.getAttribute('data-domain'));
      });
    }, { threshold: 0.35 });
    cardEls.forEach(function(c){
      var d = c.getAttribute('data-domain');
      if (!obs[d]){ obs[d]=true; io.observe(c); }
    });
  }

  // ── Modal ──
  var modal = document.getElementById('ay-modal-' + SID);
  var modalImg = document.getElementById('ay-modal-img-' + SID);
  var modalShimmer = document.getElementById('ay-modal-shimmer-' + SID);
  var modalName = document.getElementById('ay-modal-name-' + SID);
  var modalDomain = document.getElementById('ay-modal-domain-' + SID);
  var modalVisit = document.getElementById('ay-modal-visit-' + SID);

  function openModal(site, domain) {
    modalName.textContent = site.name;
    modalDomain.textContent = domain;
    modalVisit.href = site.url;
    if (imgs[domain]) {
      modalImg.src = imgs[domain]; modalImg.style.display = 'block';
      if (modalShimmer) modalShimmer.style.display = 'none';
    } else {
      modalImg.style.display = 'none';
      if (modalShimmer) modalShimmer.style.display = '';
    }
    modal.removeAttribute('hidden');
    requestAnimationFrame(function(){ modal.classList.add('is-open'); });
    document.body.style.overflow = 'hidden';
  }
  function closeModal() {
    modal.classList.remove('is-open');
    setTimeout(function(){ modal.setAttribute('hidden',''); document.body.style.overflow = ''; }, 350);
  }
  document.getElementById('ay-modal-overlay-' + SID).addEventListener('click', closeModal);
  document.getElementById('ay-modal-close-' + SID).addEventListener('click', closeModal);
  document.addEventListener('keydown', function(e){ if(e.key==='Escape' && modal.classList.contains('is-open')) closeModal(); });

  // ── Stats counter animation ──
  var statsObserved = false;
  var statsObs = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting && !statsObserved) {
        statsObserved = true;
        var counters = document.querySelectorAll('[data-count]');
        counters.forEach(function(el) {
          var target = parseInt(el.getAttribute('data-count'), 10);
          var duration = 2000;
          var start = 0;
          var startTime = null;
          function animate(ts) {
            if (!startTime) startTime = ts;
            var progress = Math.min((ts - startTime) / duration, 1);
            var eased = 1 - Math.pow(1 - progress, 3);
            el.textContent = Math.floor(eased * target);
            if (progress < 1) requestAnimationFrame(animate);
            else el.textContent = target;
          }
          requestAnimationFrame(animate);
        });
      }
    });
  }, { threshold: 0.3 });
  var statsSection = document.querySelector('.ay-stats');
  if (statsSection) statsObs.observe(statsSection);
})();
</script>

