{% comment %}
  ============================================================
  Aylesva Recursos — Premium Landing Section
  Didactic financial intermediary landing page.
  Features: Loan Simulator, Comparison Table & Micro-animations
  ============================================================
{% endcomment %}

{%- liquid
  assign brand_green = section.settings.color_brand
  assign navy = section.settings.color_navy
  assign light = section.settings.color_light
  assign white = section.settings.color_white
  assign accent = section.settings.color_accent
  assign logo_align = section.settings.logo_align
  assign contact_anchor = '#recursos-contact-' | append: section.id
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
  html {
    scroll-behavior: smooth !important;
  }
  #recursos-solutions-{{ section.id }}, #recursos-comparison-{{ section.id }}, #recursos-contact-{{ section.id }} {
    scroll-margin-top: clamp(80px, 10vw, 120px) !important;
  }
  #recursos-{{ section.id }} {
    --rc-brand: {{ brand_green }};
    --rc-navy: {{ navy }};
    --rc-light: {{ light }};
    --rc-white: {{ white }};
    --rc-accent: {{ accent }};
    --rc-accent-blue: #3B82F6;
    --rc-accent-green: #10B981;
    --rc-accent-orange: #F59E0B;
    --rc-ink: #0F172A;
    --rc-muted: #64748B;
    --rc-line: rgba(15,23,42,.08);
    --rc-radius: 24px;
    --rc-radius-sm: 16px;
    --rc-shadow: 0 1px 2px rgba(15,23,42,.04), 0 12px 32px rgba(15,23,42,.06);
    --rc-shadow-lg: 0 30px 60px -20px rgba(15,23,42,.15);
    --rc-maxw: 1240px;
    font-family: 'Manrope', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    color: var(--rc-ink);
    background: linear-gradient(135deg, #FAF5F5 0%, #FAF6F0 100%);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  #recursos-{{ section.id }} * { box-sizing: border-box; }
  #recursos-{{ section.id }} .rc-wrap { max-width: var(--rc-maxw); margin: 0 auto; padding: 0 24px; }

  /* ---------- TYPOGRAPHY & BUTTONS ---------- */
  #recursos-{{ section.id }} h1, #recursos-{{ section.id }} h2, #recursos-{{ section.id }} h3, #recursos-{{ section.id }} h4 { margin: 0; line-height: 1.2; font-weight: 800; color: var(--rc-navy); }
  #recursos-{{ section.id }} p { margin: 0; line-height: 1.6; }
  #recursos-{{ section.id }} .rc-eyebrow { display: inline-block; font-size: 13px; font-weight: 800; letter-spacing: 2px; text-transform: uppercase; color: var(--rc-brand); margin-bottom: 12px; }
  
  #recursos-{{ section.id }} .rc-btn { display: inline-flex; align-items: center; justify-content: center; font-size: 15px; font-weight: 700; padding: 14px 28px; border-radius: 30px; text-decoration: none; transition: all .25s ease; cursor: pointer; border: none; font-family: inherit; }
  #recursos-{{ section.id }} .rc-btn--primary { background: var(--rc-brand); color: #fff; box-shadow: 0 4px 14px rgba(45,90,67,.3); }
  #recursos-{{ section.id }} .rc-btn--primary:hover { background: var(--rc-navy); transform: translateY(-2px); box-shadow: 0 6px 20px rgba(45,90,67,.4); }
  #recursos-{{ section.id }} .rc-btn--ghost { background: transparent; color: var(--rc-navy); border: 2px solid var(--rc-navy); }
  #recursos-{{ section.id }} .rc-btn--ghost:hover { background: var(--rc-navy); color: #fff; transform: translateY(-2px); }
  #recursos-{{ section.id }} .rc-btn--light { background: var(--rc-white); color: var(--rc-navy); box-shadow: 0 4px 12px rgba(0,0,0,.08); }
  #recursos-{{ section.id }} .rc-btn--light:hover { background: var(--rc-brand); color: #fff; transform: translateY(-2px); box-shadow: 0 6px 16px rgba(45,90,67,.25); }

  /* ---------- LAYOUT SECTIONS ---------- */
  #recursos-{{ section.id }} .rc-band { padding: clamp(50px,7vw,92px) 0; }
  #recursos-{{ section.id }} .rc-band--gray { background: rgba(15,23,42,.02); border-top: 1px solid var(--rc-line); border-bottom: 1px solid var(--rc-line); }
  #recursos-{{ section.id }} .rc-section-head { text-align: center; max-width: 680px; margin: 0 auto clamp(36px,5vw,60px); }
  #recursos-{{ section.id }} .rc-section-head h2 { font-size: clamp(26px,3.2vw,38px); }
  #recursos-{{ section.id }} .rc-section-head p { font-size: 16px; color: var(--rc-muted); margin-top: 14px; }

  /* ---------- ANIMATION EFFECTS ---------- */
  @-webkit-keyframes rc-fadeup { from { opacity: 0; -webkit-transform: translateY(24px); transform: translateY(24px); } to { opacity: 1; -webkit-transform: translateY(0); transform: translateY(0); } }
  @keyframes rc-fadeup { from { opacity: 0; -webkit-transform: translateY(24px); transform: translateY(24px); } to { opacity: 1; -webkit-transform: translateY(0); transform: translateY(0); } }
  
  #recursos-{{ section.id }} .rc-reveal { opacity: 0; -webkit-transform: translateY(24px); transform: translateY(24px); transition: opacity .65s ease, transform .65s ease, -webkit-transform .65s ease; }
  #recursos-{{ section.id }} .rc-reveal.rc-in { opacity: 1; -webkit-transform: translateY(0); transform: translateY(0); }

  #recursos-{{ section.id }} .rc-hero-unique-copy { position: relative; z-index: 10; -webkit-animation: rc-fadeup 0.85s cubic-bezier(.25, 1, .5, 1) both; animation: rc-fadeup 0.85s cubic-bezier(.25, 1, .5, 1) both; }
  #recursos-{{ section.id }} .rc-hero-unique-collage { -webkit-animation: rc-fadeup 1s 0.15s cubic-bezier(.25, 1, .5, 1) both; animation: rc-fadeup 1s 0.15s cubic-bezier(.25, 1, .5, 1) both; }

  /* ---------- LOGO HEADER ---------- */
  #recursos-{{ section.id }} .rc-logo-wrap { padding: 24px 0 12px; }
  #recursos-{{ section.id }} .rc-logo { display: flex; }
  #recursos-{{ section.id }} .rc-logo--left { justify-content: flex-start; }
  #recursos-{{ section.id }} .rc-logo--center { justify-content: center; }
  #recursos-{{ section.id }} .rc-logo--right { justify-content: flex-end; }
  #recursos-{{ section.id }} .rc-logo img { height: clamp(48px,6vw,72px); width: auto; object-fit: contain; }
  #recursos-{{ section.id }} .rc-logo-text { font-size: 26px; font-weight: 800; color: var(--rc-brand); letter-spacing: -0.5px; display: flex; align-items: center; gap: 4px; }
  #recursos-{{ section.id }} .rc-logo-text b { color: var(--rc-accent); }

  /* ---------- 1. HERO SECTION ---------- */
  #recursos-{{ section.id }} .rc-hero { padding: clamp(40px,5vw,70px) 0; overflow: hidden; }
  #recursos-{{ section.id }} .rc-hero-unique-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px,5vw,64px); align-items: center; }
  #recursos-{{ section.id }} .rc-hero-unique-copy h1 { font-size: clamp(34px,4.5vw,56px); font-weight: 800; letter-spacing: -1.5px; color: var(--rc-navy); }
  #recursos-{{ section.id }} .rc-lede { font-size: clamp(16px,2vw,19px); line-height: 1.65; color: var(--rc-muted); margin-top: 24px; }
  #recursos-{{ section.id }} .rc-hero-unique-cta { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 32px; position: relative; z-index: 20; pointer-events: auto !important; }
  #recursos-{{ section.id }} .rc-trust { display: flex; flex-wrap: wrap; gap: 16px 28px; margin-top: 40px; padding-top: 28px; border-top: 1px solid var(--rc-line); }
  #recursos-{{ section.id }} .rc-trust-item { display: flex; align-items: center; gap: 9px; font-size: 14px; font-weight: 700; color: var(--rc-navy); }
  #recursos-{{ section.id }} .rc-check { width: 22px; height: 22px; border-radius: 50%; background: rgba(45,90,67,.1); color: var(--rc-brand); display: grid; place-items: center; flex: none; }
  #recursos-{{ section.id }} .rc-check svg { width: 14px; height: 14px; }
  
  /* Image collage style for Hero */
  #recursos-{{ section.id }} .rc-hero-unique-collage { display: grid; grid-template-columns: repeat(12, 1fr); gap: 16px; position: relative; }
  #recursos-{{ section.id }} .rc-hero-unique-tile { border-radius: var(--rc-radius); overflow: hidden; box-shadow: var(--rc-shadow); position: relative; aspect-ratio: 4/3; background: var(--rc-light); }
  #recursos-{{ section.id }} .rc-hero-unique-tile img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s ease; }
  #recursos-{{ section.id }} .rc-hero-unique-tile:hover img { transform: scale(1.06); }
  #recursos-{{ section.id }} .rc-hero-unique-tile--1 { grid-column: 1 / 8; grid-row: 1 / 4; aspect-ratio: 16/10; }
  #recursos-{{ section.id }} .rc-hero-unique-tile--2 { grid-column: 8 / 13; grid-row: 1 / 3; aspect-ratio: 1; }
  #recursos-{{ section.id }} .rc-hero-unique-tile--3 { grid-column: 8 / 13; grid-row: 3 / 5; aspect-ratio: 4/3; }
  #recursos-{{ section.id }} .rc-hero-unique-tile--4 { grid-column: 2 / 8; grid-row: 4 / 6; aspect-ratio: 16/9; }
  @media(max-width:820px) {
    #recursos-{{ section.id }} .rc-hero-unique-grid { grid-template-columns: 1fr; }
    #recursos-{{ section.id }} .rc-hero-unique-collage { display: none; }
  }

  /* ---------- 2. SOLUTIONS (TYPES OF LOANS) ---------- */
  #recursos-{{ section.id }} .rc-sol-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 30px; }
  #recursos-{{ section.id }} .rc-sol-card { background: var(--rc-white); border-radius: var(--rc-radius); overflow: hidden; border: 1px solid var(--rc-line); display:flex; flex-direction:column; transition: all .4s cubic-bezier(.25,.8,.25,1); }
  #recursos-{{ section.id }} .rc-sol-card:hover { transform: translateY(-8px); box-shadow: var(--rc-shadow-lg); border-color: transparent; }
  #recursos-{{ section.id }} .rc-card-img { height: 180px; width: 100%; background: var(--rc-brand); position: relative; overflow: hidden; }
  #recursos-{{ section.id }} .rc-card-img img { width:100%; height:100%; object-fit:cover; opacity: 0.85; transition: transform .6s ease; }
  #recursos-{{ section.id }} .rc-sol-card:hover .rc-card-img img { transform: scale(1.05); }
  #recursos-{{ section.id }} .rc-card-icon { position: absolute; bottom: -24px; left: 24px; width: 56px; height: 56px; border-radius: 50%; background: var(--rc-brand); color: #fff; display: grid; place-items: center; border: 4px solid var(--rc-white); box-shadow: var(--rc-shadow); }
  #recursos-{{ section.id }} .rc-card-icon svg { width: 24px; height: 24px; }
  #recursos-{{ section.id }} .rc-card-body { padding: 40px 24px 30px; flex-grow: 1; display: flex; flex-direction: column; }
  #recursos-{{ section.id }} .rc-card-eyebrow { display: inline-block; font-size: 11px; font-weight: 800; letter-spacing: 1px; text-transform: uppercase; color: var(--rc-brand); margin-bottom: 8px; }
  #recursos-{{ section.id }} .rc-sol-card h3 { font-size: clamp(20px, 2.5vw, 24px); margin: 0 0 12px; color: var(--rc-navy); }
  #recursos-{{ section.id }} .rc-sol-card p { font-size: 14.5px; color: var(--rc-muted); line-height: 1.6; margin-bottom: 24px; flex-grow: 1; }
  #recursos-{{ section.id }} .rc-card-link { font-size: 14.5px; font-weight: 700; color: var(--rc-brand); text-decoration: none; display: inline-flex; align-items: center; gap: 8px; }
  #recursos-{{ section.id }} .rc-card-link svg { transition: transform 0.25s ease; width: 18px; height: 18px; }
  #recursos-{{ section.id }} .rc-sol-card:hover .rc-card-link svg { transform: translateX(4px); }

  /* ---------- 3. INTERACTIVE SIMULATOR ---------- */
  .rc-sim-container { background: var(--rc-white); padding: 40px; border-radius: var(--rc-radius); border: 1px solid var(--rc-line); box-shadow: var(--rc-shadow-lg); display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 40px; margin-top: 40px; }
  .rc-sim-controls { display: flex; flex-direction: column; gap: 28px; }
  .rc-sim-slider-group { display: flex; flex-direction: column; gap: 10px; }
  .rc-sim-label-row { display: flex; justify-content: space-between; align-items: center; }
  .rc-sim-label { font-size: 15px; font-weight: 700; color: var(--rc-navy); }
  .rc-sim-value { font-size: 20px; font-weight: 800; color: var(--rc-brand); }
  .rc-sim-input { -webkit-appearance: none; width: 100%; height: 8px; border-radius: 999px; background: var(--rc-light); outline: none; border: 1px solid var(--rc-line); }
  .rc-sim-input::-webkit-slider-thumb { -webkit-appearance: none; width: 22px; height: 22px; border-radius: 50%; background: var(--rc-brand); cursor: pointer; border: 2px solid var(--rc-white); box-shadow: var(--rc-shadow); transition: transform 0.15s; }
  .rc-sim-input::-webkit-slider-thumb:hover { transform: scale(1.15); }
  .rc-sim-limits { display: flex; justify-content: space-between; font-size: 12px; color: var(--rc-muted); }
  
  .rc-sim-results { background: rgba(45,90,67,0.03); padding: 32px; border-radius: var(--rc-radius-sm); border: 1px solid var(--rc-line); display: flex; flex-direction: column; gap: 20px; justify-content: center; }
  .rc-sim-result-item { text-align: center; }
  .rc-sim-result-label { font-size: 12px; font-weight: 800; color: var(--rc-muted); letter-spacing: 1.5px; text-transform: uppercase; }
  .rc-sim-result-value { font-size: clamp(28px, 4vw, 36px); font-weight: 800; color: var(--rc-navy); margin-top: 4px; }
  .rc-sim-rec-box { background: var(--rc-white); padding: 20px; border-radius: 12px; border: 1px solid var(--rc-line); text-align: center; box-shadow: var(--rc-shadow); }
  .rc-sim-rec-title { font-size: 11px; font-weight: 800; color: var(--rc-accent); text-transform: uppercase; letter-spacing: 1px; }
  .rc-sim-rec-name { font-size: 16px; font-weight: 800; color: var(--rc-brand); margin-top: 4px; }
  @media(max-width:820px) {
    .rc-sim-container { grid-template-columns: 1fr; gap: 30px; padding: 24px; }
  }

  /* ---------- 4. COMPARISON TABLE ---------- */
  .rc-table-wrap { width: 100%; overflow-x: auto; margin-top: 40px; border-radius: var(--rc-radius-sm); border: 1px solid var(--rc-line); background: var(--rc-white); box-shadow: var(--rc-shadow); }
  .rc-table { width: 100%; border-collapse: collapse; min-width: 750px; font-size: 14.5px; text-align: left; }
  .rc-table th { background: var(--rc-light); padding: 18px 24px; font-weight: 800; color: var(--rc-navy); border-bottom: 1px solid var(--rc-line); }
  .rc-table td { padding: 20px 24px; border-bottom: 1px solid var(--rc-line); color: var(--rc-ink); vertical-align: middle; }
  .rc-table tr:last-child td { border-bottom: none; }
  .rc-table-badge { display: inline-flex; align-items: center; justify-content: center; padding: 4px 12px; border-radius: 999px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; }
  .rc-table-badge--blue { background: rgba(59,130,246,0.1); color: var(--rc-accent-blue); }
  .rc-table-badge--green { background: rgba(16,185,129,0.1); color: var(--rc-accent-green); }
  .rc-table-badge--orange { background: rgba(245,158,11,0.1); color: var(--rc-accent-orange); }

  /* ---------- 5. MISSION & VISION TABBED ---------- */
  #recursos-{{ section.id }} .rc-mv-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px,5vw,64px); align-items: start; }
  #recursos-{{ section.id }} .rc-mv-copy h2 { font-size: clamp(28px,3.5vw,42px); line-height: 1.15; margin-bottom: 24px; }
  #recursos-{{ section.id }} .rc-mv-tabs { display: flex; flex-direction: column; gap: 16px; margin-top: 24px; }
  #recursos-{{ section.id }} .rc-mv-tab { padding: 20px 24px; border-radius: var(--rc-radius-sm); border: 1px solid var(--rc-line); cursor: pointer; transition: all 0.3s; }
  #recursos-{{ section.id }} .rc-mv-tab h3 { font-size: 18px; margin-bottom: 6px; color: var(--rc-muted); transition: color 0.3s; }
  #recursos-{{ section.id }} .rc-mv-tab p { font-size: 14.5px; display: none; color: var(--rc-muted); margin-top: 8px; }
  #recursos-{{ section.id }} .rc-mv-tab.rc-active { border-color: var(--rc-brand); background: rgba(45,90,67,.02); }
  #recursos-{{ section.id }} .rc-mv-tab.rc-active h3 { color: var(--rc-brand); font-weight: 800; }
  #recursos-{{ section.id }} .rc-mv-tab.rc-active p { display: block; }
  
  #recursos-{{ section.id }} .rc-mv-val-wrap { background: var(--rc-white); padding: 40px; border-radius: var(--rc-radius); border: 1px solid var(--rc-line); box-shadow: var(--rc-shadow); }
  #recursos-{{ section.id }} .rc-values-grid { display: flex; flex-direction: column; gap: 20px; margin-top: 24px; }
  #recursos-{{ section.id }} .rc-value-card { background: var(--rc-light); padding: 24px; border-radius: var(--rc-radius-sm); border: 1px solid var(--rc-line); transition: transform 0.3s; }
  #recursos-{{ section.id }} .rc-value-card:hover { transform: translateY(-3px); }
  #recursos-{{ section.id }} .rc-value-card h4 { font-size: 16px; font-weight: 800; color: var(--rc-brand); margin: 0 0 6px; }
  #recursos-{{ section.id }} .rc-value-card p { font-size: 13.5px; color: var(--rc-muted); }
  @media(max-width:820px) {
    #recursos-{{ section.id }} .rc-mv-grid { grid-template-columns: 1fr; gap: 40px; }
  }

  /* ---------- 6. TIMELINE ---------- */
  #recursos-{{ section.id }} .rc-timeline { position: relative; max-width: 900px; margin: 0 auto; display: flex; flex-direction: column; gap: 32px; }
  #recursos-{{ section.id }} .rc-timeline::before { content:''; position: absolute; left: 26px; top: 12px; bottom: 12px; width: 2px; background: var(--rc-line); }
  #recursos-{{ section.id }} .rc-step { display: flex; gap: 24px; position: relative; }
  #recursos-{{ section.id }} .rc-step-dot { width: 54px; height: 54px; border-radius: 50%; background: var(--rc-white); border: 2px solid var(--rc-brand); display: grid; place-items: center; box-shadow: var(--rc-shadow); flex-shrink: 0; z-index: 1; }
  #recursos-{{ section.id }} .rc-step-num { font-size: 20px; font-weight: 800; color: var(--rc-brand); }
  #recursos-{{ section.id }} .rc-step-text { background: var(--rc-white); padding: 24px 30px; border-radius: var(--rc-radius-sm); border: 1px solid var(--rc-line); flex-grow: 1; box-shadow: var(--rc-shadow); }
  #recursos-{{ section.id }} .rc-step-text h3 { font-size: 18px; margin: 0 0 8px; color: var(--rc-navy); }
  #recursos-{{ section.id }} .rc-step-text p { font-size: 14.5px; color: var(--rc-muted); line-height: 1.5; }

  /* ---------- 7. STUDY FORM (INTERMEDIARY FLOW) ---------- */
  #recursos-{{ section.id }} .rc-form-wrap { max-width: 800px; margin: 0 auto; background: var(--rc-white); padding: clamp(24px, 5vw, 48px); border-radius: var(--rc-radius); border: 1px solid var(--rc-line); box-shadow: var(--rc-shadow-lg); }
  #recursos-{{ section.id }} .rc-form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  #recursos-{{ section.id }} .rc-field { display: flex; flex-direction: column; gap: 8px; }
  #recursos-{{ section.id }} .rc-span2 { grid-column: span 2; }
  #recursos-{{ section.id }} .rc-field label { font-size: 13.5px; font-weight: 700; color: var(--rc-navy); }
  #recursos-{{ section.id }} .rc-field input, #recursos-{{ section.id }} .rc-field select, #recursos-{{ section.id }} .rc-field textarea {
    height: 48px; padding: 0 16px; border-radius: 8px; border: 1px solid var(--rc-line); outline: none; font-family: inherit; font-size: 14.5px; color: var(--rc-ink); transition: border-color 0.25s;
  }
  #recursos-{{ section.id }} .rc-field input:focus, #recursos-{{ section.id }} .rc-field select:focus, #recursos-{{ section.id }} .rc-field textarea:focus { border-color: var(--rc-brand); }
  #recursos-{{ section.id }} .rc-field textarea { height: 120px; padding: 12px 16px; resize: vertical; }
  #recursos-{{ section.id }} .rc-form-actions { display: flex; justify-content: center; margin-top: 32px; }
  #recursos-{{ section.id }} .rc-form-note { display: flex; align-items: center; justify-content: center; gap: 8px; font-size: 12.5px; color: var(--rc-muted); margin-top: 18px; text-align: center; }
  #recursos-{{ section.id }} .rc-form-note svg { width: 16px; height: 16px; flex-shrink: 0; }
  #recursos-{{ section.id }} .rc-form-success { background: rgba(45,90,67,.08); border: 1px solid var(--rc-brand); color: var(--rc-brand); font-weight: 700; padding: 20px; border-radius: 8px; text-align: center; margin-bottom: 24px; font-size: 15px; line-height: 1.5; }
  @media(max-width:600px) {
    #recursos-{{ section.id }} .rc-disclosure-box {
      background: var(--rc-light);
      border: 1px solid var(--rc-line);
      border-radius: var(--rc-radius);
      padding: 30px;
      margin-top: 40px;
      font-size: 13px;
      line-height: 1.6;
      color: var(--rc-muted);
      text-align: left;
    }
    #recursos-{{ section.id }} .rc-disclosure-box h4 {
      font-family: 'Outfit', sans-serif;
      font-size: 15px;
      font-weight: 800;
      margin: 0 0 16px;
      color: var(--rc-navy);
      text-transform: uppercase;
      letter-spacing: 1px;
      border-bottom: 1px solid var(--rc-line);
      padding-bottom: 8px;
    }
    #recursos-{{ section.id }} .rc-disclosure-item {
      margin-bottom: 16px;
    }
    #recursos-{{ section.id }} .rc-disclosure-item:last-child {
      margin-bottom: 0;
    }
    #recursos-{{ section.id }} .rc-disclosure-item strong {
      color: var(--rc-navy);
      display: block;
      margin-bottom: 4px;
      font-size: 12px;
    }
    #recursos-{{ section.id }} .rc-disclosure-item ul {
      margin: 4px 0 0 18px;
      padding: 0;
    }
  }

  /* ============ WHATSAPP BUTTON ============ */
  #recursos-{{ section.id }} .rc-btn-whatsapp,
  #recursos-{{ section.id }} a.rc-btn-whatsapp {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 10px !important;
    background: #25D366 !important;
    color: #ffffff !important;
    font-family: 'Poppins', sans-serif !important;
    font-weight: 700 !important;
    font-size: 15px !important;
    padding: 14px 32px !important;
    border-radius: 60px !important;
    text-decoration: none !important;
