<script>
  function RecursosTab(el) {
    var tabs = el.parentElement.querySelectorAll('.rc-mv-tab');
    tabs.forEach(function(tab) {
      tab.classList.remove('rc-active');
    });
    el.classList.add('rc-active');
  }

  (function(){
    var root = document.getElementById('recursos-{{ section.id }}');
    if(!root) return;
    
    // Reveal animations on scroll
    var els = root.querySelectorAll('.rc-reveal');
    if(!('IntersectionObserver' in window)){ 
      els.forEach(function(e){ e.classList.add('rc-in'); }); 
      return; 
    }
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(en){
        if(en.isIntersecting){ 
          en.target.classList.add('rc-in'); 
          io.unobserve(en.target); 
        }
      });
    }, { threshold: 0.1 });
    els.forEach(function(e){ io.observe(e); });


    // Smooth scroll handled natively by CSS scroll-behavior



  })();
</script>

