<style>

  @media (max-width: 480px) {

  .flex-active-slide .slider-content-wrap.left.effect_left {
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    bottom: 0;
    margin: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
}    
</style>

<script>
  $(window).load(function() {
    $('.flexslider.type_slide').flexslider({
      animation: "slide"
    });


        $('.flexslider.type_fade').flexslider({
      animation: "fade"
    });
    
  });
</script>
{% schema %}
 {
   "name": "Slideshow",
   "class": "tt-flexslider",
   "settings": [
     {
       "type": "checkbox",
       "id": "slider_home_auto",
       "label": "Auto-rotate slides"
     },
     {

         "type": "range",
  "id": "slider_home_rate",
  "min": 1000,
  "max": 9000,
  "step": 1000,
  "label": "AutoPlay Speed",
  "default": 8000

       
     },
     {
       "type": "select",
       "id": "slider_animation_type",
       "label": "Transition effect",
       "options": [
         {
           "value": "slide",
           "label": "Slide"
         },
         {
           "value": "fade",
           "label": "Fade"
         }
       ]
     },
	{
       "type": "color",
       "id": "slide_button_bg_color",
       "label": "Button Background Color",
       "default": "#000000"
     },
     {
       "type": "color",
       "id": "slide_button_bg_hover_color",
       "label": "Button Background Hover Color",
       "default": "#ffc446"
     },
     {
       "type": "color",
       "id": "slide_button_txt_color",
       "label": "Button Text Color",
       "default": "#ffffff"
     },
     {
       "type": "color",
       "id": "slide_button_txt_hover_color",
       "label": "Button Text Hover Color",
       "default": "#000000"
     }
   ],
   "blocks" : [
     {
       "type": "image",
       "name": "Slide",
       "settings": [
         {
           "type": "image_picker",
           "id": "image",
           "label": "Image"
         },
	{
         "type": "checkbox",
         "id": "show_video",
         "label": "Show video",
         "default":false
     	},
{
       "type": "video_url",
       "id": "video_url",
       "label": "YouTube link",
       "accept": ["youtube", "vimeo"]
     },
		  {
         "type": "color",
         "id": "title_color",
         "label": "Title Color",
         "default":"#fff"
         },
         {
         "type": "color",
         "id": "subtitle_color",
         "label": "Subtitle Color",
         "default":"#fff"
         },
	{
         "type": "color",
         "id": "subtitle_bgcolor",
         "label": "Subtitle Background Color",
         "default":"#fff"
         },
		{
         "type": "color",
         "id": "btn_bg_color",
         "label": "button background Color",
         "default":"#EB3039"
         },{
         "type": "color",
         "id": "btn_txt_color",
         "label": "Button text Color",
         "default":"#fff"
         },
		{
         "type": "color",
         "id": "btn_bghover_color",
         "label": "button hover background Color",
         "default":"#000"
         },{
         "type": "color",
         "id": "btn_hovertxt_color",
         "label": "Button hover text Color",
         "default":"#fff"
         },
         {
         "type": "select",
         "id": "text_position",
         "label": "Text Position",
         "options": [
           {
             "value": "left",
             "label": "left"
           },
           {
             "value": "right",
             "label": "Right"
           },
           {
             "value": "center",
             "label": "Center"
           }
         ]
       },
	{
         "type": "select",
         "id": "bottom_desc_position",
         "label": "Bottom Description Position",
         "options": [
           {
             "value": "left",
             "label": "left"
           },
           {
             "value": "right",
             "label": "Right"
           },
           {
             "value": "center",
             "label": "Center"
           }
         ]
       },
        {
         "type": "select",
         "id": "text_effect",
         "label": "Text Effect",
         "options": [
           {
             "value": "left",
             "label": "left"
           },
           {
             "value": "right",
             "label": "Right"
           },
           {
             "value": "top",
             "label": "Top"
           },
           {
             "value": "bottom",
             "label": "Bottom"
           }
         ]
       },
        {
           "type": "textarea",
           "id": "title",
           "label": "Title",
           "default": "Minimal Work Portfolio"
         },
		{
           "type": "textarea",
           "id": "sub_title",
           "label": "Sub Title",
           "default": "New Decoration Furniture Home, Office"
         },
		{
           "type": "text",
           "id": "btn_txt",
           "label": "button text",
           "default": "shop now"
         },
		{
           "type": "url",
           "id": "btn_link",
           "label": "button link"
         }
       ]
     }
   ],
   "presets": [
     {
       "name": "Slideshow",
       "category": "Image",
       "settings": {
         "slider_home_auto": true
       },
       "blocks": [
         {
           "type": "image"
         },
         {
           "type": "image"
         }
       ]
     }
   ]
 }
{% endschema %}