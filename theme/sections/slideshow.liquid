{% if section.blocks.size > 0 %}
  {% assign slider_enabled = true %}
  <div class="flexslider type_{{ section.settings.slider_animation_type }}" id="flexslider--{{ section.id }}" data-section-id="{{ section.id }}" data-section-type="slideshow-section" data-autoplay="{{ section.settings.slider_home_auto }}" data-speed="{{ section.settings.slider_home_rate }}" data-animation-type="{{ section.settings.slider_animation_type }}">
    <ul class="slides">
      {% for block in section.blocks %}
        {% if block.settings.image != blank %}
          <li id="slide--{{ block.id }}" data-flexslider-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            
            {% if block.settings.show_video == false %}
            <img loading="lazy" height="auto" width="1903px" src="{{  block.settings.image | img_url: "1903x" }}" alt="slider-image" />
            {% endif %}

            {% if block.settings.show_video == true %}
            <div id="popup_toggle">
              <div class="videoimg">  
                <img loading="lazy" height="auto" width="1903" src="{{ block.settings.image | img_url: '1903x'}}" alt="slider"/>
                {% if block.settings.title != blank %}
                <div class="slider-content-wrap {{ block.settings.text_position }} effect_{{ block.settings.text_effect }}"> 
                  {% if block.settings.sub_title != blank %}
                  <div class="slider-subtitle" style="color:{{block.settings.subtitle_color }};background:{{block.settings.subtitle_bgcolor }}">{{ block.settings.sub_title }}</div> 
                  {% endif %}
                  <div class="slider-title" style="color:{{block.settings.title_color }}">{{ block.settings.title }}</div>  
                  <div class="slider-button"><a class="btn" href=" {% if block.settings.btn_url != blank %}{{ block.settings.btn_url }}{% else %}#{% endif %}">{{ block.settings.btn_txt }}</a></div>
                </div>
                {% endif %}
                <span class="play-icone"><i class="mdi mdi-play-circle" aria-hidden="true"></i></span>       
              </div>
            </div>
            <div class="popup_overlay">
              <div class="popup" id="popupVid">
                {% if block.settings.video_url.id == blank %}
                <iframe src="//www.youtube.com/embed/_9VUPq3SxOc?autoplay=1&showinfo=0&rel=0&enablejsapi=1?vq=720" width="1903" height="600" frameborder="0" allowfullscreen></iframe>
                {% else %}
                {% if block.settings.video_url.type == "youtube" %}
                <iframe src="//www.youtube.com/embed/{{ block.settings.video_url.id }}?vq=720&rel=0&loop=1&autoplay=1&background=1&enablejsapi=1&muted=1&player_id=bgvid-0" width="1903" height="940" allow='autoplay' frameborder="0" allowfullscreen></iframe>
                {% elsif block.settings.video_url.type == "vimeo" %}
                <iframe src="//player.vimeo.com/video/{{ block.settings.video_url.id }}?byline=0&portrait=0&badge=0&loop=1&autoplay=1&enablejsapi=1&background=1&muted=1&player_id=bgvid-0" width="1903" height="600" frameborder="0" allowfullscreen></iframe>
                {% endif %}
                {% endif %}
              </div>
            </div>
            {% endif %}
            {% if block.settings.show_video == false %}
            {% if block.settings.title != blank %}
            <div class="slider-content-wrap {{ block.settings.text_position }} effect_{{ block.settings.text_effect }}">
              <div class="slider-title" style="color:{{block.settings.title_color }}">{{ block.settings.title }}</div>
              <div class="slider-subtitle" style="color:{{block.settings.subtitle_color }};background:{{block.settings.subtitle_bgcolor }}">{{ block.settings.sub_title }}</div>   
              <div class="slider-button">
                <a href="{{block.settings.btn_link }}" class="btn" style="background-color:{{block.settings.btn_bg_color}};color:{{block.settings.btn_txt_color}}">{{block.settings.btn_txt}}</a>
              </div>
            </div>
            {% endif %}
            {% endif %}      
                    
            {% if block.settings.btn_txt != blank %}
            <style>#slide--{{ block.id }} .slider-button > a:hover{background-color:{{ block.settings.btn_bghover_color }} !important;color:{{ block.settings.btn_hovertxt_color }} !important;}</style>
            {% endif %}
            
          </li>
          {% else %}
            <li id="slide--{{ block.id }}" data-flexslider-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
              <span class="slide-link">
                {% capture current %}{% cycle 1, 2 %}{% endcapture %}
                {{ 'lifestyle-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
              </span>
            </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>
{% endif %}
<style>.flex-direction-nav a{border-color:{{ section.settings.slide_button_bg_color}};background:{{ section.settings.slide_button_bg_color}};}.flex-direction-nav a:hover{border-color:{{ section.settings.slide_button_bg_hover_color}};background:{{ section.settings.slide_button_bg_hover_color}};}.flex-direction-nav .flex-next:hover::before,.flex-direction-nav .flex-prev:hover::before{color:{{ section.settings.slide_button_txt_hover_color}};}.flex-direction-nav .flex-next::before, .flex-direction-nav .flex-prev::before {color: {{ section.settings.slide_button_txt_color}};text-align: center;width: 100%;float: left;}.flex-direction-nav a.flex-next:hover::before ,.flex-direction-nav a.flex-prev:hover::before {color:{{ section.settings.slide_button_txt_hover_color}}; }@media screen and (max-width: 480px) {.flex-direction-nav a{border-color:transparent;}.flex-direction-nav a:hover{border-color:transparent;background:none;}}</style>
