6s}.flex-active-slide .slider-content-wrap.right.effect_left{right:auto;left:58%;opacity:1;text-align:center}.slider-content-wrap.right.effect_top{right:10%;left:auto;top:0;opacity:0;text-align:left;bottom:auto;transition:all 0.3s;-webkit-transition:all 0.3s}.flex-active-slide .slider-content-wrap.right.effect_top{top:30%;opacity:1}.slider-content-wrap.center.effect_top{left:0;right:0;margin:0 auto;text-align:center;top:30%}.slider-content-wrap.center{left:0;right:0;margin:0 auto;text-align:center;top:30%;width:30%}.flexslider .slider-content-wrap.center .slider-button>a{float:none;display:inline-block;vertical-align:top}.slider-content-wrap.center.effect_bottom{left:0;right:0;margin:0 auto;text-align:center;top:auto;bottom:0;transition:all 0.3s;-webkit-transition:all 0.3s;opacity:0}.flex-active-slide .slider-content-wrap.center.effect_bottom{bottom:30%;opacity:1}.slider-content-wrap.center.effect_top{left:0;right:0;margin:0 auto;text-align:center;top:0;bottom:auto;transition:all 0.3s;-webkit-transition:all 0.3s;opacity:0}.flex-active-slide .slider-content-wrap.center.effect_top{top:25%;opacity:1}.flexslider.type_slide .slider-content-wrap{transition:all 0.9s!important;-webkit-transition:all 0.9s!important}.slider-title{font-size:60px;font-weight:700;line-height:70px;text-transform:capitalize;margin:0 0 30px 0}.slider-subtitle{font-size:20px;font-weight:400;margin-top:0;padding:0 0 30px;line-height:24px;font-style:normal;text-transform:capitalize}.flexslider .slider-content-wrap .slider-button>a{float:none;display:inline-block;vertical-align:top;width:auto;padding:10px 25px;border-radius:25px;text-transform:capitalize}@media screen and (max-width:1500px){.slider-title{font-size:44px;line-height:44px}}@media screen and (max-width:1459px){.slider-title{font-size:40px;line-height:50px;margin:0 0 20px 0}}@media screen and (max-width:1300px){.slider-subtitle{font-size:16px;line-height:20px}.slider-desc span{font-size:18px}.slider-desc.left{font-size:14px}}@media(max-width:1199px){.slider-title{margin:0 0 15px 0;font-size:26px;line-height:30px}.slider-subtitle{padding:0 0 20px;font-size:14px;line-height:16px}.slider-content-wrap.right.effect_left{bottom:40%}.flex-active-slide .slider-content-wrap.left.effect_right{right:26%}.flex-active-slide .slider-content-wrap.center.effect_bottom{bottom:20%}}@media screen and (max-width:991px){.flex-active-slide .slider-content-wrap.center.effect_top{top:20%}.flex-active-slide .slider-content-wrap.left.effect_right{right:40%}}@media screen and (max-width:767px){.slider-content-wrap{width:50%;}.slider-content-wrap.left.effect_left{bottom:25%;}.slider-content-wrap.center .slider-button,.slider-content-wrap.center .slider-subtitle{margin-top:0}.slider-button>a{padding:5px 10px}.slider-subtitle{font-size:14px;line-height:16px}.flex-active-slide .slider-content-wrap.left.effect_right{right:32%}.flex-active-slide .slider-content-wrap.center.effect_bottom{bottom:20%}}@media screen and (max-width:543px){.flex-active-slide .slider-content-wrap.left.effect_left{left:14%;}.slider-content-wrap.left.effect_right,.slider-content-wrap.left.effect_left{bottom:25%;}.slider-button>a{padding:2px 5px}.slider-button{float:left;width:100%}.flexslider .slider-content-wrap .slider-button>a{padding:6px 20px}.slider-content-wrap{width:60%}.slider-title{font-size:20px;line-height:24px;margin:0 0 10px 0}.flex-active-slide .slider-content-wrap.left.effect_right{right:26%}.slider-content-wrap.center{width:50%}.slider-subtitle{padding:0 0 15px}.flex-active-slide .slider-content-wrap.right.effect_left{left:28%}}@media screen and (max-width:480px){.flex-active-slide .slider-content-wrap.right.effect_right,.slider-content-wrap.left.effect_left,.slider-content-wrap.left.effect_right,.slider-content-wrap.right.effect_right,.slider-content-wrap.right.effect_left{bottom:10%}.slider-desc.left,.slider-desc.right{font-size:12px;bottom:3px}.slider-desc span{font-size:15px}.slider-content-wrap.left.effect_right,.slider-content-wrap.left.