{% if template.name == 'product' %}
  <script src="{{ 'threesixty.min.js' | asset_url}}" defer="defer"></script>
  <script src="{{ 'jquery.zoom.min.js' | asset_url}}" defer="defer"></script>
{% endif %}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign sold_out = true -%}
{% if product.available %}{%- assign sold_out = false -%}{% endif %}

<style>
  /* ── DUAL VIEWER TOGGLE ── */
  @media (max-width: 767px) {
    .ayl-desktop-viewer-wrapper { display: none !important; }
    .ayl-mobile-viewer-wrapper { display: block !important; }
  }
  @media (min-width: 768px) {
    .ayl-mobile-viewer-wrapper { display: none !important; }
    .ayl-desktop-viewer-wrapper { display: block !important; }
  }
</style>

<div class="product-page">
  <div class="container">
    <div class="row">
      <div itemscope itemtype="http://schema.org/Product" class="product-template__container page-width" id="ProductSection-{{ section.id }}" data-section-id="{{ section.id }}" data-section-type="product-template" data-enable-history-state="true" data-zoom-enable="{{ section.settings.product_image_zoom_enable }}" data-ajax-enabled="{{ settings.use_ajax_cart }}">
        <div class="product-single{% if section.settings.product_layout == 'design_1' or section.settings.product_layout == 'design_4' %} {{ section.settings.thumb_position }}{% endif %} {{ section.settings.product_layout }} demo"> 
          <div class="product-single-wrap" style="width: 100% !important; max-width: 100% !important; padding: 0 !important;">
            
            <!-- 1. VISOR MÓVIL (AMAZON STYLE - INTACTO) -->
            <div class="ayl-mobile-viewer-wrapper">
              {% render 'ayl-amazon-product-viewer', 
                product: product, 
                section: section 
              %}
            </div>

            <!-- 2. VISOR DESKTOP (PREMIUM LUXURY - NUEVO) -->
            <div class="ayl-desktop-viewer-wrapper">
              {% render 'ayl-premium-desktop-viewer', 
                product: product, 
                section: section 
              %}
            </div>
            
          </div>

          <!-- PESTAÑAS CENTRALIZADAS (SOLO UNA VEZ EN TODA LA PÁGINA) -->
          <div class="ayl-central-tabs hidden-xs" style="margin-top: 30px;">
             {% render 'product-tabs', product: product, section: section %}
          </div>

          {% if section.settings.related_products_enable %}     
            <div class="ayl-related-section" style="margin-top: 40px; border-top: 8px solid #F0F2F2; padding-top: 30px; margin-left: -15px; margin-right: -15px;">
               {% render 'related-products', product: product %}
            </div>
          {% endif %}
          
          {% comment %} Old Recently Viewed Removed for Premium Version {% endcomment %}
        </div>

        {% comment %} Sticky Add to Cart Bar (DESACTIVADO POR PETICIÓN: DEMASIADO INVASIVO)
        {% render 'product-sticky-cart', product: product, section: section, current_variant: current_variant %}
        {% endcomment %}
        
        {% comment %} Modals (Size Chart, Notify Me) {% endcomment %}
        {% render 'product-modals', section: section, product: product %}
        
      </div>    
    </div>
  </div>
</div>

{% comment %} Product Page Scripts and JSON Data {% endcomment %}
{% render 'product-scripts', product: product, section: section %}

