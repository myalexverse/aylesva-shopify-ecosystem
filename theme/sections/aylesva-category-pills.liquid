{%- style -%}
  .aylesva-pills-{{ section.id }} {
    padding: 25px 0;
    background: {{ section.settings.bg_color }};
    display: block !important;
    visibility: visible !important;
    opacity: 1 !important;
    overflow: hidden;
  }

  .ayl-pills-container {
    max-width: 1520px; /* Increased from 1400px to allow all 7 pills to fit perfectly without crop */
    margin: 0 auto;
    padding: 0 40px;
  }

  .ayl-pills-row {
    display: flex;
    flex-direction: row;
    justify-content: flex-start; /* Default to start to prevent left/right clipping on overflow */
    align-items: center;
    gap: 16px;
    overflow-x: auto;
    padding: 10px 4px;
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* IE 10+ */
    -webkit-overflow-scrolling: touch;
  }

  @media (min-width: 1506px) {
    .ayl-pills-row {
      justify-content: center; /* Center the pills only when the screen fits them entirely */
    }
  }

  .ayl-pills-row::-webkit-scrollbar {
    display: none; /* Safari and Chrome */
  }

  .ayl-pill-card {
    display: flex;
    align-items: center;
    background: {{ section.settings.card_bg_color }};
    border-radius: 14px;
    text-decoration: none;
    overflow: hidden;
    width: 190px;
    height: 64px;
    flex-shrink: 0;
    border: 1px solid rgba(0,0,0,0.03);
    transition: all 0.35s cubic-bezier(0.165, 0.84, 0.44, 1);
    box-shadow: 0 2px 8px rgba(0,0,0,0.02);
  }

  .ayl-pill-card:hover {
    transform: translateY(-3px);
    background: #ffffff;
    border-color: #C5A47E;
    box-shadow: 0 8px 20px rgba(197, 164, 126, 0.15);
  }

  .ayl-pill-img-wrap {
    width: 58px;
    height: 64px;
    flex-shrink: 0;
    overflow: hidden;
    background: #f0f0f0;
    position: relative;
  }

  .ayl-pill-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.5s cubic-bezier(0.165, 0.84, 0.44, 1);
  }

  .ayl-pill-img-wrap .placeholder-svg {
    width: 100%;
    height: 100%;
    opacity: 0.3;
  }

  .ayl-pill-card:hover .ayl-pill-img-wrap img {
    transform: scale(1.08);
  }

  .ayl-pill-text {
    padding: 8px 12px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    flex-grow: 1;
  }

  .ayl-pill-title {
    font-size: 14px;
    font-weight: 700;
    color: #111111;
    margin: 0 0 2px 0;
    line-height: 1.2;
    font-family: 'Inter', sans-serif;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
    transition: color 0.3s ease;
  }

  .ayl-pill-card:hover .ayl-pill-title {
    color: #000000;
  }

  .ayl-pill-subtext {
    font-size: 11px;
    font-weight: 500;
    color: #C5A47E;
    margin: 0;
    line-height: 1.1;
    font-family: 'Inter', sans-serif;
    transition: color 0.3s ease;
  }

  .ayl-pill-card:hover .ayl-pill-subtext {
    color: #b2916c;
  }

  @media (max-width: 1200px) {
    .ayl-pills-row {
      justify-content: flex-start;
      padding-left: 20px;
      padding-right: 20px;
    }
    .ayl-pills-container {
      padding: 0;
    }
  }

  @media (max-width: 767px) {
    .aylesva-pills-{{ section.id }} {
      padding: 15px 0;
    }
    .ayl-pills-row {
      gap: 12px;
      padding: 8px 15px;
      scroll-snap-type: x mandatory;
    }
    .ayl-pill-card {
      scroll-snap-align: start;
      width: 175px;
      height: 58px;
      border-radius: 12px;
    }
    .ayl-pill-img-wrap {
      width: 52px;
      height: 58px;
    }
    .ayl-pill-title {
      font-size: 13px;
    }
    .ayl-pill-subtext {
      font-size: 10px;
    }
  }
{%- endstyle -%}

<section class="aylesva-pills-{{ section.id }}">
  <div class="ayl-pills-container">
    <div class="ayl-pills-row">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link | default: '#' }}" class="ayl-pill-card" {{ block.shopify_attributes }}>
          <div class="ayl-pill-img-wrap">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | img_url: '120x130', crop: 'center' }}" alt="{{ block.settings.title | escape }}" loading="lazy">
            {% else %}
              {%- assign handle = block.settings.title | handleize -%}
              {%- if handle == 'mujer' or handle == 'belleza' -%}
                {%- assign asset_name = handle | append: '-v2.png' -%}
              {%- else -%}
                {%- assign asset_name = handle | append: '.png' -%}
              {%- endif -%}
              <img src="{{ asset_name | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy">
            {% endif %}
          </div>
          <div class="ayl-pill-text">
            <h3 class="ayl-pill-title">{{ block.settings.title }}</h3>
            <span class="ayl-pill-subtext">{{ block.settings.subtext }}</span>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
