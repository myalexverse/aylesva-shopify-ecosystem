    { "type": "text", "id": "form_title", "label": "Encuentra tu Propiedad Ideal" },
    { "type": "text", "id": "form_subtitle", "label": "Subtítulo del Formulario" },
    { "type": "text", "id": "form_btn_text", "label": "Texto del Botón Enviar", "default": "Solicitar Asesoría" },
