<script>
  (function(){
    var root = document.getElementById('as-page-root');
    if(!root) return;

    var secPersonas = root.querySelector('#servicios-personas');
    var secEmpresas = root.querySelector('#servicios-empresas');

    function checkScrollTransitions() {
      var scrollPos = window.scrollY + (window.innerHeight / 2.5);
      
      var personasTop = secPersonas.offsetTop;
      var empresasTop = secEmpresas.offsetTop;

      if (scrollPos >= empresasTop) {
        root.className = 'as-theme-dark-empresas';
      } else if (scrollPos >= personasTop) {
        root.className = 'as-theme-light-personas';
      } else {
        root.className = 'as-theme-dark-hero';
      }

      var scrollPct = window.scrollY / (document.documentElement.scrollHeight - window.innerHeight);
      
      var sphere = root.querySelector('.as-shape-sphere');
      var prism = root.querySelector('.as-shape-prism');
      var torus = root.querySelector('.as-shape-torus');

      if(sphere) {
        sphere.style.transform = 'translateY(' + (scrollPct * 150) + 'px) rotate(' + (scrollPct * 360) + 'deg)';
      }
      if(prism) {
        prism.style.transform = 'translateY(' + (-scrollPct * 120) + 'px) rotateX(' + (scrollPct * 180) + 'deg) rotateY(' + (scrollPct * 180) + 'deg)';
      }
      if(torus) {
        torus.style.transform = 'translateY(' + (scrollPct * 90) + 'px) rotate(' + (-scrollPct * 270) + 'deg)';
      }
    }

    window.addEventListener('scroll', checkScrollTransitions);
    checkScrollTransitions();
  })();
</script>
