  }
  #rdp-luxury-{{ section.id }} .rdp-attr-label {
    font-size: 11.5px;
    letter-spacing: 0.06em;
    color: rgba(247, 244, 239, 0.8);
    text-transform: uppercase;
    font-weight: 500;
  }

  /* RESPONSIVE */
  @media (max-width: 1080px) {
    #rdp-luxury-{{ section.id }} .rdp-inner-grid {
      grid-template-columns: 1fr;
      padding: 40px 32px;
      gap: 36px;
    }
    #rdp-luxury-{{ section.id }} .rdp-stage-side {
      order: -1;
    }
    #rdp-luxury-{{ section.id }} .rdp-bottle-canvas {
      max-width: 360px;
    }
    #rdp-luxury-{{ section.id }} .rdp-floating-pill {
      right: 0;
      bottom: -10px;
    }
  }

  @media (max-width: 768px) {
    #rdp-luxury-{{ section.id }} {
      padding: 0 12px;
      margin: 24px 0 36px;
    }
    #rdp-luxury-{{ section.id }} .rdp-editorial-frame {
      border-radius: 20px;
    }
    #rdp-luxury-{{ section.id }} .rdp-inner-grid {
      padding: 28px 18px 24px;
    }
    #rdp-luxury-{{ section.id }} .rdp-brand-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
    #rdp-luxury-{{ section.id }} .rdp-heraldic-logo {
      height: 48px;
    }
    #rdp-luxury-{{ section.id }} .rdp-vertical-divider {
      display: none;
    }
    #rdp-luxury-{{ section.id }} .rdp-title {
