    #rdp-luxury-{{ section.id }} .rdp-cta-primary,
    #rdp-luxury-{{ section.id }} .rdp-cta-wa {
      width: 100%;
      justify-content: center;
    }
    #rdp-luxury-{{ section.id }} .rdp-attributes-bar {
      flex-direction: column;
      align-items: flex-start;
      padding: 16px 20px;
      gap: 10px;
    }
  }
</style>

<script>
  (function(){
    var root = document.getElementById('rdp-luxury-{{ section.id }}');
    if (!root) return;

    var wineCatalog = {
      lvo: {
        category: "GRAN RESERVA · TINTO",
        name: "L.V.O. Cosecha 2022",
        price: "$450 <small>MXN</small>",
        blend: "40% Tempranillo · 40% Cariñan · 20% Nebbiolo",
        barrel: "12 meses en barrica de roble francés",
        profile: "Ciruela negra madura, moras silvestres, café tostado y cacao. Final aterciopelado con taninos redondos y gran permanencia.",
        image: "{{ 'rdp-botella-lvo.jpg' | asset_url }}",
        alt: "Raíz de Plata L.V.O. 2022",
        pillTitle: "Valle de Barranquillas",
        pillSub: "Cosecha Seleccionada a Mano"
      },
      cabernet: {
        category: "VARIETAL TINTO · ROBLE",
        name: "Cabernet Sauvignon 2020",
        price: "$480 <small>MXN</small>",
        blend: "100% Cabernet Sauvignon",
        barrel: "14 meses en barrica de roble francés",
        profile: "Estructura potente y taninos elegantes. Aromas a cassis, pimienta negra, cacao amargo, sutiles notas de vainilla y tabaco dulce.",
        image: "{{ 'rdp-botella-cabernet.jpg' | asset_url }}",
        alt: "Raíz de Plata Cabernet Sauvignon 2020",
        pillTitle: "Valle de Barranquillas",
        pillSub: "Gran Reserva de Guarda"
      },
      syrah: {
        category: "VARIETAL TINTO · ALTURA",
        name: "Syrah Cosecha 2021",
        price: "$450 <small>MXN</small>",
        blend: "100% Syrah",
        barrel: "10 meses en barrica de roble",
        profile: "Mineralidad vibrante y frescura aromática. Notas de higo maduro, lavanda silvestre, pimienta rosa y trufa negra con cuerpo sedoso.",
        image: "{{ 'rdp-botella-syrah.jpg' | asset_url }}",
        alt: "Raíz de Plata Syrah 2021",
        pillTitle: "Viñedo Martínez",
        pillSub: "Terroir Mineral de Altura"
      },
      rose: {
        category: "ROSADO PROVENZAL",
        name: "Rosé Cosecha 2023",
        price: "$400 <small>MXN</small>",
        blend: "56% Syrah · 44% Cariñan",
        barrel: "Fermentación en frío sin barrica",
        profile: "Color salmón pálido provenzal. Aromas de fresas silvestres, pétalos de rosa, toronja rubí y una acidez fresca y crujiente.",
        image: "{{ 'rdp-botella-rose.jpg' | asset_url }}",
        alt: "Raíz de Plata Rosé 2023",
        pillTitle: "Viñedo Martínez",
        pillSub: "Fresco, Floral & Vibrante"
      },
      semillon: {
        category: "BLANCO MINERAL",
        name: "Semillón Cosecha 2023",
        price: "$400 <small>MXN</small>",
        blend: "100% Semillón",
        barrel: "Lías finas en tanque de acero inoxidable",
        profile: "Blanco de gran complejidad y pureza mineral. Aromas de lima kaffir, manzana verde, cera de abeja y jazmín con textura untuosa.",
        image: "{{ 'rdp-botella-semillon.jpg' | asset_url }}",
        alt: "Raíz de Plata Semillón 2023",
        pillTitle: "Viñedo Martínez",
        pillSub: "Blanco de Altura Mineral"
      }
    };

    var buttons = root.querySelectorAll('.rdp-vintage-btn');
    var elType = root.querySelector('#rdp-wine-type');
    var elName = root.querySelector('#rdp-wine-name');
    var elPrice = root.querySelector('#rdp-wine-price');
    var elBlend = root.querySelector('#rdp-wine-blend');
    var elBarrel = root.querySelector('#rdp-wine-barrel');
    var elProfile = root.querySelector('#rdp-wine-profile');
    var elImage = root.querySelector('#rdp-main-bottle-img');
    var elPillTitle = root.querySelector('#rdp-pill-title');
    var elPillSub = root.querySelector('#rdp-pill-sub');

    buttons.forEach(function(btn){
      btn.addEventListener('click', function(){
        var key = this.getAttribute('data-wine');
        var wine = wineCatalog[key];
        if (!wine) return;

        buttons.forEach(function(b){
          b.classList.remove('is-selected');
          b.setAttribute('aria-selected', 'false');
        });
        this.classList.add('is-selected');
        this.setAttribute('aria-selected', 'true');

        // Smooth bottle image transition
        elImage.style.opacity = '0';
        elImage.style.transform = 'scale(0.96)';

        setTimeout(function(){
          elImage.src = wine.image;
          elImage.alt = wine.alt;
          if (elType) elType.textContent = wine.category;
          if (elName) elName.textContent = wine.name;
          if (elPrice) elPrice.innerHTML = wine.price;
          if (elBlend) elBlend.textContent = wine.blend;
          if (elBarrel) elBarrel.textContent = wine.barrel;
          if (elProfile) elProfile.textContent = wine.profile;
          if (elPillTitle) elPillTitle.textContent = wine.pillTitle;
          if (elPillSub) elPillSub.textContent = wine.pillSub;

          elImage.style.opacity = '1';
          elImage.style.transform = 'scale(1)';
        }, 160);
      });
    });

  })();
</script>

