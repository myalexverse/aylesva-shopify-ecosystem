{% comment %}
  ============================================================
  Raíz de Plata — De Haro | Banner Editorial de Lujo para Marketplace
  Diseño refinado, atmósfera de cava y viñedo de altura, interactivo
  100% Responsive (Desktop & Mobile)
  ============================================================
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<section id="rdp-luxury-{{ section.id }}" class="rdp-editorial-wrapper">
  <div class="rdp-editorial-frame">
    
    <!-- BACKGROUND ATMOSPHERE -->
    <div class="rdp-bg-art">
      <div class="rdp-bg-photo" style="background-image: url('{{ 'rdp-vinedos-bg.jpg' | asset_url }}');"></div>
      <div class="rdp-bg-gradient"></div>
      <div class="rdp-vignette"></div>
      <div class="rdp-light-amber"></div>
      <div class="rdp-light-wine"></div>
    </div>

    <!-- INNER CONTENT GRID -->
    <div class="rdp-inner-grid">
      
      <!-- LEFT EDITORIAL NARRATIVE -->
      <div class="rdp-narrative-side">
        
        <!-- BRAND BADGE -->
        <div class="rdp-brand-row">
          <img src="{{ 'rdp-logo-gold.png' | asset_url }}" alt="Raíz de Plata — De Haro" class="rdp-heraldic-logo" width="160" height="80" loading="lazy">
          <div class="rdp-vertical-divider"></div>
          <div class="rdp-terroir-badge">
            <span class="rdp-gold-dot"></span>
            <span>JEREZ, ZACATECAS · 2,000 MSNM</span>
          </div>
        </div>

        <!-- MAIN TITLE -->
        <h2 class="rdp-title">
          El Arte del Vino en las <br>
          <span class="rdp-title-italic">Alturas de Zacatecas</span>
        </h2>

        <p class="rdp-description">
          Donde el sol generoso, la altitud y los suelos minerales dan origen a una expresión auténtica en cada racimo. Vinos artesanales de autor con crianza paciente en barricas de roble francés.
        </p>

        <!-- WINE INTERACTIVE SELECTOR STRIP -->
        <div class="rdp-selection-intro">
          <span class="rdp-label-text">COLECCIÓN DISPONIBLE</span>
          <span class="rdp-label-line"></span>
        </div>

        <div class="rdp-vintage-selector" role="tablist">
          <button type="button" class="rdp-vintage-btn is-selected" data-wine="lvo" role="tab" aria-selected="true">
            <span class="rdp-btn-tag">Tinto Ensamble</span>
            <span class="rdp-btn-name">L.V.O. 2022</span>
          </button>
          <button type="button" class="rdp-vintage-btn" data-wine="cabernet" role="tab" aria-selected="false">
            <span class="rdp-btn-tag">Tinto Roble</span>
            <span class="rdp-btn-name">Cabernet Sauvignon</span>
          </button>
          <button type="button" class="rdp-vintage-btn" data-wine="syrah" role="tab" aria-selected="false">
            <span class="rdp-btn-tag">Tinto Mineral</span>
            <span class="rdp-btn-name">Syrah 2021</span>
          </button>
          <button type="button" class="rdp-vintage-btn" data-wine="rose" role="tab" aria-selected="false">
            <span class="rdp-btn-tag">Rosado</span>
            <span class="rdp-btn-name">Rosé 2023</span>
          </button>
          <button type="button" class="rdp-vintage-btn" data-wine="semillon" role="tab" aria-selected="false">
            <span class="rdp-btn-tag">Blanco</span>
            <span class="rdp-btn-name">Semillón 2023</span>
          </button>
        </div>

        <!-- CURRENT WINE INFO PANEL -->
        <div class="rdp-tasting-card">
          <div class="rdp-card-header">
            <div>
              <span id="rdp-wine-type" class="rdp-wine-category">GRAN RESERVA · TINTO</span>
              <h3 id="rdp-wine-name" class="rdp-wine-heading">L.V.O. Cosecha 2022</h3>
            </div>
            <div class="rdp-price-wrap">
              <span class="rdp-price-currency">DESDE</span>
              <span id="rdp-wine-price" class="rdp-price-val">$400 <small>MXN</small></span>
            </div>
          </div>

          <div class="rdp-card-body">
            <div class="rdp-detail-cell">
              <span class="rdp-detail-lbl">Ensamble & Uvas</span>
              <p id="rdp-wine-blend" class="rdp-detail-txt">40% Tempranillo · 40% Cariñan · 20% Nebbiolo</p>
            </div>
            <div class="rdp-detail-cell">
              <span class="rdp-detail-lbl">Crianza</span>
              <p id="rdp-wine-barrel" class="rdp-detail-txt">12 meses en barrica de roble francés</p>
            </div>
            <div class="rdp-detail-cell full-span">
              <span class="rdp-detail-lbl">Perfil & Notas de Cata</span>
              <p id="rdp-wine-profile" class="rdp-detail-txt">Ciruela negra madura, moras silvestres, café tostado y cacao. Final aterciopelado con taninos redondos y gran permanencia.</p>
            </div>
          </div>

          <!-- CTAS -->
          <div class="rdp-buttons-row">
            <a id="rdp-btn-buy" href="https://www.raizdeplata.com/collections/all" target="_blank" rel="noopener noreferrer" class="rdp-cta-primary">
              <span>Explorar Selección Raíz de Plata</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
            <a id="rdp-btn-wa" href="https://wa.me/524941044143?text=Hola%2C%20me%20interesa%20adquirir%20vinos%20de%20Ra%C3%ADz%20de%20Plata%20en%20Aylesva%20Marketplace." target="_blank" rel="noopener noreferrer" class="rdp-cta-wa">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824z"/></svg>
              <span>Atención WhatsApp</span>
            </a>
          </div>
        </div>

      </div>

      <!-- RIGHT EDITORIAL BOTTLE STAGE -->
      <div class="rdp-stage-side">
        <div class="rdp-bottle-canvas">
          <div class="rdp-stage-aura"></div>
          <div class="rdp-stage-pedestal"></div>
          
          <div class="rdp-bottle-frame">
            <img id="rdp-main-bottle-img" src="{{ 'rdp-botella-lvo.jpg' | asset_url }}" alt="Raíz de Plata L.V.O." class="rdp-stage-bottle" width="819" height="1024" loading="lazy">
          </div>

          <!-- FLOATING TASTING PILL -->
          <div class="rdp-floating-pill">
            <span class="rdp-pill-icon">🍇</span>
            <div class="rdp-pill-text">
              <span id="rdp-pill-title" class="rdp-pill-main">Valle de Barranquillas</span>
              <span id="rdp-pill-sub" class="rdp-pill-sub">Cosecha Seleccionada a Mano</span>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- BOTTOM DELICATE ATTRIBUTES BAR -->
    <div class="rdp-attributes-bar">
      <div class="rdp-attr-item">
        <span class="rdp-attr-symbol">✦</span>
        <span class="rdp-attr-label">Terroir a 2,000 metros de altitud</span>
      </div>
      <div class="rdp-attr-item">
        <span class="rdp-attr-symbol">✦</span>
        <span class="rdp-attr-label">Suelos calcáreos de gran pureza mineral</span>
      </div>
      <div class="rdp-attr-item">
        <span class="rdp-attr-symbol">✦</span>
        <span class="rdp-attr-label">Crianza noble en barrica de roble francés</span>
      </div>
      <div class="rdp-attr-item">
        <span class="rdp-attr-symbol">✦</span>
        <span class="rdp-attr-label">Orgullo vitivinícola de Los Haro, Jerez</span>
      </div>
    </div>

  </div>
</section>

<style>
  #rdp-luxury-{{ section.id }} {
    --rdp-gold: #C5A47E;
    --rdp-gold-bright: #E2C79E;
    --rdp-gold-deep: #967448;
    --rdp-wine: #5A131E;
    --rdp-wine-dark: #2E070D;
    --rdp-obsidian: #0D0B0E;
    --rdp-charcoal: #17141A;
    --rdp-card: rgba(23, 20, 26, 0.78);
    --rdp-border-gold: rgba(197, 164, 126, 0.32);
    --rdp-border-soft: rgba(255, 255, 255, 0.08);
    --rdp-text-light: #F7F4EF;
    --rdp-text-muted: rgba(247, 244, 239, 0.72);
    
    width: 100%;
    margin: 44px 0 54px;
    padding: 0 24px;
    box-sizing: border-box;
    font-family: 'Montserrat', -apple-system, sans-serif;
    color: var(--rdp-text-light);
  }

  #rdp-luxury-{{ section.id }} * {
    box-sizing: border-box;
  }

  /* CONTAINED LUXURY FRAME */
  #rdp-luxury-{{ section.id }} .rdp-editorial-frame {
    position: relative;
    max-width: 1380px;
    margin: 0 auto;
    border-radius: 28px;
    overflow: hidden;
    background-color: var(--rdp-obsidian);
    border: 1px solid var(--rdp-border-gold);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45), 0 0 40px rgba(197, 164, 126, 0.12);
  }

  /* ATMOSPHERIC BACKGROUND */
  #rdp-luxury-{{ section.id }} .rdp-bg-art {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }
  #rdp-luxury-{{ section.id }} .rdp-bg-photo {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center 40%;
    filter: brightness(0.42) contrast(1.18);
    transform: scale(1.02);
    transition: transform 10s ease;
  }
  #rdp-luxury-{{ section.id }}:hover .rdp-bg-photo {
    transform: scale(1.05);
  }
  #rdp-luxury-{{ section.id }} .rdp-bg-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, rgba(13, 11, 14, 0.95) 0%, rgba(26, 17, 22, 0.88) 45%, rgba(13, 11, 14, 0.94) 100%);
  }
  #rdp-luxury-{{ section.id }} .rdp-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 75% 50%, transparent 20%, rgba(13, 11, 14, 0.85) 85%);
  }
  #rdp-luxury-{{ section.id }} .rdp-light-amber {
    position: absolute;
    width: 500px;
    height: 500px;
    right: 8%;
    top: 15%;
    background: radial-gradient(circle, rgba(197, 164, 126, 0.22) 0%, transparent 70%);
    filter: blur(70px);
  }
  #rdp-luxury-{{ section.id }} .rdp-light-wine {
    position: absolute;
    width: 600px;
    height: 600px;
    left: -100px;
    bottom: -100px;
    background: radial-gradient(circle, rgba(90, 19, 30, 0.28) 0%, transparent 65%);
    filter: blur(90px);
  }

  /* INNER GRID */
  #rdp-luxury-{{ section.id }} .rdp-inner-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 40px;
    align-items: center;
    padding: 56px 56px 44px;
  }

  /* NARRATIVE SIDE (LEFT) */
  #rdp-luxury-{{ section.id }} .rdp-narrative-side {
    display: flex;
    flex-direction: column;
  }

  /* BRAND ROW */
  #rdp-luxury-{{ section.id }} .rdp-brand-row {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 24px;
  }
  #rdp-luxury-{{ section.id }} .rdp-heraldic-logo {
    height: 64px;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 4px 10px rgba(0,0,0,0.5));
  }
  #rdp-luxury-{{ section.id }} .rdp-vertical-divider {
    width: 1px;
    height: 36px;
    background: linear-gradient(180deg, transparent, var(--rdp-border-gold), transparent);
  }
  #rdp-luxury-{{ section.id }} .rdp-terroir-badge {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 10.5px;
    letter-spacing: 0.16em;
    font-weight: 600;
    color: var(--rdp-gold-bright);
    text-transform: uppercase;
  }
  #rdp-luxury-{{ section.id }} .rdp-gold-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--rdp-gold);
    box-shadow: 0 0 6px var(--rdp-gold);
  }

  /* TITLES */
  #rdp-luxury-{{ section.id }} .rdp-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(34px, 3.8vw, 50px);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.01em;
    color: #FFFFFF;
    margin: 0 0 16px 0;
  }
  #rdp-luxury-{{ section.id }} .rdp-title-italic {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-weight: 400;
    color: var(--rdp-gold-bright);
    text-shadow: 0 0 20px rgba(197, 164, 126, 0.3);
  }
  #rdp-luxury-{{ section.id }} .rdp-description {
    font-size: 14px;
    line-height: 1.65;
    color: var(--rdp-text-muted);
    max-width: 58ch;
    margin: 0 0 28px 0;
  }

  /* SELECTOR STRIP */
  #rdp-luxury-{{ section.id }} .rdp-selection-intro {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 12px;
  }
  #rdp-luxury-{{ section.id }} .rdp-label-text {
    font-size: 10px;
    letter-spacing: 0.2em;
    font-weight: 700;
    color: var(--rdp-gold);
    text-transform: uppercase;
  }
  #rdp-luxury-{{ section.id }} .rdp-label-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--rdp-border-gold), transparent);
  }

  /* VINTAGE SELECTOR (BUTTONS) */
  #rdp-luxury-{{ section.id }} .rdp-vintage-selector {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 22px;
  }
  #rdp-luxury-{{ section.id }} .rdp-vintage-btn {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 8px 14px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    color: #E2DDD6;
    text-align: left;
  }
  #rdp-luxury-{{ section.id }} .rdp-vintage-btn:hover {
    background: rgba(197, 164, 126, 0.12);
    border-color: var(--rdp-gold);
    transform: translateY(-2px);
  }
  #rdp-luxury-{{ section.id }} .rdp-vintage-btn.is-selected {
    background: linear-gradient(135deg, rgba(197, 164, 126, 0.22) 0%, rgba(90, 19, 30, 0.35) 100%);
    border-color: var(--rdp-gold-bright);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.3);
  }
  #rdp-luxury-{{ section.id }} .rdp-btn-tag {
    font-size: 9.5px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--rdp-gold);
    font-weight: 600;
  }
  #rdp-luxury-{{ section.id }} .rdp-btn-name {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 15px;
    font-weight: 600;
    color: #FFFFFF;
    margin-top: 1px;
  }
  #rdp-luxury-{{ section.id }} .rdp-vintage-btn.is-selected .rdp-btn-name {
    color: var(--rdp-gold-bright);
  }

  /* TASTING CARD */
  #rdp-luxury-{{ section.id }} .rdp-tasting-card {
    background: var(--rdp-card);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--rdp-border-gold);
    border-radius: 18px;
    padding: 24px 26px;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.35);
  }
  #rdp-luxury-{{ section.id }} .rdp-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding-bottom: 14px;
    margin-bottom: 14px;
    border-bottom: 1px solid var(--rdp-border-soft);
    gap: 16px;
  }
  #rdp-luxury-{{ section.id }} .rdp-wine-category {
    display: inline-block;
    font-size: 10px;
    letter-spacing: 0.14em;
    font-weight: 700;
    color: var(--rdp-gold-bright);
    background: rgba(90, 19, 30, 0.6);
    border: 1px solid rgba(197, 164, 126, 0.3);
    padding: 3px 10px;
    border-radius: 4px;
    margin-bottom: 6px;
  }
  #rdp-luxury-{{ section.id }} .rdp-wine-heading {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 26px;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0;
  }
  #rdp-luxury-{{ section.id }} .rdp-price-wrap {
    text-align: right;
    flex-shrink: 0;
  }
  #rdp-luxury-{{ section.id }} .rdp-price-currency {
    display: block;
    font-size: 9px;
    letter-spacing: 0.16em;
    color: var(--rdp-gold);
    font-weight: 600;
  }
  #rdp-luxury-{{ section.id }} .rdp-price-val {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 24px;
    font-weight: 700;
    color: var(--rdp-gold-bright);
  }
  #rdp-luxury-{{ section.id }} .rdp-price-val small {
    font-size: 12px;
    font-family: 'Montserrat', sans-serif;
    color: rgba(255, 255, 255, 0.6);
  }

  /* DETAILS BODY */
  #rdp-luxury-{{ section.id }} .rdp-card-body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px 20px;
    margin-bottom: 20px;
  }
  #rdp-luxury-{{ section.id }} .rdp-detail-cell.full-span {
    grid-column: 1 / -1;
  }
  #rdp-luxury-{{ section.id }} .rdp-detail-lbl {
    display: block;
    font-size: 9.5px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--rdp-gold);
    font-weight: 600;
    margin-bottom: 2px;
  }
  #rdp-luxury-{{ section.id }} .rdp-detail-txt {
    font-size: 13px;
    line-height: 1.45;
    color: var(--rdp-text-muted);
    margin: 0;
  }

  /* BUTTONS ROW */
  #rdp-luxury-{{ section.id }} .rdp-buttons-row {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    padding-top: 14px;
    border-top: 1px solid var(--rdp-border-soft);
  }
  #rdp-luxury-{{ section.id }} .rdp-cta-primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 24px;
    background: linear-gradient(135deg, #D6B27C 0%, #C5A47E 50%, #9B784C 100%);
    color: #0E0C10;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.05em;
    border-radius: 999px;
    text-decoration: none;
    transition: all 0.25s ease;
    box-shadow: 0 4px 18px rgba(197, 164, 126, 0.35);
  }
  #rdp-luxury-{{ section.id }} .rdp-cta-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(197, 164, 126, 0.55);
    filter: brightness(1.08);
  }
  #rdp-luxury-{{ section.id }} .rdp-cta-wa {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 20px;
    background: rgba(37, 211, 102, 0.12);
    border: 1px solid rgba(37, 211, 102, 0.38);
    color: #25D366;
    font-size: 12.5px;
    font-weight: 600;
    border-radius: 999px;
    text-decoration: none;
    transition: all 0.25s ease;
  }
  #rdp-luxury-{{ section.id }} .rdp-cta-wa:hover {
    background: rgba(37, 211, 102, 0.22);
    border-color: #25D366;
    transform: translateY(-2px);
  }

  /* STAGE SIDE (RIGHT) */
  #rdp-luxury-{{ section.id }} .rdp-stage-side {
    display: flex;
    justify-content: center;
    align-items: center;
  }
  #rdp-luxury-{{ section.id }} .rdp-bottle-canvas {
    position: relative;
    width: 100%;
    max-width: 420px;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  #rdp-luxury-{{ section.id }} .rdp-stage-aura {
    position: absolute;
    width: 320px;
    height: 320px;
    top: 45%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgba(197, 164, 126, 0.3) 0%, rgba(90, 19, 30, 0.2) 50%, transparent 75%);
    filter: blur(45px);
    pointer-events: none;
  }
  #rdp-luxury-{{ section.id }} .rdp-bottle-frame {
    position: relative;
    z-index: 2;
    width: 100%;
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid var(--rdp-border-gold);
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.55), 0 0 30px rgba(197, 164, 126, 0.12);
    background-color: rgba(14, 12, 16, 0.5);
  }
  #rdp-luxury-{{ section.id }} .rdp-stage-bottle {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    transition: opacity 0.35s ease, transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }
  #rdp-luxury-{{ section.id }} .rdp-floating-pill {
    position: absolute;
    bottom: -16px;
    right: -12px;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(18, 15, 20, 0.9);
    border: 1px solid var(--rdp-border-gold);
    border-radius: 999px;
    padding: 8px 18px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.6);
    backdrop-filter: blur(10px);
  }
  #rdp-luxury-{{ section.id }} .rdp-pill-icon {
    font-size: 16px;
  }
  #rdp-luxury-{{ section.id }} .rdp-pill-main {
    display: block;
