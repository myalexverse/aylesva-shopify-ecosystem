{% comment %}
  Aylesva · Landing Page Corporativa "Nosotros"
  Gold & Ink Design System · Responsive · Modular
{% endcomment %}

<div class="ay ay-nosotros-wrapper">

  <!-- 1. HERO NOSOTROS -->
  <section class="ay-nosotros-hero">
    <div class="ay-wrap">
      <div class="ay-nosotros-hero-grid">
        
        <!-- Left: Text content -->
        <div class="ay-nosotros-hero-content">
          <p class="ay-eyebrow">GRUPO AYLESVA · IDENTIDAD Y VISIÓN</p>
          <h1 class="ay-h1 ay-nosotros-title">
            Impulsamos el presente.<br>
            <span style="color:var(--ay-gold-text);">Construimos el futuro.</span>
          </h1>
          <p class="ay-lead ay-nosotros-sub">
            Somos un ecosistema corporativo y comercial multi-vertical con presencia binacional en México y Estados Unidos. Diseñamos soluciones integrales que potencian a emprendedores, optimizan operaciones empresariales y protegen el patrimonio familiar.
          </p>

          <div class="ay-nosotros-pills">
            <span class="ay-pill">🏢 Holding Multi-Vertical</span>
            <span class="ay-pill">🌐 Conexión México · USA · Asia</span>
            <span class="ay-pill">⚡ Soluciones 360°</span>
            <span class="ay-pill">🔒 Seguridad & Respaldo Legal</span>
          </div>
        </div>

        <!-- Right: Hero Visual -->
        <div class="ay-nosotros-hero-media">
          <div class="ay-nosotros-img-frame">
            <img src="{{ 'corporate_architecture.jpg' | asset_url }}" 
                 alt="Sede Corporativa Grupo Aylesva" 
                 class="ay-nosotros-hero-img"
                 loading="eager">
            <div class="ay-nosotros-media-badge">
              <span class="ay-badge-dot"></span>
              <span>Sede Corporativa & Operaciones Binacionales</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 2. MANIFIESTO & PROPÓSITO -->
  <section class="ay-nosotros-manifesto">
    <div class="ay-wrap">
      <div class="ay-manifesto-grid">
        <div class="ay-manifesto-left">
          <p class="ay-eyebrow">NUESTRO PROPÓSITO</p>
          <h2 class="ay-h2 ay-manifesto-title">Un solo grupo, todas las respuestas estratégicas.</h2>
        </div>
        <div class="ay-manifesto-right">
          <p class="ay-manifesto-text">
            En <strong>Grupo Aylesva</strong> creemos que el crecimiento económico y la tranquilidad patrimonial no deben ser caminos complejos ni solitarios. Por ello, articulamos un ecosistema donde convergen el <strong>financiamiento inteligente</strong>, el <strong>comercio global</strong>, el <strong>desarrollo inmobiliario de alto valor</strong> y la <strong>protección integral de las familias</strong>.
          </p>
          <p class="ay-manifesto-text">
            Con operaciones estratégicas en México y Estados Unidos, eliminamos barreras operativas para que nuestros clientes e inversionistas se concentren en lo verdaderamente esencial: <em>crecer, prosperar y trascender</em>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. PILARES ESTRATÉGICOS -->
  <section class="ay-nosotros-pillars">
    <div class="ay-wrap">
      <div style="text-align:center;margin-bottom:56px">
        <p class="ay-eyebrow" style="justify-content:center;margin-bottom:12px">VALORES FUNDAMENTALES</p>
        <h2 class="ay-h2">Los pilares que guían nuestras decisiones</h2>
      </div>

      <div class="ay-pillars-grid">
        <div class="ay-pillar-card">
          <div class="ay-pillar-icon-box">
            <svg class="ay-icon" viewBox="0 0 24 24" stroke-linecap="square" aria-hidden="true">
              <path d="M12 3l8 3v6c0 5-4 8-8 9-4-1-8-4-8-9V6z"/>
              <path d="M8.5 12l2.5 2.5 4.5-5"/>
            </svg>
          </div>
          <h3 class="ay-pillar-title">1. Solidez y Cumplimiento</h3>
          <p class="ay-pillar-desc">
            Operamos bajo los más estrictos estándares legales, financieros y aduanales en cada jurisdicción donde participamos. La transparencia y la certeza jurídica son innegociables.
          </p>
        </div>

        <div class="ay-pillar-card">
          <div class="ay-pillar-icon-box">
            <svg class="ay-icon" viewBox="0 0 24 24" stroke-linecap="square" aria-hidden="true">
              <circle cx="12" cy="12" r="9"/>
              <path d="M3 12h18"/>
              <path d="M12 3c3 3 3 15 0 18-3-3-3-15 0-18z"/>
            </svg>
          </div>
          <h3 class="ay-pillar-title">2. Visión Binacional</h3>
          <p class="ay-pillar-desc">
            Comprendemos la realidad y el dinamismo entre México y EE. UU. Diseñamos productos y servicios pensados tanto para empresas transfronterizas como para la comunidad migrante.
          </p>
        </div>

        <div class="ay-pillar-card">
          <div class="ay-pillar-icon-box">
            <svg class="ay-icon" viewBox="0 0 24 24" stroke-linecap="square" aria-hidden="true">
              <path d="M4 20V8M10 20V4M16 20v-9M22 20h-20"/>
            </svg>
          </div>
          <h3 class="ay-pillar-title">3. Enfoque en Resultados</h3>
          <p class="ay-pillar-desc">
            No ofrecemos soluciones teóricas: entregamos llaves de inmuebles, tiendas online facturando, mercancía en bodega con aduana liberada y créditos aprobados con claridad.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. EL ECOSISTEMA: NUESTRAS DIVISIONES -->
  <section class="ay-nosotros-divisions">
    <div class="ay-wrap">
      <div style="text-align:center;margin-bottom:56px">
        <p class="ay-eyebrow" style="justify-content:center;margin-bottom:12px">UNIDADES DE NEGOCIO</p>
        <h2 class="ay-h2">El ecosistema de soluciones Aylesva</h2>
        <p style="font-size:16px;color:#64748b;margin:14px auto 0;max-width:58ch">
          Cada unidad está especializada en resolver un reto específico con equipo dedicado y tecnología de vanguardia.
        </p>
      </div>

      <div class="ay-divisions-grid">
        
        <!-- Division 1 -->
        <a href="/pages/aylesva-recursos" class="ay-div-card">
          <div class="ay-div-header">
            <span class="ay-div-tag">Fintech & Capital</span>
            <span class="ay-arrow">&rarr;</span>
          </div>
          <h3 class="ay-div-name">Aylesva Recursos</h3>
          <p class="ay-div-desc">Estudio de perfil y canalización ágil para financiamiento de capital de trabajo, expansión y adquisición de maquinaria.</p>
        </a>

        <!-- Division 2 -->
        <a href="/pages/aylesva-direct" class="ay-div-card">
          <div class="ay-div-header">
            <span class="ay-div-tag">Comercio Global</span>
            <span class="ay-arrow">&rarr;</span>
          </div>
          <h3 class="ay-div-name">Aylesva Direct</h3>
          <p class="ay-div-desc">Validación de fabricantes en China, gestión de compras internacionales, control de calidad y logística aduanal puerta a puerta.</p>
        </a>

        <!-- Division 3 -->
        <a href="/pages/globalestates" class="ay-div-card">
          <div class="ay-div-header">
            <span class="ay-div-tag">Bienes Raíces</span>
            <span class="ay-arrow">&rarr;</span>
          </div>
          <h3 class="ay-div-name">Global Estates</h3>
          <p class="ay-div-desc">Desarrollos inmobiliarios prémium frente al mar y destinos de alta plusvalía en México y El Salvador (Torre 40 Puerto Vallarta).</p>
        </a>

        <!-- Division 4 -->
        <a href="/pages/lanza-tu-propia-marca" class="ay-div-card">
          <div class="ay-div-header">
            <span class="ay-div-tag">E-Commerce 360°</span>
            <span class="ay-arrow">&rarr;</span>
          </div>
          <h3 class="ay-div-name">Lanza tu Tienda Online</h3>
          <p class="ay-div-desc">Diseño, sincronización de catálogo con más de 1,500 productos y envíos automatizados desde nuestro almacén. Sin inventario propio.</p>
        </a>

        <!-- Division 5 -->
        <a href="/pages/aylesva-care" class="ay-div-card">
          <div class="ay-div-header">
            <span class="ay-div-tag">Salud & Asistencia</span>
            <span class="ay-arrow">&rarr;</span>
          </div>
          <h3 class="ay-div-name">Aylesva Care</h3>
          <p class="ay-div-desc">Planes integrales de telemedicina 24/7 en español/inglés, descuentos médicos y red New Benefits en EE. UU. desde  USD/mes.</p>
        </a>

        <!-- Division 6 -->
        <a href="/pages/mi-ultima-voluntad" class="ay-div-card">
          <div class="ay-div-header">
            <span class="ay-div-tag">Previsión Familiar</span>
            <span class="ay-arrow">&rarr;</span>
          </div>
          <h3 class="ay-div-name">Mi Última Voluntad (MUV)</h3>
          <p class="ay-div-desc">Membresía de protección funeraria y coordinación de repatriación internacional México-EE. UU. con pases CBX incluidos.</p>
        </a>

      </div>
    </div>
  </section>

  <!-- 5. CIFRAS DE IMPACTO -->
  <section class="ay-nosotros-stats">
    <div class="ay-wrap">
      <div class="ay-stats-grid">
        <div class="ay-stat-box">
          <span class="ay-stat-num">6</span>
          <span class="ay-stat-label">Divisiones de Servicio</span>
        </div>
        <div class="ay-stat-box">
          <span class="ay-stat-num">+2,000</span>
          <span class="ay-stat-label">Productos en Catálogo</span>
        </div>
        <div class="ay-stat-box">
          <span class="ay-stat-num">23</span>
          <span class="ay-stat-label">Marcas Lanzadas</span>
        </div>
        <div class="ay-stat-box">
          <span class="ay-stat-num">2</span>
          <span class="ay-stat-label">Países con Cobertura (MX / USA)</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. CTA FINAL -->
  <section class="ay-nosotros-cta">
    <div class="ay-wrap ay-cta-inner">
      <p class="ay-eyebrow ay-eyebrow--dark" style="justify-content:center;margin-bottom:14px">ATENCIÓN PERSONALIZADA</p>
      <h2 class="ay-h2" style="color:#fff;font-size:clamp(32px,3.8vw,48px);margin-bottom:18px">¿Listo para impulsar tu siguiente proyecto?</h2>
      <p style="font-size:17px;color:rgba(255,255,255,.75);max-width:54ch;margin:0 auto 34px;line-height:1.65">
        Nuestro equipo multidisciplinario está a tu disposición para orientarte y diseñar la ruta más conveniente para tu negocio o patrimonio.
      </p>
      <div class="ay-cta-buttons">
        <a href="/#contacto" class="ay-btn ay-btn--gold">Contactar a un Asesor &rarr;</a>
        <a href="https://api.whatsapp.com/send/?phone=524774136612&text=Hola%2C+me+gustar%C3%ADa+conocer+m%C3%A1s+sobre+Grupo+Aylesva" target="_blank" rel="noopener" class="ay-btn ay-btn--ghost-dark">Hablar por WhatsApp</a>
      </div>
    </div>
  </section>

</div>

<style>
  .ay-nosotros-wrapper{background:#FFFFFF;color:var(--ay-ink-800)}
  
  /* Hero 2 Columns */
  .ay-nosotros-hero{background:var(--ay-stone);border-bottom:var(--ay-hairline);padding:64px 0 72px}
  .ay-nosotros-hero-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:48px;align-items:center}
  .ay-nosotros-title{font-size:clamp(34px,4vw,52px);font-weight:400;line-height:1.08;letter-spacing:-.03em;margin:0 0 20px;color:var(--ay-ink-900)}
  .ay-nosotros-sub{font-size:17px;line-height:1.68;color:#334155;margin:0 0 30px;text-wrap:pretty}
  .ay-nosotros-pills{display:flex;gap:10px;flex-wrap:wrap}
  .ay-pill{font-family:var(--ay-font-mono);font-size:11px;font-weight:500;letter-spacing:.08em;background:#FFFFFF;border:1px solid rgba(15,23,42,.12);padding:7px 14px;border-radius:100px;color:var(--ay-ink-800);box-shadow:0 2px 6px rgba(0,0,0,.03)}

  .ay-nosotros-hero-media{position:relative}
  .ay-nosotros-img-frame{position:relative;border-radius:12px;overflow:hidden;border:1px solid rgba(197,164,126,.4);box-shadow:0 24px 48px -16px rgba(2,6,23,.2)}
  .ay-nosotros-hero-img{width:100%;height:380px;object-fit:cover;display:block;transition:transform .6s ease}
  .ay-nosotros-hero-media:hover .ay-nosotros-hero-img{transform:scale(1.03)}
  .ay-nosotros-media-badge{position:absolute;bottom:16px;left:16px;right:16px;background:rgba(2,6,23,0.85);backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,.15);border-radius:6px;padding:10px 14px;display:flex;align-items:center;gap:10px;color:#fff;font-family:var(--ay-font-mono);font-size:11px;letter-spacing:.06em}
  .ay-badge-dot{width:8px;height:8px;border-radius:50%;background:var(--ay-gold);flex:0 0 8px;box-shadow:0 0 8px var(--ay-gold)}

  /* Manifesto */
  .ay-nosotros-manifesto{padding:88px 0;border-bottom:var(--ay-hairline)}
  .ay-manifesto-grid{display:grid;grid-template-columns:1fr 1.25fr;gap:56px;align-items:start}
  .ay-manifesto-title{font-size:clamp(28px,3vw,38px);line-height:1.18;color:var(--ay-ink-900)}
  .ay-manifesto-text{font-size:16.5px;line-height:1.75;color:#334155;margin:0 0 20px}

  /* Pillars */
  .ay-nosotros-pillars{padding:88px 0;background:var(--ay-stone);border-bottom:var(--ay-hairline)}
  .ay-pillars-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
  .ay-pillar-card{background:#FFFFFF;border:1px solid rgba(15,23,42,.1);border-radius:10px;padding:36px 28px;transition:transform .3s ease,box-shadow .3s ease}
  .ay-pillar-card:hover{transform:translateY(-4px);box-shadow:0 18px 36px -12px rgba(2,6,23,.12);border-color:var(--ay-gold)}
  .ay-pillar-icon-box{width:52px;height:52px;background:var(--ay-ink-900);border-radius:8px;display:flex;align-items:center;justify-content:center;margin-bottom:22px;border:1px solid rgba(197,164,126,0.3)}
  .ay-pillar-icon-box .ay-icon{stroke:var(--ay-gold-light);width:26px;height:26px}
  .ay-pillar-title{font-family:var(--ay-font-display);font-size:20px;font-weight:700;color:var(--ay-ink-900);margin:0 0 12px}
  .ay-pillar-desc{font-size:14.5px;line-height:1.65;color:#475569;margin:0}

  /* Divisions */
  .ay-nosotros-divisions{padding:88px 0;border-bottom:var(--ay-hairline)}
  .ay-divisions-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
  .ay-div-card{background:var(--ay-stone);border:1px solid rgba(15,23,42,.1);border-radius:10px;padding:30px 24px;text-decoration:none;color:inherit;transition:all .3s ease;display:flex;flex-direction:column}
  .ay-div-card:hover{background:#FFFFFF;transform:translateY(-4px);box-shadow:0 20px 40px -10px rgba(2,6,23,.14);border-color:var(--ay-gold)}
  .ay-div-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px}
  .ay-div-tag{font-family:var(--ay-font-mono);font-size:10px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--ay-gold-text);background:rgba(197,164,126,.15);padding:4px 10px;border-radius:4px}
  .ay-div-card .ay-arrow{font-size:16px;color:var(--ay-gold-text);transition:transform .25s ease}
  .ay-div-card:hover .ay-arrow{transform:translateX(5px);color:var(--ay-ink-900)}
  .ay-div-name{font-family:var(--ay-font-display);font-size:19px;font-weight:700;color:var(--ay-ink-900);margin:0 0 8px}
  .ay-div-desc{font-size:13.5px;line-height:1.6;color:#475569;margin:0}

  /* Stats */
  .ay-nosotros-stats{background:var(--ay-ink-900);color:#FFFFFF;padding:64px 0;border-bottom:var(--ay-hairline)}
  .ay-stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:32px;text-align:center}
  .ay-stat-box{display:flex;flex-direction:column;gap:6px}
  .ay-stat-num{font-family:var(--ay-font-display);font-size:clamp(36px,4vw,52px);font-weight:700;color:var(--ay-gold-light);line-height:1}
  .ay-stat-label{font-family:var(--ay-font-mono);font-size:12px;font-weight:500;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.7)}

  /* CTA */
  .ay-nosotros-cta{background:radial-gradient(ellipse at center,#1e293b 0%,#020617 100%);padding:96px 0;text-align:center}
  .ay-cta-inner{max-width:800px}
  .ay-cta-buttons{display:flex;gap:16px;justify-content:center;flex-wrap:wrap}

  /* Responsive */
  @media (max-width:1024px){
    .ay-nosotros-hero-grid{grid-template-columns:1fr;gap:36px}
    .ay-nosotros-hero-img{height:300px}
    .ay-manifesto-grid{grid-template-columns:1fr;gap:32px}
    .ay-pillars-grid{grid-template-columns:1fr 1fr}
    .ay-divisions-grid{grid-template-columns:1fr 1fr}
    .ay-stats-grid{grid-template-columns:1fr 1fr;gap:36px}
  }

  @media (max-width:640px){
    .ay-nosotros-hero{padding:40px 0 48px}
    .ay-nosotros-hero-img{height:240px}
    .ay-manifesto-grid,.ay-pillars-grid,.ay-divisions-grid,.ay-stats-grid{grid-template-columns:1fr !important;gap:20px !important}
    .ay-nosotros-pills{flex-direction:column;align-items:flex-start}
    .ay-cta-buttons{flex-direction:column}
    .ay-cta-buttons .ay-btn{width:100%}
  }
</style>

