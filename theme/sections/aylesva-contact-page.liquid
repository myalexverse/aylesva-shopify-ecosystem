{% comment %}
  Aylesva · Landing Page "Contacto"
  Gold & Ink Design System · Responsive · Corporate Hero & Channels
{% endcomment %}

<div class="ay ay-contact-wrapper">

  <!-- 1. HERO CONTACTO -->
  <section class="ay-contact-hero">
    <div class="ay-wrap">
      <div class="ay-contact-hero-grid">
        
        <!-- Left: Text -->
        <div class="ay-contact-hero-content">
          <p class="ay-eyebrow">ATENCIÓN DIRECTA & ASESORÍA ESTRATÉGICA</p>
          <h1 class="ay-h1 ay-contact-title">
            Estamos listos para<br>
            <span style="color:var(--ay-gold-text);">orientarte y acompañarte.</span>
          </h1>
          <p class="ay-lead ay-contact-sub">
            Conecta con nuestro equipo directivo y asesores especializados. Te ayudamos a estructurar la mejor ruta para tu negocio, inversión o protección familiar en México y Estados Unidos.
          </p>

          <div class="ay-contact-quick-badges">
            <span class="ay-pill">⚡ Respuesta en < 24 hrs</span>
            <span class="ay-pill">🇲🇽 🇺🇸 Asesoría Binacional</span>
            <span class="ay-pill">🔒 Consulta confidencial y sin costo</span>
          </div>
        </div>

        <!-- Right: Hero Media -->
        <div class="ay-contact-hero-media">
          <div class="ay-contact-img-frame">
            <img src="{{ 'ay-home-corporate-ecosystem.jpg' | asset_url }}" 
                 alt="Asesoría Corporativa Grupo Aylesva" 
                 class="ay-contact-hero-img"
                 loading="eager">
            <div class="ay-contact-media-badge">
              <span class="ay-contact-online-dot"></span>
              <span>Equipo de Asesores Activo · Atención Inmediata</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 2. CANALES DE CONTACTO RÁPIDO -->
  <section class="ay-contact-channels">
    <div class="ay-wrap">
      <div class="ay-channels-grid">
        
        <!-- Canal 1: WhatsApp -->
        <a href="https://api.whatsapp.com/send/?phone=524774136612&text=Hola%2C+me+gustar%C3%ADa+recibir+asesor%C3%ADa+personalizada+de+Grupo+Aylesva" target="_blank" rel="noopener" class="ay-channel-card ay-channel-highlight">
          <div class="ay-channel-icon-box">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
          </div>
          <span class="ay-channel-tag">Atención Inmediata</span>
          <h3 class="ay-channel-name">WhatsApp Corporativo</h3>
          <p class="ay-channel-val">+52 477 413 6612</p>
          <span class="ay-channel-btn">Abrir Chat &rarr;</span>
        </a>

        <!-- Canal 2: Email -->
        <a href="mailto:contacto@aylesva.mx" class="ay-channel-card">
          <div class="ay-channel-icon-box">
            <svg class="ay-icon" viewBox="0 0 24 24" stroke-linecap="square" aria-hidden="true">
              <rect x="2" y="4" width="20" height="16" rx="2"/>
              <path d="M22 6l-10 7L2 6"/>
            </svg>
          </div>
          <span class="ay-channel-tag">Soporte & Alianzas</span>
          <h3 class="ay-channel-name">Correo Electrónico</h3>
          <p class="ay-channel-val">contacto@aylesva.mx</p>
          <span class="ay-channel-btn">Enviar Correo &rarr;</span>
        </a>

        <!-- Canal 3: Sedes -->
        <div class="ay-channel-card">
          <div class="ay-channel-icon-box">
            <svg class="ay-icon" viewBox="0 0 24 24" stroke-linecap="square" aria-hidden="true">
              <path d="M3 21V9l6-4 6 4v12"/>
              <path d="M15 21V13h6v8"/>
              <path d="M7 13h2M7 17h2"/>
            </svg>
          </div>
          <span class="ay-channel-tag">Presencia Binacional</span>
          <h3 class="ay-channel-name">Oficinas & Operaciones</h3>
          <p class="ay-channel-val" style="font-size:13px;line-height:1.5;">
            🇲🇽 México (CDMX & Bajío)<br>
            🇺🇸 USA (California & Texas)
          </p>
          <span class="ay-channel-btn" style="color:#64748b;">Lunes a Viernes 9:00 - 18:00</span>
        </div>

      </div>
    </div>
  </section>

  <!-- 3. FORMULARIO CORPORATIVO -->
  <section class="ay-contact-form-section" id="formulario">
    <div class="ay-wrap">
      <div class="ay-form-layout">
        
        <div class="ay-form-header">
          <p class="ay-eyebrow">FORMULARIO DE CONTACTO</p>
          <h2 class="ay-h2">Envíanos un mensaje</h2>
          <p style="font-size:16px;color:#64748b;margin:12px 0 0;line-height:1.6;">
            Completa tus datos y un especialista del área correspondiente te contactará a la brevedad.
          </p>
        </div>

        <div class="ay-form-box">
          {% form 'contact' %}
            {% if form.posted_successfully? %}
              <div class="ay-form-alert ay-form-alert--success">
                <strong>¡Mensaje enviado con éxito!</strong> Nuestro equipo se comunicará contigo en menos de 24 horas.
              </div>
            {% endif %}

            {% if form.errors %}
              <div class="ay-form-alert ay-form-alert--error">
                {{ form.errors | default_errors }}
              </div>
            {% endif %}

            <div class="ay-form-grid">
              
              <!-- Nombre -->
              <div class="ay-field-group">
                <label for="ContactFormName" class="ay-label">Nombre completo *</label>
                <input type="text" 
                       id="ContactFormName" 
                       name="contact[name]" 
                       class="ay-input" 
                       placeholder="Ej. Carlos Mendoza" 
                       required 
                       value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}">
              </div>

              <!-- Email -->
              <div class="ay-field-group">
                <label for="ContactFormEmail" class="ay-label">Correo electrónico *</label>
                <input type="email" 
                       id="ContactFormEmail" 
                       name="contact[email]" 
                       class="ay-input" 
                       placeholder="tu@empresa.com" 
                       required 
                       autocorrect="off" 
                       autocapitalize="off" 
                       value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}">
              </div>

              <!-- Teléfono -->
              <div class="ay-field-group">
                <label for="ContactFormPhone" class="ay-label">Teléfono / WhatsApp *</label>
                <input type="tel" 
                       id="ContactFormPhone" 
                       name="contact[phone]" 
                       class="ay-input" 
                       placeholder="+52 477 ..." 
                       value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}">
              </div>

              <!-- Servicio de Interés -->
              <div class="ay-field-group">
                <label for="ContactFormService" class="ay-label">Área de interés</label>
                <select id="ContactFormService" name="contact[servicio_interes]" class="ay-input ay-select">
                  <option value="General / Asesoría Global">Asesoría General / Orientación</option>
                  <option value="Aylesva Recursos (Financiamiento)">Financiamiento (Aylesva Recursos)</option>
                  <option value="Aylesva Direct (Importaciones)">Importaciones desde China (Aylesva Direct)</option>
                  <option value="Global Estates (Bienes Raíces)">Inversión Inmobiliaria (Global Estates)</option>
                  <option value="Lanza tu Marca (E-commerce)">Lanza tu Tienda Online (E-commerce)</option>
                  <option value="Aylesva Care (Salud EE. UU.)">Salud & Beneficios (Aylesva Care)</option>
                  <option value="Mi Última Voluntad (Repatriación)">Previsión Funeraria (Mi Última Voluntad)</option>
                  <option value="Marketplace (Compra & Mayoreo)">Marketplace / Compra Mayoreo</option>
                </select>
              </div>

              <!-- Mensaje -->
              <div class="ay-field-group ay-field-full">
                <label for="ContactFormMessage" class="ay-label">¿Cómo podemos ayudarte? *</label>
                <textarea rows="5" 
                          id="ContactFormMessage" 
                          name="contact[body]" 
                          class="ay-input ay-textarea" 
                          placeholder="Describe brevemente tus requerimientos o dudas..." 
                          required>{% if form.body %}{{ form.body }}{% endif %}</textarea>
              </div>

            </div>

            <div class="ay-form-action">
              <button type="submit" class="ay-btn ay-btn--gold">Enviar Mensaje a un Asesor &rarr;</button>
            </div>

          {% endform %}
        </div>

      </div>
    </div>
  </section>

</div>

<style>
  .ay-contact-wrapper{background:#FFFFFF;color:var(--ay-ink-800)}

  /* Hero */
  .ay-contact-hero{background:var(--ay-stone);border-bottom:var(--ay-hairline);padding:64px 0 72px}
  .ay-contact-hero-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:48px;align-items:center}
  .ay-contact-title{font-size:clamp(34px,4vw,52px);font-weight:400;line-height:1.08;letter-spacing:-.03em;margin:0 0 20px;color:var(--ay-ink-900)}
  .ay-contact-sub{font-size:17px;line-height:1.68;color:#334155;margin:0 0 30px;text-wrap:pretty}
  .ay-contact-quick-badges{display:flex;gap:10px;flex-wrap:wrap}

  .ay-contact-hero-media{position:relative}
  .ay-contact-img-frame{position:relative;border-radius:12px;overflow:hidden;border:1px solid rgba(197,164,126,.4);box-shadow:0 24px 48px -16px rgba(2,6,23,.2)}
  .ay-contact-hero-img{width:100%;height:380px;object-fit:cover;display:block;transition:transform .6s ease}
  .ay-contact-hero-media:hover .ay-contact-hero-img{transform:scale(1.03)}
  .ay-contact-media-badge{position:absolute;bottom:16px;left:16px;right:16px;background:rgba(2,6,23,0.88);backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,.15);border-radius:6px;padding:10px 14px;display:flex;align-items:center;gap:10px;color:#fff;font-family:var(--ay-font-mono);font-size:11px;letter-spacing:.06em}
  .ay-contact-online-dot{width:8px;height:8px;border-radius:50%;background:#22c55e;flex:0 0 8px;box-shadow:0 0 8px #22c55e}

  /* Channels */
  .ay-contact-channels{padding:72px 0;border-bottom:var(--ay-hairline)}
  .ay-channels-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
  .ay-channel-card{background:var(--ay-stone);border:1px solid rgba(15,23,42,.1);border-radius:10px;padding:32px 24px;text-decoration:none;color:inherit;transition:all .3s ease;display:flex;flex-direction:column}
  .ay-channel-card:hover{background:#FFFFFF;transform:translateY(-4px);box-shadow:0 20px 40px -10px rgba(2,6,23,.14);border-color:var(--ay-gold)}
  .ay-channel-highlight{border-color:rgba(197,164,126,.4);background:#fff}
  .ay-channel-icon-box{width:48px;height:48px;background:var(--ay-ink-900);border-radius:8px;display:flex;align-items:center;justify-content:center;margin-bottom:18px;border:1px solid rgba(197,164,126,0.3);color:var(--ay-gold-light)}
  .ay-channel-icon-box .ay-icon{stroke:var(--ay-gold-light);width:24px;height:24px}
  .ay-channel-tag{font-family:var(--ay-font-mono);font-size:10px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--ay-gold-text);margin-bottom:6px}
  .ay-channel-name{font-family:var(--ay-font-display);font-size:18px;font-weight:700;color:var(--ay-ink-900);margin:0 0 8px}
  .ay-channel-val{font-size:15px;font-weight:600;color:var(--ay-ink-800);margin:0 0 16px}
  .ay-channel-btn{font-family:var(--ay-font-mono);font-size:11px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--ay-gold-text);margin-top:auto}

  /* Form */
  .ay-contact-form-section{padding:88px 0;background:var(--ay-stone)}
  .ay-form-layout{max-width:840px;margin:0 auto}
  .ay-form-header{text-align:center;margin-bottom:44px}
  .ay-form-box{background:#FFFFFF;border:1px solid rgba(15,23,42,.12);border-radius:12px;padding:44px 38px;box-shadow:0 12px 36px -12px rgba(2,6,23,.08)}
  .ay-form-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}
  .ay-field-full{grid-column:1 / -1}
  .ay-field-group{display:flex;flex-direction:column;gap:8px}
  .ay-label{font-family:var(--ay-font-mono);font-size:11px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--ay-ink-800)}
  .ay-input{width:100%;padding:14px 16px;border:1px solid rgba(15,23,42,.18);border-radius:6px;font-family:inherit;font-size:14.5px;color:var(--ay-ink-900);background:#fff;transition:border-color .2s ease,box-shadow .2s ease}
  .ay-input:focus{outline:none;border-color:var(--ay-gold);box-shadow:0 0 0 3px rgba(197,164,126,.2)}
  .ay-textarea{resize:vertical;min-height:120px}
  .ay-select{cursor:pointer}
  .ay-form-action{margin-top:28px;text-align:center}
  .ay-form-alert{padding:14px 20px;border-radius:6px;margin-bottom:24px;font-size:14px;line-height:1.5}
  .ay-form-alert--success{background:#ecfdf5;color:#065f46;border:1px solid #a7f3d0}
  .ay-form-alert--error{background:#fef2f2;color:#991b1b;border:1px solid #fecaca}

  /* Responsive */
  @media (max-width:1024px){
    .ay-contact-hero-grid{grid-template-columns:1fr;gap:36px}
    .ay-contact-hero-img{height:300px}
    .ay-channels-grid{grid-template-columns:1fr 1fr}
  }

  @media (max-width:640px){
    .ay-contact-hero{padding:40px 0 48px}
    .ay-contact-hero-img{height:240px}
    .ay-channels-grid{grid-template-columns:1fr !important;gap:18px !important}
    .ay-form-box{padding:28px 20px}
    .ay-form-grid{grid-template-columns:1fr}
    .ay-form-action .ay-btn{width:100%}
  }
</style>

{% schema %}
{
  "name": "Aylesva · Página Contacto",
  "settings": [],
  "presets": [
    {
      "name": "Aylesva · Página Contacto"
    }
  ]
}
{% endschema %}
