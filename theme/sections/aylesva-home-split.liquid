{% comment %}
  Aylesva · Home · Bloque a dos columnas con chips y galería.
  Usado para "Qué hacemos" (dos universos) y para el bloque de Marketplace.
{% endcomment %}
<section class="ay" id="{{ section.settings.anchor }}" style="background:{{ section.settings.bg }};border-bottom:var(--ay-hairline)">
  <div class="ay-wrap ay-split" style="display:grid;grid-template-columns:{% if section.settings.media_right %}1fr 1.05fr{% else %}1.05fr 1fr{% endif %};gap:72px;align-items:center;padding-top:80px;padding-bottom:80px">
    <div style="{% unless section.settings.media_right %}order:2{% endunless %}">
      {% if section.settings.eyebrow != blank %}<p class="ay-eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      <h2 class="ay-h2" style="font-size:clamp(28px,3vw,40px);margin-bottom:20px">{{ section.settings.title }}</h2>
      <p class="ay-lead" style="max-width:50ch;margin-bottom:28px;font-size:16px;line-height:1.65;color:rgba(15,23,42,.7)">{{ section.settings.text }}</p>

      {% if section.settings.chips != blank %}
        <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:32px">
          {% assign chips = section.settings.chips | split: ',' %}
          {% for chip in chips %}
            <span style="font-size:12px;font-weight:600;color:rgba(15,23,42,.78);border:1px solid rgba(197,164,126,.45);padding:7px 13px;border-radius:var(--ay-radius);background:#fff;display:inline-flex;align-items:center;gap:5px">
              <span style="color:var(--ay-gold-text);font-size:10px">◈</span> {{ chip | strip }}
            </span>
          {% endfor %}
        </div>
      {% endif %}

      <div style="display:flex;gap:14px;flex-wrap:wrap;align-items:center">
        {% if section.settings.cta_label != blank %}
          <a class="ay-btn ay-btn--primary" href="{{ section.settings.cta_link | default: '/pages/marketplace' }}">{{ section.settings.cta_label }} &rarr;</a>
        {% endif %}
        {% if section.settings.cta2_label != blank %}
          <a class="ay-btn ay-btn--outline" href="{{ section.settings.cta2_link | default: '/pages/lanza-tu-propia-marca' }}">{{ section.settings.cta2_label }}</a>
        {% endif %}
      </div>
    </div>

    <div class="ay-split-gallery" style="{% unless section.settings.media_right %}order:1{% endunless %};display:grid;grid-template-columns:1fr 1fr;gap:14px">
      {% for block in section.blocks %}
        {%- assign raw_img = block.settings.image_url | default: block.settings.image -%}
        {%- capture split_img_src -%}
          {%- if raw_img.src -%}{{ raw_img | image_url: width: 900 }}
          {%- elsif raw_img contains 'http' -%}{{ raw_img }}
          {%- elsif raw_img contains 'shopify://shop_images/' -%}{%- assign ch = raw_img | remove: 'shopify://shop_images/' -%}{{ ch | file_img_url: '900x' }}
          {%- elsif raw_img contains '.jpg' or raw_img contains '.png' or raw_img contains '.webp' -%}{{ raw_img | asset_url }}
          {%- endif -%}
        {%- endcapture -%}
        {%- assign split_img_src = split_img_src | strip -%}
        <a 
          href="{{ block.settings.link | default: section.settings.cta_link | default: '/pages/marketplace' }}" 
          class="ay-media ay-mp-card" 
          style="height:210px;{% cycle '', 'margin-top:24px' %};border:var(--ay-hairline);border-radius:var(--ay-radius);overflow:hidden;background-size:cover;background-position:center;display:block;text-decoration:none;position:relative;transition:all .35s ease;{% if split_img_src != blank %}background-image:url({{ split_img_src }}){% else %}background:repeating-linear-gradient(135deg,#efece6 0 8px,#e7e3db 8px 16px){% endif %}" 
          {{ block.shopify_attributes }}
          title="Ver producto en Marketplace"
        >
          <span class="ay-mp-card-overlay" style="position:absolute;inset:0;background:rgba(2,6,23,0);transition:background .3s ease;display:flex;align-items:center;justify-content:center">
            <span class="ay-mp-card-badge" style="opacity:0;transform:translateY(8px);transition:all .3s ease;font-family:var(--ay-font-mono);font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:#fff;background:rgba(2,6,23,0.8);padding:6px 12px;border-radius:4px;border:1px solid var(--ay-gold)">Ver en catálogo →</span>
          </span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .ay-mp-card:hover{transform:translateY(-4px);box-shadow:0 12px 24px -8px rgba(0,0,0,0.2)}
  .ay-mp-card:hover .ay-mp-card-overlay{background:rgba(2,6,23,0.3)}
  .ay-mp-card:hover .ay-mp-card-badge{opacity:1;transform:none}
  @media (max-width:1024px){
    .ay-split{grid-template-columns:1fr !important;gap:36px !important}
    .ay-split > div{order:0 !important}
    .ay-split-gallery .ay-media{margin-top:0 !important;height:160px !important}
  }
</style>

{% schema %}
{
  "name": "Aylesva · Split 2 col",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Ancla (id)", "default": "marketplace" },
    { "type": "color", "id": "bg", "label": "Fondo", "default": "#FFFFFF" },
    { "type": "checkbox", "id": "media_right", "label": "Imágenes a la derecha", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Marketplace" },
    { "type": "textarea", "id": "title", "label": "Titular" },
    { "type": "textarea", "id": "text", "label": "Texto" },
    { "type": "textarea", "id": "chips", "label": "Etiquetas separadas por coma (categorías)" },
    { "type": "text", "id": "cta_label", "label": "CTA", "default": "Explorar el catálogo" },
    { "type": "url", "id": "cta_link", "label": "Enlace del CTA" },
    { "type": "text", "id": "cta2_label", "label": "CTA Secundario" },
    { "type": "url", "id": "cta2_link", "label": "Enlace CTA Secundario" }
  ],
  "blocks": [
    { "type": "image", "name": "Imagen", "limit": 4, "settings": [
      { "type": "image_picker", "id": "image", "label": "Imagen (900px)" },
      { "type": "text", "id": "image_url", "label": "URL o nombre de asset de imagen" },
      { "type": "url", "id": "link", "label": "Enlace de la imagen" }
    ]}
  ],
  "presets": [{ "name": "Aylesva · Split 2 col" }]
}
{% endschema %}