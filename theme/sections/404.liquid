
<style>
  /* ── Reset de la sección original ── */
  .error-404, .page-content-wrapper { display: none !important; }

  /* ── Contenedor principal ── */
  #ayl-404 {
    font-family: Arial, sans-serif;
    min-height: 85vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 40px 20px;
    background: linear-gradient(160deg, #f0faf0 0%, #ffffff 60%, #f5f0ff 100%);
    position: relative;
    overflow: hidden;
  }

  /* Círculos decorativos de fondo */
  #ayl-404::before {
    content: "";
    position: absolute;
    width: 500px; height: 500px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(46,125,50,0.06) 0%, transparent 70%);
    top: -100px; left: -100px;
    pointer-events: none;
  }
  #ayl-404::after {
    content: "";
    position: absolute;
    width: 400px; height: 400px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(156,39,176,0.05) 0%, transparent 70%);
    bottom: -80px; right: -80px;
    pointer-events: none;
  }

  /* Ícono animado */
  .ayl-404-icon {
    font-size: 72px;
    margin-bottom: 16px;
    animation: ayl-float 3s ease-in-out infinite;
    display: block;
  }
  @keyframes ayl-float {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(-12px); }
  }

  /* Badge "Próximamente" */
  .ayl-badge {
    display: inline-block;
    background: linear-gradient(135deg, #2e7d32, #43a047);
    color: #fff;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 3px;
    text-transform: uppercase;
    padding: 6px 18px;
    border-radius: 50px;
    margin-bottom: 20px;
    box-shadow: 0 4px 14px rgba(46,125,50,0.3);
  }

  /* Título principal */
  .ayl-404-title {
    font-size: clamp(1.8rem, 4vw, 3rem);
    font-weight: 900;
    color: #1a1a1a;
    margin: 0 0 16px;
    line-height: 1.2;
    max-width: 700px;
  }
  .ayl-404-title span {
    color: #2e7d32;
  }

  /* Subtítulo */
  .ayl-404-sub {
    font-size: clamp(0.95rem, 2vw, 1.15rem);
    color: #555;
    max-width: 560px;
    line-height: 1.7;
    margin: 0 auto 32px;
  }

  /* Separador con puntos */
  .ayl-dots {
    display: flex;
    gap: 8px;
    justify-content: center;
    margin-bottom: 32px;
  }
  .ayl-dots span {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: #2e7d32;
    opacity: 0.3;
    animation: ayl-pulse 1.4s ease-in-out infinite;
  }
  .ayl-dots span:nth-child(2) { animation-delay: .2s; background: #43a047; }
  .ayl-dots span:nth-child(3) { animation-delay: .4s; background: #66bb6a; }
  @keyframes ayl-pulse {
    0%, 100% { opacity: 0.3; transform: scale(1); }
    50%       { opacity: 1;   transform: scale(1.4); }
  }

  /* Botones */
  .ayl-404-btns {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    margin-bottom: 40px;
  }
  .ayl-btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: linear-gradient(135deg, #2e7d32, #43a047);
    color: #fff;
    text-decoration: none;
    padding: 14px 28px;
    border-radius: 50px;
    font-size: 0.95rem;
    font-weight: 700;
    box-shadow: 0 6px 20px rgba(46,125,50,0.35);
    transition: transform .2s, box-shadow .2s;
  }
  .ayl-btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 28px rgba(46,125,50,0.45);
    color: #fff;
  }
  .ayl-btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #fff;
    color: #2e7d32;
    text-decoration: none;
    padding: 13px 26px;
    border-radius: 50px;
    font-size: 0.95rem;
    font-weight: 700;
    border: 2px solid #2e7d32;
    transition: all .2s;
  }
  .ayl-btn-secondary:hover {
    background: #2e7d32;
    color: #fff;
    transform: translateY(-2px);
  }

  /* Tarjetas de secciones sugeridas */
  .ayl-suggestions-title {
    font-size: 0.85rem;
    font-weight: 700;
    color: #999;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 16px;
  }
  .ayl-suggestions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
    max-width: 640px;
  }
  .ayl-sug-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    background: #fff;
    border: 1.5px solid #e8e8e8;
    border-radius: 50px;
    font-size: 0.85rem;
    color: #333;
    text-decoration: none;
    transition: all .15s;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
  }
  .ayl-sug-link:hover {
    border-color: #2e7d32;
    color: #2e7d32;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(46,125,50,0.15);
  }

  @media (max-width: 600px) {
    .ayl-404-btns { flex-direction: column; align-items: center; }
    .ayl-btn-primary, .ayl-btn-secondary { width: 100%; justify-content: center; max-width: 300px; }
  }
</style>

