{% comment %}
  Custom Corporate & Ecosystem Footer - GRUPO AYLESVA
  Clean vanilla CSS & SVG icons, Gold & Ink palette.
  Mobile accordion-enabled for ultra-clean mobile browsing.
{% endcomment %}

<style>
  .ay-footer {
    display: block !important;
    background: #FFFFFF !important;
    color: #0F172A !important;
    border-top: 1px solid rgba(15, 23, 42, 0.08) !important;
    padding: 64px 0 36px !important;
    -webkit-font-smoothing: antialiased !important;
    width: 100% !important;
    position: relative !important;
    z-index: 10 !important;
  }
  .ay-footer-wrap {
    max-width: 1320px !important;
    margin: 0 auto !important;
    padding: 0 24px !important;
  }
  .ay-footer-grid {
    display: grid !important;
    grid-template-columns: 1.4fr 1fr 1.1fr 1fr !important;
    gap: 48px !important;
    margin-bottom: 52px !important;
    visibility: visible !important;
    opacity: 1 !important;
  }
  .ay-footer-brand,
  .ay-footer-col {
    display: block !important;
    visibility: visible !important;
    opacity: 1 !important;
  }
  .ay-footer-brand-desc {
    font-size: 14px !important;
    line-height: 1.7 !important;
    color: #64748B !important;
    margin: 20px 0 24px !important;
    max-width: 380px !important;
  }
  .ay-footer-contact-item {
    display: flex !important;
    align-items: center !important;
    gap: 12px !important;
    margin-bottom: 12px !important;
    font-size: 14px !important;
    font-weight: 500 !important;
    color: #334155 !important;
  }
  .ay-footer-contact-item svg {
    color: #C5A47E !important;
    flex-shrink: 0 !important;
  }
  .ay-footer-contact-item a {
    color: #334155 !important;
    text-decoration: none !important;
    transition: color 0.2s ease !important;
  }
  .ay-footer-contact-item a:hover {
    color: #9E1B2A !important;
  }
  .ay-footer-col-title {
    font-size: 12px !important;
    font-weight: 800 !important;
    letter-spacing: 0.16em !important;
    text-transform: uppercase !important;
    color: #0F172A !important;
    margin: 0 0 20px !important;
    display: flex !important;
    align-items: center !important;
    gap: 8px !important;
  }
  .ay-footer-col-title .title-left {
    display: inline-flex !important;
    align-items: center !important;
    gap: 8px !important;
  }
  .ay-footer-col-title .title-left::before {
    content: '' !important;
    display: inline-block !important;
    width: 6px !important;
    height: 6px !important;
    border-radius: 50% !important;
    background: #C5A47E !important;
  }
  .ay-footer-col-toggle {
    display: none !important;
  }
  .ay-footer-col-content {
    display: block !important;
    visibility: visible !important;
    opacity: 1 !important;
  }
  .ay-footer-links {
    list-style: none !important;
    padding: 0 !important;
    margin: 0 !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 12px !important;
  }
  .ay-footer-links li {
    margin: 0 !important;
    padding: 0 !important;
  }
  .ay-footer-links a {
    color: #64748B !important;
    text-decoration: none !important;
    font-size: 14px !important;
    font-weight: 500 !important;
    transition: all 0.2s ease !important;
    display: inline-flex !important;
    align-items: center !important;
    gap: 6px !important;
  }
  .ay-footer-links a:hover {
    color: #9E1B2A !important;
    transform: translateX(3px) !important;
  }
  .ay-footer-links a .tag-pill {
    font-size: 9px !important;
    font-weight: 700 !important;
    letter-spacing: 0.05em !important;
    padding: 2px 6px !important;
    border-radius: 10px !important;
    background: rgba(197, 164, 126, 0.15) !important;
    color: #9A7B52 !important;
    text-transform: uppercase !important;
  }
  .ay-footer-bottom {
    border-top: 1px solid rgba(15, 23, 42, 0.08) !important;
    padding-top: 28px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    flex-wrap: wrap !important;
    gap: 20px !important;
  }
  .ay-footer-copy {
    font-size: 12px !important;
    font-weight: 600 !important;
    letter-spacing: 0.06em !important;
    color: #94A3B8 !important;
    text-transform: uppercase !important;
  }
  .ay-footer-payments {
    display: flex !important;
    align-items: center !important;
    gap: 10px !important;
    flex-wrap: wrap !important;
  }
  .ay-footer-payments .pay-badge {
    height: 24px !important;
    padding: 2px 6px !important;
    background: #FAFAF8 !important;
    border: 1px solid rgba(15, 23, 42, 0.08) !important;
    border-radius: 4px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    opacity: 0.8 !important;
  }

  @media (max-width: 1024px) {
    .ay-footer-grid {
      grid-template-columns: 1fr 1fr !important;
      gap: 36px !important;
    }
  }

  @media (max-width: 640px) {
    .ay-footer {
      padding: 40px 0 24px !important;
    }
    .ay-footer-grid {
      grid-template-columns: 1fr !important;
      gap: 28px !important;
      margin-bottom: 32px !important;
    }
    .ay-footer-bottom {
      flex-direction: column !important;
      text-align: center !important;
      gap: 16px !important;
    }
    .ay-footer-payments {
      justify-content: center !important;
    }
  }
</style>

