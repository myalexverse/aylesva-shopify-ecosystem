{%- style -%}
  .ayl-premium-cats-{{ section.id }} {
    padding: 60px 0;
    background: {{ section.settings.bg_color }};
  }

  .premium-cats-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .premium-cats-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
  }

  .premium-cats-title {
    font-family: 'Playfair Display', serif;
    font-size: 32px;
    color: #111;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  .premium-cats-nav {
    display: flex;
    gap: 12px;
  }

  .premium-cats-arrow {
    width: 44px;
    height: 44px;
    border: 1px solid #e0e0e0;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    background: #fff;
    color: #111;
  }

  .premium-cats-arrow:hover {
    background: #111;
    color: #fff;
    border-color: #111;
  }

  .premium-cats-arrow svg {
    width: 20px;
    height: 20px;
  }

  .premium-cats-viewport {
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none;  /* IE/Edge */
  }

  .premium-cats-viewport::-webkit-scrollbar {
    display: none; /* Chrome/Safari */
  }

  .premium-cats-grid {
    display: flex;
    gap: 20px;
    padding-bottom: 20px;
    align-items: flex-start; /* Prevent stretching to tallest card */
  }

  .premium-cat-item {
    flex: 0 0 calc(20% - 16px); /* 5 items perfect fit */
    text-decoration: none;
    background: #f3ece4; 
    border-radius: 15px;
    overflow: hidden;
    transition: all 0.4s ease;
    display: flex;
    flex-direction: column;
    height: auto;
  }

  @media (max-width: 1400px) {
    .premium-cat-item { flex: 0 0 calc(25% - 15px); } /* 4 items fit */
  }

  @media (max-width: 1100px) {
    .premium-cat-item { flex: 0 0 calc(33.333% - 14px); } /* 3 items fit */
  }

  .premium-cat-item:hover {
    transform: translateY(-8px);
    box-shadow: 0 10px 25px rgba(0,0,0,0.08);
  }

  .premium-cat-image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1; /* Maintains square ratio dynamically */
    overflow: hidden;
    background: #f3ece4;
  }

  .premium-cat-image-wrap img,
  .premium-cat-image-wrap svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .premium-cat-footer {
    padding: 18px 10px;
    text-align: center;
    background: #f3ece4;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 50px; /* Ensure label space is uniform */
  }

  .premium-cat-label {
    color: #111;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-family: 'Inter', sans-serif;
    margin: 0;
  }

  @media (max-width: 767px) {
    .ayl-premium-cats-{{ section.id }} { 
      display: none !important; 
    }
  }
{%- endstyle -%}

<section class="ayl-premium-cats-{{ section.id }}">
  <div class="premium-cats-container">
    <div class="premium-cats-header">
      {% if section.settings.title != blank %}
        <h2 class="premium-cats-title">{{ section.settings.title }}</h2>
      {% endif %}
      
      <div class="premium-cats-nav">
        <div class="premium-cats-arrow arrow-prev" onclick="scrollCats_{{ section.id | replace: '-', '_' }}(-1)">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
        </div>
        <div class="premium-cats-arrow arrow-next" onclick="scrollCats_{{ section.id | replace: '-', '_' }}(1)">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        </div>
      </div>
    </div>

    <div class="premium-cats-viewport" id="Viewport-{{ section.id }}">
      <div class="premium-cats-grid">
        {% for block in section.blocks %}
          <a href="{{ block.settings.link }}" class="premium-cat-item" {{ block.shopify_attributes }}>
            <div class="premium-cat-image-wrap">
              {% if block.settings.image != blank %}
                <img src="{{ block.settings.image | img_url: '600x720', crop: 'center' }}" alt="{{ block.settings.label }}" loading="lazy">
              {% else %}
                {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {% endif %}
            </div>
            
            <div class="premium-cat-footer">
              {% if block.settings.label != blank %}
                <span class="premium-cat-label">{{ block.settings.label }}</span>
              {% endif %}
            </div>
          </a>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<script>
  function scrollCats_{{ section.id | replace: '-', '_' }}(direction) {
    const viewport = document.getElementById('Viewport-{{ section.id }}');
    const scrollAmount = viewport.offsetWidth * 0.7;
    viewport.scrollBy({
      left: direction * scrollAmount,
      behavior: 'smooth'
    });
  }
</script>

{% schema %}
{
  "name": "Aylesva Premium Cats",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título de la sección",
      "default": "COMPRAR POR CATEGORÍA"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de Fondo",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categoría",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen de Categoría"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Nombre",
          "default": "Calzado"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Aylesva Premium Categories",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
