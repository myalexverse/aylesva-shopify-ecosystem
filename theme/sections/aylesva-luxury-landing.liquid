<script>
  (function () {
    var root = document.getElementById('ayl-{{ sid }}');
    if (!root) return;

    /* ---------- Mapa: capa geo con object-fit CONTAIN ----------
       La imagen usa object-fit:contain (mapa completo siempre visible).
       La capa geo se dimensiona con JS para coincidir exactamente con el
       área renderizada de la imagen. Los pines en % quedan fijos al mapa
       sin importar el tamaño de pantalla. */
    var mapCanvas = root.querySelector('[data-ayl-map]');
    var geoLayer = root.querySelector('[data-ayl-geo]');
    var geoImg = mapCanvas ? mapCanvas.querySelector('.ayl-map-canvas__img img') : null;
    function layoutMapGeo() {
      if (!mapCanvas || !geoLayer || !geoImg || !geoImg.naturalWidth) return;
      var cw = mapCanvas.clientWidth, ch = mapCanvas.clientHeight;
      var iw = geoImg.naturalWidth, ih = geoImg.naturalHeight;
      /* contain: el mapa completo es visible, pines siempre correctos */
      var scale = Math.min(cw / iw, ch / ih);
      var w = iw * scale, h = ih * scale;
      geoLayer.style.position = 'absolute';
      geoLayer.style.width = w + 'px';
      geoLayer.style.height = h + 'px';
      geoLayer.style.left = (cw - w) / 2 + 'px';
      geoLayer.style.top = (ch - h) / 2 + 'px';
    }
    if (geoImg) {
      if (geoImg.complete) layoutMapGeo();
      geoImg.addEventListener('load', layoutMapGeo);
      window.addEventListener('resize', layoutMapGeo);
      if (window.ResizeObserver && mapCanvas) new ResizeObserver(layoutMapGeo).observe(mapCanvas);
    }

    /* ---------- Asistente de pines (solo en el editor de temas) ----------
       1. Haz clic en cualquier punto del mapa
       2. Aparece un menú para elegir qué pin mover
       3. Selecciona el pin → se mueve visualmente y se copian las coordenadas
       4. Actualiza Posición X / Y en el panel lateral del pin */
    if (window.Shopify && window.Shopify.designMode && geoLayer) {
      geoLayer.style.cursor = 'crosshair';

      /* Banner de instrucciones */
      var banner = document.createElement('div');
      banner.style.cssText = 'position:absolute;top:8px;left:50%;transform:translateX(-50%);z-index:10;background:rgba(20,38,46,0.92);color:#D3AC6E;font:600 12px/1.4 sans-serif;padding:8px 16px;border-radius:6px;white-space:nowrap;pointer-events:none;box-shadow:0 4px 14px rgba(0,0,0,.3)';
      banner.textContent = '📍 Haz clic en el mapa → elige un pin → se mueve ahí';
      geoLayer.appendChild(banner);

      /* Estilos del menú */
      var menuCSS = document.createElement('style');
      menuCSS.textContent = [
        '.ayl-pin-menu{position:absolute;z-index:20;background:#14262E;border:1px solid rgba(211,172,110,.5);border-radius:8px;padding:6px 0;min-width:200px;box-shadow:0 12px 32px rgba(0,0,0,.4);font-family:var(--ayl-sans,sans-serif);overflow:hidden;animation:ayl-fade .15s ease}',
        '.ayl-pin-menu__title{padding:8px 16px;font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:rgba(255,255,255,.45);border-bottom:1px solid rgba(255,255,255,.1)}',
        '.ayl-pin-menu__btn{display:flex;align-items:center;gap:10px;width:100%;padding:10px 16px;font-size:13px;font-weight:600;color:#fff;background:none;border:none;cursor:pointer;text-align:left;transition:background .15s}',
        '.ayl-pin-menu__btn:hover{background:rgba(192,138,62,.25)}',
        '.ayl-pin-menu__btn .dot{width:12px;height:12px;border-radius:50%;background:#C08A3E;border:2px solid #fff;flex:none}',
        '.ayl-pin-menu__btn .name{flex:1}',
        '.ayl-pin-menu__btn .status{font-size:11px;color:rgba(255,255,255,.4);font-weight:400}',
        '@keyframes ayl-fade{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}'
      ].join('\n');
      document.head.appendChild(menuCSS);

      var activeMenu = null;

      function removeMenu() {
        if (activeMenu) { activeMenu.remove(); activeMenu = null; }
        var oldMarker = geoLayer.querySelector('.ayl-coord-marker');
        if (oldMarker) oldMarker.remove();
      }

      geoLayer.addEventListener('click', function (e) {
        /* Si se hizo clic en un pin existente, no hacer nada */
        if (e.target.closest('.ayl-pin')) return;
        /* Cerrar menú anterior si existe */
        removeMenu();

        var r = geoLayer.getBoundingClientRect();
        var px = Math.round((e.clientX - r.left) / r.width * 100);
        var py = Math.round((e.clientY - r.top) / r.height * 100);

        /* Marcador visual en la posición clickeada */
        var marker = document.createElement('div');
        marker.className = 'ayl-coord-marker';
        marker.style.cssText = 'position:absolute;width:22px;height:22px;border-radius:50%;background:#C08A3E;border:3px solid #fff;box-shadow:0 2px 12px rgba(0,0,0,.5);transform:translate(-50%,-50%);z-index:15;pointer-events:none;animation:ayl-fade .2s ease';
        marker.style.left = px + '%';
        marker.style.top = py + '%';
        geoLayer.appendChild(marker);

        /* Recopilar pines del DOM */
        var pinEls = geoLayer.querySelectorAll('.ayl-pin');
        if (!pinEls.length) return;

        /* Crear menú */
        var menu = document.createElement('div');
        menu.className = 'ayl-pin-menu';
        var menuLeft = e.clientX - r.left + 16;
        var menuTop = e.clientY - r.top - 20;
        if (menuLeft + 220 > r.width) menuLeft = e.clientX - r.left - 220;
        if (menuTop + 160 > r.height) menuTop = e.clientY - r.top - 160;
        if (menuTop < 0) menuTop = 8;
        menu.style.left = menuLeft + 'px';
        menu.style.top = menuTop + 'px';

        var title = document.createElement('div');
        title.className = 'ayl-pin-menu__title';
        title.textContent = '¿Mover cuál pin aquí?';
        menu.appendChild(title);

        pinEls.forEach(function (pin, idx) {
          var nameEl = pin.querySelector('.ayl-pin__tip strong');
          var statusEl = pin.querySelector('.ayl-pin__tip span');
          var pinName = nameEl ? nameEl.textContent.trim() : 'Pin ' + (idx + 1);
          var pinStatus = statusEl ? statusEl.textContent.trim() : '';

          var btn = document.createElement('button');
          btn.className = 'ayl-pin-menu__btn';
          btn.innerHTML = '<span class="dot"></span><span class="name">' + pinName + '</span><span class="status">' + pinStatus + '</span>';

          btn.addEventListener('click', function (ev) {
            ev.stopPropagation();
            pin.style.left = px + '%';
            pin.style.top = py + '%';
            banner.innerHTML = '✅ <b>' + pinName + '</b> movido a X: ' + px + ' · Y: ' + py + ' — <span style="opacity:.6">Actualiza Posición X / Y en el panel</span>';
            banner.style.color = '#fff';
            try { navigator.clipboard.writeText('X: ' + px + '  Y: ' + py); } catch (err) {}
            removeMenu();
            setTimeout(function () {
              banner.textContent = '📍 Haz clic en el mapa → elige un pin → se mueve ahí';
              banner.style.color = '#D3AC6E';
            }, 6000);
          });

          menu.appendChild(btn);
        });

        geoLayer.appendChild(menu);
        activeMenu = menu;
      });

      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') removeMenu(); });
      document.addEventListener('click', function (e) {
        if (activeMenu && !e.target.closest('.ayl-pin-menu') && !e.target.closest('[data-ayl-geo]')) removeMenu();
      });
    }

    /* ---------- Mapa: pines con tooltip (hover via CSS, click/tap via JS) ---------- */
    var pins = root.querySelectorAll('.ayl-pin');
    pins.forEach(function (pin) {
      pin.addEventListener('click', function (e) {
        e.stopPropagation();
        var wasOpen = pin.classList.contains('is-open');
        pins.forEach(function (p) { p.classList.remove('is-open'); });
        if (!wasOpen) pin.classList.add('is-open');
      });
      pin.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); pin.click(); }
      });
    });
    document.addEventListener('click', function () {
      pins.forEach(function (p) { p.classList.remove('is-open'); });
    });

    /* ---------- Cross-fade helper ---------- */
    function swapImage(img, src) {
      if (!src || img.getAttribute('src') === src) return;
      img.classList.add('is-fading');
      var pre = new Image();
      pre.onload = function () {
        img.src = src;
        requestAnimationFrame(function () { img.classList.remove('is-fading'); });
      };
      pre.onerror = function () { img.classList.remove('is-fading'); };
      pre.src = src;
    }

    /* ---------- Proyectos: cada bloque cablea sus thumbnails o pestañas ---------- */
    root.querySelectorAll('[data-ayl-project]').forEach(function (proj) {
      var mainImg = proj.querySelector('[data-ayl-main]');
      var mainVideo = proj.querySelector('[data-ayl-video]');
      if (!mainImg) return;
      var switches = proj.querySelectorAll('[data-ayl-switch]');
      switches.forEach(function (btn) {
        btn.addEventListener('click', function () {
          switches.forEach(function (b) {
            b.classList.remove('is-active');
            if (b.hasAttribute('role')) b.setAttribute('aria-selected', 'false');
          });
          btn.classList.add('is-active');
          if (btn.hasAttribute('role')) btn.setAttribute('aria-selected', 'true');
          if (btn.hasAttribute('data-show-video') && mainVideo) {
            mainImg.hidden = true;
            mainVideo.hidden = false;
            mainVideo.play();
          } else {
            if (mainVideo) { mainVideo.hidden = true; mainVideo.pause(); }
            mainImg.hidden = false;
            swapImage(mainImg, btn.getAttribute('data-full'));
          }
        });
      });
    });
  })();
</script>

