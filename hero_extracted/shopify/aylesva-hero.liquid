<script>
(function () {
  var frame = document.getElementById('ayFrame');
  var scene = document.getElementById('ayScene');
  if (!frame || !scene) return;
  var layers = scene.querySelectorAll('[data-layer]');
  var scale = 1;

  function fit() {
    scale = Math.min(1, frame.clientWidth / 800);
    scene.style.transform = 'translateY(-50%) scale(' + scale + ')';
    frame.style.minHeight = (540 * scale) + 'px';
  }
  function parallax() {
    var r = scene.getBoundingClientRect();
    var p = (window.innerHeight / 2 - (r.top + r.height / 2)) / window.innerHeight;
    for (var i = 0; i < layers.length; i++) {
      layers[i].style.translate = '0 ' + (p * parseFloat(layers[i].dataset.layer) * 80).toFixed(1) + 'px';
    }
  }
  window.addEventListener('resize', fit);
  window.addEventListener('scroll', parallax, { passive: true });
  fit(); parallax();
})();
</script>

