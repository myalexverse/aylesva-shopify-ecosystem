{% comment %}
  ============================================================
  Mi Última Voluntad — Premium US Replica Landing Section
  Identical design, maquetation, images, hover and interactive
  effects translated to Spanish.
  ============================================================
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
  body:has(#muv-{{ section.id }}) .breadcrumb-wrapper,
  body:has(#muv-{{ section.id }}) .breadcrumb-wrap,
  body:has(#muv-{{ section.id }}) nav[aria-label="breadcrumbs"],
  body:has(#muv-{{ section.id }}) #annoucementbar,
  body:has(#muv-{{ section.id }}) .shopify-section.announcement-bar { display: none !important; }

  html { scroll-behavior: smooth; }

  @keyframes muvGlow-{{ section.id }}  { 0%,100%{opacity:.55;transform:translate(-50%,-50%) scale(1)}50%{opacity:.9;transform:translate(-50%,-50%) scale(1.08)} }
  @keyframes muvFloat-{{ section.id }} { 0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)} }

  #muv-{{ section.id }} {
    font-family: 'Manrope', -apple-system, sans-serif;
    background: #FAF9F6;
    color: #1B1710;
    margin-top: 20px;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
  }
  #muv-{{ section.id }} * { box-sizing: border-box; }
  #muv-{{ section.id }} h1, #muv-{{ section.id }} h2, #muv-{{ section.id }} h3 { margin: 0; color: #1B1710; }
  #muv-{{ section.id }} p { margin: 0; }
  #muv-{{ section.id }} a { text-decoration: none; color: #1B1710; }

  /* ---- BUTTONS ---- */
  #muv-{{ section.id }} .muv-btn-primary { font-family:'Sora',sans-serif; font-weight:700; font-size:15px; color:#fff; background:#1B1710; padding:16px 34px; border-radius:100px; box-shadow:0 8px 32px rgba(27,23,16,.28); transition:transform .25s,box-shadow .25s,filter .25s; display:inline-block; border: none; cursor: pointer; }
  #muv-{{ section.id }} .muv-btn-primary:hover { transform:translateY(-2px); box-shadow:0 12px 42px rgba(27,23,16,.38); color:#fff; }
  #muv-{{ section.id }} .muv-btn-ghost { font-family:'Sora',sans-serif; font-weight:600; font-size:15px; color:#1B1710; background:rgba(255,255,255,.65); border:1px solid rgba(27,23,16,.22); padding:16px 34px; border-radius:100px; backdrop-filter:blur(8px); transition:border-color .25s,background .25s; display:inline-block; }
  #muv-{{ section.id }} .muv-btn-ghost:hover { border-color:#1B1710; background:rgba(27,23,16,.08); }
  #muv-{{ section.id }} .muv-btn-outline { font-family:'Sora',sans-serif; font-weight:700; font-size:15px; color:#1B1710; border:1.5px solid #1B1710; padding:15px 34px; border-radius:100px; transition:background .25s,color .25s; display:inline-block; }
  #muv-{{ section.id }} .muv-btn-outline:hover { background:#1B1710; color:#fff; }

  /* ---- EYEBROW ---- */
  #muv-{{ section.id }} .muv-eyebrow { display:block; font-size:12px; font-weight:600; letter-spacing:.26em; text-transform:uppercase; color:#1B1710; }

  /* ---- SECTION PADDING ---- */
  #muv-{{ section.id }} .muv-band { padding:clamp(80px,10vw,140px) clamp(20px,5vw,64px); }

  /* ======== HERO ======== */
  #muv-{{ section.id }} .muv-hero { position:relative; margin-top:0; min-height:100vh; display:flex; align-items:center; justify-content:center; text-align:center; overflow:hidden; }
  #muv-{{ section.id }} .muv-hero-bg { position:absolute; inset:-12% 0; z-index:0; }
  #muv-{{ section.id }} .muv-hero-bg img { width:100%; height:100%; object-fit:cover; display:block; }
  #muv-{{ section.id }} .muv-hero-overlay { position:absolute; inset:0; z-index:1; background:linear-gradient(180deg,rgba(250,249,246,.88) 0%,rgba(250,249,246,.68) 45%,rgba(250,249,246,.97) 100%); }
  #muv-{{ section.id }} .muv-hero-glow { position:absolute; left:50%; top:38%; width:640px; height:640px; transform:translate(-50%,-50%); z-index:1; border-radius:50%; background:radial-gradient(circle,rgba(27,23,16,.18) 0%,transparent 62%); animation:muvGlow-{{ section.id }} 7s ease-in-out infinite; pointer-events:none; }
  #muv-{{ section.id }} .muv-hero-content { position:relative; z-index:2; max-width:880px; padding:140px 24px 90px; display:flex; flex-direction:column; align-items:center; gap:28px; }
  #muv-{{ section.id }} .muv-hero h1 { font-family:'Sora',sans-serif; font-weight:800; font-size:clamp(34px,5.6vw,64px); line-height:1.12; letter-spacing:-.01em; color:#1B1710; }
  #muv-{{ section.id }} .muv-hero-sub { max-width:620px; font-size:clamp(16px,1.6vw,19px); line-height:1.65; color:rgba(27,23,16,.72); }
  #muv-{{ section.id }} .muv-hero-cta { display:flex; flex-wrap:wrap; gap:14px; justify-content:center; margin-top:6px; }
  #muv-{{ section.id }} .muv-badges { display:flex; flex-wrap:wrap; gap:clamp(14px,3vw,34px); justify-content:center; margin-top:16px; }
  #muv-{{ section.id }} .muv-badge { display:flex; align-items:center; gap:8px; font-size:13.5px; font-weight:500; color:rgba(27,23,16,.7); }
  #muv-{{ section.id }} .muv-badge-check { display:inline-flex; width:18px; height:18px; border-radius:50%; background:rgba(27,23,16,.15); align-items:center; justify-content:center; color:#1B1710; font-size:11px; flex-shrink:0; }
  #muv-{{ section.id }} .muv-scroll-arrow { position:absolute; bottom:28px; left:50%; transform:translateX(-50%); z-index:2; color:rgba(27,23,16,.4); font-size:20px; animation:muvFloat-{{ section.id }} 2.6s ease-in-out infinite; }

  /* ======== WHY MUV ======== */
  #muv-{{ section.id }} .muv-why-inner { max-width:1200px; margin:0 auto; }
  #muv-{{ section.id }} .muv-why-title { max-width:760px; text-align:center; margin:0 auto 64px; font-family:'Sora',sans-serif; font-weight:700; font-size:clamp(26px,3.4vw,40px); line-height:1.25; color:#1B1710; }
  #muv-{{ section.id }} .muv-why-title .muv-gold { color:#1B1710; }
  #muv-{{ section.id }} .muv-cards-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:24px; }
  #muv-{{ section.id }} .muv-card { padding:40px 32px; border-radius:20px; background:#FFFFFF; border:1px solid rgba(27,23,16,.08); box-shadow:0 6px 24px rgba(27,23,16,.05); transition:transform .3s,border-color .3s; }
  #muv-{{ section.id }} .muv-card:hover { transform:translateY(-6px); border-color:rgba(27,23,16,.45); }
  #muv-{{ section.id }} .muv-card-icon { width:48px; height:48px; border-radius:14px; background:rgba(27,23,16,.1); border:1px solid rgba(27,23,16,.3); display:flex; align-items:center; justify-content:center; margin-bottom:22px; color:#1B1710; font-family:'Sora',sans-serif; font-weight:700; font-size:18px; }
  #muv-{{ section.id }} .muv-card h3 { font-family:'Sora',sans-serif; font-weight:700; font-size:20px; margin-bottom:10px; color:#1B1710; }
  #muv-{{ section.id }} .muv-card p { font-size:15px; line-height:1.65; color:rgba(27,23,16,.62); }

  /* ======== MEMBERSHIPS ======== */
  #muv-{{ section.id }} .muv-memberships { background:radial-gradient(ellipse 80% 60% at 50% 0%,rgba(27,23,16,.08),transparent 70%); }
  #muv-{{ section.id }} .muv-mem-inner { max-width:1080px; margin:0 auto; }
  #muv-{{ section.id }} .muv-section-head { text-align:center; margin-bottom:64px; }
  #muv-{{ section.id }} .muv-section-head h2 { font-family:'Sora',sans-serif; font-weight:700; font-size:clamp(26px,3.4vw,40px); line-height:1.25; margin-top:16px; color:#1B1710; }
  #muv-{{ section.id }} .muv-plans-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(300px,1fr)); gap:28px; }
  #muv-{{ section.id }} .muv-plan { position:relative; padding:44px 38px; border-radius:24px; background:#FFFFFF; border:1px solid rgba(27,23,16,.3); overflow:hidden; box-shadow:0 10px 36px rgba(27,23,16,.06); transition:transform .3s,box-shadow .3s; }
  #muv-{{ section.id }} .muv-plan:hover { transform:translateY(-6px); box-shadow:0 24px 60px rgba(27,23,16,.14),0 0 0 1px rgba(27,23,16,.4); }
  #muv-{{ section.id }} .muv-plan-glow { position:absolute; top:-60px; right:-60px; width:200px; height:200px; border-radius:50%; background:radial-gradient(circle,rgba(27,23,16,.08),transparent 70%); pointer-events:none; }
  #muv-{{ section.id }} .muv-plan-title { display:flex; align-items:center; gap:12px; margin-bottom:8px; }
  #muv-{{ section.id }} .muv-plan-title span { font-family:'Sora',sans-serif; font-weight:700; font-size:clamp(20px,2.2vw,25px); color:#1B1710; }
  #muv-{{ section.id }} .muv-plan-title .muv-arrow { color:#1B1710; font-size:22px; }
  #muv-{{ section.id }} .muv-plan-title .muv-dest { color:#1B1710; }
  #muv-{{ section.id }} .muv-plan-label { font-size:13px; letter-spacing:.08em; text-transform:uppercase; color:rgba(27,23,16,.45); margin-bottom:30px; }
  #muv-{{ section.id }} .muv-plan-benefits { display:flex; flex-direction:column; gap:14px; margin-bottom:36px; }
  #muv-{{ section.id }} .muv-benefit { display:flex; align-items:flex-start; gap:12px; font-size:15px; line-height:1.5; color:rgba(27,23,16,.75); }
  #muv-{{ section.id }} .muv-benefit-check { flex:none; display:inline-flex; width:20px; height:20px; border-radius:50%; background:rgba(27,23,16,.13); align-items:center; justify-content:center; color:#1B1710; font-size:11px; margin-top:1px; }

  /* ======== CBX ======== */
  #muv-{{ section.id }} .muv-cbx { position:relative; min-height:min(720px,90vh); display:flex; align-items:center; background:#F2EFE8; overflow:hidden; }
  #muv-{{ section.id }} .muv-cbx-bg { position:absolute; inset:0; z-index:0; }
  #muv-{{ section.id }} .muv-cbx-bg img { width:100%; height:100%; object-fit:cover; display:block; }
  #muv-{{ section.id }} .muv-cbx-overlay { position:absolute; inset:0; z-index:1; background:linear-gradient(90deg,rgba(242,239,232,.97) 0%,rgba(242,239,232,.85) 50%,rgba(242,239,232,.4) 100%); }
  #muv-{{ section.id }} .muv-cbx-inner { position:relative; z-index:2; max-width:1200px; margin:0 auto; padding:80px 24px; width:100%; display:grid; grid-template-columns:repeat(auto-fit,minmax(300px,1fr)); gap:clamp(40px,6vw,90px); align-items:center; }
  #muv-{{ section.id }} .muv-cbx-text { max-width:540px; }
  #muv-{{ section.id }} .muv-cbx-text .muv-eyebrow { color:rgba(27,23,16,.6); margin-bottom:18px; }
  #muv-{{ section.id }} .muv-cbx-text h2 { font-family:'Sora',sans-serif; font-weight:800; font-size:clamp(28px,3.6vw,44px); line-height:1.18; margin-bottom:20px; color:#1B1710; }
  #muv-{{ section.id }} .muv-cbx-text p { font-size:16.5px; line-height:1.7; color:rgba(27,23,16,.75); margin-bottom:30px; }
  #muv-{{ section.id }} .muv-cbx-text strong { color:#1B1710; }
  #muv-{{ section.id }} .muv-cbx-disclaimer { margin-top:34px; padding:14px 18px; border:1px solid rgba(27,23,16,.25); border-radius:10px; background:rgba(255,255,255,.75); display:flex; flex-direction:column; gap:6px; max-width:480px; text-align: left; }
  #muv-{{ section.id }} .muv-cbx-disclaimer span { font-size:11.5px; font-weight:700; line-height:1.5; color:rgba(27,23,16,.8); }
  #muv-{{ section.id }} .muv-cbx-card-wrap { display:flex; justify-content:center; }
  #muv-{{ section.id }} .muv-cbx-card { position:relative; width:min(520px,100%); border-radius:26px; border:3px solid #C5A47E; background:linear-gradient(135deg,rgba(24,12,40,.94),rgba(45,20,80,.9)); box-shadow:0 18px 60px rgba(27,23,16,.22),0 0 90px rgba(197,164,126,.15),inset 0 0 40px rgba(197,164,126,.08); padding:clamp(24px,3vw,38px) clamp(20px,2.5vw,32px); display:grid; grid-template-columns:1.2fr auto 1.1fr; align-items:center; gap:clamp(14px,2vw,24px); animation:muvFloat-{{ section.id }} 5s ease-in-out infinite; }
  #muv-{{ section.id }} .muv-cbx-card-left { text-align:center; }
  #muv-{{ section.id }} .muv-cbx-brand { font-family:'Sora',sans-serif; font-weight:800; font-size:clamp(30px,3.4vw,44px); letter-spacing:.04em; color:#fff; line-height:1; }
  #muv-{{ section.id }} .muv-cbx-bar { height:4px; width:70%; margin:6px auto 8px; border-radius:100px; background:linear-gradient(90deg,#C5A47E,#FAF9F6); }
  #muv-{{ section.id }} .muv-cbx-label { font-size:10px; letter-spacing:.18em; font-weight:600; color:rgba(255,255,255,.85); }
  #muv-{{ section.id }} .muv-cbx-mid { display:flex; align-items:center; gap:clamp(10px,1.4vw,18px); }
  #muv-{{ section.id }} .muv-cbx-divider { width:0; height:80px; border-left:2px dashed rgba(255,255,255,.3); }
  #muv-{{ section.id }} .muv-cbx-plane { font-size:clamp(26px,2.8vw,36px); color:#C5A47E; }
  #muv-{{ section.id }} .muv-cbx-card-right { text-align:center; }
  #muv-{{ section.id }} .muv-cbx-pass { font-family:'Sora',sans-serif; font-weight:700; font-size:clamp(13px,1.3vw,17px); letter-spacing:.08em; color:#fff; }
  #muv-{{ section.id }} .muv-cbx-free { font-family:'Sora',sans-serif; font-weight:800; font-size:clamp(28px,3vw,40px); line-height:1.1; background:linear-gradient(90deg,#C5A47E,#FAF9F6); -webkit-background-clip:text; background-clip:text; -webkit-text-fill-color:transparent; }
  #muv-{{ section.id }} .muv-cbx-via { font-family:'Sora',sans-serif; font-weight:700; font-size:clamp(12px,1.2vw,16px); letter-spacing:.1em; color:#fff; }

  /* ======== HOW IT WORKS ======== */
  #muv-{{ section.id }} .muv-steps-inner { max-width:1200px; margin:0 auto; }
  #muv-{{ section.id }} .muv-steps-head { text-align:center; margin-bottom:70px; }
  #muv-{{ section.id }} .muv-steps-head h2 { font-family:'Sora',sans-serif; font-weight:700; font-size:clamp(26px,3.4vw,40px); margin-top:16px; color:#1B1710; }
  #muv-{{ section.id }} .muv-steps-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:20px; }
  #muv-{{ section.id }} .muv-step { padding:36px 26px 32px; border-radius:18px; background:#FFFFFF; border:1px solid rgba(27,23,16,.08); box-shadow:0 6px 24px rgba(27,23,16,.04); text-align: left; }
  #muv-{{ section.id }} .muv-step-num { font-family:'Sora',sans-serif; font-weight:800; font-size:44px; line-height:1; background:linear-gradient(180deg,#1B1710,rgba(27,23,16,.25)); -webkit-background-clip:text; background-clip:text; -webkit-text-fill-color:transparent; margin-bottom:20px; }
  #muv-{{ section.id }} .muv-step p { font-size:15.5px; line-height:1.6; color:rgba(27,23,16,.75); }

  /* ======== EMOTIONAL ======== */
  #muv-{{ section.id }} .muv-emo-inner { max-width:1080px; margin:0 auto; display:grid; grid-template-columns:repeat(auto-fit,minmax(300px,1fr)); gap:clamp(36px,6vw,72px); align-items:center; }
  #muv-{{ section.id }} .muv-emo-media { position:relative; }
  #muv-{{ section.id }} .muv-emo-glow { position:absolute; inset:-20px; border-radius:28px; background:radial-gradient(circle at 30% 70%,rgba(27,23,16,.12),transparent 70%); pointer-events:none; }
  #muv-{{ section.id }} .muv-emo-media img { position:relative; width:100%; height:clamp(320px,40vw,460px); object-fit:cover; border-radius:24px; display:block; }
  #muv-{{ section.id }} .muv-emo-body { text-align: left; }
  #muv-{{ section.id }} .muv-emo-body h2 { font-family:'Sora',sans-serif; font-weight:700; font-size:clamp(26px,3.4vw,40px); line-height:1.22; margin-bottom:22px; color:#1B1710; }
  #muv-{{ section.id }} .muv-emo-body h2 span { color:#1B1710; }
  #muv-{{ section.id }} .muv-emo-body p { font-size:17px; line-height:1.75; color:rgba(27,23,16,.68); margin-bottom:32px; }

  /* ======== FAQ ======== */
  #muv-{{ section.id }} .muv-faq-inner { max-width:760px; margin:0 auto; }
  #muv-{{ section.id }} .muv-faq-inner h2 { text-align:center; font-family:'Sora',sans-serif; font-weight:700; font-size:clamp(24px,3vw,36px); margin-bottom:48px; color:#1B1710; }
  #muv-{{ section.id }} .muv-faq-list { display:flex; flex-direction:column; gap:14px; }
  #muv-{{ section.id }} .muv-faq-item { border-radius:16px; background:#FFFFFF; border:1px solid rgba(27,23,16,.09); box-shadow:0 4px 18px rgba(27,23,16,.04); overflow:hidden; text-align: left; }
  #muv-{{ section.id }} .muv-faq-btn { width:100%; display:flex; align-items:center; justify-content:space-between; gap:16px; padding:22px 26px; background:none; border:none; cursor:pointer; text-align:left; font-family:'Sora',sans-serif; font-weight:600; font-size:16px; color:#1B1710; transition:color .2s; }
  #muv-{{ section.id }} .muv-faq-btn:hover { color:#000; }
  #muv-{{ section.id }} .muv-faq-icon { flex:none; display:inline-flex; width:28px; height:28px; align-items:center; justify-content:center; border-radius:50%; border:1px solid rgba(27,23,16,.4); color:#1B1710; font-size:14px; transition:transform .35s; }
  #muv-{{ section.id }} .muv-faq-icon.is-open { transform:rotate(45deg); }
  #muv-{{ section.id }} .muv-faq-body { max-height:0; overflow:hidden; opacity:0; transition:max-height .45s ease,opacity .35s ease; }
  #muv-{{ section.id }} .muv-faq-body.is-open { max-height:400px; opacity:1; }
  #muv-{{ section.id }} .muv-faq-body p { padding:0 26px 24px; font-size:15px; line-height:1.7; color:rgba(27,23,16,.62); }

  /* ======== FINAL CTA ======== */
  #muv-{{ section.id }} .muv-cta { position:relative; padding:clamp(100px,13vw,180px) clamp(20px,5vw,64px); text-align:center; overflow:hidden; background:#F2EFE8; }
  #muv-{{ section.id }} .muv-cta-bg { position:absolute; inset:0; opacity:.3; }
  #muv-{{ section.id }} .muv-cta-bg img { width:100%; height:100%; object-fit:cover; }
  #muv-{{ section.id }} .muv-cta-overlay { position:absolute; inset:0; background:linear-gradient(180deg,rgba(250,249,246,1) 0%,rgba(250,249,246,.6) 45%,rgba(242,239,232,.97) 100%),radial-gradient(ellipse 70% 90% at 50% 110%,rgba(27,23,16,.14),transparent 70%); }
  #muv-{{ section.id }} .muv-cta-content { position:relative; max-width:720px; margin:0 auto; display:flex; flex-direction:column; align-items:center; gap:26px; }
  #muv-{{ section.id }} .muv-cta-content h2 { font-family:'Sora',sans-serif; font-weight:800; font-size:clamp(32px,5vw,56px); line-height:1.15; color:#1B1710; }
  #muv-{{ section.id }} .muv-cta-content h2 span { color:#1B1710; }
  #muv-{{ section.id }} .muv-cta-content p { font-size:17px; line-height:1.7; color:rgba(27,23,16,.68); max-width:560px; }

  /* ======== FORM ======== */
  #muv-{{ section.id }} .muv-form-inner { max-width:760px; margin:0 auto; }
  #muv-{{ section.id }} .muv-form-inner h2 { text-align:center; font-family:'Sora',sans-serif; font-weight:700; font-size:clamp(24px,3vw,36px); margin-bottom:14px; color:#1B1710; }
  #muv-{{ section.id }} .muv-form-sub { text-align:center; font-size:15.5px; line-height:1.7; color:rgba(27,23,16,.62); margin-bottom:40px; }
  #muv-{{ section.id }} .muv-form-embed { width:100%; min-height: 555px; }
  #muv-{{ section.id }} .muv-form-embed iframe { width:100% !important; border:0 !important; display:block; min-height: 555px; border-radius: 8px; }
  #muv-{{ section.id }} .muv-form-box { background: #fff; padding: 40px; border-radius: 20px; border: 1px solid rgba(27,23,16,.08); box-shadow: 0 8px 30px rgba(27,23,16,.04); }
  #muv-{{ section.id }} .muv-form-grid { display: grid; grid-template-columns: 1fr; gap: 20px; text-align: left; }
  #muv-{{ section.id }} .muv-field { display: flex; flex-direction: column; gap: 8px; }
  #muv-{{ section.id }} .muv-field label { font-size: 13.5px; font-weight: 700; color: #1B1710; text-transform: uppercase; letter-spacing: 0.5px; }
  #muv-{{ section.id }} .muv-field input,
  #muv-{{ section.id }} .muv-field select,
  #muv-{{ section.id }} .muv-field textarea { width: 100%; padding: 14px 18px; border-radius: 12px; border: 1.5px solid rgba(0, 0, 0, 0.12); font-family: inherit; font-size: 15px; transition: border-color .3s, box-shadow .3s; outline: none; background: #fff; }
  #muv-{{ section.id }} .muv-field input:focus,
  #muv-{{ section.id }} .muv-field select:focus,
  #muv-{{ section.id }} .muv-field textarea:focus { border-color: #1B1710; box-shadow: 0 0 0 4px rgba(27, 23, 16, 0.08); }
  #muv-{{ section.id }} .muv-field textarea { height: 120px; resize: vertical; }
