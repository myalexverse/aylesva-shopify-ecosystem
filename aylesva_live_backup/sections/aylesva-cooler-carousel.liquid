{% comment %}
  aylesva-cooler-carousel.liquid  v3
  
  Desktop : animacin ping-pong CSS  igual que antes (no tocado)
  Mobile  : viewport scrollable + touch drag + barra de progreso
            La animacin se pausa en mobile; el viewport se vuelve
            scrollable horizontalmente. Sin HTML duplicado.
  
{% endcomment %}

{%- assign collection = collections[section.settings.collection] -%}
{%- assign product_limit = section.settings.product_limit -%}
{%- assign sid = section.id -%}

<div class="aylesva-cooler-section" id="section-{{ sid }}"
     style="margin-top:{{ section.settings.margin_top }}px; margin-bottom:{{ section.settings.margin_bottom }}px;">
  <div class="aylesva-full-container">
    {% if section.settings.title != blank %}
      <h2 class="aylesva-cooler-title">{{ section.settings.title }}</h2>
    {% endif %}

    <div class="aylesva-carousel-viewport" id="viewport-{{ sid }}">
      <div class="aylesva-carousel-track"
           id="track-{{ sid }}"
           style="animation-duration:{{ section.settings.animation_speed }}s;">
        {% for product in collection.products limit: product_limit %}
          <div class="aylesva-carousel-item">
            {% render 'aylesva-ml-card', product: product %}
          </div>
        {% else %}
          {% for i in (1..10) %}
            <div class="aylesva-carousel-item">
              <div class="aylesva-ml-card-placeholder"></div>
            </div>
          {% endfor %}
        {% endfor %}
      </div>
    </div>

    {%- comment -%} Barra de progreso  solo visible en mobile {%- endcomment -%}
    <div class="ayc-prog-wrap" id="ayc-prog-wrap-{{ sid }}" aria-hidden="true">
      <div class="ayc-prog-fill" id="ayc-prog-{{ sid }}"></div>
    </div>

    {%- comment -%} Swipe hint  solo en mobile, desaparece al primer toque {%- endcomment -%}
    <div class="ayc-swipe-hint" id="ayc-hint-{{ sid }}" aria-hidden="true">
      <span class="ayc-hint-arrow">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
      </span>
      Desliza
    </div>
  </div>
</div>

<style>
  .aylesva-cooler-section {
    padding: 15px 0;
    background: #fff;
    display: block;
    margin: 0;
    overflow: hidden;
  }
  .aylesva-full-container { width: 100%; padding: 0; }
  
  .aylesva-cooler-title {
    font-size: 14px;
    font-weight: 900;
    text-transform: uppercase;
    margin: 0 0 15px;
    color: #1a1a1a;
    letter-spacing: 0.1em;
    padding: 0 15px;
    text-align: center;
  }
  
  .aylesva-carousel-viewport {
    overflow: hidden;
    width: 100%;
    padding: 0 15px 5px;
  }
  
  .aylesva-carousel-track {
    display: flex;
    width: max-content;
    gap: 10px;
    animation-name: aylesvaPingPong;
    animation-iteration-count: infinite;
    animation-timing-function: linear;
    animation-direction: alternate;
    animation-play-state: running;
    will-change: transform;
  }

  .aylesva-carousel-item {
    width: 280px; /* Corregido: antes era 100px, lo que aplastaba las tarjetas en escritorio */
    flex-shrink: 0;
  }

  @keyframes aylesvaPingPong {
    0%   { transform: translateX(0); }
    100% { transform: translateX(calc(-100% + 100vw - 20px)); }
  }

  @media (max-width: 767px) {
    .aylesva-cooler-section {
      padding: 15px 0 25px;
      background: #fafafa;
    }
    .aylesva-carousel-viewport {
      padding: 0 10px;
    }
    .aylesva-carousel-track {
      gap: 8px;
      /* Desactivar animación CSS en móvil para que el JS tome el control total */
      animation: none !important;
      will-change: transform;
    }
    .aylesva-carousel-item {
      /* Exactly 4 products visible: 100vw / 4 = 25vw, minus margins/gaps */
      width: calc(25vw - 11px);
    }
    
    /* MICRO-CARD OVERRIDES (Only for this carousel to fit 4 items) */
    .aylesva-carousel-item .aylesva-ml-card__content {
      padding: 4px 2px;
    }
    .aylesva-carousel-item .aylesva-ml-card__badge {
      font-size: 7px;
      padding: 1px 4px;
      margin-bottom: 2px;
    }
    .aylesva-carousel-item .aylesva-ml-card__title {
      font-size: 9px;
      line-height: 1.2;
      max-height: 22px;
    }
    .aylesva-carousel-item .aylesva-ml-card__price {
      font-size: 11px;
    }
    .aylesva-carousel-item .aylesva-ml-card__original-price,
    .aylesva-carousel-item .aylesva-ml-card__discount {
      display: none; /* Hide secondary prices to save space */
    }

    .ayc-prog-wrap, .ayc-swipe-hint {
      display: none !important;
    }
  }
 */
  .ayc-prog-wrap {
    display: block;
    height: 2px;
    background: #e8e8e8;
    margin: 10px 14px 0;
    border-radius: 99px;
    overflow: hidden;
  }
  .ayc-prog-fill {
    height: 100%;
    width: 15%;
    background: #1a1a1a;
    border-radius: 99px;
    transition: width 0.12s linear;
  }

  /*  Swipe hint  */
  .ayc-swipe-hint {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 0 14px 8px;
    font-size: 11px;
    font-weight: 500;
    color: #aaa;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    opacity: 1;
    transition: opacity 0.4s ease;
  }
  .ayc-swipe-hint.hidden { opacity: 0; pointer-events: none; }
  .ayc-hint-arrow {
    display: inline-flex;
    animation: aycHintSlide 0.9s ease-in-out infinite;
  }
  @keyframes aycHintSlide {
    0%,100% { transform: translateX(0); }
    50%      { transform: translateX(5px); }
  }
}

/* Ocultar progress y hint en desktop */
@media (min-width: 768px) {
  .ayc-prog-wrap  { display: none; }
  .ayc-swipe-hint { display: none; }
}
</style>

<script>
(function() {
  var sid = '{{ sid }}';

  var track = document.getElementById('track-' + sid);
  var viewport = document.getElementById('viewport-' + sid);
  if (!track || !viewport) return;

  /* 
     DESKTOP: animacion ping-pong  solo pausa en hover
   */
  if (window.innerWidth > 767) {
    track.style.animationPlayState = 'running';
    track.addEventListener('mouseenter', function() {
      track.style.animationPlayState = 'paused';
    });
    track.addEventListener('mouseleave', function() {
      track.style.animationPlayState = 'running';
    });
    return; /* nada mas que hacer en desktop */
  }

  /* 
     MOBILE: Motor interactivo JS (Ping-Pong + Touch Drag)
   */
  var currentX = 0;
  var direction = -1; // -1 = izquierda, 1 = derecha
  var speed = 0.6; // Pixeles por frame (velocidad del auto-play)
  var isDragging = false;
  var isPaused = false;
  var startX = 0;
  var lastInteractionTime = 0;
  var animationFrameId;

  function animate() {
    var now = Date.now();
    var timeSinceInteraction = now - lastInteractionTime;

    // Solo se mueve si NO estamos arrastrando Y han pasado al menos 3 segundos desde el último toque
    if (!isDragging && timeSinceInteraction > 3000) {
      var maxScroll = -(track.scrollWidth - viewport.clientWidth);
      
      if (maxScroll < 0) {
        currentX += speed * direction;
        
        if (currentX <= maxScroll) {
          currentX = maxScroll;
          direction = 1; 
        } else if (currentX >= 0) {
          currentX = 0;
          direction = -1;
        }
        
        track.style.transform = 'translate3d(' + currentX + 'px, 0, 0)';
      }
    }
    
    animationFrameId = requestAnimationFrame(animate);
  }

  animate();

  // ----- EVENTOS TÁCTILES -----
  track.addEventListener('touchstart', function(e) {
    isDragging = true;
    lastInteractionTime = Date.now();
    startX = e.touches[0].clientX - currentX;
    track.style.transition = 'none';
  }, { passive: true });

  track.addEventListener('touchmove', function(e) {
    if (!isDragging) return;
    lastInteractionTime = Date.now();
    
    var maxScroll = -(track.scrollWidth - viewport.clientWidth);
    var newX = e.touches[0].clientX - startX;
    
    // Permitir un ligero "rebote" elástico al arrastrar (opcional, pero se siente mejor)
    if (newX > 10) newX = 10;
    if (newX < maxScroll - 10) newX = maxScroll - 10;
    
    currentX = newX;
    track.style.transform = 'translate3d(' + currentX + 'px, 0, 0)';
  }, { passive: true });

  track.addEventListener('touchend', function(e) {
    isDragging = false;
    lastInteractionTime = Date.now();
    
    // Corregir posición si se pasó del límite elástico
    var maxScroll = -(track.scrollWidth - viewport.clientWidth);
    if (currentX > 0) {
      currentX = 0;
      track.style.transition = 'transform 0.3s ease-out';
      track.style.transform = 'translate3d(0, 0, 0)';
    } else if (currentX < maxScroll) {
      currentX = maxScroll;
      track.style.transition = 'transform 0.3s ease-out';
      track.style.transform = 'translate3d(' + maxScroll + 'px, 0, 0)';
    }
  });

})();
</script>

{% schema %}
{
  "name": "Cooler Carrusel",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Ttulo de la Seccin",
      "default": "Ofertas Destacadas"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Seleccionar Coleccin"
    },
    {
      "type": "range",
      "id": "product_limit",
      "min": 4,
      "max": 24,
      "step": 1,
      "label": "Mximo de productos",
      "default": 12
    },
    {
      "type": "range",
      "id": "animation_speed",
      "min": 10,
      "max": 60,
      "step": 5,
      "label": "Velocidad de Movimiento (segundos)",
      "default": 25,
      "info": "Menos segundos = ms rpido"
    },
    {
      "type": "header",
      "content": "Diseo"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "label": "Margen Superior",
      "default": 30
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "label": "Margen Inferior",
      "default": 30
    }
  ],
  "presets": [
    {
      "name": "Cooler Carrusel",
      "category": "Colecciones"
    }
  ]
}
{% endschema %}
