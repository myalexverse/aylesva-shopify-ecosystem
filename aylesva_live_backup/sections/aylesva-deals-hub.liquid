  // Carousel scroll arrows behavior
  function updateArrows() {
    if (!prevBtn || !nextBtn || !tabsEl) return;
    prevBtn.disabled = tabsEl.scrollLeft <= 4;
    nextBtn.disabled = tabsEl.scrollLeft >= tabsEl.scrollWidth - tabsEl.clientWidth - 4;
  }
  if (prevBtn && nextBtn && tabsEl) {
    prevBtn.addEventListener('click', function() {
      tabsEl.scrollBy({ left: -240, behavior: 'smooth' });
    });
    nextBtn.addEventListener('click', function() {
      tabsEl.scrollBy({ left: 240, behavior: 'smooth' });
    });
    tabsEl.addEventListener('scroll', updateArrows);
    updateArrows();
    // Watch resize to update buttons correctly
    window.addEventListener('resize', updateArrows);
  }

