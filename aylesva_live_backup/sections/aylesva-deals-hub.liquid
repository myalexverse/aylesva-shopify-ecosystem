  function syncCategoryUI() {
    if (tabsEl) {
      tabsEl.querySelectorAll('.aos-tab').forEach(function(t) {
        t.classList.toggle('active', t.dataset.cat === activeCat);
      });
    }
    if (sideCatsEl) {
