        t.classList.toggle('active', t.dataset.cat === activeCat);
      });
    }
    if (drawerCatsEl) {
      drawerCatsEl.querySelectorAll('.aos-side-cat').forEach(function(t) {
        t.classList.toggle('active', t.dataset.cat === activeCat);
      });
    }
  }

  buildSidebarCats();

  // Price inputs sync behavior
  if (pminEl) pminEl.addEventListener('input', function(){ priceMin = parseFloat(pminEl.value) || 0; if (pmin2El) pmin2El.value = pminEl.value; currentPage = 1; render(); });
  if (pmaxEl) pmaxEl.addEventListener('input', function(){ priceMax = parseFloat(pmaxEl.value) || Infinity; if (pmax2El) pmax2El.value = pmaxEl.value; currentPage = 1; render(); });

  // Sidebar discount filter chips
  page.querySelectorAll('.aos-sidebar .aos-disc-chip').forEach(function(chip) {
    chip.addEventListener('click', function() {
      page.querySelectorAll('.aos-sidebar .aos-disc-chip').forEach(function(c){ c.classList.remove('active'); });
      chip.classList.add('active');
      activeDisc = parseInt(chip.dataset.min, 10) || 0;
      if (drawerDiscEl) {
        drawerDiscEl.querySelectorAll('.aos-disc-chip').forEach(function(c){ c.classList.remove('active'); });
        var mMatch = drawerDiscEl.querySelector('.aos-disc-chip[data-min="' + chip.dataset.min + '"]');
        if (mMatch) mMatch.classList.add('active');
      }
      currentPage = 1;
      render();
    });
  });

  // Toolbar secondary filter buttons
  var tierButtons = page.querySelectorAll('[data-tier]');
  if (tierButtons.length) {
    tierButtons.forEach(function(btn) {
      btn.addEventListener('click', function() {
        tierButtons.forEach(function(b){ b.classList.remove('active'); });
        btn.classList.add('active');
        activeTier = btn.dataset.tier;
        currentPage = 1;
        render();
      });
    });
  }

  // Sort dropdown changes
  var sortSelect = page.querySelector('.aos-sort');
  if (sortSelect) {
    sortSelect.addEventListener('change', function() {
      activeSort = sortSelect.value;
      currentPage = 1;
      render();
    });
  }

  // Reset filters
  if (resetBtn) {
    resetBtn.addEventListener('click', function() {
      activeCat = 'all';
      activeTier = 'all';
      activeDisc = 0;
      priceMin = 0;
      priceMax = Infinity;
      if (pminEl) pminEl.value = '';
      if (pmaxEl) pmaxEl.value = '';
      if (pmin2El) pmin2El.value = '';
      if (pmax2El) pmax2El.value = '';
      
      page.querySelectorAll('.aos-disc-chip').forEach(function(c){ c.classList.toggle('active', c.dataset.min === '0'); });
      if (tierButtons.length) {
        tierButtons.forEach(function(b){ b.classList.toggle('active', b.dataset.tier === 'all'); });
      }
      syncCategoryUI();
      currentPage = 1;
      render();
    });
  }

  // Main client-side filtering + pagination render core
  function render() {
    if (loadEl) loadEl.style.display = 'block';
    if (gridEl) gridEl.style.display = 'none';
    if (emptyEl) emptyEl.style.display = 'none';
    if (pagEl) pagEl.style.display = 'none';

    // 1. Filter products list
    var filtered = processedProducts.filter(function(p) {
      if (activeCat !== 'all' && p.computedCategory !== activeCat) return false;

      if (activeTier === '50plus' && p.computedDiscount < 50) return false;
      if (activeTier === '30to49' && (p.computedDiscount < 30 || p.computedDiscount > 49)) return false;
      if (activeTier === 'under30' && p.computedDiscount >= 30) return false;

      if (activeDisc > 0 && p.computedDiscount < activeDisc) return false;

      var priceMXN = p.computedPrice / 100.0;
      if (priceMXN < priceMin) return false;
      if (priceMXN > priceMax) return false;

      return true;
    });

    // 2. Sort products list
    filtered.sort(function(a, b) {
      if (activeSort === 'pct-desc') {
        return b.computedDiscount - a.computedDiscount;
      } else if (activeSort === 'price-asc') {
        return a.computedPrice - b.computedPrice;
      } else if (activeSort === 'price-desc') {
        return b.computedPrice - a.computedPrice;
      }
      return 0;
    });

    // 3. Update result counter UI
    if (countEl) countEl.textContent = filtered.length;

    if (loadEl) loadEl.style.display = 'none';

    if (filtered.length === 0) {
      if (emptyEl) emptyEl.style.display = 'block';
      if (gridEl) gridEl.innerHTML = '';
      return;
    }

    // 4. Paginate products
    var totalPages = Math.ceil(filtered.length / PAGE_SIZE);
    if (currentPage > totalPages) currentPage = totalPages || 1;

    var startIdx = (currentPage - 1) * PAGE_SIZE;
    var endIdx = startIdx + PAGE_SIZE;
    var pageProducts = filtered.slice(startIdx, endIdx);

    // Build grid DOM
    if (gridEl) {
      var gridHtml = '';
      pageProducts.forEach(function(p, i) {
        gridHtml += buildCard(p, startIdx + i);
      });
      gridEl.innerHTML = gridHtml;
      gridEl.style.display = 'grid';
    }

    // Paginate UI controls
    if (pagEl && totalPages > 1) {
      var pagHtml = '';
      
      pagHtml += '<button class="aos-pag-btn" ' + (currentPage === 1 ? 'disabled' : '') + ' data-page="' + (currentPage - 1) + '">←</button>';
      
      for (var pageNum = 1; pageNum <= totalPages; pageNum++) {
        var isActive = pageNum === currentPage;
        pagHtml += '<button class="aos-pag-btn' + (isActive ? ' active' : '') + '" data-page="' + pageNum + '">' + pageNum + '</button>';
      }

      pagHtml += '<button class="aos-pag-btn" ' + (currentPage === totalPages ? 'disabled' : '') + ' data-page="' + (currentPage + 1) + '">→</button>';
      
      pagEl.innerHTML = pagHtml;
      pagEl.style.display = 'flex';

      pagEl.querySelectorAll('.aos-pag-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          if (btn.disabled) return;
          currentPage = parseInt(btn.dataset.page, 10);
          render();
          var barY = page.querySelector('.aos-tabs-bar').getBoundingClientRect().top + window.scrollY;
          window.scrollTo({ top: barY - 10, behavior: 'smooth' });
        });
      });
    }
  }

  // Flash Deal bar display logic
  var bestFlashDeal = null;
  processedProducts.forEach(function(p) {
    if (p.computedDiscount > 0) {
      if (!bestFlashDeal || p.computedDiscount > bestFlashDeal.computedDiscount) {
        bestFlashDeal = p;
      }
    }
  });

  if (bestFlashDeal && flashEl) {
    if (flashTitle) {
      flashTitle.innerHTML = '¡Hasta <span>' + bestFlashDeal.computedDiscount + '% de descuento</span> en ' + bestFlashDeal.title + '!';
    }
    if (flashLink) {
      flashLink.href = '/products/' + bestFlashDeal.handle;
      flashLink.textContent = '¡Comprar ya! →';
    }
    flashEl.style.display = 'block';

    var countdownDuration = 12 * 60 * 60 * 1000;
    var endTime = Date.now() + countdownDuration;
    
    var hEl = flashEl.querySelector('#aos-cd-h');
    var mEl = flashEl.querySelector('#aos-cd-m');
    var sEl = flashEl.querySelector('#aos-cd-s');

    function updateCountdown() {
      var diff = endTime - Date.now();
      if (diff <= 0) {
        endTime = Date.now() + countdownDuration;
        diff = countdownDuration;
      }
      var hrs = Math.floor(diff / (60 * 60 * 1000));
      var mins = Math.floor((diff % (60 * 60 * 1000)) / (60 * 1000));
      var secs = Math.floor((diff % (60 * 1000)) / 1000);
      
      if (hEl) hEl.textContent = pad2(hrs);
      if (mEl) mEl.textContent = pad2(mins);
      if (sEl) sEl.textContent = pad2(secs);
    }
    updateCountdown();
    setInterval(updateCountdown, 1000);
  }

  // Hero section mini-grid and carousel dynamic builder
  var topDeals = processedHeroProducts.filter(function(p){ return p.computedDiscount > 0; })
    .sort(function(a,b){ return b.computedDiscount - a.computedDiscount; })
    .slice(0, 4);

  // Robust Fallback: if we have fewer than 4 discounted products, fill the rest with products from the collection to avoid blank space
  if (topDeals.length < 4 && processedHeroProducts.length > 0) {
    var usedIds = {};
    topDeals.forEach(function(d){ usedIds[d.id] = true; });
    for (var i = 0; i < processedHeroProducts.length; i++) {
      if (topDeals.length >= 4) break;
      var p = processedHeroProducts[i];
      if (!usedIds[p.id]) {
        topDeals.push(p);
        usedIds[p.id] = true;
      }
    }
  }

  if (topDeals.length > 0) {
    if (heroMiniGrid) {
      var mgHtml = '';
      topDeals.forEach(function(p) {
        var imgUrl = p.featured_image ? thumbUrl(p.featured_image) : '';
        mgHtml += '<a href="/products/' + p.handle + '" class="aos-hero-mini">';
        if (imgUrl) {
          mgHtml += '<img src="' + imgUrl + '" alt="' + p.title + '" loading="lazy">';
        }
        mgHtml += '<div class="aos-hero-mini-overlay"></div>';
        if (p.computedDiscount > 0) {
          mgHtml += '<span class="aos-hero-mini-badge">-' + p.computedDiscount + '%</span>';
        }
        mgHtml += '</a>';
      });
      heroMiniGrid.innerHTML = mgHtml;
      heroMiniGrid.style.display = 'grid';
    }

    if (heroCarousel && heroTrack && heroDotsEl) {
      var trackHtml = '';
      var dotsHtml = '';
      topDeals.forEach(function(p, i) {
        var imgUrl = p.featured_image ? thumbUrl(p.featured_image) : '';
        var activeClass = i === 0 ? '' : ' aos-hc-hidden';
        
        trackHtml += '<a href="/products/' + p.handle + '" class="aos-hero-card' + activeClass + (i === 0 ? ' active' : '') + '">';
        if (p.computedDiscount > 0) {
          trackHtml += '<span class="aos-hero-card-badge">-' + p.computedDiscount + '%</span>';
        }
        trackHtml += '<div class="aos-hero-card-img">';
        if (imgUrl) {
          trackHtml += '<img src="' + imgUrl + '" alt="' + p.title + '" loading="lazy">';
        }
        trackHtml += '</div>';
        trackHtml += '<div class="aos-hero-card-body">';
        trackHtml += '<div class="aos-hero-card-brand">' + (p.vendor || '') + '</div>';
        trackHtml += '<h4 class="aos-hero-card-title">' + p.title + '</h4>';
        trackHtml += '<div class="aos-hero-card-prices">';
        trackHtml += '<span class="aos-hero-card-price">' + fmtMoney(p.computedPrice / 100.0) + '</span>';
        if (p.computedCompare > 0 && p.computedDiscount > 0) {
          trackHtml += '<span class="aos-hero-card-was">' + fmtMoney(p.computedCompare / 100.0) + '</span>';
        }
        trackHtml += '</div></div></a>';

        dotsHtml += '<div class="aos-hero-dot' + (i === 0 ? ' active' : '') + '" data-idx="' + i + '"></div>';
      });
      heroTrack.innerHTML = trackHtml;
      heroDotsEl.innerHTML = dotsHtml;
      heroCarousel.style.display = 'flex';
      
      heroCards = heroTrack.querySelectorAll('.aos-hero-card');
      
      heroDotsEl.querySelectorAll('.aos-hero-dot').forEach(function(dot) {
        dot.addEventListener('click', function() {
          heroGoTo(parseInt(dot.dataset.idx, 10));
        });
      });

      // Smooth auto play interval
      setInterval(function() {
        heroGoTo(heroCurrent + 1);
      }, 4500);
    }
  }

  // Persistent Countdown Timer logic
  var countdownDuration = 12 * 24 * 60 * 60 * 1000; // 12 days
  var endtimeKey = 'aylesva_deals_hero_endtime';
  var endTime = localStorage.getItem(endtimeKey);
  
  if (!endTime) {
    endTime = Date.now() + countdownDuration;
    localStorage.setItem(endtimeKey, endTime);
  } else {
    endTime = parseInt(endTime, 10);
    // If timer expired, reset to a new 12-day block
    if (endTime < Date.now()) {
      endTime = Date.now() + countdownDuration;
      localStorage.setItem(endtimeKey, endTime);
    }
  }

  var htD = page.querySelector('#aos-ht-d');
  var htH = page.querySelector('#aos-ht-h');
  var htM = page.querySelector('#aos-ht-m');
  var htS = page.querySelector('#aos-ht-s');

  function updateHeroCountdown() {
    var diff = endTime - Date.now();
    if (diff <= 0) {
      endTime = Date.now() + countdownDuration;
      localStorage.setItem(endtimeKey, endTime);
      diff = countdownDuration;
    }
    
    var days = Math.floor(diff / (24 * 60 * 60 * 1000));
    var hrs  = Math.floor((diff % (24 * 60 * 60 * 1000)) / (60 * 60 * 1000));
    var mins = Math.floor((diff % (60 * 60 * 1000)) / (60 * 1000));
    var secs = Math.floor((diff % (60 * 1000)) / 1000);

    if (htD) htD.textContent = pad2(days);
    if (htH) htH.textContent = pad2(hrs);
    if (htM) htM.textContent = pad2(mins);
    if (htS) htS.textContent = pad2(secs);
  }
  
  updateHeroCountdown();
  setInterval(updateHeroCountdown, 1000);

  // Smooth scroll to offers section
  page.querySelectorAll('.scroll-to-offers').forEach(function(el) {
    el.addEventListener('click', function(e) {
      e.preventDefault();
      var targetTab = page.querySelector('.aos-tabs-bar');
      
      // If we clicked "EXPLORAR SALDOS", we also want to simulate clicking the 50%+ tier or similar
      if (el.getAttribute('data-target') === 'saldos') {
        var saldosTier = page.querySelector('[data-tier="50plus"]');
        if (saldosTier) {
          saldosTier.click();
        }
      } else {
        // Standard view offers: reset tier back to 'all' for best onboarding
        var allTier = page.querySelector('[data-tier="all"]');
        if (allTier && !allTier.classList.contains('active')) {
          allTier.click();
        }
      }

      if (targetTab) {
        var barY = targetTab.getBoundingClientRect().top + window.scrollY;
        window.scrollTo({ top: barY - 10, behavior: 'smooth' });
      }
    });
  });

  // Initialize display
  render();

  // --- New Carousel Navigation & Swipe Support ---
  var track = page.querySelector('#aos-track-' + sid);
  var arrowPrev = page.querySelector('#aos-nav-prev-' + sid);
  var arrowNext = page.querySelector('#aos-nav-next-' + sid);

  function updateCarouselArrows() {
    if (!track || !arrowPrev || !arrowNext) return;
    arrowPrev.disabled = track.scrollLeft <= 5;
    // Check if scrolled to the end (allowing 5px buffer)
    arrowNext.disabled = track.scrollLeft >= track.scrollWidth - track.clientWidth - 5;
  }

  if (track && arrowPrev && arrowNext) {
    arrowPrev.addEventListener('click', function() {
      var cardWidth = track.querySelector('.aos-carousel-card').clientWidth + 20; // card + gap
      track.scrollBy({ left: -cardWidth, behavior: 'smooth' });
    });

    arrowNext.addEventListener('click', function() {
      var cardWidth = track.querySelector('.aos-carousel-card').clientWidth + 20; // card + gap
      track.scrollBy({ left: cardWidth, behavior: 'smooth' });
    });

    track.addEventListener('scroll', updateCarouselArrows);
    window.addEventListener('resize', updateCarouselArrows);
    setTimeout(updateCarouselArrows, 100);
  }

  // --- New Wishlist Persistence via localStorage ---
  var wishlistKey = 'aylesva_deals_hub_wishlist';
  var likedIds = [];
  try {
    var stored = localStorage.getItem(wishlistKey);
    if (stored) likedIds = JSON.parse(stored);
  } catch(e) { console.error('Wishlist storage access error', e); }

  // Set active states on load
  function restoreWishlistUI() {
    likedIds.forEach(function(id) {
      var hearts = page.querySelectorAll('.aos-card-wishlist[data-id="' + id + '"]');
      hearts.forEach(function(h) { h.classList.add('active'); });
    });
  }

  // Add click listeners to heart buttons
  page.querySelectorAll('.aos-card-wishlist').forEach(function(heartBtn) {
    heartBtn.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      var id = heartBtn.getAttribute('data-id');
      if (!id) return;
      
      var idx = likedIds.indexOf(id);
      if (idx > -1) {
        likedIds.splice(idx, 1);
        heartBtn.classList.remove('active');
      } else {
        likedIds.push(id);
        heartBtn.classList.add('active');
        
        // Add a premium pop animation on click
        heartBtn.style.transform = 'scale(1.3)';
        setTimeout(function() {
          heartBtn.style.transform = '';
        }, 200);
      }
      
      // Update other hearts for the same product in this section (if any)
      page.querySelectorAll('.aos-card-wishlist[data-id="' + id + '"]').forEach(function(otherHeart) {
        otherHeart.classList.toggle('active', idx === -1);
      });
      
      try {
        localStorage.setItem(wishlistKey, JSON.stringify(likedIds));
      } catch(err) { console.error('Could not save wishlist', err); }
    });
  });

  restoreWishlistUI();

})();
</script>

