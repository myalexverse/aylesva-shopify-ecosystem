  function mapCat(raw) { return CATEGORY_MAP[raw] || raw || 'Otros'; }
  function makeCatKey(c) { return (c||'').toLowerCase().replace(/\s+/g,'-').replace(/[&']/g,'').trim(); }
  function fmtMoney(n) { return '$' + n.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g,',') + ' MXN'; }
  function thumbUrl(src) {
    if (!src) return '';
    return src.replace(/\.(jpg|jpeg|png|gif|webp)(\?.*)?$/i,'_400x400.$1$2');
  }
  function pad2(n) { return String(n).padStart(2,'0'); }

  function buildCard(product, index) {
    var pMin = product.computedPrice;
    var capMax = product.computedCompare;
    var discount = product.computedDiscount;
    
    var imgUrl = product.featured_image ? thumbUrl(product.featured_image) : '';
    var initials = '';
    if (!imgUrl) {
      initials = (product.title || '').split(' ').slice(0,2).map(function(w){return w[0];}).join('').toUpperCase();
    }
    
    var cardHtml = '<a href="/products/' + product.handle + '" class="aos-card">';
    cardHtml += '<div class="aos-card-img">';
    if (discount > 0) {
      var extraClass = discount >= 50 ? ' red' : '';
      cardHtml += '<span class="aos-pct-tag' + extraClass + '">-' + discount + '%</span>';
    }
    if (imgUrl) {
      cardHtml += '<img src="' + imgUrl + '" alt="' + product.title + '" loading="lazy">';
    } else {
      var colorIdx = index % COLORS.length;
      cardHtml += '<div class="aos-initials" style="background:' + COLORS[colorIdx] + '">' + initials + '</div>';
    }
    cardHtml += '<div class="aos-quick">Ver Oferta →</div>';
    cardHtml += '</div>';
    
    cardHtml += '<div class="aos-card-body">';
    cardHtml += '<div class="aos-card-brand">' + (product.vendor || '') + '</div>';
    cardHtml += '<h3 class="aos-card-title">' + product.title + '</h3>';
    cardHtml += '<div class="aos-card-prices">';
    cardHtml += '<span class="aos-sale-price">' + fmtMoney(pMin / 100.0) + '</span>';
    if (discount > 0 && capMax > 0) {
      cardHtml += '<span class="aos-orig-price">' + fmtMoney(capMax / 100.0) + '</span>';
      cardHtml += '<span class="aos-save-txt">Ahorras ' + fmtMoney((capMax - pMin) / 100.0) + '</span>';
    }
    cardHtml += '</div>';
    cardHtml += '</div></a>';
    return cardHtml;
  }

  // Precompute pricing, discounts, and categories client-side once
  var processedProducts = allProducts.map(function(p) {
    var pMin = Infinity, capMax = 0, bestPct = 0;
    (p.variants || []).forEach(function(v) {
      var price = parseFloat(v.price) || 0;
      var cap = parseFloat(v.compare_at_price) || 0;
      if (price > 0 && cap > price) {
        var pct = Math.round((cap - price) / cap * 100);
        if (pct > bestPct) {
          bestPct = pct;
          capMax = cap;
          pMin = price;
        }
      }
    });
    // Fallback: use cheapest price if no active discount variants are set up
    if (!isFinite(pMin) || pMin === Infinity) {
      pMin = 0;
      (p.variants || []).forEach(function(v) {
        var price = parseFloat(v.price) || 0;
        if (price > 0 && (price < pMin || pMin === 0)) pMin = price;
      });
    }
    var discount = 0;
    if (capMax > pMin && capMax > 0) {
      discount = Math.round((capMax - pMin) / capMax * 100);
    }
    p.computedPrice = pMin;
    p.computedCompare = capMax;
    p.computedDiscount = discount;
    p.computedCategory = mapCat(p.type);
    return p;
  });

  // Precompute pricing, discounts, and categories client-side once for the hero
  var processedHeroProducts = heroProducts.map(function(p) {
    var pMin = Infinity, capMax = 0, bestPct = 0;
    (p.variants || []).forEach(function(v) {
      var price = parseFloat(v.price) || 0;
      var cap = parseFloat(v.compare_at_price) || 0;
      if (price > 0 && cap > price) {
        var pct = Math.round((cap - price) / cap * 100);
        if (pct > bestPct) {
          bestPct = pct;
          capMax = cap;
          pMin = price;
        }
      }
    });
    // Fallback: use cheapest price if no active discount variants are set up
    if (!isFinite(pMin) || pMin === Infinity) {
      pMin = 0;
      (p.variants || []).forEach(function(v) {
        var price = parseFloat(v.price) || 0;
        if (price > 0 && (price < pMin || pMin === 0)) pMin = price;
      });
    }
    var discount = 0;
    if (capMax > pMin && capMax > 0) {
      discount = Math.round((capMax - pMin) / capMax * 100);
    }
    p.computedPrice = pMin;
    p.computedCompare = capMax;
    p.computedDiscount = discount;
    p.computedCategory = mapCat(p.type);
    return p;
  });

  // Calculate high-fidelity stats
  var totalDeals = processedProducts.length;
  var maxDiscount = 0;
  var categoryCounts = { all: totalDeals };
  
  processedProducts.forEach(function(p) {
    if (p.computedDiscount > maxDiscount) maxDiscount = p.computedDiscount;
    var cat = p.computedCategory;
    categoryCounts[cat] = (categoryCounts[cat] || 0) + 1;
  });

  // Fallback if max discount is 0
  if (maxDiscount === 0) maxDiscount = 70; // Fallback display placeholder

  if (maxPctEl) maxPctEl.textContent = maxDiscount;
  if (heroMaxEl) heroMaxEl.textContent = maxDiscount + '%';
  if (heroMaxPctTitle) heroMaxPctTitle.textContent = maxDiscount + '%';
  if (heroMetricPct) heroMetricPct.textContent = 'Hasta ' + maxDiscount + '%';

  // Build category tabs carousel dynamically
  var categoryOrderFiltered = CATEGORY_ORDER.filter(function(c) {
    return (categoryCounts[c] || 0) > 0;
  });

  if (tabsEl) {
    var tabsHtml = '<button class="aos-tab active" data-cat="all">';
    tabsHtml += '<span class="aos-tab-ico"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg></span>';
    tabsHtml += '<span>Todas las Ofertas</span>';
    tabsHtml += '<span class="aos-tab-ct">' + totalDeals + '</span></button>';

    categoryOrderFiltered.forEach(function(cat) {
      var icon = CAT_ICONS[cat] || '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg>';
      tabsHtml += '<button class="aos-tab" data-cat="' + cat + '">';
      tabsHtml += '<span class="aos-tab-ico">' + icon + '</span>';
      tabsHtml += '<span>' + cat + '</span>';
      tabsHtml += '<span class="aos-tab-ct">' + categoryCounts[cat] + '</span></button>';
    });
    tabsEl.innerHTML = tabsHtml;

    // Set tab click listeners
    tabsEl.querySelectorAll('.aos-tab').forEach(function(tab) {
      tab.addEventListener('click', function() {
        tabsEl.querySelectorAll('.aos-tab').forEach(function(t){ t.classList.remove('active'); });
        tab.classList.add('active');
        activeCat = tab.dataset.cat;
        currentPage = 1;
        syncCategoryUI();
        render();
      });
    });
    updateArrows();
  }

