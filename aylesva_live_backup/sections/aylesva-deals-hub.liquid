<script>
(function() {
  var sid  = '{{ section.id }}';
  var page = document.querySelector('[data-section-id="' + sid + '"]');
  if (!page) return;

  var gridEl    = page.querySelector('#aos-grid-' + sid);
  var loadEl    = page.querySelector('#aos-loading-' + sid);
  var countEl   = page.querySelector('#aos-count-' + sid);
  var emptyEl   = page.querySelector('#aos-empty-' + sid);
  var pagEl     = page.querySelector('#aos-pag-' + sid);
  var tabsEl    = page.querySelector('#aos-tabs-' + sid);
  var prevBtn   = page.querySelector('#aos-prev-' + sid);
  var nextBtn   = page.querySelector('#aos-next-' + sid);
  var sideCatsEl= page.querySelector('#aos-side-cats-' + sid);
  var maxPctEl  = page.querySelector('#aos-max-pct-' + sid);
  var heroMaxEl = page.querySelector('#aos-hero-maxpct-' + sid);
  var heroMaxPctTitle = page.querySelector('#aos-hero-max-pct-title-' + sid);
  var heroMetricPct = page.querySelector('#aos-hero-metric-pct-' + sid);
  var flashEl   = page.querySelector('#aos-flash-' + sid);
  var flashTitle= page.querySelector('#aos-flash-title-' + sid);
  var flashLink = page.querySelector('#aos-flash-link-' + sid);
  var heroMiniGrid  = page.querySelector('#aos-hero-minigrid-' + sid);
  var heroCarousel  = page.querySelector('#aos-hero-carousel-' + sid);
  var heroTrack     = page.querySelector('#aos-hero-track-' + sid);
  var heroDotsEl    = page.querySelector('#aos-hero-dots-' + sid);
  var heroPrevBtn   = page.querySelector('#aos-hero-prev-' + sid);
  var heroNextBtn   = page.querySelector('#aos-hero-next-' + sid);
  var heroCurrent   = 0;
  var heroCards     = [];

  function heroGoTo(idx) {
    if (!heroCards.length) return;
    var dir = idx > heroCurrent ? 1 : -1;
    heroCards[heroCurrent].classList.add(dir > 0 ? 'aos-hc-prev-hidden' : 'aos-hc-hidden');
    heroCards[heroCurrent].classList.remove('active');
    heroCurrent = (idx + heroCards.length) % heroCards.length;
    heroCards[heroCurrent].classList.remove('aos-hc-hidden','aos-hc-prev-hidden');
    heroCards[heroCurrent].classList.add('active');
    var dots = heroDotsEl.querySelectorAll('.aos-hero-dot');
    if (dots.length) {
      dots.forEach(function(d,i){ d.classList.toggle('active', i===heroCurrent); });
    }
  }
  if (heroPrevBtn) heroPrevBtn.addEventListener('click', function(){ heroGoTo(heroCurrent-1); });
  if (heroNextBtn) heroNextBtn.addEventListener('click', function(){ heroGoTo(heroCurrent+1); });

  var pminEl    = page.querySelector('#aos-pmin-' + sid);
  var pmaxEl    = page.querySelector('#aos-pmax-' + sid);
  var resetBtn  = page.querySelector('#aos-reset-' + sid);

  // Mobile filter drawer toggles
  var filterOpenBtn  = page.querySelector('#aos-filter-open-' + sid);
  var filterCloseBtn = page.querySelector('#aos-filter-close-' + sid);
  var filterOverlay  = page.querySelector('#aos-overlay-' + sid);
  var filterDrawer   = page.querySelector('#aos-drawer-' + sid);
  var drawerDiscEl   = page.querySelector('#aos-drawer-disc-' + sid);
  var drawerCatsEl   = page.querySelector('#aos-drawer-cats-' + sid);
  var pmin2El        = page.querySelector('#aos-pmin2-' + sid);
  var pmax2El        = page.querySelector('#aos-pmax2-' + sid);

  function openDrawer() {
    if (filterOverlay) filterOverlay.classList.add('open');
    if (filterDrawer)  filterDrawer.classList.add('open');
    document.body.style.overflow = 'hidden';
  }
  function closeDrawer() {
    if (filterOverlay) filterOverlay.classList.remove('open');
    if (filterDrawer)  filterDrawer.classList.remove('open');
    document.body.style.overflow = '';
  }
  if (filterOpenBtn)  filterOpenBtn.addEventListener('click', openDrawer);
  if (filterCloseBtn) filterCloseBtn.addEventListener('click', closeDrawer);
  if (filterOverlay)  filterOverlay.addEventListener('click', closeDrawer);

  if (drawerDiscEl) {
    drawerDiscEl.querySelectorAll('.aos-disc-chip').forEach(function(chip) {
      chip.addEventListener('click', function() {
        drawerDiscEl.querySelectorAll('.aos-disc-chip').forEach(function(c){ c.classList.remove('active'); });
        chip.classList.add('active');
        activeDisc = parseInt(chip.dataset.min, 10) || 0;
        page.querySelectorAll('.aos-sidebar .aos-disc-chip').forEach(function(c){ c.classList.remove('active'); });
        var match = page.querySelector('.aos-sidebar .aos-disc-chip[data-min="'+chip.dataset.min+'"]');
        if (match) match.classList.add('active');
        currentPage = 1; render(); closeDrawer();
      });
    });
  }
  if (pmin2El) pmin2El.addEventListener('input', function(){ priceMin = parseFloat(pmin2El.value)||0; if(pminEl) pminEl.value=pmin2El.value; currentPage=1; render(); });
  if (pmax2El) pmax2El.addEventListener('input', function(){ priceMax = parseFloat(pmax2El.value)||Infinity; if(pmaxEl) pmaxEl.value=pmax2El.value; currentPage=1; render(); });

  var activeCat   = 'all';
  var activeTier  = 'all';
  var activeSort  = 'pct-desc';
  var activeDisc  = 0;
  var priceMin    = 0;
  var priceMax    = Infinity;
  var allProducts = [];
  var heroProducts = [];
  var currentPage = 1;
  var PAGE_SIZE   = 24;

  // Render collections products as dynamic Javascript JSON data
  allProducts = [
