{%- liquid
  assign sort_by = results.sort_by | default: results.default_sort_by
  assign total_active_values = 0
  if results.url
    assign results_url = results.url
  else 
    assign terms = results.terms | escape
    assign results_url = '?q=' | append: terms | append: '&options%5Bprefix%5D=last&sort_by=' | append: sort_by
  endif
-%}
<div class="facets-container">
  {%- unless collapse_on_larger_devices -%}
  <facet-filters-form class="facets">
    <form id="FacetFiltersForm" class="facets__form">
      {%- if results.terms -%}
      <input type="hidden" name="q" value="{{ results.terms | escape }}">
      <input name="options[prefix]" type="hidden" value="last">
      {%- endif -%}
      {% if show_filter %}
      <div id="FacetsWrapperDesktop" class="facets__wrapper">
        {%- for filter in results.filters -%}
        {%- assign total_active_values = total_active_values | plus: filter.active_values.size -%}
        {% case filter.type %}
        {% when 'list' %}
        <div class="disclosure-has-popup facets__disclosure js-filter widget active" data-index="{{ forloop.index }}">
          <summary class="facets__summary caption-large focus-offset">
            <div>
              <h4 class="widget-title">{{ filter.label | escape }}</h4>
            </div>
          </summary>
          <div class="facets-filter">
            {% if filter.label == 'Marca' or filter.label == 'Brand' or filter.label == 'Vendor' %}
              <div class="ayl-brand-search-wrap" style="padding: 0 15px 12px 0;">
                <input type="text" class="ayl-brand-search-input" placeholder="Buscar marca..." style="width: 100%; border: 1.5px solid #eaeaea; border-radius: 4px; padding: 8px 12px; font-size: 13px; outline: none; box-sizing: border-box; transition: border-color 0.2s;" onkeyup="filterBrands(this)">
              </div>
              <script>
                function filterBrands(input) {
                  var filter = input.value.toLowerCase();
                  var ul = input.closest('.facets-filter').querySelector('.facets__list');
                  var li = ul.getElementsByTagName('li');
                  for (var i = 0; i < li.length; i++) {
                    var label = li[i].querySelector('label');
                    if (label) {
                      var txtValue = label.textContent || label.innerText;
                      if (txtValue.toLowerCase().indexOf(filter) > -1) {
                        li[i].style.display = "";
                      } else {
                        li[i].style.display = "none";
                      }
                    }
                  }
                }
              </script>
            {% endif %}
            <ul class="facets__list list-unstyled" role="list">
              {%- for value in filter.values -%}
               <li class="list-menu__item facets__item {% if filter.label == 'Color' %} Color{% endif %}{% if filter.label == 'Talla' or filter.label == 'Size' %} Talla{% endif %}">
                <label for="Filter-{{ filter.label | escape }}-{{ forloop.index }}" class="facet-checkbox{% if value.active %} facet-checkbox--disabled{% endif %}" {% if filter.label == 'Color' %}style="background-color:{{ value.value }}"{% endif %}>
                  <input type="checkbox"
                         name="{{ value.param_name }}"
                         value="{{ value.value }}"
                         id="Filter-{{ filter.label | escape }}-{{ forloop.index }}"
                         {% if value.active %}checked{% endif %}
                         {% if value.count == 0 and value.active == false %}disabled{% endif %}
                         >
                  {% if filter.label == 'Talla' or filter.label == 'Size' %}
                    <span class="size-box-label">{{ value.label | escape }}</span>
                  {% elsif filter.label != 'Color' %}
                    {{ value.label | escape }} ({{ value.count }})
                  {% endif %}
                  <svg class="icon icon-checkmark"
                       width="11"
                       height="7"
                       viewBox="0 0 11 7"
                       fill="none"
                       xmlns="http://www.w3.org/2000/svg">

                    <path d="M1.5 3.5L2.83333 4.75L4.16667 6L9.5 1"
                          stroke="currentColor"
                          stroke-width="1.75"
                          stroke-linecap="round"
                          stroke-linejoin="round" />
                  </svg>
                </label>
                {% if filter.label == 'Color' %} <span>{{ value.label | escape }} ({{ value.count }})</span> {% endif %}
              </li>
              {%- endfor -%}
            </ul>
          </div>
        </div>
        {% when 'price_range' %}
        {% liquid
                  assign currencies_using_comma_decimals = 'ANG,ARS,BRL,BYN,BYR,CLF,CLP,COP,CRC,CZK,DKK,EUR,HRK,HUF,IDR,ISK,MZN,NOK,PLN,RON,RUB,SEK,TRY,UYU,VES,VND' | split: ','
                  assign uses_comma_decimals = false
                  if currencies_using_comma_decimals contains cart.currency.iso_code
                    assign uses_comma_decimals = true
                  endif
                  
                  if uses_comma_decimals
                    assign max_price_amount = filter.range_max | money_without_currency | replace: '.', '' | replace: ',', '.' | plus: 0
                    assign min_value_amount = filter.min_value.value | money_without_currency | replace: '.', '' | replace: ',', '.' | plus: 0 | default: 0
                    assign max_value_amount = filter.max_value.value | money_without_currency | replace: '.', '' | replace: ',', '.' | plus: 0 | default: max_price_amount
                  else
                    assign max_price_amount = filter.range_max | money_without_currency | replace: ',', '' | plus: 0
                    assign min_value_amount = filter.min_value.value | money_without_currency | replace: ',', '' | plus: 0 | default: 0
                    assign max_value_amount = filter.max_value.value | money_without_currency | replace: ',', '' | plus: 0 | default: max_price_amount
                  endif
                %}
        <div class="disclosure-has-popup facets__disclosure js-filter widget active" data-index="{{ forloop.index }}">
          <summary class="facets__summary caption-large focus-offset">
            <div>
              <h4 class="widget-title">{{ filter.label | escape }}</h4>
            </div>
          </summary>
          <div class="facets-filter">
            <price-range class="facets__price">
              <!-- Dual Range Slider HTML -->
              <div class="ayl-range-slider-container" style="padding: 0 5px; margin-top: 10px; width: 100%;">
                <div class="ayl-range-slider-wrapper" style="position: relative; height: 30px; width: 100%;">
                  <div class="ayl-range-slider-track" style="position: absolute; height: 4px; border-radius: 2px; left: 0; right: 0; top: 13px; z-index: 1;"></div>
                  <input type="range" class="ayl-range-min" min="0" max="{{ max_price_amount }}" value="{{ min_value_amount }}">
                  <input type="range" class="ayl-range-max" min="0" max="{{ max_price_amount }}" value="{{ max_value_amount }}">
                </div>
                <div class="ayl-range-slider-values" style="display: flex; justify-content: space-between; margin-top: 5px; font-size: 13px; font-weight: 600; color: #1c1c1e;">
                  <span class="ayl-range-val-min">{{ cart.currency.symbol }}{{ min_value_amount | round }}</span>
                  <span class="ayl-range-val-max">{{ cart.currency.symbol }}{{ max_value_amount | round }}{% if max_value_amount >= max_price_amount %}+{% endif %}</span>
                </div>
              </div>
              
              <!-- Hidden inputs that standard form uses -->
              <input class="field__input ayl-real-min"
                     name="{{ filter.min_value.param_name }}"
                     id="Filter-{{ filter.label | escape }}-GTE"
                     value="{{ min_value_amount }}"
                     type="hidden">
              <input class="field__input ayl-real-max"
                     name="{{ filter.max_value.param_name }}"
                     id="Filter-{{ filter.label | escape }}-LTE"
                     value="{{ max_value_amount }}"
                     type="hidden">
            </price-range>
            
            <script>
              (function() {
                var container = document.currentScript.previousElementSibling;
                var minInput = container.querySelector('.ayl-range-min');
                var maxInput = container.querySelector('.ayl-range-max');
                var realMin = container.querySelector('.ayl-real-min');
                var realMax = container.querySelector('.ayl-real-max');
                var minLabel = container.querySelector('.ayl-range-val-min');
                var maxLabel = container.querySelector('.ayl-range-val-max');
                var track = container.querySelector('.ayl-range-slider-track');
                var currencySymbol = "{{ cart.currency.symbol }}";
                
                function updateSlider() {
                  var val1 = parseInt(minInput.value);
                  var val2 = parseInt(maxInput.value);
                  
                  if (val1 > val2) {
                    var temp = val1;
                    val1 = val2;
                    val2 = temp;
                  }
                  
                  minLabel.textContent = currencySymbol + val1;
                  var isMaxPlus = val2 >= parseInt(maxInput.max);
                  maxLabel.textContent = currencySymbol + val2 + (isMaxPlus ? '+' : '');
                  
                  var max = parseInt(minInput.max) || 1;
                  var pct1 = (val1 / max) * 100;
                  var pct2 = (val2 / max) * 100;
                  track.style.background = 'linear-gradient(to right, #e2e8f0 ' + pct1 + '%, #C5A47E ' + pct1 + '%, #C5A47E ' + pct2 + '%, #e2e8f0 ' + pct2 + '%)';
                }
                
                function applyFilters() {
                  var val1 = parseInt(minInput.value);
                  var val2 = parseInt(maxInput.value);
                  if (val1 > val2) {
                    var temp = val1;
                    val1 = val2;
                    val2 = temp;
                  }
                  realMin.value = val1;
                  realMax.value = val2;
                  
                  // Trigger standard form submit
                  var event = new Event('input', { bubbles: true });
                  realMin.dispatchEvent(event);
                }
                
                minInput.addEventListener('input', updateSlider);
                maxInput.addEventListener('input', updateSlider);
                
                minInput.addEventListener('change', applyFilters);
                maxInput.addEventListener('change', applyFilters);
                
                updateSlider();
              })();
            </script>
          </div>
        </div>
    {% endcase %}
    {%- endfor -%}
    <noscript>
      <button type="submit" class="facets__button-no-js button button--tertiary">{{ 'products.facets.filter_button' | t }}</button>
    </noscript>
    </div>

  <div class="active-facets active-facets-desktop">
    <facet-remove class="active-facets__button-wrapper">
      <a href="{{ results_url }}" class="active-facets__button-remove underlined-link btn">
        <span>{{ 'products.facets.clear_all' | t }}</span>
      </a>
    </facet-remove>
  </div>
  {% endif %}

  {% if results.current_vendor or results.current_type %}
  <input type="hidden" name="q" value="{{ results.current_vendor }}{{ results.current_type }}">
  {% endif %}

  </form>
</facet-filters-form>
{%- endunless -%}
<menu-drawer class="mobile-facets__wrapper" data-breakpoint="mobile">
  <details class="mobile-facets__disclosure disclosure-has-popup">
    <summary class="mobile-facets__open-wrapper focus-offset">
      <span class="mobile-facets__open">
        <i class="mdi mdi-format-list-bulleted"></i>
        <span class="mobile-facets__open-label button-label">
          {{ 'products.facets.filter_button' | t }}
        </span>
      </span>
      <span tabindex="0" class="mobile-facets__close mobile-facets__close--no-js"><i class="mdi mdi-close"></i></span>
    </summary>
    <facet-filters-form>
      <form id="FacetFiltersFormMobile" class="mobile-facets">
        <div class="mobile-facets__inner">
          <div class="mobile-facets__main">
            <div class="mobile-facets__footer main">
              <facet-remove class="mobile-facets__clear-wrapper">
                <a href="{{ results_url }}" class="mobile-facets__clear underlined-link btn">{{ 'products.facets.clear_all' | t }}</a>
              </facet-remove>
              <button type="button" class="no-js-hidden btn btn-primary" onclick="this.closest('.mobile-facets__wrapper').querySelector('summary').click()">{{ 'products.facets.apply_all' | t }}</button>
              <noscript><button class="button button--primary">{{ 'products.facets.apply_all' | t }}</button></noscript>
            </div>
            {%- for filter in results.filters -%}
            {% case filter.type %}
            {% when 'list' %}
            <details class="mobile-facets__details js-filter" data-index="mobile-{{ forloop.index }}" open>
              <summary class="mobile-facets__summary focus-inset">
                <div>
                  <h4 class="widget-title">{{ filter.label | escape }}</h4>                        
                  <span class="mobile-facets__arrow no-js-hidden"> <i class="mdi mdi-arrow-right"></i></span>
                  <noscript><svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-caret" viewBox="0 0 10 6">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="#666" />
                    </svg>
                  </noscript>
                </div>
              </summary>
              <div class="mobile-facets__submenu">
                <ul class="mobile-facets__list list-unstyled" role="list">
                  {%- for value in filter.values -%}
                  <li class="mobile-facets__item list-menu__item {% if filter.label == 'Color' %} Color{% endif %}">
                    <label for="Filter-{{ filter.label | escape }}-mobile-{{ forloop.index }}" class="mobile-facets__label{% if value.count == 0 and value.active == false %} mobile-facets__label--disabled{% endif %}" {% if filter.label == 'Color' %}style="background-color:{{ value.value }}"{% endif %}>
                      <input type="checkbox"
                             name="{{ value.param_name }}"
                             value="{{ value.value }}"
                             id="Filter-{{ filter.label | escape }}-{{ forloop.index }}"
                             {% if value.active %}checked{% endif %}
                             {% if value.count == 0 and value.active == false %}disabled{% endif %}
                             >
                      {% if filter.label != 'Color' %} {{ value.label | escape }} ({{ value.count }}){% endif %}
                      <svg class="icon icon-checkmark" width="11" height="7" viewBox="0 0 11 7" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M1.5 3.5L2.83333 4.75L4.16667 6L9.5 1" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </label>
                    {% if filter.label == 'Color' %} <span>{{ value.label | escape }} ({{ value.count }})</span> {% endif %}
                  </li>
                  {%- endfor -%}
                </ul>

                <div class="no-js-hidden mobile-facets__footer">
                  <facet-remove class="mobile-facets__clear-wrapper">
                    <a href="{{ results_url }}" class="mobile-facets__clear underlined-link btn">{{ 'products.facets.clear' | t }}</a>
                  </facet-remove>
                  <button type="button" class="no-js-hidden btn btn-primary" onclick="this.closest('.mobile-facets__wrapper').querySelector('summary').click()">{{ 'products.facets.apply' | t }}</button>
                  <noscript><button class="button button--primary">{{ 'products.facets.apply' | t }}</button></noscript>
                </div>
              </div>
            </details>
            {% when 'price_range' %}
            <details class="mobile-facets__details js-filter" data-index="mobile-{{ forloop.index }}" open>
              <summary class="mobile-facets__summary focus-inset">
                <div>
                  <h4 class="widget-title">{{ filter.label | escape }}</h4>
                  <span class="mobile-facets__arrow no-js-hidden"><i class="mdi mdi-arrow-right"></i></span>
                  <noscript><svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-caret" viewBox="0 0 10 6">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="#666" />
                    </svg>
                  </noscript>
                </div>
              </summary>
              <div class="mobile-facets__submenu">
                <price-range class="facets__price">
                  <div class="field">
                    <span class="field-currency">{{ cart.currency.symbol }}</span>
                    <label class="field__label" for="Filter-{{ filter.label | escape }}-GTE">{{ 'products.facets.from' | t }}</label>
                    <input class="field__input"
                           name="{{ filter.min_value.param_name }}"
                           id="Mobile-Filter-{{ filter.label | escape }}-GTE"
                           {%- if filter.min_value.value -%}
                           {%- if uses_comma_decimals -%}value="{{ filter.min_value.value | money_without_currency | replace: '.', '' | replace: ',', '.' }}"{%- else -%}value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"{% endif %}
                           {%- endif -%}
                           type="number"
                           placeholder="0"
                           min="0"
                           inputmode="decimal"
                           {%- if uses_comma_decimals -%}max="{{ filter.range_max | money_without_currency | replace: '.', '' | replace: ',', '.' }}"{%- else -%}max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"{% endif %}
                           >
                    </input>
                  </div>
                <div class="field">
                  <span class="field-currency">{{ cart.currency.symbol }}</span>
                  <label class="field__label" for="Filter-{{ filter.label | escape }}-GTE">{{ 'products.facets.to' | t }}</label>
                  <input class="field__input"
                         name="{{ filter.min_value.param_name }}"
                         id="Mobile-Filter-{{ filter.label | escape }}-GTE"
                         {%- if filter.min_value.value -%}
                         {%- if uses_comma_decimals -%}value="{{ filter.min_value.value | money_without_currency | replace: '.', '' | replace: ',', '.' }}"{%- else -%}value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"{% endif %}
                         {%- endif -%}
                         type="number"
                         placeholder="0"
                         min="0"
                         inputmode="decimal"
                         {%- if uses_comma_decimals -%}max="{{ filter.range_max | money_without_currency | replace: '.', '' | replace: ',', '.' }}"{%- else -%}max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"{% endif %}
                         >
                  </input>
              </div>
              </price-range>
            <div class="no-js-hidden mobile-facets__footer">
              <facet-remove class="mobile-facets__clear-wrapper">
                <a href="{{ results_url }}" class="mobile-facets__clear underlined-link btn">{{ 'products.facets.clear' | t }}</a>
              </facet-remove>
              <button type="button" class="no-js-hidden btn btn-primary" onclick="this.closest('.mobile-facets__wrapper').querySelector('summary').click()">{{ 'products.facets.apply' | t }}</button>
              <noscript><button class="button button--primary">{{ 'products.facets.apply' | t }}</button></noscript>
            </div>
          </div>
          </details>
        {% endcase %}
        {%- endfor -%}
        </div>

      {% if results.current_vendor or results.current_type %}
      <input type="hidden" name="q" value="{{ results.current_vendor }}{{ results.current_type }}">
      {% endif %}
      {%- if results.terms -%}
      <input type="hidden" name="q" value="{{ results.terms | escape }}">
      <input name="options[prefix]" type="hidden" value="last">
      {%- endif -%}            
      </div>
    </form>
  </facet-filters-form>
</details>
</menu-drawer>
</div>